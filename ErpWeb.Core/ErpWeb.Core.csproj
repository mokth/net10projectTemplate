<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Compile Remove="artifacts\**" />
    <EmbeddedResource Remove="artifacts\**" />
    <None Remove="artifacts\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ErpWeb.Model\ErpWeb.Model.csproj" />
    <ProjectReference Include="..\ErpWeb.Library\ErpWeb.Library.csproj" />
    <ProjectReference Include="..\ErpWeb.EInvoiceLib\ErpWeb.EInvoiceLib.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ErpWeb.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <!-- MailKit replaces System.Net.Mail.SmtpClient for outbound mail: SmtpClient cannot do
         implicit TLS (port 465), which is the only TLS mode this provider's mail host supports. -->
    <PackageReference Include="MailKit" Version="4.18.1" />
    <!-- MimeKit transitively resolves System.Security.Cryptography.Pkcs 10.0.0, which is flagged by
         GHSA-846f-f764-76mx / GHSA-2fmv-rv2c-59x7. Pin the patched build instead of inheriting it. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>

