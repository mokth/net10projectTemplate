@page "/sales/analysis/by-item"
@using ErpWeb.UI.Components.Common
@inherits SaAnalysisPageBase

<PageTitle>Sales by Item</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.SalesByItem">
    <div class="iv-page">
        @if (!string.IsNullOrWhiteSpace(LoadError))
        {
            <div class="iv-toast iv-toast--err" role="alert">
                <span>@LoadError</span>
                <button type="button" class="iv-toast__close" @onclick="DismissError" aria-label="Dismiss">×</button>
            </div>
        }

        <header class="iv-hero">
            <div class="iv-hero__mark" aria-hidden="true"><i class="fa-solid fa-cube"></i></div>
            <div class="iv-hero__copy">
                <p class="iv-eyebrow">Sales · Analysis</p>
                <h1 class="iv-title">Sales by Item</h1>
                <div class="iv-chips">
                    <span class="iv-chip">Posted invoice lines only</span>
                </div>
            </div>
        </header>

        <section class="iv-card">
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:.5rem .75rem;">
                <div class="iv-field">
                    <label class="iv-field__label">From</label>
                    <DxDateEdit @bind-Date="@DateFrom" />
                </div>
                <div class="iv-field">
                    <label class="iv-field__label">To</label>
                    <DxDateEdit @bind-Date="@DateTo" />
                </div>
                <div class="iv-field">
                    <label class="iv-field__label">Item</label>
                    <IvStockMasterPicker ICode="@ItemCode"
                                         ICodeChanged="@OnItemCodeChangedAsync"
                                         Selected="@OnItemSelectedAsync" />
                </div>
                <div class="iv-field">
                    <label class="iv-field__label">Salesman</label>
                    <IvCodeComboBox Data="@SalesmanOptions" @bind-Value="@SalesmanCode" NullText="All salesmen" />
                </div>
                <div class="iv-field">
                    <label class="iv-field__label">Customer</label>
                    <IvCodeComboBox Data="@CustomerOptions" @bind-Value="@CustCode" NullText="All customers" />
                    <DxTextBox NullText="Search customers" maxlength="40"
                               TextChanged="@(async (v) => await OnCustomerSearchChangedAsync(v))" ValidationEnabled="false" />
                </div>
                <div class="iv-field">
                    <label class="iv-field__label code-style">Branch</label>
                    <DxTextBox @bind-Text="@BranchCode" NullText="All branches" maxlength="5" />
                </div>
            </div>

            <div class="iv-toolbar-row" style="margin-top:.75rem;">
                <DxButton RenderStyle="ButtonRenderStyle.Primary"
                          Text="@(IsLoading ? "Running…" : "Run")"
                          Click="@RunAsync"
                          Enabled="@(!IsLoading)" />
                @if (Rows.Count > 0)
                {
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="Export CSV"
                              Click="@(() => Navigation.NavigateTo(ExportUrl, forceLoad: true))" />
                }
            </div>
            <p class="iv-hint">
                Amounts are line totals (ex-tax). ASP is net amount ÷ quantity. Discount is the stored
                monetary discount only; percentage discounts are already inside amount / net amount.
            </p>
        </section>

        <section class="iv-card">
            @if (Rows.Count == 0)
            {
                <p class="text-muted mb-0">No posted invoice lines match the current filters.</p>
            }
            else
            {
                <DxGrid ColumnResizeMode="GridColumnResizeMode.ColumnsContainer" Data="@Rows" CssClass="w-100" TextWrapEnabled="false">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(SaSalesDetailRow.Key)" Caption="Item" Width="140px" />
                        <DxGridDataColumn FieldName="@nameof(SaSalesDetailRow.Description)" Caption="Description" />
                        <DxGridDataColumn FieldName="@nameof(SaSalesDetailRow.Qty)" Caption="Qty" Width="110px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(SaSalesDetailRow.Amount)" Caption="Amount" Width="130px" DisplayFormat="n2" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(SaSalesDetailRow.NetAmount)" Caption="Net amount" Width="130px" DisplayFormat="n2" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(SaSalesDetailRow.TaxAmount)" Caption="Tax" Width="120px" DisplayFormat="n2" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(SaSalesDetailRow.Discount)" Caption="Discount" Width="120px" DisplayFormat="n2" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(SaSalesDetailRow.Asp)" Caption="ASP" Width="110px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                    </Columns>
                </DxGrid>
            }
        </section>
    </div>
</MenuAuthorize>
