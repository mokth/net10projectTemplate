@namespace ErpWeb.UI.Sales.Lookups
@using Microsoft.AspNetCore.Components.Web

<DxPopup HeaderCssClass="code-style"
         HeaderText="SELECT CUSTOMER"
         CloseOnOutsideClick="false"
         Width="70vw"
         CssClass="common-popup"
         @bind-Visible="@Visible"
         Closing="@OnClosing">
    <Content>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-warning py-2">@_error</div>
        }

        <div class="erp-inline-search mb-2">
                <label class="erp-inline-search__caption">Search</label>
                <DxTextBox @bind-Text="@_searchText"
                           NullText="Customer code / name"
                           ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                           @onkeydown="OnSearchKeyDownAsync" />
                <DxButton CssClass="erp-inline-search__button" aria-label="Search" title="Search" RenderStyle="ButtonRenderStyle.Secondary"
                     
                      IconCssClass="fa-solid fa-magnifying-glass"
                      Click="@SearchAsync" />
            </div>

        <div class="d-flex gap-2 mt-3" @onkeydown="OnKeyDown">
            <DxButton RenderStyle="ButtonRenderStyle.Primary"
                      Text="SELECT"
                      IconCssClass="fa-solid fa-check"
                      Click="@SelectFocusedAsync"
                      Enabled="@(_focused is not null)" />
            <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                      Text="CANCEL"
                      IconCssClass="fa-solid fa-xmark"
                      Click="@CloseAsync" />
        </div>
    </Content>
</DxPopup>
