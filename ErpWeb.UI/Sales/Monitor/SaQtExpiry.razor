@page "/sales/monitor/quotation-expiry"
@inherits SaInquiryPageBase
@using ErpWeb.UI.Sales.Inquiry
@using ErpWeb.Core.Sales

<PageTitle>Quotation Expiry Watch</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.SalesQtExpiry">
    <div class="iv-page">
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="iv-toast iv-toast--err" role="alert">
                <span>@ErrorMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissError" aria-label="Dismiss">×</button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(NavMessage))
        {
            <div class="iv-toast iv-toast--warn" role="status">
                <span>@NavMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissNavMessage" aria-label="Dismiss">×</button>
            </div>
        }

        <header class="iv-hero">
            <div class="iv-hero__mark" aria-hidden="true"><i class="fa-solid fa-calendar-xmark"></i></div>
            <div class="iv-hero__copy">
                <p class="iv-eyebrow">Sales · Monitor</p>
                <h1 class="iv-title">Quotation Expiry Watch</h1>
                <div class="iv-chips" aria-busy="@SummaryLoading">
                    <span class="iv-chip">Open: @(SummaryLoading ? "…" : Summary.OpenCount.ToString("N0")) · @(SummaryLoading ? "…" : Summary.OpenValue.ToString("N2"))</span>
                    <button type="button" class="@(ExpiringSoonOnly ? "iv-chip iv-chip--active" : "iv-chip")"
                            @onclick="OnExpiringSoonClick">
                        Expiring soon: @(SummaryLoading ? "…" : Summary.ExpiringSoonCount.ToString("N0")) · @(SummaryLoading ? "…" : Summary.ExpiringSoonValue.ToString("N2"))
                    </button>
                    <button type="button" class="@(ExpiredOnly ? "iv-chip iv-chip--active" : "iv-chip")"
                            @onclick="OnExpiredClick">
                        Past validity: @(SummaryLoading ? "…" : Summary.ExpiredCount.ToString("N0")) · @(SummaryLoading ? "…" : Summary.ExpiredValue.ToString("N2"))
                    </button>
                    @if (!string.IsNullOrWhiteSpace(ScopeBranchCode))
                    {
                        <span class="iv-chip">Branch: @ScopeBranchCode</span>
                    }
                </div>
            </div>
        </header>

        @if (!IsBootstrapping && Summary.BySalesRep.Count > 0)
        {
            <section class="iv-card">
                <div class="iv-chips">
                    <span class="iv-chip">By sales rep</span>
                    @foreach (var rep in Summary.BySalesRep.Take(8))
                    {
                        <span class="iv-chip">@(string.IsNullOrWhiteSpace(rep.SalesRep) ? "(none)" : rep.SalesRep): @rep.Count.ToString("N0") · @rep.Value.ToString("N2")</span>
                    }
                </div>
            </section>
        }

        <section class="iv-card">
            <div class="iv-toolbar-row">
                <div class="iv-toolbar-row__search">
                    <IvCodeComboBox Data="@CustomerOptions"
                                    Value="@CustCode"
                                    ValueChanged="@(async (string? v) => await OnCustomerChangedAsync(v))"
                                    NullText="All customers" />
                </div>
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          Text="FILTER"
                          IconCssClass="fa-solid fa-filter"
                          Click="@OpenFilterPopup" />
            </div>

            @if (IsBootstrapping)
            {
                <div class="iv-skeleton" aria-busy="true">
                    <div class="iv-skeleton__line iv-skeleton__line--lg"></div>
                    <div class="iv-skeleton__line iv-skeleton__line--md"></div>
                    <div class="iv-skeleton__line"></div>
                </div>
            }
            else
            {
                <div class="iv-list-desktop">
                    <CommonDataGridEx T="SaQtExpiryRow"
                                      Columns="@Columns"
                                      Buttons="@Buttons"
                                      ActionButtons="@ActionButtons"
                                      KeyName="@nameof(SaQtExpiryRow.QtNo)"
                                      GridKey="sa-qt-expiry"
                                      Title="Quotation expiry watch"
                                      CustomDataSource="@DataSource"
                                      ShowToolbarText="true"
                                      ShowResetLayoutButton="true"
                                      UseBuiltInExport="false"
                                      ShowSearchBox="false"
                                      ShowFilterRow="false"
                                      ShowGroupPanel="false"
                                      allowSelect="false"
                                      OnGridInstance="@OnGridInstance"
                                      OnButtonEventHandle="@OnButtonClick"
                                      OnActionEventHandle="@OnActionClick" />
                </div>
            }
        </section>

        <p class="iv-subtitle">
            A watchlist, not an error list: <strong>EXPIRED</strong> is a normal state of the quotation
            lifecycle (the lazy sweep moves NEW/SENT there) and an <strong>ACCEPTED</strong> quotation is
            never auto-expired, so it is not flagged here. "Expiring soon" means the sweep would expire it
            within @ErpWeb.Core.Sales.SaMonitorLimits.QtExpiringSoonDays days.
        </p>
    </div>

    <DxPopup HeaderText="Filter quotations"
             CloseOnOutsideClick="false"
             Width="640px"
             CssClass="common-popup"
             @bind-Visible="@FilterPopupVisible">
        <Content>
            <div class="iv-popup-body">
                <DxFormLayout SizeMode="SizeMode.Small">
                    <DxFormLayoutItem Caption="QT date from" ColSpanMd="6">
                        <Template>
                            <DxDateEdit @bind-Date="@DraftDateFrom"
                                        DisplayFormat="dd/MM/yyyy"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="QT date to" ColSpanMd="6">
                        <Template>
                            <DxDateEdit @bind-Date="@DraftDateTo"
                                        DisplayFormat="dd/MM/yyyy"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Salesman" ColSpanMd="6">
                        <Template>
                            <IvCodeComboBox Data="@SalesmanOptions"
                                            @bind-Value="@DraftSalesmanCode"
                                            NullText="All salesmen" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Status" ColSpanMd="6">
                        <Template>
                            <DxComboBox Data="@StatusOptions"
                                        TextFieldName="@nameof(StatusFilterOption.Name)"
                                        ValueFieldName="@nameof(StatusFilterOption.Key)"
                                        @bind-Value="@DraftStatus"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Expiry bucket" ColSpanMd="6">
                        <Template>
                            <DxComboBox Data="@BucketOptions"
                                        @bind-Value="@DraftBucket"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Validity" ColSpanMd="6">
                        <Template>
                            <div>
                                <DxCheckBox @bind-Checked="@DraftExpiringSoonOnly" Text="Expiring soon only" />
                                <DxCheckBox @bind-Checked="@DraftExpiredOnly" Text="Past validity only" />
                            </div>
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayout>
                <p class="iv-popup-hint">
                    An empty field means <strong>all</strong> values, never "none". Only current revisions
                    are shown. The customer is chosen on the toolbar and applies as soon as it is picked.
                </p>
            </div>
            <div class="iv-popup-footer">
                <div class="iv-popup-footer__actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Clear" Click="@ClearFiltersAsync" />
                    <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Apply" Click="@ApplyFiltersAsync" />
                </div>
            </div>
        </Content>
    </DxPopup>
</MenuAuthorize>
