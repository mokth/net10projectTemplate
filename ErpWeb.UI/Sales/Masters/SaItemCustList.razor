@page "/sales/customer-items"
@using ErpWeb.UI.Admin.Master
@inherits SaRefListPageBase<SaItemCustListRow>

<PageTitle>Customer Items</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.SalesItemCust">
<div class="iv-page">
    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="iv-toast iv-toast--ok" role="status">
            <span>@StatusMessage</span>
            <button type="button" class="iv-toast__close" @onclick="DismissStatus" aria-label="Dismiss">×</button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(ErrorMessage) && !PopupVisible)
    {
        <div class="iv-toast iv-toast--err" role="alert">
            <span>@ErrorMessage</span>
            <button type="button" class="iv-toast__close" @onclick="DismissError" aria-label="Dismiss">×</button>
        </div>
    }

    <header class="iv-hero">
        <div class="iv-hero__mark" aria-hidden="true"><i class="fa-solid fa-user-tag"></i></div>
        <div>
            <p class="iv-eyebrow">Sales</p>
            <h1 class="iv-title">Customer Items</h1>
        </div>
    </header>

    @if (IsLoading)
    {
        <p>Loading customer items…</p>
    }

    <CommonDataGridEx Columns="@Columns()"
                      Buttons="@ToolbarButtons"
                      ActionButtons="@RowActionButtons"
                      KeyName="@nameof(SaItemCustListRow.Key)"
                      GridKey="sa-item-cust-list"
                      Title="Customer Items"
                      T="SaItemCustListRow"
                      OnGridInstance="@OnGridInstance"
                      GridData="@Data"
                      allowSelect="true"
                      OnSelectionsEventHandle="@OnSelectionsEvent"
                      OnButtonEventHandle="@OnToolbarButtonAsync"
                      OnActionEventHandle="@OnRowActionAsync" />

    <DxPopup HeaderCssClass="code-style"
             HeaderText="@(IsEditMode ? (EditEnabled ? "Edit Customer Item" : "View Customer Item") : "New Customer Item")"
             CloseOnOutsideClick="false"
             Width="52vw"
             CssClass="common-popup"
             @bind-Visible="@PopupVisible">
        <Content>
            <EditForm Model="@EditModel" Context="itemCustForm" OnValidSubmit="@HandleValidSubmitAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <DxFormLayout SizeMode="SizeMode.Small">
                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="Customer" ColSpanMd="6">
                        <Template>
                            <IvCodeComboBox Data="@CustomerOptions"
                                            @bind-Value="@EditModel.CustCode"
                                            Enabled="@(!IsEditMode)"
                                            NullText="Select customer"
                                            InputCssClass="required-field code-style" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="Item" ColSpanMd="6">
                        <Template>
                            <IvStockMasterPicker ICode="@EditModel.ICode"
                                                 ICodeChanged="@(v => EditModel.ICode = v ?? string.Empty)"
                                                 Selected="OnItemSelectedAsync"
                                                 Enabled="@(!IsEditMode)"
                                                 InputCssClass="required-field code-style" />
                        </Template>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="Customer item code" ColSpanMd="6" BeginRow="true">
                        <Template>
                            <DxTextBox @bind-Text="@EditModel.CustICode"
                                       maxlength="100"
                                       ReadOnly="@(!EditEnabled)"
                                       InputCssClass="required-field" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="Selling UOM" ColSpanMd="3">
                        <Template>
                            <IvCodeComboBox Data="@UomOptions"
                                            @bind-Value="@EditModel.SellingUOM"
                                            Enabled="@(!IsEditMode)"
                                            NullText="Select UOM"
                                            InputCssClass="required-field code-style" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="MOQ" ColSpanMd="3">
                        <Template>
                            <DxSpinEdit @bind-Value="@EditModel.MOQ"
                                        ReadOnly="@IsEditMode"
                                        MinValue="0"
                                        ShowSpinButtons="false"
                                        InputCssClass="required-field" />
                        </Template>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="Invoice description" ColSpanMd="12" BeginRow="true">
                        <Template>
                            <DxTextBox @bind-Text="@EditModel.InvDesc"
                                       maxlength="300"
                                       ReadOnly="@(!EditEnabled)" />
                        </Template>
                    </DxFormLayoutItem>

                    @if (CanViewPrice)
                    {
                        <DxFormLayoutItem CaptionCssClass="code-style" Caption="Unit price" ColSpanMd="4" BeginRow="true">
                            <Template>
                                <DxSpinEdit @bind-Value="@EditModel.UnitPrice"
                                            ReadOnly="@(!EditEnabled)"
                                            MinValue="0"
                                            ShowSpinButtons="false" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem CaptionCssClass="code-style" Caption="Currency" ColSpanMd="4">
                            <Template>
                                <IvCodeComboBox Data="@CurrencyOptions"
                                                @bind-Value="@EditModel.Currency"
                                                Enabled="@EditEnabled"
                                                NullText="Select currency"
                                                InputCssClass="code-style" />
                            </Template>
                        </DxFormLayoutItem>
                    }

                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="Status" ColSpanMd="4" BeginRow="true">
                        <Template>
                                <DxTextBox @bind-Text="@EditModel.Status"  ReadOnly="true" />
                        </Template>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem CaptionCssClass="code-style" ColSpanMd="12" BeginRow="true">
                        <Template>
                            <small class="sdoc-field-hint">Customer, item, UOM and MOQ form the identity: change them by creating a new row.</small>
                        </Template>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem CaptionCssClass="code-style" ColSpanMd="12" BeginRow="true">
                        <Template>
                            <div class="iv-popup-actions">
                                @if (EditEnabled)
                                {
                                    <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                              Text="@(IsSubmitting ? "Saving…" : "Save")"
                                              SubmitFormOnClick="true"
                                              Enabled="@(!IsSubmitting)" />
                                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                              Text="Cancel"
                                              Click="@ClosePopup"
                                              Enabled="@(!IsSubmitting)" />
                                }
                                else
                                {
                                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                              Text="Close"
                                              Click="@ClosePopup" />
                                    @if (CanEditFromView)
                                    {
                                        <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                                  Text="Edit"
                                                  Click="@SwitchViewToEditAsync" />
                                    }
                                }
                            </div>
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem CaptionCssClass="code-style" ColSpanMd="12">
                        <Template>
                            <small class="text-danger">@ErrorMessage</small>
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayout>
            </EditForm>
        </Content>
    </DxPopup>
</div>
</MenuAuthorize>
