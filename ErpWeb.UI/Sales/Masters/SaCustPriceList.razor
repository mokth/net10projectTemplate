@page "/sales/customer-prices"
@using ErpWeb.UI.Admin.Master
@inherits SaRefListPageBase<IvCustPriceListRow>

<PageTitle>Customer Prices</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.SalesCustPrice">
<div class="iv-page">
    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="iv-toast iv-toast--ok" role="status">
            <span>@StatusMessage</span>
            <button type="button" class="iv-toast__close" @onclick="DismissStatus" aria-label="Dismiss">×</button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="iv-toast iv-toast--err" role="alert">
            <span>@ErrorMessage</span>
            <button type="button" class="iv-toast__close" @onclick="DismissError" aria-label="Dismiss">×</button>
        </div>
    }

    <header class="iv-hero">
        <div class="iv-hero__mark" aria-hidden="true"><i class="fa-solid fa-money-bill-wave"></i></div>
        <div>
            <p class="iv-eyebrow">Sales</p>
            <h1 class="iv-title">Customer Prices</h1>
        </div>
    </header>

    <div class="iv-filters">
        <DxComboBox Data="@PriceGroupOptions"
                    Value="@SelectedPriceGroup"
                    ValueChanged="@(async (string? v) => await OnPriceGroupChanged(v))"
                    NullText="Select a price group"
                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                    CssClass="iv-filter-combo" />
    </div>

    @if (IsLoading)
    {
        <p>Loading item prices…</p>
    }

    <CommonDataGridEx Columns="@Columns()"
                      Buttons="@ToolbarButtons"
                      ActionButtons="@RowActionButtons"
                      KeyName="@nameof(IvCustPriceListRow.Key)"
                      GridKey="sa-cust-price-list"
                      Title="Customer Prices"
                      T="IvCustPriceListRow"
                      OnGridInstance="@OnGridInstance"
                      GridData="@Data"
                      allowSelect="false"
                      OnSelectionsEventHandle="@OnSelectionsEvent"
                      OnButtonEventHandle="@OnToolbarButtonAsync"
                      OnActionEventHandle="@OnRowActionAsync" />
</div>
</MenuAuthorize>
