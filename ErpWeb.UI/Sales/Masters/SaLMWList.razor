@page "/sales/lmw"
@using ErpWeb.UI.Admin.Master
@inherits SaRefListPageBase<SaLMWListRow>

<PageTitle>LMW Licences</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.SalesLmw">
<div class="iv-page">
    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="iv-toast iv-toast--ok" role="status">
            <span>@StatusMessage</span>
            <button type="button" class="iv-toast__close" @onclick="DismissStatus" aria-label="Dismiss">×</button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(ErrorMessage) && !PopupVisible)
    {
        <div class="iv-toast iv-toast--err" role="alert">
            <span>@ErrorMessage</span>
            <button type="button" class="iv-toast__close" @onclick="DismissError" aria-label="Dismiss">×</button>
        </div>
    }

    <header class="iv-hero">
        <div class="iv-hero__mark" aria-hidden="true"><i class="fa-solid fa-certificate"></i></div>
        <div>
            <p class="iv-eyebrow">Sales</p>
            <h1 class="iv-title">LMW Licences</h1>
        </div>
    </header>

    @if (IsLoading)
    {
        <p>Loading LMW licences…</p>
    }

    <CommonDataGridEx Columns="@Columns()"
                      Buttons="@ToolbarButtons"
                      ActionButtons="@RowActionButtons"
                      KeyName="@nameof(SaLMWListRow.RowKey)"
                      GridKey="sa-lmw-list"
                      Title="LMW Licences"
                      T="SaLMWListRow"
                      OnGridInstance="@OnGridInstance"
                      GridData="@Data"
                      allowSelect="true"
                      OnSelectionsEventHandle="@OnSelectionsEvent"
                      OnButtonEventHandle="@OnToolbarButtonAsync"
                      OnActionEventHandle="@OnRowActionAsync" />

    <DxPopup HeaderCssClass="code-style"
             HeaderText="@(IsEditMode ? (EditEnabled ? "Edit LMW Licence" : "View LMW Licence") : "New LMW Licence")"
             CloseOnOutsideClick="false"
             Width="70vw"
             CssClass="common-popup"
             @bind-Visible="@PopupVisible">
        <Content>
            <EditForm Model="@EditModel" Context="lmwForm" OnValidSubmit="@HandleValidSubmitAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <DxFormLayout SizeMode="SizeMode.Small">
                    @* Both key fields are locked in edit mode — the key is never editable (D-11). *@
                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="Licence No" ColSpanMd="4">
                        <Template>
                            <DxTextBox @bind-Text="@EditModel.LicenseNo"
                                       maxlength="40"
                                       ReadOnly="@IsEditMode"
                                       InputCssClass="required-field code-style" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="Customer Code" ColSpanMd="4">
                        <Template>
                            <IvCodeComboBox Data="@CustomerOptions"
                                            Value="@EditModel.CustCode"
                                            ValueChanged="@OnCustomerCodeChangedAsync"
                                            Enabled="@(!IsEditMode)"
                                            NullText="Select customer"
                                            InputCssClass="required-field code-style" />
                        </Template>
                    </DxFormLayoutItem>
                    @* CustName is a stored denormalisation of SaCust.CustName, never an independent input:
                       the combo above fills it. A legacy row whose customer is retired has no option to
                       match, so the combo renders blank while the stored name stays in the read-only box —
                       smoke step 5 must confirm a load-then-save does not clear either value (plan §4.5/§7). *@
                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="Customer Name" ColSpanMd="4">
                        <Template>
                            <DxTextBox @bind-Text="@EditModel.CustName"
                                       maxlength="200"
                                       ReadOnly="true"
                                       NullText="From the selected customer" />
                        </Template>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="Licence ID" ColSpanMd="4" BeginRow="true">
                        <Template>
                            <DxTextBox @bind-Text="@EditModel.LicenseID"
                                       maxlength="40"
                                       ReadOnly="@(!EditEnabled)" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="Licence Type" ColSpanMd="4">
                        <Template>
                            <DxTextBox @bind-Text="@EditModel.LicenseType"
                                       maxlength="20"
                                       ReadOnly="@(!EditEnabled)" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="Position" ColSpanMd="4">
                        <Template>
                            <DxTextBox @bind-Text="@EditModel.Position"
                                       maxlength="50"
                                       ReadOnly="@(!EditEnabled)" />
                        </Template>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="Licence Start" ColSpanMd="3" BeginRow="true">
                        <Template>
                            <DxDateEdit @bind-Date="@EditModel.LicenseStartDate"
                                        ReadOnly="@(!EditEnabled)" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="Licence End" ColSpanMd="3">
                        <Template>
                            <DxDateEdit @bind-Date="@EditModel.LicenseEndDate"
                                        ReadOnly="@(!EditEnabled)" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="System Start" ColSpanMd="3">
                        <Template>
                            <DxDateEdit @bind-Date="@EditModel.SystemStartDate"
                                        ReadOnly="@(!EditEnabled)" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="System End" ColSpanMd="3">
                        <Template>
                            <DxDateEdit @bind-Date="@EditModel.SystemEndDate"
                                        ReadOnly="@(!EditEnabled)" />
                        </Template>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="Name" ColSpanMd="6" BeginRow="true">
                        <Template>
                            <DxTextBox @bind-Text="@EditModel.Name"
                                       maxlength="100"
                                       ReadOnly="@(!EditEnabled)" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="IC" ColSpanMd="6">
                        <Template>
                            <DxTextBox @bind-Text="@EditModel.IC"
                                       maxlength="30"
                                       ReadOnly="@(!EditEnabled)" />
                        </Template>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem CaptionCssClass="code-style" ColSpanMd="12" BeginRow="true">
                        <Template>
                            <div class="iv-popup-actions">
                                @if (EditEnabled)
                                {
                                    <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                              Text="@(IsSubmitting ? "Saving…" : "Save")"
                                              SubmitFormOnClick="true"
                                              Enabled="@(!IsSubmitting)" />
                                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                              Text="Cancel"
                                              Click="@ClosePopup"
                                              Enabled="@(!IsSubmitting)" />
                                }
                                else
                                {
                                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                              Text="Close"
                                              Click="@ClosePopup" />
                                    @if (CanEditFromView)
                                    {
                                        <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                                  Text="Edit"
                                                  Click="@SwitchViewToEditAsync" />
                                    }
                                }
                            </div>
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem CaptionCssClass="code-style" ColSpanMd="12">
                        <Template>
                            <small class="text-danger">@ErrorMessage</small>
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayout>
            </EditForm>
        </Content>
    </DxPopup>

    <DxPopup HeaderCssClass="code-style"
             HeaderText="Confirm Delete"
             CloseOnOutsideClick="false"
             Width="420px"
             CssClass="common-popup"
             @bind-Visible="@ConfirmDeleteVisible">
        <Content>
            <p>@ConfirmDeleteMessage</p>
            <div class="iv-popup-actions">
                <DxButton RenderStyle="ButtonRenderStyle.Danger"
                          Text="@(IsSubmitting ? "Deleting…" : "Delete")"
                          Click="@ConfirmDeleteAsync"
                          Enabled="@(!IsSubmitting)" />
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          Text="Cancel"
                          Click="@CloseConfirmDelete"
                          Enabled="@(!IsSubmitting)" />
            </div>
        </Content>
    </DxPopup>
</div>
</MenuAuthorize>
