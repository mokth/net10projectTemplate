@page "/sales/price-groups"
@using ErpWeb.UI.Admin.Master
@inherits SaRefListPageBase<IvCustPriceGroupListRow>

<PageTitle>Price Groups</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.SalesCustPriceGroup">
<div class="iv-page">
    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="iv-toast iv-toast--ok" role="status">
            <span>@StatusMessage</span>
            <button type="button" class="iv-toast__close" @onclick="DismissStatus" aria-label="Dismiss">×</button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(ErrorMessage) && !PopupVisible)
    {
        <div class="iv-toast iv-toast--err" role="alert">
            <span>@ErrorMessage</span>
            <button type="button" class="iv-toast__close" @onclick="DismissError" aria-label="Dismiss">×</button>
        </div>
    }

    <header class="iv-hero">
        <div class="iv-hero__mark" aria-hidden="true"><i class="fa-solid fa-tags"></i></div>
        <div>
            <p class="iv-eyebrow">Sales</p>
            <h1 class="iv-title">Price Groups</h1>
        </div>
    </header>

    @if (IsLoading)
    {
        <p>Loading price groups…</p>
    }

    <CommonDataGridEx Columns="@Columns()"
                      Buttons="@ToolbarButtons"
                      ActionButtons="@RowActionButtons"
                      KeyName="@nameof(IvCustPriceGroupListRow.Key)"
                      GridKey="sa-cust-price-group-list"
                      Title="Price Groups"
                      T="IvCustPriceGroupListRow"
                      OnGridInstance="@OnGridInstance"
                      GridData="@Data"
                      allowSelect="true"
                      OnSelectionsEventHandle="@OnSelectionsEvent"
                      OnButtonEventHandle="@OnToolbarButtonAsync"
                      OnActionEventHandle="@OnRowActionAsync" />

    <DxPopup HeaderCssClass="code-style"
             HeaderText="@(IsEditMode ? (EditEnabled ? "Edit Price Group" : "View Price Group") : "New Price Group")"
             CloseOnOutsideClick="false"
             Width="70vw"
             CssClass="common-popup"
             @bind-Visible="@PopupVisible">
        <Content>
            <EditForm Model="@EditModel" Context="priceGroupForm" OnValidSubmit="@HandleValidSubmitAsync">
                <DataAnnotationsValidator />
                <div class="spg-form">
                    <ValidationSummary />

                    <section class="spg-section">
                        <div class="spg-head">
                            <div class="iv-field spg-head__code">
                                <label class="iv-field__label code-style">Code</label>
                                <DxTextBox @bind-Text="@EditModel.CustPriceCode"
                                           maxlength="20"
                                           ReadOnly="@IsEditMode"
                                           InputCssClass="required-field code-style" />
                            </div>
                            <div class="iv-field">
                                <label class="iv-field__label">Description</label>
                                <DxTextBox @bind-Text="@EditModel.CustPriceDesc"
                                           maxlength="50"
                                           ReadOnly="@(!EditEnabled)"
                                           InputCssClass="required-field" />
                            </div>
                            <div class="iv-field spg-head__active">
                                <label class="iv-field__label">Active</label>
                                <DxCheckBox @bind-Checked="@EditModel.IsActive" Enabled="@EditEnabled" />
                            </div>
                        </div>
                    </section>

                    <section class="spg-section">
                        <header class="spg-section__head">
                            <h5 class="iv-eyebrow">Item prices</h5>
                            <span class="spg-count">@EditModel.Lines.Count @(EditModel.Lines.Count == 1 ? "line" : "lines")</span>
                        </header>

                        @if (EditEnabled)
                        {
                            <div class="spg-editor">
                                <div class="iv-field spg-editor__item">
                                    <label class="iv-field__label code-style">Item</label>
                                    <IvStockMasterPicker ICode="@LineItem"
                                                         ICodeChanged="@(v => LineItem = v)"
                                                         Selected="OnLineItemSelectedAsync"
                                                         InputCssClass="required-field code-style" />
                                </div>
                                <div class="iv-field">
                                    <label class="iv-field__label code-style">UOM</label>
                                    <IvCodeComboBox Data="@UomOptions"
                                                    @bind-Value="@LineUom"
                                                    NullText="Select UOM"
                                                    InputCssClass="required-field code-style" />
                                </div>
                                <div class="iv-field">
                                    <label class="iv-field__label">Selling price</label>
                                    <DxSpinEdit @bind-Value="@LinePrice" MinValue="0" ShowSpinButtons="false" />
                                </div>
                                <div class="iv-field">
                                    <label class="iv-field__label">Pack size</label>
                                    <DxSpinEdit @bind-Value="@LinePack" MinValue="0" ShowSpinButtons="false" />
                                </div>
                                <div class="spg-editor__actions">
                                    <DxButton RenderStyle="@(LineEditKey is null ? ButtonRenderStyle.Primary : ButtonRenderStyle.Secondary)"
                                              Text="@(LineEditKey is null ? "Add line" : "Update line")"
                                              Click="@OnLineAddOrUpdate"
                                              Enabled="@(!IsSubmitting)" />
                                    @if (LineEditKey is not null)
                                    {
                                        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                                  Text="Discard"
                                                  Click="@ResetLineEditor"
                                                  Enabled="@(!IsSubmitting)" />
                                    }
                                </div>
                            </div>

                            <p class="spg-hint">
                                @if (LineEditKey is null)
                                {
                                    <span>Pick an item, set the UOM and the price, then choose <strong>Add line</strong>.</span>
                                }
                                else
                                {
                                    <span><i class="fa-solid fa-pen" aria-hidden="true"></i> Editing @LineEditKey — <strong>Update line</strong> replaces it, <strong>Discard</strong> leaves it as it is.</span>
                                }
                            </p>
                        }

                        @if (EditModel.Lines.Count > 0)
                        {
                            <div class="spg-grid">
                                <DxGrid Data="@EditModel.Lines"
                                        KeyFieldName="@nameof(IvCustPriceLineVm.Key)"
                                        ShowFilterRow="false"
                                        ShowGroupPanel="false"
                                        ShowSearchBox="false"
                                        TextWrapEnabled="false"
                                        PageSize="10"
                                        CssClass="spg-line-grid">
                                    <Columns>
                                        @if (EditEnabled)
                                        {
                                            <DxGridCommandColumn Width="92px" Caption=" " NewButtonVisible="false" EditButtonVisible="false" DeleteButtonVisible="false">
                                                <CellDisplayTemplate>
                                                    @{
                                                        var line = (IvCustPriceLineVm)context.DataItem;
                                                    }
                                                    <div class="spg-row-actions">
                                                        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                                                  RenderStyleMode="ButtonRenderStyleMode.Text"
                                                                  IconCssClass="fa-solid fa-pen"
                                                                  title="Edit this line"
                                                                  Click="@(() => OnLineEdit(line))"
                                                                  Enabled="@(!IsSubmitting)" />
                                                        <DxButton RenderStyle="ButtonRenderStyle.Danger"
                                                                  RenderStyleMode="ButtonRenderStyleMode.Text"
                                                                  IconCssClass="fa-solid fa-trash"
                                                                  title="Remove this line"
                                                                  Click="@(() => OnLineRemove(line))"
                                                                  Enabled="@(!IsSubmitting)" />
                                                    </div>
                                                </CellDisplayTemplate>
                                            </DxGridCommandColumn>
                                        }
                                        <DxGridDataColumn FieldName="@nameof(IvCustPriceLineVm.ICode)" Caption="Item" Width="140px" />
                                        <DxGridDataColumn FieldName="@nameof(IvCustPriceLineVm.IDesc)" Caption="Description" />
                                        <DxGridDataColumn FieldName="@nameof(IvCustPriceLineVm.UOM)" Caption="UOM" Width="90px" />
                                        @if (CanViewPrice)
                                        {
                                            <DxGridDataColumn FieldName="@nameof(IvCustPriceLineVm.SellingPrice)" Caption="Selling price" Width="130px" />
                                        }
                                        <DxGridDataColumn FieldName="@nameof(IvCustPriceLineVm.SellPackSize)" Caption="Pack size" Width="110px" />
                                    </Columns>
                                </DxGrid>
                            </div>
                        }
                        else
                        {
                            <p class="spg-empty">
                                <i class="fa-regular fa-rectangle-list" aria-hidden="true"></i>
                                No item prices yet — @(EditEnabled
                                    ? "pick an item and add the first line."
                                    : "this price list has no lines.")
                            </p>
                        }
                    </section>

                    <footer class="spg-footer">
                        <div class="spg-footer__left">
                            @if (IsEditMode && CanExport && EditModel.Lines.Count > 0)
                            {
                                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                          IconCssClass="fa-solid fa-file-excel"
                                          Text="Export prices"
                                          Click="@OnExportPrices"
                                          Enabled="@(!IsSubmitting)" />
                            }
                        </div>
                        <div class="spg-footer__right">
                            @if (EditEnabled)
                            {
                                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                          Text="Cancel"
                                          Click="@ClosePopup"
                                          Enabled="@(!IsSubmitting)" />
                                <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                          Text="@(IsSubmitting ? "Saving…" : "Save")"
                                          SubmitFormOnClick="true"
                                          Enabled="@(!IsSubmitting)" />
                            }
                            else
                            {
                                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                          Text="Close"
                                          Click="@ClosePopup" />
                                @if (CanEditFromView)
                                {
                                    <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                              Text="Edit"
                                              Click="@SwitchViewToEditAsync" />
                                }
                            }
                        </div>
                    </footer>

                    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                    {
                        <p class="spg-error" role="alert">@ErrorMessage</p>
                    }
                </div>
            </EditForm>
        </Content>
    </DxPopup>
</div>
</MenuAuthorize>
