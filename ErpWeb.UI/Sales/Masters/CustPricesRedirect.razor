@page "/sales/customer-prices"
@using ErpWeb.Core.Authentication
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@inject ErpWeb.UI.Services.AppNavigation Navigation
@attribute [Authorize(Policy = ErpAuthPolicies.ErpAccess)]

@*
    Legacy address of the removed read-only "Customer Prices" screen. Item prices are maintained inside
    the Price Groups popup (one aggregate, one writer), so the old URL forwards instead of 404ing.
*@

@code {
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            Navigation.NavigateTo("/sales/price-groups", replace: true);
        }
    }
}
