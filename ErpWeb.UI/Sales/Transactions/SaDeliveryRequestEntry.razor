@page "/sales/delivery-requests/{Mode:regex(^(new)$)}"
@page "/sales/delivery-requests/{Mode:regex(^(edit|view)$)}/{Uid:long}"
@inherits PageBase
@using DevExpress.Blazor
@using ErpWeb.Core.Sales
@using ErpWeb.Model.Entities.Sales
@using ErpWeb.UI.Inventory.Lookups

<PageTitle>@PageHeading</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.SalesDeliveryRequest">
    <SaDocPage>
        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <div class="sdoc-toast sdoc-toast--ok" role="status">
                <span>@StatusMessage</span>
                <button type="button" class="sdoc-toast__close" @onclick="DismissStatus" aria-label="Dismiss">×</button>
            </div>
        }
        <SdValidationSummary Errors="@ValidationErrors" FallbackMessage="@ErrorMessage" OnDismiss="DismissError" />

        @if (IsLoading)
        {
            <div class="sdoc-loading">
                <p class="mb-0">Loading Delivery Request…</p>
            </div>
        }
        else
        {
            <header class="sdoc-titlebar">
                <h1 class="sdoc-titlebar__title" title="@($"{PageHeading} · {DocumentNoDisplay}")">
                    @PageHeading · @DocumentNoDisplay
                </h1>
                <span class="sdoc-titlebar__status" title="@($"{StatusDisplay} · {ModeDisplay}")">
                    @StatusDisplay
                    <span class="sdoc-titlebar__status-extra">@ModeDisplay</span>
                </span>
                <div class="sdoc-titlebar__kpi">
                    <span>@HeaderKpiLabel</span>
                    <strong>@HeaderKpiValue</strong>
                </div>
            </header>

            <section class="sdoc-master dr-fulfilment" aria-label="Delivery Request fulfilment">
                <div class="dr-progress">
                    <div class="dr-progress__item"><span>Requested</span><strong>@(Detail?.RequestedQty.ToString("n4") ?? (SourceRows.Count == 0 ? "—" : SourceRows.Sum(x => x.Quantity).ToString("n4"))) <small>@(Detail?.ProductionUom ?? ProductionUom)</small></strong></div>
                    <div class="dr-progress__item"><span>Delivered</span><strong>@(Detail?.DeliveredQty.ToString("n4") ?? "—") <small>@Detail?.ProductionUom</small></strong></div>
                    <div class="dr-progress__item"><span>DR stock reserved</span><strong>@(Detail?.DrStockReservedQty.ToString("n4") ?? "—") <small>@Detail?.ProductionUom</small></strong></div>
                    <div class="dr-progress__item"><span>NEW shipment reserved</span><strong>@(Detail?.NewShipmentReservedQty.ToString("n4") ?? "—") <small>@Detail?.ProductionUom</small></strong></div>
                    <div class="dr-progress__item"><span>Ready</span><strong>@(Detail?.ReadyQty.ToString("n4") ?? "—") <small>@Detail?.ProductionUom</small></strong></div>
                    <div class="dr-progress__item"><span>Production required</span><strong>@(Detail?.ProductionRequiredQty.ToString("n4") ?? "—") <small>@Detail?.ProductionUom</small></strong></div>
                    <div class="dr-progress__item"><span>Production unplanned</span><strong>@(Detail?.ProductionUnplannedQty.ToString("n4") ?? "—") <small>@Detail?.ProductionUom</small></strong></div>
                    <div class="dr-progress__item"><span>Outstanding WO supply</span><strong>@(Detail?.OutstandingWoSupplyQty.ToString("n4") ?? "—") <small>@Detail?.ProductionUom</small></strong></div>
                </div>
                @if (Detail is not null)
                {
                    <div class="dr-fulfilment__meta">
                        <span class="iv-status @(Detail.IsAtRisk ? "is-off" : "is-on")">@Detail.FulfilmentStatus</span>
                        @if (!string.Equals(Detail.BlockerCode, SaDeliveryRequestBlockerCodes.None, StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="iv-status is-hold">Blocker: @Detail.BlockerCode</span>
                        }
                        @if (Detail.FulfilledDate is DateTime fulfilledDate)
                        {
                            <span>Fulfilled @fulfilledDate.ToString("dd/MM/yyyy")</span>
                        }
                        @if (Detail.IsAtRisk)
                        {
                            <span class="dr-fulfilment__risk">At risk</span>
                        }
                    </div>
                }
            </section>

            <section class="sdoc-master">
                <DxFormLayout SizeMode="SizeMode.Small" CssClass="sdoc-header-form">
                    <DxFormLayoutGroup ColSpanMd="4">
                        <HeaderContentTemplate>Document</HeaderContentTemplate>
                        <Items>
                            <DxFormLayoutItem Caption="Request no." ColSpanMd="12">
                                <Template><DxTextBox Text="@DocumentNoDisplay" ReadOnly="true" ValidationEnabled="false" /></Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Required date" ColSpanMd="12">
                                <Template>
                                    <DxDateEdit Date="@RequiredDate"
                                                DateChanged="@((DateTime date) => OnRequiredDateChanged(date))"
                                                DateExpression="() => RequiredDate"
                                                DisplayFormat="dd/MM/yyyy"
                                                Enabled="@CanEdit"
                                                InputCssClass="required-field" />
                                </Template>
                            </DxFormLayoutItem>
                            @if (Detail is not null)
                            {
                                <DxFormLayoutItem Caption="Status" ColSpanMd="12">
                                    <Template><DxTextBox Text="@StatusDisplay" ReadOnly="true" ValidationEnabled="false" /></Template>
                                </DxFormLayoutItem>
                            }
                        </Items>
                    </DxFormLayoutGroup>

                    <DxFormLayoutGroup ColSpanMd="4">
                        <HeaderContentTemplate>Production</HeaderContentTemplate>
                        <Items>
                            <DxFormLayoutItem Caption="Product" ColSpanMd="12">
                                <Template>
                                    @if (SourceRows.Count == 0 && CanEdit)
                                    {
                                        <IvStockMasterPicker ICode="@ProductCode"
                                                             ICodeChanged="@OnProductCodeChanged"
                                                             Enabled="@CanEdit"
                                                             NullText="Select product or use SO filter" />
                                    }
                                    else
                                    {
                                        <DxTextBox Text="@ProductCode" ReadOnly="true" ValidationEnabled="false" />
                                    }
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Production UOM" ColSpanMd="12">
                                <Template><DxTextBox Text="@ProductionUom" ReadOnly="true" ValidationEnabled="false" /></Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Product definition" ColSpanMd="12">
                                <Template>
                                    @if (CanEdit && DefinitionOptions.Count > 0)
                                    {
                                        <DxComboBox Data="@DefinitionOptions"
                                                    TextFieldName="@nameof(DefinitionOption.Label)"
                                                    ValueFieldName="@nameof(DefinitionOption.Code)"
                                                    @bind-Value="@DefinitionCode"
                                                    @bind-Value:after="MarkDirtyOnly"
                                                    NullText="Select ACTIVE definition" />
                                    }
                                    else
                                    {
                                        <DxTextBox Text="@DefinitionCode" ReadOnly="true" MaxLength="30" ValidationEnabled="false" />
                                    }
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Warehouse" ColSpanMd="12">
                                <Template>
                                    <DxTextBox @bind-Text="@WarehouseCode" @bind-Text:after="MarkDirtyOnly" Enabled="@(CanEdit && SourceRows.Count == 0)" MaxLength="20" />
                                </Template>
                            </DxFormLayoutItem>
                        </Items>
                    </DxFormLayoutGroup>

                    <DxFormLayoutGroup ColSpanMd="4">
                        <HeaderContentTemplate>Planning / Reference</HeaderContentTemplate>
                        <Items>
                            <DxFormLayoutItem Caption="Project" ColSpanMd="12">
                                <Template>
                                    <DxTextBox @bind-Text="@ProjectCode" @bind-Text:after="MarkDirtyOnly" Enabled="@(CanEdit && SourceRows.Count == 0)" MaxLength="20" />
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Priority" ColSpanMd="12">
                                <Template>
                                    <DxComboBox Data="@PriorityOptions" @bind-Value="@Priority" @bind-Value:after="MarkDirtyOnly" Enabled="@CanEdit" />
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Remark" ColSpanMd="12">
                                <Template>
                                    <DxMemo @bind-Text="@Remark" @bind-Text:after="MarkDirtyOnly" Rows="3" Enabled="@CanEdit" MaxLength="500" />
                                </Template>
                            </DxFormLayoutItem>
                        </Items>
                    </DxFormLayoutGroup>
                </DxFormLayout>
            </section>

            <section class="sdoc-items">
                <div class="sdoc-items__head">
                    <div>
                        <h2 class="sdoc-items__title">Sales Order demand sources</h2>
                        <p class="sdoc-popup-hint">Every row is an exact SO number, revision and line. Quantity is sourced from StdQty / StdUom.</p>
                    </div>
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="Add SO line"
                              IconCssClass="fa-solid fa-plus"
                              Click="@OpenSourcePickerAsync"
                              Enabled="@CanEdit" />
                </div>

                @if (SourceRows.Count == 0)
                {
                    <div class="sdoc-empty">
                        <h3>No demand sources yet</h3>
                        <p>Add at least one eligible current Sales Order line.</p>
                        @if (CanEdit)
                        {
                            <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Add SO line" Click="@OpenSourcePickerAsync" />
                        }
                    </div>
                }
                else
                {
                    <DxGrid ColumnResizeMode="GridColumnResizeMode.ColumnsContainer" Data="@SourceRows" CssClass="sdoc-line-grid" TextWrapEnabled="false">
                        <Columns>
                            <DxGridDataColumn Caption="SO / revision / line" Width="190px">
                                <CellDisplayTemplate>
                                    @{
                                        var source = (SourceEditorRow)context.DataItem;
                                    }
                                    <DxButton RenderStyle="ButtonRenderStyle.Link"
                                              RenderStyleMode="ButtonRenderStyleMode.Text"
                                              Text="@($"{source.SoNo} / Rev {source.CustRel} / Line {source.SoLine}")"
                                              Click="@(() => OpenSalesOrder(source))" />
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn Caption="Product" Width="180px">
                                <CellDisplayTemplate>
                                    @{
                                        var source = (SourceEditorRow)context.DataItem;
                                    }
                                    <div class="dr-cell-stack">
                                        <span class="dr-cell-stack__primary">@source.ProductCode</span>
                                        <span class="dr-cell-stack__secondary">@source.ProductDescription</span>
                                    </div>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn FieldName="@nameof(SourceEditorRow.SourceQty)" Caption="Demand" DisplayFormat="n4" Width="110px" />
                            <DxGridDataColumn FieldName="@nameof(SourceEditorRow.OpenProductionDemandQty)" Caption="Open" DisplayFormat="n4" Width="100px" />
                            <DxGridDataColumn FieldName="@nameof(SourceEditorRow.ActiveAllocatedProductionQty)" Caption="Active DR" DisplayFormat="n4" Width="100px" />
                            <DxGridDataColumn FieldName="@nameof(SourceEditorRow.ActiveDrLinkedDoQty)" Caption="Linked DO" DisplayFormat="n4" Width="100px" />
                            <DxGridDataColumn FieldName="@nameof(SourceEditorRow.ActiveDrOutstandingQty)" Caption="Outstanding" DisplayFormat="n4" Width="105px" />
                            <DxGridDataColumn FieldName="@nameof(SourceEditorRow.AvailableForDr)" Caption="Available" DisplayFormat="n4" Width="100px" />
                            <DxGridDataColumn FieldName="@nameof(SourceEditorRow.ProductionUom)" Caption="UOM" Width="80px" />
                            <DxGridDataColumn FieldName="@nameof(SourceEditorRow.WarehouseCode)" Caption="Warehouse" Width="110px" />
                            <DxGridDataColumn FieldName="@nameof(SourceEditorRow.ProjectCode)" Caption="Project" Width="110px" />
                            <DxGridDataColumn FieldName="@nameof(SourceEditorRow.CustomerCode)" Caption="Customer" Width="110px" />
                            <DxGridDataColumn Caption="Allocated" Width="145px">
                                <CellDisplayTemplate>
                                    @{
                                        var source = (SourceEditorRow)context.DataItem;
                                    }
                                    @if (CanEdit)
                                    {
                                        <DxSpinEdit Value="@source.Quantity"
                                                    ValueChanged="@((decimal value) => OnSourceQuantityChanged(source, value))"
                                                    Increment="0.0001m"
                                                    ShowSpinButtons="false"
                                                    InputCssClass="dr-qty" ValueExpression="@(() => source.Quantity)" />
                                    }
                                    else
                                    {
                                        <span>@source.Quantity.ToString("n4")</span>
                                    }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn Caption="Required date" Width="120px">
                                <CellDisplayTemplate>
                                    @{
                                        var source = (SourceEditorRow)context.DataItem;
                                    }
                                    @(source.RequestedDeliveryDate?.ToString("dd/MM/yyyy") ?? "—")
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridCommandColumn Caption="" Width="88px" NewButtonVisible="false" EditButtonVisible="false" DeleteButtonVisible="false">
                                <CellDisplayTemplate>
                                    @{
                                        var source = (SourceEditorRow)context.DataItem;
                                    }
                                    @if (CanEdit)
                                    {
                                        <DxButton RenderStyle="ButtonRenderStyle.Danger"
                                                  RenderStyleMode="ButtonRenderStyleMode.Text"
                                                  Text="Remove"
                                                  Click="@(() => RemoveSource(source))" />
                                    }
                                </CellDisplayTemplate>
                            </DxGridCommandColumn>
                        </Columns>
                        <EmptyDataAreaTemplate>
                            <div class="sdoc-empty"><p>No demand sources yet.</p></div>
                        </EmptyDataAreaTemplate>
                    </DxGrid>
                }
            </section>

            @if (ShowWorkOrderSection && Detail is not null)
            {
                <section class="sdoc-master">
                    <div class="sdoc-items__head">
                        <div>
                            <h2 class="sdoc-items__title">Production Work Order</h2>
                            <p class="sdoc-popup-hint">Create a Work Order from the remaining Delivery Request quantity. The server builds the normal snapshot and schedule atomically.</p>
                        </div>
                        @if (CanOfferWorkOrderCreation)
                        {
                            <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                      Text="Create draft Work Order"
                                      IconCssClass="fa-solid fa-plus"
                                      Click="@CreateWorkOrderAsync"
                                      Enabled="@(!IsSubmitting && WorkOrderQty > 0m)" />
                        }
                    </div>

                    @if (CanOfferWorkOrderCreation)
                    {
                        <DxFormLayout SizeMode="SizeMode.Small" CssClass="dr-work-order-form">
                            <DxFormLayoutItem Caption="Planned quantity" ColSpanMd="4">
                                <Template><DxSpinEdit @bind-Value="@WorkOrderQty" Increment="0.0001m" Enabled="@(!IsSubmitting)" /></Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Start" ColSpanMd="4">
                                <Template><DxDateEdit @bind-Date="@WorkOrderStart" DisplayFormat="dd/MM/yyyy" Enabled="@(!IsSubmitting)" /></Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Completion" ColSpanMd="4">
                                <Template><DxDateEdit @bind-Date="@WorkOrderCompletion" DisplayFormat="dd/MM/yyyy" Enabled="@(!IsSubmitting)" /></Template>
                            </DxFormLayoutItem>
                        </DxFormLayout>
                    }

                    @if (Detail.WorkOrders.Count > 0)
                    {
                        <DxGrid ColumnResizeMode="GridColumnResizeMode.ColumnsContainer" Data="@Detail.WorkOrders" CssClass="sdoc-line-grid dr-work-order-grid" TextWrapEnabled="false">
                            <Columns>
                                <DxGridDataColumn Caption="Work Order" Width="150px">
                                    <CellDisplayTemplate>
                                        @{
                                            var workOrder = (SaDeliveryRequestWorkOrderTrace)context.DataItem;
                                        }
                                        <DxButton RenderStyle="ButtonRenderStyle.Link"
                                                  RenderStyleMode="ButtonRenderStyleMode.Text"
                                                  Text="@workOrder.WorkOrderNo"
                                                  Click="@(() => OpenWorkOrder(workOrder.WorkOrderNo))" />
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn FieldName="@nameof(SaDeliveryRequestWorkOrderTrace.AllocatedQty)" Caption="Allocated" DisplayFormat="n4" />
                                <DxGridDataColumn FieldName="@nameof(SaDeliveryRequestWorkOrderTrace.PlannedQty)" Caption="Planned" DisplayFormat="n4" />
                                <DxGridDataColumn FieldName="@nameof(SaDeliveryRequestWorkOrderTrace.GoodQty)" Caption="Good" DisplayFormat="n4" />
                                <DxGridDataColumn Caption="Status">
                                    <CellDisplayTemplate>
                                        @{
                                            var workOrder = (SaDeliveryRequestWorkOrderTrace)context.DataItem;
                                        }
                                        @workOrder.Status @(workOrder.IsActive ? "" : "(inactive)")
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                            </Columns>
                        </DxGrid>
                    }
                    else if (CanOfferWorkOrderCreation)
                    {
                        <p class="text-muted mb-0 mt-3">No linked Work Orders yet.</p>
                    }
                </section>
            }

            @if (Detail is not null && Detail.MaterialShortages.Count > 0)
            {
                <section class="sdoc-master">
                    <div class="sdoc-items__head">
                        <div>
                            <h2 class="sdoc-items__title">Material / procurement</h2>
                            <p class="sdoc-popup-hint">Purchased and external-supply materials use current stock availability and linked PR/PO coverage. Quantities are in the material base UOM.</p>
                        </div>
                    </div>
                    <DxGrid ColumnResizeMode="GridColumnResizeMode.ColumnsContainer" Data="@Detail.MaterialShortages" CssClass="sdoc-line-grid dr-work-order-grid" TextWrapEnabled="false">
                        <Columns>
                            <DxGridDataColumn FieldName="@nameof(SaDeliveryRequestMaterialShortageTrace.WorkOrderNo)" Caption="Work Order" Width="130px" />
                            <DxGridDataColumn Caption="Component" Width="210px">
                                <CellDisplayTemplate>
                                    @{
                                        var material = (SaDeliveryRequestMaterialShortageTrace)context.DataItem;
                                    }
                                    <div class="dr-cell-stack">
                                        <span class="dr-cell-stack__primary">@material.ComponentCode</span>
                                        <span class="dr-cell-stack__secondary">@material.ComponentDescription</span>
                                    </div>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn FieldName="@nameof(SaDeliveryRequestMaterialShortageTrace.RequiredBaseQty)" Caption="Required" DisplayFormat="n4" />
                            <DxGridDataColumn FieldName="@nameof(SaDeliveryRequestMaterialShortageTrace.AvailableBaseQty)" Caption="Available" DisplayFormat="n4" />
                            <DxGridDataColumn FieldName="@nameof(SaDeliveryRequestMaterialShortageTrace.PhysicalShortBaseQty)" Caption="Physical short" DisplayFormat="n4" />
                            <DxGridDataColumn FieldName="@nameof(SaDeliveryRequestMaterialShortageTrace.OpenProcurementBaseQty)" Caption="Open procurement" DisplayFormat="n4" />
                            <DxGridDataColumn FieldName="@nameof(SaDeliveryRequestMaterialShortageTrace.NetProcurementRequiredBaseQty)" Caption="Net to procure" DisplayFormat="n4" />
                            <DxGridDataColumn Caption="PR / PO" Width="190px">
                                <CellDisplayTemplate>
                                    @{
                                        var material = (SaDeliveryRequestMaterialShortageTrace)context.DataItem;
                                        var trace = string.Join(", ", material.Procurement
                                            .Select(x => string.IsNullOrWhiteSpace(x.PoNo)
                                                ? $"PR {x.PrNo}/{x.PrLineNo}"
                                                : $"PR {x.PrNo}/{x.PrLineNo} → PO {x.PoNo}/{x.PoRelNo}"));
                                    }
                                    <span>@(string.IsNullOrWhiteSpace(trace) ? "—" : trace)</span>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridCommandColumn Caption="" Width="110px" NewButtonVisible="false" EditButtonVisible="false" DeleteButtonVisible="false">
                                <CellDisplayTemplate>
                                    @{
                                        var material = (SaDeliveryRequestMaterialShortageTrace)context.DataItem;
                                    }
                                    @if (!material.IsConsistent && !string.IsNullOrWhiteSpace(material.InconsistencyMessage))
                                    {
                                        <span class="iv-status is-hold" title="@material.InconsistencyMessage">UOM issue</span>
                                    }
                                    else if (CanCreatePurchaseRequisition && material.NetProcurementRequiredBaseQty > 0.0001m)
                                    {
                                        <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                                  RenderStyleMode="ButtonRenderStyleMode.Text"
                                                  Text="Create PR"
                                                  Click="@(() => CreatePurchaseRequisitionAsync(material))"
                                                  Enabled="@(!IsSubmitting)" />
                                    }
                                </CellDisplayTemplate>
                            </DxGridCommandColumn>
                        </Columns>
                    </DxGrid>
                </section>
            }

            @if (Detail is not null)
            {
                <section class="sdoc-master">
                    <h2 class="sdoc-items__title">Audit trail</h2>
                    @if (Detail.AuditEvents.Count == 0)
                    {
                        <div class="sdoc-empty"><p>No audit events.</p></div>
                    }
                    else
                    {
                        <DxGrid ColumnResizeMode="GridColumnResizeMode.ColumnsContainer" Data="@Detail.AuditEvents" CssClass="sdoc-line-grid" TextWrapEnabled="false">
                            <Columns>
                                <DxGridDataColumn FieldName="@nameof(SaDeliveryRequestAuditTrace.OccurredDate)" Caption="When" DisplayFormat="dd/MM/yyyy HH:mm" Width="155px" />
                                <DxGridDataColumn FieldName="@nameof(SaDeliveryRequestAuditTrace.EventType)" Caption="Event" Width="150px" />
                                <DxGridDataColumn FieldName="@nameof(SaDeliveryRequestAuditTrace.ActorUserId)" Caption="Actor" Width="140px" />
                                <DxGridDataColumn FieldName="@nameof(SaDeliveryRequestAuditTrace.Reason)" Caption="Reason" />
                            </Columns>
                        </DxGrid>
                    }
                </section>
            }

            <footer class="sdoc-footer">
                <p class="sdoc-footer__hint">@(_isDirty ? "Unsaved changes" : "Ready") · @SourceRows.Count @(SourceRows.Count == 1 ? "source" : "sources")</p>
                <div class="sdoc-footer__actions">
                    @if (IsReadOnlyPresentation)
                    {
                        <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Close" IconCssClass="fa-solid fa-xmark" Click="@OnClose" />
                        @if (CanEditFromView)
                        {
                            <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Edit" IconCssClass="fa-solid fa-pen" Click="@OnEditFromView" />
                        }
                        @if (CanRefreshFulfilment)
                        {
                            <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Refresh fulfilment" IconCssClass="fa-solid fa-rotate" Click="@RefreshFulfilmentAsync" Enabled="@(!IsSubmitting)" />
                        }
                        @if (CanRelease)
                        {
                            <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Release" IconCssClass="fa-solid fa-check" Click="@BeginRelease" />
                        }
                        @if (CanCancel)
                        {
                            <DxButton RenderStyle="ButtonRenderStyle.Danger" Text="Cancel Delivery Request" IconCssClass="fa-solid fa-ban" Click="@BeginCancel" />
                        }
                        @if (CanDelete)
                        {
                            <DxButton RenderStyle="ButtonRenderStyle.Danger" Text="Delete Draft" IconCssClass="fa-regular fa-trash-can" Click="@BeginDelete" />
                        }
                    }
                    else
                    {
                        <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Cancel" Click="@OnCancelAsync" Enabled="@(!IsSubmitting)" />
                        <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                  Text="@(IsSubmitting ? "Saving…" : "Save Draft")"
                                  IconCssClass="fa-solid fa-floppy-disk"
                                  Click="@SaveAsync"
                                  Enabled="@CanSave" />
                    }
                </div>
            </footer>
        }

        <DxPopup HeaderText="Select current SO demand"
                 CloseOnOutsideClick="false"
                 Width="980px"
                 CssClass="sdoc-popup common-popup"
                 @bind-Visible="@SourcePickerVisible">
            <Content>
                <div class="sdoc-popup-body">
                    @if (!string.IsNullOrWhiteSpace(SourcePickerError))
                    {
                        <p class="sdoc-popup-error">@SourcePickerError</p>
                    }
                    <div class="dr-picker-search">
                        <DxTextBox @bind-Text="@SourceSearchSoNo" NullText="Sales Order number" CssClass="w-100" />
                        <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Search" IconCssClass="fa-solid fa-magnifying-glass" Click="@LoadEligibleAsync" />
                    </div>
                    @if (EligibleSources.Count == 0)
                    {
                        <div class="sdoc-empty"><p>No eligible current SO demand loaded.</p></div>
                    }
                    else
                    {
                        <DxGrid ColumnResizeMode="GridColumnResizeMode.ColumnsContainer" Data="@EligibleSources" CssClass="sdoc-line-grid" TextWrapEnabled="false">
                            <Columns>
                                <DxGridDataColumn FieldName="@nameof(SaDeliveryRequestEligibleSource.SoNo)" Caption="SO / revision / line" Width="190px">
                                    <CellDisplayTemplate>
                                        @{
                                            var source = (SaDeliveryRequestEligibleSource)context.DataItem;
                                        }
                                        @($"{source.SoNo} / Rev {source.CustRel} / Line {source.SoLine}")
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn Caption="Product" Width="190px">
                                    <CellDisplayTemplate>
                                        @{
                                            var source = (SaDeliveryRequestEligibleSource)context.DataItem;
                                        }
                                        <div class="dr-cell-stack">
                                            <span class="dr-cell-stack__primary">@source.ProductCode</span>
                                            <span class="dr-cell-stack__secondary">@source.ProductDescription</span>
                                        </div>
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn FieldName="@nameof(SaDeliveryRequestEligibleSource.ProductionDemandQty)" Caption="Standard demand" DisplayFormat="n4" />
                                <DxGridDataColumn FieldName="@nameof(SaDeliveryRequestEligibleSource.AvailableForDr)" Caption="Available" DisplayFormat="n4" />
                                <DxGridCommandColumn Caption="" Width="72px" NewButtonVisible="false" EditButtonVisible="false" DeleteButtonVisible="false">
                                    <CellDisplayTemplate>
                                        @{
                                            var source = (SaDeliveryRequestEligibleSource)context.DataItem;
                                        }
                                         <DxButton RenderStyle="ButtonRenderStyle.Primary" RenderStyleMode="ButtonRenderStyleMode.Text" Text="Add" Click="@(() => AddEligibleSourceAsync(source))" />
                                    </CellDisplayTemplate>
                                </DxGridCommandColumn>
                            </Columns>
                        </DxGrid>
                    }
                </div>
                <div class="sdoc-popup-footer">
                    <div class="sdoc-popup-footer__actions">
                        <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Close" Click="@CloseSourcePicker" />
                    </div>
                </div>
            </Content>
        </DxPopup>

        <DxPopup HeaderText="Discard changes?"
                 CloseOnOutsideClick="false"
                 Width="420px"
                 CssClass="common-popup"
                 @bind-Visible="@ConfirmDiscardVisible">
            <Content>
                <p class="sdoc-confirm__copy">Unsaved changes will be lost. This cannot be undone.</p>
                <div class="sdoc-popup-footer__actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Keep editing" Click="@(() => ConfirmDiscardVisible = false)" />
                    <DxButton RenderStyle="ButtonRenderStyle.Danger" Text="Discard" Click="@ConfirmDiscardAsync" />
                </div>
            </Content>
        </DxPopup>

        <DxPopup HeaderText="Confirm Delivery Request action"
                 CloseOnOutsideClick="false"
                 Width="520px"
                 CssClass="common-popup"
                 @bind-Visible="@ConfirmLifecycleVisible">
            <Content>
                <p class="sdoc-confirm__copy">@LifecycleConfirmMessage</p>
                <div class="sdoc-popup-footer__actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Cancel" Click="@(() => ConfirmLifecycleVisible = false)" Enabled="@(!IsSubmitting)" />
                    <DxButton RenderStyle="@LifecycleConfirmButtonStyle" Text="@LifecycleConfirmButtonText" Click="@ConfirmLifecycleAsync" Enabled="@(!IsSubmitting)" />
                </div>
            </Content>
        </DxPopup>

        <DxPopup HeaderText="Reload required"
                 CloseOnOutsideClick="false"
                 Width="460px"
                 CssClass="common-popup"
                 @bind-Visible="@ConcurrencyVisible">
            <Content>
                <p class="sdoc-confirm__copy">This Delivery Request changed by another user. Reload the latest version before continuing.</p>
                <div class="sdoc-popup-footer__actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Close" Click="@(() => ConcurrencyVisible = false)" />
                    <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Reload latest" Click="@ReloadLatestAsync" />
                </div>
            </Content>
        </DxPopup>
    </SaDocPage>
</MenuAuthorize>
