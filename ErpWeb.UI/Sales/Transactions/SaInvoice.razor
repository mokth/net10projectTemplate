@page "/sales/invoices/{Mode:regex(^(new|edit|view)$)}"
@page "/sales/invoices/{Mode:regex(^(new|edit|view)$)}/{InvNo}"

@inherits PageBase

<PageTitle>@PageHeading</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.SalesInvoice">
    <SaDocPage>
        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <div class="sdoc-toast sdoc-toast--ok" role="status">
                <span>@StatusMessage</span>
                <button type="button" class="sdoc-toast__close" @onclick="DismissStatus" aria-label="Dismiss">×</button>
            </div>
        }
        <SdValidationSummary Errors="@ValidationErrors" FallbackMessage="@ErrorMessage" OnDismiss="DismissError" />
        @if (DateShipmentWarning)
        {
            <div class="sdoc-toast sdoc-toast--warn" role="status">
                <span>Invoice date changed after shipment. Rebuild shipment before posting.</span>
            </div>
        }
        @if (PostWarnings.Count > 0)
        {
            <div class="sdoc-toast sdoc-toast--warn" role="status">
                <div class="sdoc-toast__body">
                    <strong>Fix these before this invoice can be posted:</strong>
                    <ul class="sdoc-warn-list">
                        @foreach (var warning in PostWarnings)
                        {
                            <li>@warning</li>
                        }
                    </ul>
                </div>
            </div>
        }

        @if (IsLoading)
        {
            <div class="sdoc-loading">
                <p class="mb-0">Loading invoice…</p>
            </div>
        }
        else
        {
            <header class="sdoc-titlebar">
                <h1 class="sdoc-titlebar__title" title="@($"{PageHeading} · {InvNoDisplay}")">@PageHeading · @InvNoDisplay</h1>
                <span class="sdoc-titlebar__status" title="@StatusDisplay">@StatusDisplay</span>
                <div class="sdoc-titlebar__kpi">
                    <span>Total incl. tax</span>
                    <strong>@TotAmnt.ToString("n2")</strong>
                </div>
            </header>

            <section class="sdoc-master">
                <DxFormLayout SizeMode="SizeMode.Small" CssClass="sdoc-header-form">
                    <DxFormLayoutGroup ColSpanMd="4">
                        <HeaderContentTemplate>Document</HeaderContentTemplate>
                        <Items>
                            <DxFormLayoutItem Caption="Inv no." ColSpanMd="12">
                                <Template>
                                    <DxTextBox Text="@InvNoDisplay" ReadOnly="true" />
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Date" ColSpanMd="12">
                                <Template>
                                    <DxDateEdit Date="@InvDate"
                                                DateChanged="@(async (DateTime d) => await OnInvDateChanged(d))"
                                                DisplayFormat="dd/MM/yyyy"
                                                Enabled="@CanEditDocument" />
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Status" ColSpanMd="12">
                                <Template>
                                    <DxTextBox Text="@StatusDisplay" ReadOnly="true" />
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Prefix" ColSpanMd="12">
                                <Template>
                                    <DxTextBox Text="@(InvPrefix ?? string.Empty)" ReadOnly="true" NullText="From customer" />
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Department" ColSpanMd="12">
                                <Template>
                                    <IvCodeComboBox Data="@Departments"
                                                    @bind-Value="@Dept"
                                                    Enabled="@CanEditDocument"
                                                    NullText="Select department" />
                                    @FieldError("Dept")
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Project" ColSpanMd="12">
                                <Template>
                                    <IvCodeComboBox Data="@Projects"
                                                    @bind-Value="@ProjId"
                                                    Enabled="@CanEditDocument"
                                                    NullText="Select project" />
                                    @FieldError("ProjId")
                                </Template>
                            </DxFormLayoutItem>
                        </Items>
                    </DxFormLayoutGroup>

                    <DxFormLayoutGroup ColSpanMd="4">
                        <HeaderContentTemplate>Customer</HeaderContentTemplate>
                        <Items>
                            <DxFormLayoutItem Caption="Customer" ColSpanMd="12">
                                <Template>
                                    <DxComboBox Data="@Customers"
                                                TextFieldName="@nameof(SaInvoiceCustomerLookupRow.DisplayText)"
                                                ValueFieldName="@nameof(SaInvoiceCustomerLookupRow.CustCode)"
                                                Value="@CustCode"
                                                ValueChanged="@(async (string? v) => await OnCustCodeChanged(v))"
                                                SearchMode="ListSearchMode.AutoSearch"
                                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                                Enabled="@CanEditDocument"
                                                NullText="Select customer"
                                                CssClass="w-100 required-field" />
                                    @FieldError("CustCode")
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Currency / rate" ColSpanMd="12">
                                <Template>
                                    <DxTextBox Text="@($"{Currency} @ {CurrRate:n6}")" ReadOnly="true" />
                                    @if (HasCustomer && !CurrRateValid)
                                    {
                                        <p class="sdoc-field-error">Valid FX rate is required.</p>
                                    }
                                </Template>
                            </DxFormLayoutItem>
                        </Items>
                    </DxFormLayoutGroup>

                    <DxFormLayoutGroup ColSpanMd="4">
                        <HeaderContentTemplate>Terms</HeaderContentTemplate>
                        <Items>
                            <DxFormLayoutItem Caption="Payment term" ColSpanMd="12">
                                <Template>
                                    <IvCodeComboBox Data="@PayCodes" Value="@PayCode" ValueChanged="@(async (string? v) => await OnPayCodeChanged(v))" Enabled="@CanEditDocument" NullText="Select payment term" InputCssClass="required-field" />
                                    @FieldError("PayCode")
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Tax group" ColSpanMd="12">
                                <Template>
                                    <DxComboBox Data="@TaxGroups"
                                                TextFieldName="@nameof(SaInvoiceTaxGroupLookupRow.DisplayText)"
                                                ValueFieldName="@nameof(SaInvoiceTaxGroupLookupRow.TaxGrCode)"
                                                Value="@TaxGrCode"
                                                ValueChanged="@(async (string? v) => await OnTaxGrCodeChanged(v))"
                                                SearchMode="ListSearchMode.AutoSearch"
                                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                                Enabled="@CanEditDocument"
                                                NullText="Select tax group"
                                                CssClass="@(TaxGroupRequired ? "w-100 required-field" : "w-100")" />
                                    @FieldError("TaxGrCode")
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Salesman" ColSpanMd="12">
                                <Template>
                                    <IvCodeComboBox Data="@SalesReps"
                                                    Value="@SalesmanCode"
                                                    ValueChanged="@(v => { SalesmanCode = v; MarkDirtyOnly(); })"
                                                    Enabled="@CanEditDocument"
                                                    NullText="Select salesman"
                                                    InputCssClass="required-field" />
                                    @FieldError("SalesmanCode")
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Due date" ColSpanMd="12">
                                <Template>
                                    <DxDateEdit T="DateTime?" Value="@DueDate" ReadOnly="true" NullText="Set on save" />
                                </Template>
                            </DxFormLayoutItem>
                        </Items>
                    </DxFormLayoutGroup>

                    <DxFormLayoutGroup ColSpanMd="12">
                        <HeaderContentTemplate>References</HeaderContentTemplate>
                        <Items>
                            <DxFormLayoutItem Caption="External doc no." ColSpanMd="6">
                                <Template>
                                    <DxTextBox @bind-Text="@PoNo" @bind-Text:after="MarkDirtyOnly" Enabled="@CanEditDocument" MaxLength="50" />
                                </Template>
                            </DxFormLayoutItem>
                            @if (ShowSourceCard)
                            {
                                <DxFormLayoutItem Caption="DO no." ColSpanMd="6">
                                    <Template>
                                        <DxTextBox Text="@DoNoDisplay" ReadOnly="true" />
                                    </Template>
                                </DxFormLayoutItem>
                            }
                        </Items>
                    </DxFormLayoutGroup>
                </DxFormLayout>

                <div class="sdoc-address-tabs">
                    <DxTabs @bind-ActiveTabIndex="@ActiveTabIndex">
                    <DxTabPage Text="Billing">
                        <div class="sdoc-tab">
                            <DxFormLayout SizeMode="SizeMode.Small">
                                <DxFormLayoutItem Caption="Bill name" ColSpanMd="6">
                                    <Template>
                                        <DxTextBox @bind-Text="@InvName" @bind-Text:after="MarkDirtyOnly" Enabled="@CanEditAddresses" InputCssClass="required-field" />
                                        @FieldError("InvName")
                                    </Template>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="Address 1" ColSpanMd="6">
                                    <Template>
                                        <DxTextBox @bind-Text="@InvAddress1" @bind-Text:after="MarkDirtyOnly" Enabled="@CanEditAddresses" InputCssClass="required-field" />
                                        @FieldError("InvAddress1")
                                    </Template>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="Address 2" ColSpanMd="6">
                                    <Template>
                                        <DxTextBox @bind-Text="@InvAddress2" @bind-Text:after="MarkDirtyOnly" Enabled="@CanEditAddresses" />
                                    </Template>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="Address 3" ColSpanMd="6">
                                    <Template>
                                        <DxTextBox @bind-Text="@InvAddress3" @bind-Text:after="MarkDirtyOnly" Enabled="@CanEditAddresses" />
                                    </Template>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="Address 4" ColSpanMd="6">
                                    <Template>
                                        <DxTextBox @bind-Text="@InvAddress4" @bind-Text:after="MarkDirtyOnly" Enabled="@CanEditAddresses" />
                                    </Template>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="City" ColSpanMd="3">
                                    <Template>
                                        <DxTextBox @bind-Text="@InvCity" @bind-Text:after="MarkDirtyOnly" Enabled="@CanEditAddresses" InputCssClass="required-field" />
                                        @FieldError("InvCity")
                                    </Template>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="State" ColSpanMd="3">
                                    <Template>
                                        <IvCodeComboBox Data="@States"
                                                        Value="@InvState"
                                                        ValueChanged="@(v => { InvState = v; MarkDirtyOnly(); })"
                                                        Enabled="@CanEditAddresses"
                                                        NullText="Select state" />
                                    </Template>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="Postal" ColSpanMd="3">
                                    <Template>
                                        <DxTextBox @bind-Text="@InvPostalCode" @bind-Text:after="MarkDirtyOnly" Enabled="@CanEditAddresses" InputCssClass="required-field" />
                                        @FieldError("InvPostalCode")
                                    </Template>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="Country" ColSpanMd="3">
                                    <Template>
                                        <IvCodeComboBox Data="@Countries"
                                                        Value="@InvCountry"
                                                        ValueChanged="@(v => { InvCountry = v; MarkDirtyOnly(); })"
                                                        Enabled="@CanEditAddresses"
                                                        NullText="Select country"
                                                        InputCssClass="required-field" />
                                        @FieldError("InvCountry")
                                    </Template>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="Tel or email" ColSpanMd="3">
                                    <Template>
                                        <DxTextBox @bind-Text="@InvTel" @bind-Text:after="MarkDirtyOnly" Enabled="@CanEditAddresses" InputCssClass="@ContactRequiredCss" />
                                        @FieldError("InvTel")
                                    </Template>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="Email" ColSpanMd="3">
                                    <Template>
                                        <DxTextBox @bind-Text="@InvEmail" @bind-Text:after="MarkDirtyOnly" Enabled="@CanEditAddresses" InputCssClass="@ContactRequiredCss" />
                                    </Template>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="Fax" ColSpanMd="3">
                                    <Template>
                                        <DxTextBox @bind-Text="@InvFax" @bind-Text:after="MarkDirtyOnly" Enabled="@CanEditAddresses" />
                                    </Template>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="TIN or BRN" ColSpanMd="3">
                                    <Template>
                                        <DxTextBox @bind-Text="@BuyerTin" @bind-Text:after="MarkDirtyOnly" Enabled="@CanEditAddresses" InputCssClass="@BuyerIdRequiredCss" />
                                        @FieldError("BuyerTin")
                                    </Template>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="BRN" ColSpanMd="3">
                                    <Template>
                                        <DxTextBox @bind-Text="@BuyerBrn" @bind-Text:after="MarkDirtyOnly" Enabled="@CanEditAddresses" InputCssClass="@BuyerIdRequiredCss" />
                                    </Template>
                                </DxFormLayoutItem>
                            </DxFormLayout>
                        </div>
                    </DxTabPage>
                    <DxTabPage Text="Shipping">
                        <div class="sdoc-tab">
                            <DxFormLayout SizeMode="SizeMode.Small">
                                <DxFormLayoutItem Caption="Ship to" ColSpanMd="6">
                                    <Template>
                                        <DxComboBox Data="@ShipToOptions"
                                                    TData="SaCustAddressVm"
                                                    TValue="int?"
                                                    TextFieldName="@nameof(SaCustAddressVm.DisplayText)"
                                                    ValueFieldName="@nameof(SaCustAddressVm.Line)"
                                                    Value="@ShipToLine"
                                                    ValueChanged="@OnShipToLineChanged"
                                                    SearchMode="ListSearchMode.AutoSearch"
                                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                                    Enabled="@CanEditAddresses"
                                                    NullText="Select ship-to address"
                                                    CssClass="w-100" />
                                    </Template>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="Ship name" ColSpanMd="6">
                                    <Template>
                                        <DxTextBox @bind-Text="@ShipName" @bind-Text:after="OnShipFieldEdited" Enabled="@CanEditAddresses" />
                                    </Template>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="Address 1" ColSpanMd="6">
                                    <Template>
                                        <DxTextBox @bind-Text="@ShipAddress1" @bind-Text:after="OnShipFieldEdited" Enabled="@CanEditAddresses" />
                                    </Template>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="Address 2" ColSpanMd="6">
                                    <Template>
                                        <DxTextBox @bind-Text="@ShipAddress2" @bind-Text:after="OnShipFieldEdited" Enabled="@CanEditAddresses" />
                                    </Template>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="Address 3" ColSpanMd="6">
                                    <Template>
                                        <DxTextBox @bind-Text="@ShipAddress3" @bind-Text:after="OnShipFieldEdited" Enabled="@CanEditAddresses" />
                                    </Template>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="City" ColSpanMd="3">
                                    <Template>
                                        <DxTextBox @bind-Text="@ShipCity" @bind-Text:after="OnShipFieldEdited" Enabled="@CanEditAddresses" />
                                    </Template>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="State" ColSpanMd="3">
                                    <Template>
                                        <IvCodeComboBox Data="@States"
                                                        Value="@ShipState"
                                                        ValueChanged="@(v => { ShipState = v; OnShipFieldEdited(); })"
                                                        Enabled="@CanEditAddresses"
                                                        NullText="Select state" />
                                    </Template>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="Postal" ColSpanMd="3">
                                    <Template>
                                        <DxTextBox @bind-Text="@ShipPostalCode" @bind-Text:after="OnShipFieldEdited" Enabled="@CanEditAddresses" />
                                    </Template>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="Country" ColSpanMd="3">
                                    <Template>
                                        <IvCodeComboBox Data="@Countries"
                                                        Value="@ShipCountry"
                                                        ValueChanged="@(v => { ShipCountry = v; OnShipFieldEdited(); })"
                                                        Enabled="@CanEditAddresses"
                                                        NullText="Select country" />
                                    </Template>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="Tel" ColSpanMd="3">
                                    <Template>
                                        <DxTextBox @bind-Text="@ShipTel" @bind-Text:after="OnShipFieldEdited" Enabled="@CanEditAddresses" />
                                    </Template>
                                </DxFormLayoutItem>
                                <DxFormLayoutItem Caption="Fax" ColSpanMd="3">
                                    <Template>
                                        <DxTextBox @bind-Text="@ShipFax" @bind-Text:after="OnShipFieldEdited" Enabled="@CanEditAddresses" />
                                    </Template>
                                </DxFormLayoutItem>
                            </DxFormLayout>
                        </div>
                    </DxTabPage>
                    <DxTabPage Text="Remarks">
                        <div class="sdoc-tab">
                            <DxMemo @bind-Text="@Remark" @bind-Text:after="MarkDirtyOnly" Rows="5" Enabled="@CanEditDocument" CssClass="w-100" />
                            @FieldError("Remark")
                        </div>
                    </DxTabPage>
                    </DxTabs>
                </div>
            </section>

            <section class="sdoc-items">
                <div class="sdoc-items__head">
                    <h2 class="sdoc-items__title">Items</h2>
                    @if (CanEditDocument)
                    {
                        <div class="sdoc-footer__actions">
                            <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                      Text="Add from SO"
                                      IconCssClass="fa-solid fa-file-import"
                                      Click="@OpenSoPickerAsync"
                                      Enabled="@CanOpenSoPicker" />
                            <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                      Text="Add from DO"
                                      IconCssClass="fa-solid fa-truck"
                                      Click="@OpenDoPickerAsync"
                                      Enabled="@CanOpenDoPicker" />
                            <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                      Text="Add item"
                                      IconCssClass="fa-solid fa-plus"
                                      Click="@OnNewLineClick"
                                      Enabled="@CanMutateLines" />
                        </div>
                    }
                </div>

                <DxGrid Data="@Lines"
                        KeyFieldName="@nameof(SaInvoiceLineVm.Line)"
                        ShowFilterRow="false"
                        ShowGroupPanel="false"
                        ShowSearchBox="false"
                        TextWrapEnabled="false"
                        HorizontalScrollBarMode="ScrollBarMode.Auto"
                        PageSize="20"
                        CssClass="sdoc-line-grid">
                    <Columns>
                        @if (CanEditDocument)
                        {
                            <DxGridCommandColumn Width="88px" Caption=" " NewButtonVisible="false" EditButtonVisible="false" DeleteButtonVisible="false">
                                <CellDisplayTemplate>
                                    @{
                                        var line = (SaInvoiceLineVm)context.DataItem;
                                    }
                                    <div class="sdoc-row-actions">
                                        <DxButton RenderStyle="ButtonRenderStyle.Secondary" RenderStyleMode="ButtonRenderStyleMode.Text"
                                                  IconCssClass="fa-solid fa-pen" Click="@(() => EditLine(line))" Enabled="@CanMutateLines" />
                                        <DxButton RenderStyle="ButtonRenderStyle.Danger" RenderStyleMode="ButtonRenderStyleMode.Text"
                                                  IconCssClass="fa-solid fa-trash" Click="@(() => RemoveLine(line))" Enabled="@CanMutateLines" />
                                    </div>
                                </CellDisplayTemplate>
                            </DxGridCommandColumn>
                        }
                        <DxGridDataColumn FieldName="@nameof(SaInvoiceLineVm.Line)" Caption="#" Width="56px" />
                        <DxGridDataColumn FieldName="@nameof(SaInvoiceLineVm.ICode)" Caption="Item" Width="160px">
                            <CellDisplayTemplate>
                                @{
                                    var itemLine = (SaInvoiceLineVm)context.DataItem;
                                }
                                <div class="sdoc-cell-stack">
                                    <span class="sdoc-cell-stack__primary">@itemLine.ICode</span>
                                    <span class="sdoc-cell-stack__secondary">@itemLine.IDesc</span>
                                </div>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(SaInvoiceLineVm.CustPo)" Caption="Cust PO" Width="120px" />
                        <DxGridDataColumn FieldName="@nameof(SaInvoiceLineVm.SoNo)" Caption="SO No" Width="130px" />
                        <DxGridDataColumn FieldName="@nameof(SaInvoiceLineVm.CustRel)" Caption="SO Rev" Width="70px">
                            <CellDisplayTemplate>@(((SaInvoiceLineVm)context.DataItem).SoRevDisplay)</CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(SaInvoiceLineVm.SoLine)" Caption="SO Line" Width="70px">
                            <CellDisplayTemplate>@(((SaInvoiceLineVm)context.DataItem).SoLineDisplay)</CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(SaInvoiceLineVm.DoNo)" Caption="DO No" Width="130px">
                            <CellDisplayTemplate>@(((SaInvoiceLineVm)context.DataItem).SourceDoNo)</CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(SaInvoiceLineVm.DoLine)" Caption="DO Line" Width="70px">
                            <CellDisplayTemplate>@(((SaInvoiceLineVm)context.DataItem).SourceDoLine)</CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(SaInvoiceLineVm.Classification)" Caption="Class." Width="90px" />
                        <DxGridDataColumn FieldName="@nameof(SaInvoiceLineVm.FrWarehouse)" Caption="Warehouse" Width="110px" />
                        <DxGridDataColumn FieldName="@nameof(SaInvoiceLineVm.Qty)" Caption="Qty" Width="90px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(SaInvoiceLineVm.UnitPrice)" Caption="Price" Width="100px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(SaInvoiceLineVm.Amount)" Caption="Amount" Width="100px" DisplayFormat="n2" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(SaInvoiceLineVm.TaxAmt)" Caption="Tax" Width="90px" DisplayFormat="n2" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(SaInvoiceLineVm.NetAmount)" Caption="Net" Width="100px" DisplayFormat="n2" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn Caption="Ship" Width="120px">
                            <CellDisplayTemplate>
                                @{
                                    var shipLine = (SaInvoiceLineVm)context.DataItem;
                                }
                                <div class="sdoc-row-actions">
                                    <span class="sdoc-status @(shipLine.ShipmentComplete ? "is-on" : "is-hold")">
                                        @(shipLine.StockControl ? (shipLine.ShipmentComplete ? "OK" : "Open") : "n/a")
                                    </span>
                                    @if (shipLine.StockControl && _hasShipment && CanEditDocument)
                                    {
                                        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                                  RenderStyleMode="ButtonRenderStyleMode.Text"
                                                  IconCssClass="fa-solid fa-boxes-stacked"
                                                  Click="@(() => OpenShipmentEditor(shipLine.Line))"
                                                  Enabled="@(!IsSubmitting)"
                                                  title="Edit shipment lots" />
                                    }
                                </div>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn Caption="Issues" Width="220px">
                            <CellDisplayTemplate>
                                @{
                                    var issuesRow = (SaInvoiceLineVm)context.DataItem;
                                    var issues = LineErrorMessages(ValidationErrors, Lines.IndexOf(issuesRow) + 1);
                                }
                                @if (issues.Count > 0)
                                {
                                    <div class="sdoc-cell-stack" title="@string.Join(' ', issues)">
                                        @foreach (var issue in issues.Take(2))
                                        {
                                            <span class="sdoc-field-error">@issue</span>
                                        }
                                        @if (issues.Count > 2)
                                        {
                                            <span class="sdoc-field-error">+@(issues.Count - 2) more</span>
                                        }
                                    </div>
                                }
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                    </Columns>
                    <EmptyDataAreaTemplate>
                        <div class="sdoc-empty">
                            <h3>No items yet</h3>
                            <p>@(CanEditDocument ? "Select a customer with a valid FX rate, then add items." : "This invoice has no lines.")</p>
                        </div>
                    </EmptyDataAreaTemplate>
                </DxGrid>

                <div class="sdoc-totals">
                    <div><span>TOTAL EXCL TAX</span><strong>@GrossAmnt.ToString("n2")</strong></div>
                    <div><span>TOTAL TAX</span><strong>@Taxes.ToString("n2")</strong></div>
                    <div><span>TOTAL INCL TAX</span><strong>@TotAmnt.ToString("n2")</strong></div>
                </div>
            </section>

            <SaDocFlowPanel DocType="INV" DocNo="@InvNo" />

            <SaEInvoicePanel DocType="INV"
                             DocNo="@InvNo"
                             MenuCode="@MenuCodes.SalesInvoice"
                             Enabled="@CanUseEInvoice"
                             OnStateChanged="@OnEInvoiceStateChangedAsync" />

            <footer class="sdoc-footer">
                <p class="sdoc-footer__hint">@FooterHint</p>
                <div class="sdoc-footer__actions">
                    @if (IsViewMode)
                    {
                        <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Close" IconCssClass="fa-solid fa-xmark" Click="@OnClose" />
                        @if (CanEditFromView)
                        {
                            <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Edit" IconCssClass="fa-solid fa-pen" Click="@OnEditFromView" />
                        }
                    }
                    else
                    {
                        <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Cancel" Click="@OnCancelAsync" Enabled="@(!IsSubmitting)" />
                        @if (!IsNewMode)
                        {
                            <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                      Text="Add shipment"
                                      IconCssClass="fa-solid fa-truck"
                                      Click="@OnAddShipmentAsync"
                                      Enabled="@(!IsSubmitting && Lines.Count > 0 && HasCustomer && HasShipmentLines)" />
                        }
                        <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                  Text="@(IsSubmitting ? "Saving…" : "Save")"
                                  IconCssClass="fa-solid fa-floppy-disk"
                                  Click="@OnSaveAsync"
                                  Enabled="@CanSave" />
                    }
                </div>
            </footer>
        }

    <DxPopup HeaderText="@PopupTitle"
             CloseOnOutsideClick="false"
             Width="760px"
             CssClass="sdoc-popup common-popup"
             @bind-Visible="@PopupVisible">
        <Content>
            <div class="sdoc-popup-body">
                @if (!string.IsNullOrWhiteSpace(PopupError))
                {
                    <p class="sdoc-popup-error">@PopupError</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(_priceHint))
                    {
                        <p class="sdoc-field-hint">Price source: @_priceHint</p>
                    }
                }
                <DxFormLayout SizeMode="SizeMode.Small" CssClass="sdoc-popup-form">
                    <DxFormLayoutItem Caption="Item" ColSpanMd="12">
                        <Template>
                            <DxComboBox Data="@Items"
                                        TextFieldName="@nameof(SaInvoiceItemLookupRow.DisplayText)"
                                        ValueFieldName="@nameof(SaInvoiceItemLookupRow.ICode)"
                                        Value="@Popup.ICode"
                                        ValueChanged="@((string? v) => OnPopupItemChangedAsync(v))"
                                        SearchMode="ListSearchMode.AutoSearch"
                                        Enabled="@CanEditDocument"
                                        NullText="Select item"
                                        CssClass="w-100 required-field" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Description" ColSpanMd="8">
                        <Template>
                            <DxTextBox @bind-Text="@Popup.IDesc" ReadOnly="true" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Warehouse" ColSpanMd="4">
                        <Template>
                            <DxComboBox Data="@Warehouses"
                                        TextFieldName="@nameof(IvWarehouseLookupRow.WarehouseCode)"
                                        ValueFieldName="@nameof(IvWarehouseLookupRow.WarehouseCode)"
                                        @bind-Value="@Popup.FrWarehouse"
                                        Enabled="@CanEditDocument" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Qty" ColSpanMd="3">
                        <Template>
                            <DxSpinEdit Value="@Popup.Qty" ValueChanged="@((decimal v) => OnPopupQuantityChangedAsync(v))" Increment="1m" Enabled="@CanEditDocument" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Pack" ColSpanMd="3">
                        <Template>
                            <DxSpinEdit Value="@(Popup.StdPackSize ?? 1m)" ReadOnly="true" Increment="0.0001m" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Unit price" ColSpanMd="3">
                        <Template>
                            @* Phase 4: an operator without PRICE_OVERRIDE sees the resolved price read-only. *@
                            <DxSpinEdit @bind-Value="@Popup.UnitPrice" Increment="0.01m" Enabled="@(CanEditDocument && CanOverridePrice)" />
                        </Template>
                    </DxFormLayoutItem>
                    @if (IsPriceOverridden())
                    {
                        <DxFormLayoutItem Caption="Override reason (required)" ColSpanMd="12">
                            <Template>
                                <DxTextBox @bind-Text="@Popup.OverrideReason"
                                           maxlength="100"
                                           InputCssClass="required-field" />
                                <p class="sdoc-field-hint">
                                    Price changed from the resolved @Popup.OriginalUnitPrice?.ToString("n4").
                                    The original is recorded on the line.
                                </p>
                            </Template>
                        </DxFormLayoutItem>
                    }
                    <DxFormLayoutItem Caption="Tax inclusive" ColSpanMd="3">
                        <Template>
                            <DxCheckBox Checked="@Popup.IsInclusive" CheckedChanged="@((bool v) => OnPopupBasisChangedAsync(v))" Enabled="@(CanEditDocument && !PopupInclusiveLocked)" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Line tax" ColSpanMd="6">
                        <Template>
                            <DxComboBox Data="@TaxGroups"
                                        TextFieldName="@nameof(SaInvoiceTaxGroupLookupRow.DisplayText)"
                                        ValueFieldName="@nameof(SaInvoiceTaxGroupLookupRow.TaxGrCode)"
                                        Value="@Popup.TaxGrCode"
                                        ValueChanged="@((string? v) => OnPopupTaxChangedAsync(v))"
                                        SearchMode="ListSearchMode.AutoSearch"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                        Enabled="@CanEditDocument"
                                        NullText="Use header tax"
                                        CssClass="w-100" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Classification" ColSpanMd="6">
                        <Template>
                            <IvCodeComboBox Data="@Classifications"
                                            @bind-Value="@Popup.Classification"
                                            Enabled="@CanEditDocument"
                                            InputCssClass="required-field"
                                            NullText="Select classification" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Discount mode" ColSpanMd="12">
                        <Template>
                            <div class="sdoc-discount-mode">
                                <DxButton RenderStyle="@(PopupDiscountIsAmount ? ButtonRenderStyle.Secondary : ButtonRenderStyle.Primary)"
                                          Text="Percent"
                                          Click="@(() => OnPopupDiscountModeChanged(false))"
                                          Enabled="@CanEditDocument" />
                                <DxButton RenderStyle="@(PopupDiscountIsAmount ? ButtonRenderStyle.Primary : ButtonRenderStyle.Secondary)"
                                          Text="Amount"
                                          Click="@(() => OnPopupDiscountModeChanged(true))"
                                          Enabled="@CanEditDocument" />
                            </div>
                        </Template>
                    </DxFormLayoutItem>
                    @if (PopupDiscountIsAmount)
                    {
                        <DxFormLayoutItem Caption="Disc amt 1" ColSpanMd="6" BeginRow="true">
                            <Template>
                                <DxSpinEdit @bind-Value="@Popup.ItemDiscAmount" Increment="0.01m" ShowSpinButtons="false" Enabled="@CanEditDocument" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Disc amt 2" ColSpanMd="6">
                            <Template>
                                <DxSpinEdit @bind-Value="@Popup.ItemDiscAmount1" Increment="0.01m" ShowSpinButtons="false" Enabled="@CanEditDocument" />
                            </Template>
                        </DxFormLayoutItem>
                    }
                    else
                    {
                        <DxFormLayoutItem Caption="Disc %1" ColSpanMd="4" BeginRow="true">
                            <Template>
                                <DxSpinEdit @bind-Value="@Popup.ItemDiscount" Increment="0.1m" ShowSpinButtons="false" Enabled="@CanEditDocument" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Disc %2" ColSpanMd="4">
                            <Template>
                                <DxSpinEdit @bind-Value="@Popup.ItemDiscount2" Increment="0.1m" ShowSpinButtons="false" Enabled="@CanEditDocument" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Disc %3" ColSpanMd="4">
                            <Template>
                                <DxSpinEdit @bind-Value="@Popup.ItemDiscount3" Increment="0.1m" ShowSpinButtons="false" Enabled="@CanEditDocument" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Disc %4" ColSpanMd="4">
                            <Template>
                                <DxSpinEdit @bind-Value="@Popup.ItemDiscount4" Increment="0.1m" ShowSpinButtons="false" Enabled="@CanEditDocument" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Disc %5" ColSpanMd="4">
                            <Template>
                                <DxSpinEdit @bind-Value="@Popup.ItemDiscount5" Increment="0.1m" ShowSpinButtons="false" Enabled="@CanEditDocument" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Disc %6" ColSpanMd="4">
                            <Template>
                                <DxSpinEdit @bind-Value="@Popup.ItemDiscount6" Increment="0.1m" ShowSpinButtons="false" Enabled="@CanEditDocument" />
                            </Template>
                        </DxFormLayoutItem>
                    }
                    <DxFormLayoutItem Caption="Remarks" ColSpanMd="12">
                        <Template>
                            <DxTextBox @bind-Text="@Popup.Remarks" Enabled="@CanEditDocument" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Preview" ColSpanMd="12">
                        <Template>
                            <div class="sdoc-amount-preview">
                                <span>Amount @PopupCalc.Amount.ToString("n2") · Tax @PopupCalc.TaxAmt.ToString("n2")</span>
                                <strong>Net @PopupCalc.NetAmount.ToString("n2")</strong>
                            </div>
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayout>
            </div>
            <div class="sdoc-popup-footer">
                <div class="sdoc-popup-footer__actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Close" Click="@(() => PopupVisible = false)" />
                    <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="@PopupPrimaryText"
                                  Click="@OnPopupSave"
                                  Enabled="@(string.IsNullOrWhiteSpace(_priceBlockMessage))" />
                </div>
            </div>
        </Content>
    </DxPopup>

    <DxPopup HeaderText="Discard changes?"
             CloseOnOutsideClick="false"
             Width="420px"
             CssClass="common-popup"
             @bind-Visible="@ConfirmDiscardVisible">
        <Content>
            <p class="sdoc-confirm__copy">Unsaved changes will be lost. This cannot be undone.</p>
            <div class="sdoc-popup-footer__actions">
                <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Keep editing" Click="@(() => ConfirmDiscardVisible = false)" />
                <DxButton RenderStyle="ButtonRenderStyle.Danger" Text="Discard" Click="@ConfirmDiscardAsync" />
            </div>
        </Content>
    </DxPopup>

    <DxPopup HeaderText="Add lines from sales order"
             CloseOnOutsideClick="false"
             Width="820px"
             CssClass="sdoc-popup common-popup"
             @bind-Visible="@SoPickerVisible">
        <Content>
            <div class="sdoc-popup-body">
                @if (!string.IsNullOrWhiteSpace(SoPickerError))
                {
                    <p class="sdoc-popup-error">@SoPickerError</p>
                }
                <DxFormLayout SizeMode="SizeMode.Small" CssClass="sdoc-popup-form">
                    <DxFormLayoutItem Caption="Sales order" ColSpanMd="12">
                        <Template>
                            <DxComboBox Data="@SoPickerOptions"
                                        TData="SaSoPickerOption"
                                        TValue="string"
                                        TextFieldName="@nameof(SaSoPickerOption.DisplayText)"
                                        ValueFieldName="@nameof(SaSoPickerOption.SoNo)"
                                        Value="@SelectedSourceSoNo"
                                        ValueChanged="@(async (string? v) => await OnSelectedSourceSoChangedAsync(v))"
                                        SearchMode="ListSearchMode.AutoSearch"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                        Enabled="@(!SoPickerLoading)"
                                        NullText="Select a sales order"
                                        CssClass="w-100" />
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayout>

                @if (SoPickerLoading)
                {
                    <p class="mb-0">Loading remaining SO lines…</p>
                }
                else if (SoPickerLines.Count > 0)
                {
                    <p class="sdoc-popup-hint mb-2">All remaining lines are selected. Uncheck items to skip them.</p>
                    <DxGrid Data="@SoPickerLines"
                            KeyFieldName="@nameof(SaSoLineDto.Line)"
                            SelectionMode="GridSelectionMode.Multiple"
                            AllowSelectRowByClick="true"
                            SelectAllCheckboxMode="GridSelectAllCheckboxMode.AllPages"
                            SelectedDataItems="@SelectedSoPickerLines"
                            SelectedDataItemsChanged="OnSelectedSoPickerLinesChanged"
                            ShowFilterRow="false"
                            ShowGroupPanel="false"
                            ShowSearchBox="false"
                            PageSize="10"
                            CssClass="sdoc-line-grid">
                        <Columns>
                            <DxGridSelectionColumn Width="48px" />
                            <DxGridDataColumn FieldName="@nameof(SaSoLineDto.Line)" Caption="#" Width="56px" />
                            <DxGridDataColumn FieldName="@nameof(SaSoLineDto.ICode)" Caption="Item" Width="160px" />
                            <DxGridDataColumn FieldName="@nameof(SaSoLineDto.IDesc)" Caption="Description" />
                            <DxGridDataColumn FieldName="@nameof(SaSoLineDto.Warehouse)" Caption="Warehouse" Width="110px" />
                            <DxGridDataColumn FieldName="@nameof(SaSoLineDto.RemainingBillableQty)" Caption="Billable qty" Width="110px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        </Columns>
                    </DxGrid>
                }
            </div>
            <div class="sdoc-popup-footer">
                <div class="sdoc-popup-footer__actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Close" Click="@CloseSoPicker" />
                    <DxButton RenderStyle="ButtonRenderStyle.Primary"
                              Text="Add selected"
                              Click="@AddFromSo"
                              Enabled="@(!SoPickerLoading && SelectedSoPickerLines.Count > 0)" />
                </div>
            </div>
        </Content>
    </DxPopup>

    <DxPopup HeaderText="Add lines from delivery order"
             CloseOnOutsideClick="false"
             Width="900px"
             CssClass="sdoc-popup common-popup"
             @bind-Visible="@DoPickerVisible">
        <Content>
            <div class="sdoc-popup-body">
                @if (!string.IsNullOrWhiteSpace(DoPickerError))
                {
                    <p class="sdoc-popup-error">@DoPickerError</p>
                }
                @if (DoPickerLoading)
                {
                    <p class="mb-0">Loading posted delivery order lines…</p>
                }
                else if (DoPickerLines.Count > 0)
                {
                    <p class="sdoc-popup-hint mb-2">All remaining lines are selected. Uncheck items to skip them.</p>
                    <DxGrid Data="@DoPickerLines"
                            KeyFieldName="@nameof(SaDoBillablePickerRow.PickerKey)"
                            SelectionMode="GridSelectionMode.Multiple"
                            AllowSelectRowByClick="true"
                            SelectAllCheckboxMode="GridSelectAllCheckboxMode.AllPages"
                            SelectedDataItems="@SelectedDoPickerLines"
                            SelectedDataItemsChanged="OnSelectedDoPickerLinesChanged"
                            ShowFilterRow="false"
                            ShowGroupPanel="false"
                            ShowSearchBox="false"
                            PageSize="10"
                            CssClass="sdoc-line-grid">
                        <Columns>
                            <DxGridSelectionColumn Width="48px" />
                            <DxGridDataColumn FieldName="@nameof(SaDoBillablePickerRow.DoNo)" Caption="DO" Width="120px" />
                            <DxGridDataColumn FieldName="@nameof(SaDoBillablePickerRow.Line)" Caption="#" Width="56px" />
                            <DxGridDataColumn FieldName="@nameof(SaDoBillablePickerRow.SoNo)" Caption="SO" Width="120px" />
                            <DxGridDataColumn FieldName="@nameof(SaDoBillablePickerRow.ICode)" Caption="Item" Width="140px" />
                            <DxGridDataColumn FieldName="@nameof(SaDoBillablePickerRow.IDesc)" Caption="Description" />
                            <DxGridDataColumn FieldName="@nameof(SaDoBillablePickerRow.RemainingBillableQty)" Caption="Billable qty" Width="110px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        </Columns>
                    </DxGrid>
                }
            </div>
            <div class="sdoc-popup-footer">
                <div class="sdoc-popup-footer__actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Close" Click="@CloseDoPicker" />
                    <DxButton RenderStyle="ButtonRenderStyle.Primary"
                              Text="Add selected"
                              Click="@AddFromDo"
                              Enabled="@(!DoPickerLoading && SelectedDoPickerLines.Count > 0)" />
                </div>
            </div>
        </Content>
    </DxPopup>

    <DxPopup HeaderText="Change customer?"
             CloseOnOutsideClick="false"
             Width="420px"
             CssClass="common-popup"
             @bind-Visible="@ConfirmCustChangeVisible">
        <Content>
            <p class="sdoc-confirm__copy">Changing customer will clear invoice lines. Continue?</p>
            <div class="sdoc-popup-footer__actions">
                <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Cancel" Click="@CancelCustChange" />
                <DxButton RenderStyle="ButtonRenderStyle.Danger" Text="Change customer" Click="@ConfirmCustChangeAsync" />
            </div>
        </Content>
    </DxPopup>

    <DxPopup HeaderText="Overwrite shipment?"
             CloseOnOutsideClick="false"
             Width="460px"
             CssClass="common-popup"
             @bind-Visible="@ConfirmShipOverwriteVisible">
        <Content>
            <p class="sdoc-confirm__copy">@(_shipConfirmMessage ?? "Shipment already exists. Confirm to overwrite.")</p>
            <div class="sdoc-popup-footer__actions">
                <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Cancel" Click="@CancelShipOverwrite" />
                <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Overwrite" Click="@ConfirmShipOverwriteAsync" />
            </div>
        </Content>
    </DxPopup>

    <DxPopup HeaderText="Edit shipment lots"
             CloseOnOutsideClick="false"
             Width="720px"
             CssClass="sdoc-popup common-popup"
             @bind-Visible="@ShipEditorVisible">
        <Content>
            @if (ShipEditorVisible && _shipEditLine is int lineNo)
            {
                <SpShipmentEditor InvNo="@(InvNo ?? string.Empty)"
                                  SoLineNo="@lineNo"
                                  RowVersion="@_rowVersion"
                                  Enabled="@CanEditDocument"
                                  OnCancelled="@CloseShipmentEditor"
                                  OnApplied="@OnShipmentAppliedAsync"
                                  OnApplyFailed="@OnShipmentApplyFailed" />
            }
        </Content>
    </DxPopup>

    <DxPopup HeaderText="Reload required"
             CloseOnOutsideClick="false"
             Width="460px"
             CssClass="common-popup"
             @bind-Visible="@ConcurrencyVisible">
        <Content>
            <p class="sdoc-confirm__copy">This invoice was changed by another user. Reload the latest version before continuing.</p>
            <div class="sdoc-popup-footer__actions">
                <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Close" Click="@(() => ConcurrencyVisible = false)" />
                <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Reload latest" Click="@ReloadLatestAsync" />
            </div>
        </Content>
    </DxPopup>
    </SaDocPage>
</MenuAuthorize>

@code {
    private RenderFragment FieldError(string field) => __builder =>
    {
        if (ValidationErrors.TryGetValue(field, out var message) && !string.IsNullOrWhiteSpace(message))
        {
            <p class="sdoc-field-error">@message</p>
        }
    };
}
