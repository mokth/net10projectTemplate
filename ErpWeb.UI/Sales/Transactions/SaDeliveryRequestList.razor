@page "/sales/delivery-requests"
@inherits PageBase
@using DevExpress.Blazor
@using ErpWeb.Core.Sales
@using ErpWeb.Model.Entities.Sales

<PageTitle>Delivery Requests</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.SalesDeliveryRequest">
    <div class="iv-page">
        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <div class="iv-toast iv-toast--ok" role="status">
                <span>@StatusMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissStatus" aria-label="Dismiss">×</button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="iv-toast iv-toast--err" role="alert">
                <span>@ErrorMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissError" aria-label="Dismiss">×</button>
            </div>
        }

        <header class="iv-hero">
            <div class="iv-hero__mark" aria-hidden="true">
                <i class="fa-solid fa-boxes-packing"></i>
            </div>
            <div class="iv-hero__copy">
                <p class="iv-eyebrow">Sales · Production demand</p>
                <h1 class="iv-title">Delivery Requests</h1>
                <div class="iv-chips">
                    <span class="iv-chip">@TotalCountLabel</span>
                    @if (HasActiveFilters)
                    {
                        <span class="iv-chip">Filtered</span>
                    }
                </div>
            </div>
            <div class="iv-hero__kpi">
                <span>Delivery Requests</span>
                <strong>@TotalCount.ToString("N0")</strong>
            </div>
        </header>

        <section class="iv-card dr-kpi-card" aria-label="Delivery Request fulfilment KPIs">
            <div class="dr-kpi-grid">
                <div class="iv-kpi">
                    <span class="iv-kpi__label">Open DRs</span>
                    <strong class="iv-kpi__value">@Kpis.OpenDrCount.ToString("N0")</strong>
                    <span class="iv-kpi__sub">@Kpis.OpenDrQty.ToString("n4") open qty</span>
                </div>
                <div class="iv-kpi">
                    <span class="iv-kpi__label">Due today</span>
                    <strong class="iv-kpi__value">@Kpis.DueTodayCount.ToString("N0")</strong>
                </div>
                <div class="iv-kpi">
                    <span class="iv-kpi__label">Due this week</span>
                    <strong class="iv-kpi__value">@Kpis.DueThisWeekCount.ToString("N0")</strong>
                </div>
                <div class="iv-kpi">
                    <span class="iv-kpi__label">Overdue</span>
                    <strong class="iv-kpi__value">@Kpis.OverdueCount.ToString("N0")</strong>
                </div>
                <div class="iv-kpi">
                    <span class="iv-kpi__label">At risk</span>
                    <strong class="iv-kpi__value">@Kpis.AtRiskCount.ToString("N0")</strong>
                </div>
                <div class="iv-kpi">
                    <span class="iv-kpi__label">Ready for delivery</span>
                    <strong class="iv-kpi__value">@Kpis.ReadyForDeliveryCount.ToString("N0")</strong>
                    <span class="iv-kpi__sub">@Kpis.ReadyForDeliveryQty.ToString("n4") qty</span>
                </div>
                <div class="iv-kpi">
                    <span class="iv-kpi__label">Material shortage</span>
                    <strong class="iv-kpi__value">@Kpis.MaterialShortageCount.ToString("N0")</strong>
                </div>
                <div class="iv-kpi">
                    <span class="iv-kpi__label">Partial fulfilment</span>
                    <strong class="iv-kpi__value">@Kpis.PartialFulfilmentCount.ToString("N0")</strong>
                </div>
                <div class="iv-kpi">
                    <span class="iv-kpi__label">On-time fulfilment</span>
                    <strong class="iv-kpi__value">@Kpis.OnTimeFulfilmentPercent.ToString("n2")%</strong>
                </div>
            </div>
        </section>

        <section class="iv-card">
            <div class="iv-toolbar-row">
                <div class="iv-toolbar-row__search">
                    <DxTextBox Text="@SearchText"
                               TextChanged="OnSearchTextChanged"
                               NullText="Search DR, SO, customer, product, WO…"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                               CssClass="w-100" />
                </div>
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          Text="FILTER"
                          IconCssClass="fa-solid fa-filter"
                          Click="@OpenFilterPopup" />
            </div>

            @if (IsBootstrapping)
            {
                <div class="iv-skeleton" aria-busy="true">
                    <div class="iv-skeleton__line iv-skeleton__line--lg"></div>
                    <div class="iv-skeleton__line iv-skeleton__line--md"></div>
                    <div class="iv-skeleton__line"></div>
                </div>
            }
            else
            {
                <div class="iv-list-desktop">
                    <CommonDataGridEx T="SaDeliveryRequestListRow"
                                      Columns="@Columns"
                                      Buttons="@Buttons"
                                      ActionButtons="@ActionButtons"
                                      KeyName="@nameof(SaDeliveryRequestListRow.Uid)"
                                      GridKey="sa-delivery-request-list"
                                      Title="Delivery Requests"
                                      CustomDataSource="@DataSource"
                                      ShowToolbarText="true"
                                      ShowResetLayoutButton="true"
                                      UseBuiltInExport="false"
                                      ShowSearchBox="false"
                                      ShowFilterRow="false"
                                      ShowGroupPanel="false"
                                      allowSelect="false"
                                      OnGridInstance="@OnGridInstance"
                                      OnButtonEventHandle="@OnButtonClick"
                                      OnActionEventHandle="@OnActionClick" />
                </div>

                <div class="iv-list-compact">
                    @if (CompactRows.Count == 0)
                    {
                        <p class="text-muted mb-0">No Delivery Requests match the current filters.</p>
                    }
                    else
                    {
                        @foreach (var row in CompactRows)
                        {
                            <button type="button"
                                    class="iv-list-compact__item"
                                    @onclick="() => NavigateView(row.Uid)">
                                <span class="iv-list-compact__code">@row.DeliveryRequestNo</span>
                                <span class="iv-list-compact__desc">
                                    @row.ProductCode · @row.ReadyQty.ToString("n4")/@row.RequestedQty.ToString("n4") ready · @row.RequiredDate.ToString("dd/MM/yyyy")
                                </span>
                                <div class="iv-list-compact__meta">
                                    <span class="iv-status @StatusChipClass(row.Status)">@row.Status</span>
                                    <span class="iv-status @FulfilmentChipClass(row)">@row.FulfilmentStatus</span>
                                    @if (!string.Equals(row.BlockerCode, SaDeliveryRequestBlockerCodes.None, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="iv-status is-off">@row.BlockerCode</span>
                                    }
                                </div>
                            </button>
                        }
                    }
                </div>
            }
        </section>
    </div>

    <DxPopup HeaderText="Filter delivery requests"
             CloseOnOutsideClick="false"
             Width="480px"
             CssClass="common-popup"
             @bind-Visible="@FilterPopupVisible">
        <Content>
            <div class="iv-popup-body">
                <DxFormLayout SizeMode="SizeMode.Small">
                    <DxFormLayoutItem Caption="Status" ColSpanMd="12">
                        <Template>
                            <DxComboBox Data="@StatusFilterOptions"
                                        TextFieldName="@nameof(StatusFilterOption.Name)"
                                        ValueFieldName="@nameof(StatusFilterOption.Key)"
                                        @bind-Value="@DraftStatusKey"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="SO no." ColSpanMd="6">
                        <Template>
                            <DxTextBox @bind-Text="DraftSoNo" NullText="SO number" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Customer" ColSpanMd="6">
                        <Template>
                            <DxTextBox @bind-Text="DraftCustomerCode" NullText="Customer code" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Product" ColSpanMd="6">
                        <Template>
                            <DxTextBox @bind-Text="DraftProductCode" NullText="Product code" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Warehouse" ColSpanMd="6">
                        <Template>
                            <DxTextBox @bind-Text="DraftWarehouseCode" NullText="Warehouse code" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Project" ColSpanMd="6">
                        <Template>
                            <DxTextBox @bind-Text="DraftProjectCode" NullText="Project code" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Work Order" ColSpanMd="6">
                        <Template>
                            <DxTextBox @bind-Text="DraftWorkOrderNo" NullText="Work Order number" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Priority" ColSpanMd="6">
                        <Template>
                            <DxComboBox Data="@PriorityFilterOptions"
                                        TextFieldName="@nameof(StatusFilterOption.Name)"
                                        ValueFieldName="@nameof(StatusFilterOption.Key)"
                                        @bind-Value="DraftPriorityKey" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Fulfilment" ColSpanMd="6">
                        <Template>
                            <DxComboBox Data="@FulfilmentFilterOptions"
                                        TextFieldName="@nameof(StatusFilterOption.Name)"
                                        ValueFieldName="@nameof(StatusFilterOption.Key)"
                                        @bind-Value="DraftFulfilmentStatusKey" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Blocker" ColSpanMd="6">
                        <Template>
                            <DxComboBox Data="@BlockerFilterOptions"
                                        TextFieldName="@nameof(StatusFilterOption.Name)"
                                        ValueFieldName="@nameof(StatusFilterOption.Key)"
                                        @bind-Value="DraftBlockerCodeKey" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Due mode" ColSpanMd="6">
                        <Template>
                            <DxComboBox Data="@DueModeFilterOptions"
                                        TextFieldName="@nameof(StatusFilterOption.Name)"
                                        ValueFieldName="@nameof(StatusFilterOption.Key)"
                                        @bind-Value="DraftDueModeKey" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Required date from" ColSpanMd="6">
                        <Template>
                            <DxDateEdit @bind-Date="@DraftDateFrom"
                                        DisplayFormat="dd/MM/yyyy"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Required date to" ColSpanMd="6">
                        <Template>
                            <DxDateEdit @bind-Date="@DraftDateTo"
                                        DisplayFormat="dd/MM/yyyy"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayout>
            </div>
            <div class="iv-popup-footer">
                <div class="iv-popup-footer__actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Clear" Click="@ClearFiltersAsync" />
                    <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Apply" Click="@ApplyFiltersAsync" />
                </div>
            </div>
        </Content>
    </DxPopup>
</MenuAuthorize>
