@page "/purchase/inquiry/price-history"
@inherits PoInquiryPageBase
@using ErpWeb.Core.Purchase

<PageTitle>Purchase Price History</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.PurchasePriceHistory">
    <div class="iv-page">
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="iv-toast iv-toast--err" role="alert">
                <span>@ErrorMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissError" aria-label="Dismiss">×</button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(NavMessage))
        {
            <div class="iv-toast iv-toast--warn" role="status">
                <span>@NavMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissNavMessage" aria-label="Dismiss">×</button>
            </div>
        }

        <header class="iv-hero">
            <div class="iv-hero__mark" aria-hidden="true"><i class="fa-solid fa-tags"></i></div>
            <div class="iv-hero__copy">
                <p class="iv-eyebrow">Purchase · Inquiry</p>
                <h1 class="iv-title">Purchase Price History</h1>
                <div class="iv-chips" aria-busy="@SummaryLoading">
                    <span class="iv-chip">Posted invoice lines only</span>
                    <span class="iv-chip">Latest: @(SummaryLoading ? "…" : FormatPrice(Summary.LatestNetUnitPrice))</span>
                    <span class="iv-chip">Previous: @(SummaryLoading ? "…" : FormatPrice(Summary.PreviousNetUnitPrice))</span>
                    <span class="iv-chip">Min: @(SummaryLoading ? "…" : FormatPrice(Summary.MinNetUnitPrice))</span>
                    <span class="iv-chip">Max: @(SummaryLoading ? "…" : FormatPrice(Summary.MaxNetUnitPrice))</span>
                    <span class="iv-chip">Avg: @(SummaryLoading ? "…" : FormatPrice(Summary.AvgNetUnitPrice))</span>
                    @if (!string.IsNullOrWhiteSpace(ScopeBranchCode))
                    {
                        <span class="iv-chip">Branch: @ScopeBranchCode</span>
                    }
                </div>
            </div>
        </header>

        <section class="iv-card">
            <div class="iv-toolbar-row">
                <div class="iv-toolbar-row__search">
                    <IvCodeComboBox Data="@SupplierOptions"
                                    Value="@SuppCode"
                                    ValueChanged="@(async (string? v) => await OnSupplierChangedAsync(v))"
                                    NullText="All suppliers" />
                </div>
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          Text="FILTER"
                          IconCssClass="fa-solid fa-filter"
                          Click="@OpenFilterPopup" />
            </div>

            @if (IsBootstrapping)
            {
                <div class="iv-skeleton" aria-busy="true">
                    <div class="iv-skeleton__line iv-skeleton__line--lg"></div>
                    <div class="iv-skeleton__line iv-skeleton__line--md"></div>
                    <div class="iv-skeleton__line"></div>
                </div>
            }
            else
            {
                <div class="iv-list-desktop">
                    <CommonDataGridEx T="PoPurchasePriceHistoryRow"
                                      Columns="@Columns"
                                      Buttons="@Buttons"
                                      ActionButtons="@ActionButtons"
                                      KeyName="@nameof(PoPurchasePriceHistoryRow.DocNo)"
                                      GridKey="po-price-history"
                                      Title="Purchase price history"
                                      CustomDataSource="@DataSource"
                                      ShowToolbarText="true"
                                      ShowResetLayoutButton="true"
                                      UseBuiltInExport="false"
                                      ShowSearchBox="false"
                                      ShowFilterRow="false"
                                      ShowGroupPanel="false"
                                      allowSelect="false"
                                      OnGridInstance="@OnGridInstance"
                                      OnButtonEventHandle="@OnButtonClick"
                                      OnActionEventHandle="@OnActionClick" />
                </div>
            }
        </section>

        <p class="iv-subtitle">
            Unit price is the posted invoice line price. Net unit is NetAmount ÷ Qty.
            Summary statistics use NetUnitPrice only (Qty = 0 excluded). CurrRate ≤ 0 yields no local amount.
        </p>
    </div>

    <DxPopup HeaderText="Filter purchase price history"
             CloseOnOutsideClick="false"
             Width="720px"
             CssClass="common-popup"
             @bind-Visible="@FilterPopupVisible">
        <Content>
            <div class="iv-popup-body">
                <DxFormLayout SizeMode="SizeMode.Small">
                    <DxFormLayoutItem Caption="Date from" ColSpanMd="6">
                        <Template>
                            <DxDateEdit @bind-Date="@DraftDateFrom"
                                        DisplayFormat="dd/MM/yyyy"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Date to" ColSpanMd="6">
                        <Template>
                            <DxDateEdit @bind-Date="@DraftDateTo"
                                        DisplayFormat="dd/MM/yyyy"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Item" ColSpanMd="6">
                        <Template>
                            <IvStockMasterPicker ICode="@DraftItemCode"
                                                 ICodeChanged="@OnDraftItemCodeChangedAsync"
                                                 Selected="@OnDraftItemSelectedAsync" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Currency" ColSpanMd="6">
                        <Template>
                            <DxTextBox @bind-Text="@DraftCurrency"
                                       NullText="All currencies"
                                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayout>
                <p class="iv-popup-hint">
                    An empty field means <strong>all</strong>. Only POSTED Type=INV lines are included.
                    Date filter applies to invoice date.
                </p>
            </div>
            <div class="iv-popup-footer">
                <div class="iv-popup-footer__actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="Clear"
                              Click="@ClearFiltersAsync" />
                    <DxButton RenderStyle="ButtonRenderStyle.Primary"
                              Text="Apply"
                              Click="@ApplyFiltersAsync" />
                </div>
            </div>
        </Content>
    </DxPopup>
</MenuAuthorize>
