@page "/purchase/inquiry/einvoice"
@inherits PoInquiryPageBase
@using ErpWeb.Core.Purchase

<PageTitle>Self-Billed e-Invoice Status</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.PurchaseSbEInvoiceInquiry">
    <div class="iv-page">
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="iv-toast iv-toast--err" role="alert">
                <span>@ErrorMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissError" aria-label="Dismiss">×</button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(NavMessage))
        {
            <div class="iv-toast iv-toast--warn" role="status">
                <span>@NavMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissNavMessage" aria-label="Dismiss">×</button>
            </div>
        }

        <header class="iv-hero">
            <div class="iv-hero__mark" aria-hidden="true"><i class="fa-solid fa-file-signature"></i></div>
            <div class="iv-hero__copy">
                <p class="iv-eyebrow">Purchase · Inquiry</p>
                <h1 class="iv-title">Self-Billed e-Invoice Status</h1>
                <div class="iv-chips" aria-busy="@SummaryLoading">
                    <span class="iv-chip">Total: @(SummaryLoading ? "…" : Summary.TotalCount.ToString("N0"))</span>
                    <button type="button" class="@ChipClass(PoInquiryWorkbenchPresets.SbNotSubmitted)"
                            @onclick="OnNotSubmittedClick">
                        Not submitted: @(SummaryLoading ? "…" : Summary.NotSubmittedCount.ToString("N0"))
                    </button>
                    <button type="button" class="@ChipClass(PoInquiryWorkbenchPresets.SbInvalid)"
                            @onclick="OnInvalidClick">
                        Invalid/Rejected: @(SummaryLoading ? "…" : Summary.InvalidCount.ToString("N0"))
                    </button>
                    @if (!string.IsNullOrWhiteSpace(ScopeBranchCode))
                    {
                        <span class="iv-chip">Branch: @ScopeBranchCode</span>
                    }
                </div>
            </div>
        </header>

        <section class="iv-card">
            <div class="iv-toolbar-row">
                <div class="iv-toolbar-row__search">
                    <IvCodeComboBox Data="@SupplierOptions"
                                    Value="@SuppCode"
                                    ValueChanged="@(async (string? v) => await OnSupplierChangedAsync(v))"
                                    NullText="All suppliers" />
                </div>
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          Text="FILTER"
                          IconCssClass="fa-solid fa-filter"
                          Click="@OpenFilterPopup" />
            </div>

            <DxTabs>
                <DxTabPage Text="Status">
                    <CommonDataGridEx T="PoSbEInvoiceStatusRow"
                                      Columns="@StatusColumns"
                                      Buttons="@Buttons"
                                      ActionButtons="@StatusActionButtons"
                                      KeyName="@nameof(PoSbEInvoiceStatusRow.DocNo)"
                                      GridKey="po-sb-einv-status"
                                      Title="Self-billed e-Invoice status"
                                      CustomDataSource="@StatusDataSource"
                                      ShowToolbarText="true"
                                      ShowResetLayoutButton="true"
                                      UseBuiltInExport="false"
                                      ShowSearchBox="false"
                                      ShowFilterRow="false"
                                      ShowGroupPanel="false"
                                      allowSelect="false"
                                      OnGridInstance="@OnStatusGridInstance"
                                      OnButtonEventHandle="@OnStatusButtonClick"
                                      OnActionEventHandle="@OnStatusActionClick" />
                </DxTabPage>
                <DxTabPage Text="Reconciliation">
                    <CommonDataGridEx T="PoSbEInvoiceReconciliationRow"
                                      Columns="@ReconciliationColumns"
                                      Buttons="@Buttons"
                                      KeyName="@nameof(PoSbEInvoiceReconciliationRow.DocNo)"
                                      GridKey="po-sb-einv-reconciliation"
                                      Title="Self-billed e-Invoice reconciliation"
                                      CustomDataSource="@ReconciliationDataSource"
                                      ShowToolbarText="true"
                                      ShowResetLayoutButton="true"
                                      UseBuiltInExport="false"
                                      ShowSearchBox="false"
                                      ShowFilterRow="false"
                                      ShowGroupPanel="false"
                                      allowSelect="false"
                                      OnGridInstance="@OnReconciliationGridInstance"
                                      OnButtonEventHandle="@OnReconciliationButtonClick" />
                </DxTabPage>
            </DxTabs>
        </section>

        <p class="iv-subtitle">
            "Not submitted" means no submission row and no IRBM value. Status chips reuse the same
            decoration as the grid — there is no second e-Invoice status map.
        </p>
    </div>

    <DxPopup HeaderText="Filter e-Invoice documents"
             CloseOnOutsideClick="false"
             Width="640px"
             CssClass="common-popup"
             @bind-Visible="@FilterPopupVisible">
        <Content>
            <div class="iv-popup-body">
                <DxFormLayout SizeMode="SizeMode.Small">
                    <DxFormLayoutItem Caption="Date from" ColSpanMd="6">
                        <Template>
                            <DxDateEdit @bind-Date="@DraftDateFrom"
                                        DisplayFormat="dd/MM/yyyy"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Date to" ColSpanMd="6">
                        <Template>
                            <DxDateEdit @bind-Date="@DraftDateTo"
                                        DisplayFormat="dd/MM/yyyy"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayout>
                <p class="iv-popup-hint">
                    An empty field means <strong>all</strong> values, never "none". Both tabs read the same
                    applied filters. The supplier is chosen on the toolbar and applies as soon as it is
                    picked.
                </p>
            </div>
            <div class="iv-popup-footer">
                <div class="iv-popup-footer__actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="Clear"
                              Click="@ClearFiltersAsync" />
                    <DxButton RenderStyle="ButtonRenderStyle.Primary"
                              Text="Apply"
                              Click="@ApplyFiltersAsync" />
                </div>
            </div>
        </Content>
    </DxPopup>
</MenuAuthorize>
