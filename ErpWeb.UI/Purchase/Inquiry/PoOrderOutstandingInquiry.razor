@page "/purchase/inquiry/po-outstanding"
@inherits PoInquiryPageBase
@using ErpWeb.Core.Purchase

<PageTitle>Purchase Order Outstanding</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.PurchaseOrderOutstanding">
    <div class="iv-page">
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="iv-toast iv-toast--err" role="alert">
                <span>@ErrorMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissError" aria-label="Dismiss">×</button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(NavMessage))
        {
            <div class="iv-toast iv-toast--warn" role="status">
                <span>@NavMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissNavMessage" aria-label="Dismiss">×</button>
            </div>
        }

        <header class="iv-hero">
            <div class="iv-hero__mark" aria-hidden="true"><i class="fa-solid fa-boxes-stacked"></i></div>
            <div class="iv-hero__copy">
                <p class="iv-eyebrow">Purchase · Inquiry</p>
                <h1 class="iv-title">Purchase Order Outstanding</h1>
                <div class="iv-chips" aria-busy="@SummaryLoading">
                    <button type="button" class="@ChipClass(PoInquiryWorkbenchPresets.AllOpen)"
                            @onclick="@(() => OnPresetClick(PoInquiryWorkbenchPresets.AllOpen))">
                        Open lines: @(SummaryLoading ? "…" : Summary.OpenLineCount.ToString("N0"))
                    </button>
                    <button type="button" class="@ChipClass(PoInquiryWorkbenchPresets.Overdue)"
                            @onclick="@(() => OnPresetClick(PoInquiryWorkbenchPresets.Overdue))">
                        Overdue: @(SummaryLoading ? "…" : Summary.OverdueLineCount.ToString("N0"))
                    </button>
                    <button type="button" class="@ChipClass(PoInquiryWorkbenchPresets.Partial)"
                            @onclick="@(() => OnPresetClick(PoInquiryWorkbenchPresets.Partial))">
                        Partial: @(SummaryLoading ? "…" : Summary.PartialLineCount.ToString("N0"))
                    </button>
                    <button type="button" class="@ChipClass(PoInquiryWorkbenchPresets.Unbilled)"
                            @onclick="@(() => OnPresetClick(PoInquiryWorkbenchPresets.Unbilled))">
                        Unbilled: @(SummaryLoading ? "…" : Summary.UnbilledLineCount.ToString("N0"))
                    </button>
                    <span class="iv-chip">
                        Outstanding: @(SummaryLoading ? "…" : Summary.OutstandingValue.ToString("N2"))
                    </span>
                    @if (!string.IsNullOrWhiteSpace(ScopeBranchCode))
                    {
                        <span class="iv-chip">Branch: @ScopeBranchCode</span>
                    }
                </div>
            </div>
        </header>

        <section class="iv-card">
            <div class="iv-toolbar-row">
                <div class="iv-toolbar-row__search">
                    <IvCodeComboBox Data="@SupplierOptions"
                                    Value="@SuppCode"
                                    ValueChanged="@(async (string? v) => await OnSupplierChangedAsync(v))"
                                    NullText="All suppliers" />
                </div>
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          Text="FILTER"
                          IconCssClass="fa-solid fa-filter"
                          Click="@OpenFilterPopup" />
            </div>

            @if (IsBootstrapping)
            {
                <div class="iv-skeleton" aria-busy="true">
                    <div class="iv-skeleton__line iv-skeleton__line--lg"></div>
                    <div class="iv-skeleton__line iv-skeleton__line--md"></div>
                    <div class="iv-skeleton__line"></div>
                </div>
            }
            else
            {
                <div class="iv-list-desktop">
                    <CommonDataGridEx T="PoOrderOutstandingRow"
                                      Columns="@Columns"
                                      Buttons="@Buttons"
                                      ActionButtons="@ActionButtons"
                                      KeyName="@nameof(PoOrderOutstandingRow.PoNo)"
                                      GridKey="po-order-outstanding"
                                      Title="Purchase order outstanding"
                                      CustomDataSource="@DataSource"
                                      ShowToolbarText="true"
                                      ShowResetLayoutButton="true"
                                      UseBuiltInExport="false"
                                      ShowSearchBox="false"
                                      ShowFilterRow="false"
                                      ShowGroupPanel="false"
                                      allowSelect="false"
                                      OnGridInstance="@OnGridInstance"
                                      OnButtonEventHandle="@OnButtonClick"
                                      OnActionEventHandle="@OnActionClick" />
                </div>

                @if (SelectedRow is not null)
                {
                    <div class="iv-chips" style="margin-top:0.75rem">
                        <span class="iv-chip">@SelectedRow.PoNo / @SelectedRow.PoRelNo line @SelectedRow.Line</span>
                        <span class="iv-chip">Ordered: @SelectedRow.PoPurQty.ToString("N4")</span>
                        <span class="iv-chip">Received: @SelectedRow.RecvQty.ToString("N4")</span>
                        <span class="iv-chip">Balance: @SelectedRow.BalanceQty.ToString("N4")</span>
                        <span class="iv-chip">Invoiceable: @SelectedRow.InvoiceableQty.ToString("N4")</span>
                        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                  Text="OPEN"
                                  IconCssClass="fa-solid fa-up-right-from-square"
                                  Click="@OpenSelected" />
                    </div>
                }
            }
        </section>

        <p class="iv-subtitle">
            Balance quantity is the persisted outstanding quantity maintained by the document engine —
            it is shown, never recomputed. Cancelled orders never appear here. Click a chip to focus exceptions.
        </p>
    </div>

    <DxPopup HeaderText="Filter purchase orders"
             CloseOnOutsideClick="false"
             Width="640px"
             CssClass="common-popup"
             @bind-Visible="@FilterPopupVisible">
        <Content>
            <div class="iv-popup-body">
                <DxFormLayout SizeMode="SizeMode.Small">
                    <DxFormLayoutItem Caption="Date from" ColSpanMd="6">
                        <Template>
                            <DxDateEdit @bind-Date="@DraftDateFrom"
                                        DisplayFormat="dd/MM/yyyy"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Date to" ColSpanMd="6">
                        <Template>
                            <DxDateEdit @bind-Date="@DraftDateTo"
                                        DisplayFormat="dd/MM/yyyy"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Buyer" ColSpanMd="6">
                        <Template>
                            <DxTextBox @bind-Text="@DraftBuyerCode"
                                       NullText="All buyers"
                                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Status" ColSpanMd="6">
                        <Template>
                            <DxComboBox Data="@StatusOptions"
                                        TextFieldName="@nameof(StatusFilterOption.Name)"
                                        ValueFieldName="@nameof(StatusFilterOption.Key)"
                                        @bind-Value="@DraftStatus"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayout>
                <p class="iv-popup-hint">
                    An empty field means <strong>all</strong> values, never "none". A non-latest revision
                    is historical and never appears here. The supplier is chosen on the toolbar and
                    applies as soon as it is picked.
                </p>
            </div>
            <div class="iv-popup-footer">
                <div class="iv-popup-footer__actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="Clear"
                              Click="@ClearFiltersAsync" />
                    <DxButton RenderStyle="ButtonRenderStyle.Primary"
                              Text="Apply"
                              Click="@ApplyFiltersAsync" />
                </div>
            </div>
        </Content>
    </DxPopup>
</MenuAuthorize>
