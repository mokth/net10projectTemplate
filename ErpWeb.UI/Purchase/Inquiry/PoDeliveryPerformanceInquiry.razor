@page "/purchase/inquiry/delivery-performance"
@inherits PoInquiryPageBase
@using ErpWeb.Core.Purchase

<PageTitle>Supplier Delivery Performance</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.PurchaseDeliveryPerformance">
    <div class="iv-page">
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="iv-toast iv-toast--err" role="alert">
                <span>@ErrorMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissError" aria-label="Dismiss">×</button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(NavMessage))
        {
            <div class="iv-toast iv-toast--warn" role="status">
                <span>@NavMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissNavMessage" aria-label="Dismiss">×</button>
            </div>
        }

        <header class="iv-hero">
            <div class="iv-hero__mark" aria-hidden="true"><i class="fa-solid fa-truck-fast"></i></div>
            <div class="iv-hero__copy">
                <p class="iv-eyebrow">Purchase · Inquiry</p>
                <h1 class="iv-title">Supplier Delivery Performance</h1>
                <div class="iv-chips">
                    <button type="button" class="@ChipClass(PoInquiryWorkbenchPresets.AllOpen)"
                            @onclick="@(() => OnPresetClick(PoInquiryWorkbenchPresets.AllOpen))"
                            title="Open PO lines (BalanceQty &gt; 0)">
                        All open
                    </button>
                    <button type="button" class="@ChipClass(PoInquiryWorkbenchPresets.Overdue)"
                            @onclick="@(() => OnPresetClick(PoInquiryWorkbenchPresets.Overdue))"
                            title="Open lines past ETA">
                        Overdue
                    </button>
                    <button type="button" class="@ChipClass(PoInquiryWorkbenchPresets.Partial)"
                            @onclick="@(() => OnPresetClick(PoInquiryWorkbenchPresets.Partial))"
                            title="Partially received open lines">
                        Partially received
                    </button>
                    <button type="button" class="@ChipClass(PoInquiryWorkbenchPresets.LateCompletion)"
                            @onclick="@(() => OnPresetClick(PoInquiryWorkbenchPresets.LateCompletion))"
                            title="Fully received after ETA">
                        Late completion
                    </button>
                    <button type="button" class="@ChipClass(PoInquiryWorkbenchPresets.OnTimeCompleted)"
                            @onclick="@(() => OnPresetClick(PoInquiryWorkbenchPresets.OnTimeCompleted))"
                            title="Completed on or before expected date">
                        On time / Early
                    </button>
                    @if (!string.IsNullOrWhiteSpace(ScopeBranchCode))
                    {
                        <span class="iv-chip">Branch: @ScopeBranchCode</span>
                    }
                </div>
            </div>
        </header>

        <section class="iv-card">
            <div class="iv-toolbar-row">
                <div class="iv-toolbar-row__search">
                    <IvCodeComboBox Data="@SupplierOptions"
                                    Value="@SuppCode"
                                    ValueChanged="@(async (string? v) => await OnSupplierChangedAsync(v))"
                                    NullText="All suppliers" />
                </div>
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          Text="FILTER"
                          IconCssClass="fa-solid fa-filter"
                          Click="@OpenFilterPopup" />
            </div>

            @if (IsBootstrapping)
            {
                <div class="iv-skeleton" aria-busy="true">
                    <div class="iv-skeleton__line iv-skeleton__line--lg"></div>
                    <div class="iv-skeleton__line iv-skeleton__line--md"></div>
                    <div class="iv-skeleton__line"></div>
                </div>
            }
            else
            {
                <div class="iv-list-desktop">
                    <CommonDataGridEx T="PoDeliveryPerformanceLineRow"
                                      Columns="@LineColumns"
                                      Buttons="@Buttons"
                                      ActionButtons="@ActionButtons"
                                      KeyName="@nameof(PoDeliveryPerformanceLineRow.RowKey)"
                                      GridKey="po-delivery-performance-lines"
                                      Title="PO line delivery performance"
                                      CustomDataSource="@LineDataSource"
                                      ShowToolbarText="true"
                                      ShowResetLayoutButton="true"
                                      UseBuiltInExport="false"
                                      ShowSearchBox="false"
                                      ShowFilterRow="false"
                                      ShowGroupPanel="false"
                                      allowSelect="false"
                                      OnGridInstance="@OnGridInstance"
                                      OnButtonEventHandle="@OnLineButtonClick"
                                      OnActionEventHandle="@OnLineActionClick" />
                </div>

                @if (SelectedLine is not null)
                {
                    <div class="iv-chips" style="margin-top:0.75rem">
                        <span class="iv-chip">@SelectedLine.PoNo / @SelectedLine.PoRelNo line @SelectedLine.Line</span>
                        <span class="iv-chip">Status: @SelectedLine.DeliveryStatus</span>
                        <span class="iv-chip">Outstanding: @SelectedLine.BalanceQty.ToString("N4")</span>
                        @if (SelectedLine.DaysLate is int daysLate)
                        {
                            <span class="iv-chip">Days late: @daysLate</span>
                        }
                        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                  Text="OPEN PO"
                                  IconCssClass="fa-solid fa-up-right-from-square"
                                  Click="@OpenSelectedPo" />
                        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                  Text="RECEIPTS"
                                  IconCssClass="fa-solid fa-list"
                                  Click="@OpenReceiptsAsync" />
                        @if (CanReadFollowUp)
                        {
                            <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                      Text="FOLLOW UP"
                                      IconCssClass="fa-solid fa-phone"
                                      Click="@OpenFollowUpAsync" />
                        }
                    </div>
                }

                <h2 class="iv-subtitle" style="margin-top:1.5rem">Supplier summary</h2>
                <div class="iv-list-desktop">
                    <CommonDataGridEx T="PoDeliveryPerformanceRow"
                                      Columns="@SummaryColumns"
                                      Buttons="@SummaryButtons"
                                      ActionButtons="@SummaryActionButtons"
                                      KeyName="@nameof(PoDeliveryPerformanceRow.SuppCode)"
                                      GridKey="po-delivery-performance-summary"
                                      Title="Supplier delivery summary"
                                      CustomDataSource="@SummaryDataSource"
                                      ShowToolbarText="true"
                                      ShowResetLayoutButton="true"
                                      UseBuiltInExport="false"
                                      ShowSearchBox="false"
                                      ShowFilterRow="false"
                                      ShowGroupPanel="false"
                                      allowSelect="false"
                                      OnGridInstance="@OnSummaryGridInstance"
                                      OnButtonEventHandle="@OnSummaryButtonClick"
                                      OnActionEventHandle="@OnSummaryActionClick" />
                </div>
            }
        </section>

        <p class="iv-subtitle">
            Supplier KPIs use commitments due within the selected ETA period. OTIF uses posted GR/NG
            chronology clipped by AsOf; In-Full uses current persisted BalanceQty. Use the row actions
            to show the exact PO lines behind each KPI. The line grid can also browse by PO date.
        </p>
    </div>

    <DxPopup HeaderText="Filter delivery performance"
             CloseOnOutsideClick="false"
             Width="720px"
             CssClass="common-popup"
             @bind-Visible="@FilterPopupVisible">
        <Content>
            <div class="iv-popup-body">
                <DxFormLayout SizeMode="SizeMode.Small">
                    <DxFormLayoutItem Caption="Date from" ColSpanMd="6">
                        <Template>
                            <DxDateEdit @bind-Date="@DraftDateFrom"
                                        DisplayFormat="dd/MM/yyyy"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Date to" ColSpanMd="6">
                        <Template>
                            <DxDateEdit @bind-Date="@DraftDateTo"
                                        DisplayFormat="dd/MM/yyyy"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Line date basis" ColSpanMd="6">
                        <Template>
                            <DxComboBox Data="@DeliveryDateBasisOptions"
                                        TextFieldName="@nameof(StatusFilterOption.Name)"
                                        ValueFieldName="@nameof(StatusFilterOption.Key)"
                                        @bind-Value="@DraftDeliveryDateBasis"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Never" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Item" ColSpanMd="6">
                        <Template>
                            <IvStockMasterPicker ICode="@DraftItemCode"
                                                 ICodeChanged="@OnDraftItemCodeChangedAsync"
                                                 Selected="@OnDraftItemSelectedAsync" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Buyer" ColSpanMd="6">
                        <Template>
                            <DxTextBox @bind-Text="@DraftBuyerCode"
                                       NullText="All buyers"
                                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Warehouse" ColSpanMd="6">
                        <Template>
                            <DxTextBox @bind-Text="@DraftWarehouse"
                                       NullText="All warehouses"
                                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Delivery status" ColSpanMd="6">
                        <Template>
                            <DxComboBox Data="@DeliveryStatusOptions"
                                        TextFieldName="@nameof(StatusFilterOption.Name)"
                                        ValueFieldName="@nameof(StatusFilterOption.Key)"
                                        @bind-Value="@DraftStatus"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayout>
                <p class="iv-popup-hint">
                    The supplier KPI summary always uses ETA / due date for this range. This selector
                    controls the line grid only; choose PO date to browse order activity. Preset and
                    delivery status filters are ANDed.
                </p>
            </div>
            <div class="iv-popup-footer">
                <div class="iv-popup-footer__actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="Clear"
                              Click="@ClearFiltersAsync" />
                    <DxButton RenderStyle="ButtonRenderStyle.Primary"
                              Text="Apply"
                              Click="@ApplyFiltersAsync" />
                </div>
            </div>
        </Content>
    </DxPopup>

    <DxPopup HeaderText="@ReceiptPopupTitle"
             CloseOnOutsideClick="true"
             Width="900px"
             CssClass="common-popup"
             @bind-Visible="@ReceiptPopupVisible">
        <Content>
            <div class="iv-popup-body">
                @if (ReceiptLoading)
                {
                    <div class="iv-skeleton" aria-busy="true">
                        <div class="iv-skeleton__line"></div>
                    </div>
                }
                else if (ReceiptRows.Count == 0)
                {
                    <p class="iv-subtitle">No posted GR/NG receipts on or before AsOf.</p>
                }
                else
                {
                    <DxGrid ColumnResizeMode="GridColumnResizeMode.ColumnsContainer" Data="@ReceiptRows" PageSize="20" ShowFilterRow="false" TextWrapEnabled="false">
                        <Columns>
                            <DxGridDataColumn FieldName="@nameof(PoDeliveryPerformanceReceiptRow.BatchNo)" Caption="GR batch" Width="145px" MinWidth="125">
                                <CellDisplayTemplate Context="receiptContext">
                                    @{
                                        var receipt = (PoDeliveryPerformanceReceiptRow)receiptContext.DataItem;
                                    }
                                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                              RenderStyleMode="ButtonRenderStyleMode.Text"
                                              Text="@receipt.BatchNo.ToString()"
                                              title="Open goods receipt"
                                              Click="@(() => OpenSelectedGr(receipt.BatchNo))" />
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn FieldName="@nameof(PoDeliveryPerformanceReceiptRow.TrxDtTime)" Caption="Date" DisplayFormat="dd/MM/yyyy" Width="120px" MinWidth="105" />
                            <DxGridDataColumn FieldName="@nameof(PoDeliveryPerformanceReceiptRow.Qty)" Caption="Received qty" DisplayFormat="n4" Width="130px" MinWidth="110" TextAlignment="GridTextAlignment.Right" />
                            <DxGridDataColumn FieldName="@nameof(PoDeliveryPerformanceReceiptRow.CumulativeQty)" Caption="Cumulative" DisplayFormat="n4" Width="130px" MinWidth="110" TextAlignment="GridTextAlignment.Right" />
                            <DxGridDataColumn FieldName="@nameof(PoDeliveryPerformanceReceiptRow.RemainingQty)" Caption="Remaining" DisplayFormat="n4" Width="130px" MinWidth="110" TextAlignment="GridTextAlignment.Right" />
                            <DxGridDataColumn FieldName="@nameof(PoDeliveryPerformanceReceiptRow.DaysVsEta)" Caption="Days vs ETA" Width="120px" MinWidth="105" />
                            <DxGridDataColumn FieldName="@nameof(PoDeliveryPerformanceReceiptRow.OnTimeOrLate)" Caption="Vs ETA" Width="110px" MinWidth="95" />
                        </Columns>
                    </DxGrid>
                }
            </div>
            <div class="iv-popup-footer">
                <div class="iv-popup-footer__actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Primary"
                              Text="Close"
                              Click="@(() => ReceiptPopupVisible = false)" />
                </div>
            </div>
        </Content>
    </DxPopup>

    <DxPopup HeaderText="Supplier delivery follow-up"
             CloseOnOutsideClick="false"
             Width="760px"
             CssClass="common-popup"
             @bind-Visible="FollowUpPopupVisible">
        <Content>
            <div class="iv-popup-body">
                @if (SelectedLine is not null)
                {
                    <div class="iv-chips">
                        <span class="iv-chip">@SelectedLine.PoNo / rev @SelectedLine.PoRelNo / line @SelectedLine.Line</span>
                        <span class="iv-chip">Supplier: @(SelectedLine.SuppCode ?? "—")</span>
                        <span class="iv-chip">PO ETA (current revision): @(SelectedLine.EtaDate?.ToString("dd/MM/yyyy") ?? "Not set")</span>
                        <span class="iv-chip">Outstanding: @SelectedLine.BalanceQty.ToString("N4")</span>
                    </div>
                }
                <p class="iv-popup-hint">
                    The contact time and user are recorded by the server. Supplier-stated dates do not change the PO ETA.
                    Resolved closes this follow-up task only.
                </p>

                @if (CanAddFollowUp)
                {
                    <div class="iv-card" style="margin:0.75rem 0">
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label" for="followup-outcome">Outcome</label>
                                <select id="followup-outcome" class="form-select" @bind="FollowUpOutcome">
                                    @foreach (var outcome in FollowUpOutcomeOptions)
                                    {
                                        <option value="@outcome">@outcome</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Supplier-stated date</label>
                                <DxDateEdit @bind-Date="SupplierStatedDate"
                                            DisplayFormat="dd/MM/yyyy"
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Next follow-up date</label>
                                <DxDateEdit @bind-Date="NextFollowUpDate"
                                            DisplayFormat="dd/MM/yyyy"
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="followup-note">Note</label>
                                <textarea id="followup-note" class="form-control" rows="3" maxlength="500"
                                          @bind="FollowUpNote"></textarea>
                            </div>
                        </div>
                        <div class="iv-popup-footer__actions" style="margin-top:0.75rem">
                            <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                      Text="@(FollowUpSaving ? "SAVING…" : "SAVE FOLLOW-UP")"
                                      Enabled="@(!FollowUpSaving)"
                                      Click="@SaveFollowUpAsync" />
                        </div>
                    </div>
                }

                <h2 class="iv-subtitle">History · latest first</h2>
                @if (FollowUpLoading)
                {
                    <div class="iv-skeleton" aria-busy="true"><div class="iv-skeleton__line"></div></div>
                }
                else if (FollowUpRows.Count == 0)
                {
                    <p class="iv-subtitle">No follow-up entries recorded for this PO revision and line.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead><tr><th>Contacted (UTC)</th><th>Outcome</th><th>Supplier date</th><th>Next action</th><th>By</th></tr></thead>
                            <tbody>
                                @foreach (var row in FollowUpRows)
                                {
                                    <tr>
                                        <td>@row.ContactAtUtc.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@row.Outcome</td>
                                        <td>@(row.SupplierStatedDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                        <td>@(row.NextFollowUpDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                        <td>@row.CreatedBy</td>
                                    </tr>
                                    @if (!string.IsNullOrWhiteSpace(row.Note))
                                    {
                                        <tr><td colspan="5" class="text-wrap">@row.Note</td></tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div class="iv-popup-footer">
                <div class="iv-popup-footer__actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="Close"
                              Click="@(() => FollowUpPopupVisible = false)" />
                </div>
            </div>
        </Content>
    </DxPopup>
</MenuAuthorize>
