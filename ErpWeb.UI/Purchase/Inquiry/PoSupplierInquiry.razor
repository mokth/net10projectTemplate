@page "/purchase/inquiry/supplier"
@inherits PoInquiryPageBase

<PageTitle>Supplier Transactions</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.PurchaseSupplierTransaction">
    <div class="iv-page">
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="iv-toast iv-toast--err" role="alert">
                <span>@ErrorMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissError" aria-label="Dismiss">×</button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(NavMessage))
        {
            <div class="iv-toast iv-toast--warn" role="status">
                <span>@NavMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissNavMessage" aria-label="Dismiss">×</button>
            </div>
        }

        <header class="iv-hero">
            <div class="iv-hero__mark" aria-hidden="true"><i class="fa-solid fa-arrow-right-arrow-left"></i></div>
            <div class="iv-hero__copy">
                <p class="iv-eyebrow">Purchase · Inquiry</p>
                <h1 class="iv-title">Supplier Transactions</h1>
                <div class="iv-chips">
                    <span class="iv-chip">All statuses</span>
                    <span class="iv-chip">History is posted only</span>
                    @if (HistoryLoaded)
                    {
                        <span class="iv-chip">Period INV: @HistoryTotals.InvoiceTotal.ToString("N2")</span>
                        <span class="iv-chip">Period CN: @HistoryTotals.CreditNoteTotal.ToString("N2")</span>
                        <span class="iv-chip">Period DN: @HistoryTotals.DebitNoteTotal.ToString("N2")</span>
                        <span class="iv-chip">Period net: @HistoryTotals.NetPurchase.ToString("N2")</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(ScopeBranchCode))
                    {
                        <span class="iv-chip">Branch: @ScopeBranchCode</span>
                    }
                </div>
            </div>
        </header>

        <section class="iv-card">
            <div class="iv-toolbar-row">
                <div class="iv-toolbar-row__search">
                    <IvCodeComboBox Data="@SupplierOptions"
                                    Value="@SuppCode"
                                    ValueChanged="@(async (string? v) => await OnSupplierChangedAsync(v))"
                                    NullText="All suppliers" />
                    <DxTextBox NullText="Search suppliers"
                               maxlength="40"
                               TextChanged="@(async (v) => await OnSupplierSearchChangedAsync(v))" ValidationEnabled="false" />
                </div>
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          Text="FILTER"
                          IconCssClass="fa-solid fa-filter"
                          Click="@OpenFilterPopup" />
            </div>

            <DxTabs>
                <DxTabPage Text="Transactions">
                    <CommonDataGridEx T="PoSupplierTransactionRow"
                                      Columns="@TransactionColumns"
                                      Buttons="@Buttons"
                                      ActionButtons="@ActionButtons"
                                      KeyName="@nameof(PoSupplierTransactionRow.DocNo)"
                                      GridKey="po-supp-trx"
                                      Title="Supplier transactions"
                                      CustomDataSource="@DataSource"
                                      ShowToolbarText="true"
                                      UseBuiltInExport="false"
                                      ShowFilterRow="false"
                                      ShowGroupPanel="false"
                                      allowSelect="false"
                                      OnGridInstance="@OnGridInstance"
                                      OnButtonEventHandle="@OnButtonClick"
                                      OnActionEventHandle="@OnActionClick" />
                </DxTabPage>
                <DxTabPage Text="Purchase History">
                    @if (!string.IsNullOrWhiteSpace(HistoryError))
                    {
                        <div class="iv-toast iv-toast--err" role="alert"><span>@HistoryError</span></div>
                    }
                    else if (HistoryRows.Count == 0)
                    {
                        <p class="text-muted mb-0">No posted invoices match the current filters.</p>
                    }
                    else
                    {
                        <div class="iv-toolbar-row">
                            <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Export CSV" Click="@OnExportHistoryClick" />
                        </div>
                        <DxGrid Data="@HistoryRows" CssClass="w-100">
                            <Columns>
                                <DxGridDataColumn FieldName="@nameof(PoSupplierPurchaseHistoryRow.Period)" Caption="Period" Width="100px" />
                                <DxGridDataColumn FieldName="@nameof(PoSupplierPurchaseHistoryRow.InvoiceCount)" Caption="Invoices" Width="90px" TextAlignment="GridTextAlignment.Right" />
                                <DxGridDataColumn FieldName="@nameof(PoSupplierPurchaseHistoryRow.InvoiceTotal)" Caption="Invoice total" Width="130px" DisplayFormat="n2" TextAlignment="GridTextAlignment.Right" />
                                <DxGridDataColumn FieldName="@nameof(PoSupplierPurchaseHistoryRow.CreditNoteCount)" Caption="Credit notes" Width="100px" TextAlignment="GridTextAlignment.Right" />
                                <DxGridDataColumn FieldName="@nameof(PoSupplierPurchaseHistoryRow.CreditNoteTotal)" Caption="Credit total" Width="130px" DisplayFormat="n2" TextAlignment="GridTextAlignment.Right" />
                                <DxGridDataColumn FieldName="@nameof(PoSupplierPurchaseHistoryRow.DebitNoteCount)" Caption="Debit notes" Width="100px" TextAlignment="GridTextAlignment.Right" />
                                <DxGridDataColumn FieldName="@nameof(PoSupplierPurchaseHistoryRow.DebitNoteTotal)" Caption="Debit total" Width="130px" DisplayFormat="n2" TextAlignment="GridTextAlignment.Right" />
                                <DxGridDataColumn FieldName="@nameof(PoSupplierPurchaseHistoryRow.NetPurchase)" Caption="Net purchase" Width="130px" DisplayFormat="n2" TextAlignment="GridTextAlignment.Right" />
                            </Columns>
                        </DxGrid>
                        <p class="iv-subtitle">Net purchase = posted invoices + debit notes − credit notes (stored positive, netted once).</p>
                    }
                </DxTabPage>
            </DxTabs>
        </section>
    </div>

    <DxPopup HeaderText="Filter supplier transactions"
             CloseOnOutsideClick="false"
             Width="640px"
             CssClass="common-popup"
             @bind-Visible="@FilterPopupVisible">
        <Content>
            <div class="iv-popup-body">
                <DxFormLayout SizeMode="SizeMode.Small">
                    <DxFormLayoutItem Caption="Date from" ColSpanMd="6">
                        <Template>
                            <DxDateEdit @bind-Date="@DraftDateFrom"
                                        DisplayFormat="dd/MM/yyyy"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Date to" ColSpanMd="6">
                        <Template>
                            <DxDateEdit @bind-Date="@DraftDateTo"
                                        DisplayFormat="dd/MM/yyyy"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Buyer" ColSpanMd="6">
                        <Template>
                            <DxTextBox @bind-Text="@DraftBuyerCode"
                                       NullText="All buyers"
                                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayout>
                <p class="iv-popup-hint">
                    An empty field means <strong>all</strong> values, never "none". Both tabs read the same
                    applied filters, so the transaction log and the purchase history can never disagree. The
                    supplier is chosen on the toolbar and applies as soon as it is picked.
                </p>
            </div>
            <div class="iv-popup-footer">
                <div class="iv-popup-footer__actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="Clear"
                              Click="@ClearFiltersAsync" />
                    <DxButton RenderStyle="ButtonRenderStyle.Primary"
                              Text="Apply"
                              Click="@ApplyFiltersAsync" />
                </div>
            </div>
        </Content>
    </DxPopup>
</MenuAuthorize>
