@namespace ErpWeb.UI.Purchase.Lookups
@using Microsoft.AspNetCore.Components.Web

<DxPopup HeaderCssClass="code-style"
         HeaderText="SELECT PURCHASE ITEM"
         CloseOnOutsideClick="false"
         Width="85vw"
         CssClass="common-popup"
         @bind-Visible="@Visible"
         Closing="@OnClosing">
    <Content>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-warning py-2">@_error</div>
        }

        <div class="erp-inline-search erp-inline-search--popup">
            <label class="erp-inline-search__caption" for="po-purchasing-item-search-popup-search">Search</label>
            <div class="erp-inline-search__editor">
                <DxTextBox InputId="po-purchasing-item-search-popup-search"
                           @bind-Text="@_searchText"
                           NullText="Item code / description"
                           ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                           @onkeydown="OnSearchKeyDownAsync"
                           BindValueMode="BindValueMode.OnInput" />
            </div>
            <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                      IconCssClass="fa-solid fa-magnifying-glass"
                      CssClass="erp-inline-search__button"
                      Click="@SearchAsync"
                      aria-label="Search purchasing items"
                      title="Search purchasing items" />
        </div>

        <DxGrid ColumnResizeMode="GridColumnResizeMode.ColumnsContainer" @ref="_grid"
                Data="@_items"
                KeyFieldName="@nameof(PoPurchasingItemLookupRow.ICode)"
                ShowFilterRow="false"
                ShowGroupPanel="false"
                PageSize="@_pageSize"
                TextWrapEnabled="false"
                FocusedRowEnabled="true"
                RowDoubleClick="@OnRowDoubleClick"
                SelectedDataItemChanged="@OnSelectedItemChanged">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(PoPurchasingItemLookupRow.ICode)" Caption="ITEM CODE" Width="165px" MinWidth="145" />
                <DxGridDataColumn FieldName="@nameof(PoPurchasingItemLookupRow.IDesc)" Caption="DESCRIPTION" Width="280px" MinWidth="210" />
                <DxGridDataColumn FieldName="@nameof(PoPurchasingItemLookupRow.SourceLabel)" Caption="SOURCE" Width="90px" />
                <DxGridDataColumn FieldName="@nameof(PoPurchasingItemLookupRow.PurchaseUom)" Caption="UOM" Width="70px" />
                <DxGridDataColumn FieldName="@nameof(PoPurchasingItemLookupRow.Category)" Caption="CATEGORY" Width="110px" />
                @if (ShowUnitPrice)
                {
                    <DxGridDataColumn FieldName="@nameof(PoPurchasingItemLookupRow.UnitPrice)" Caption="UNIT PRICE" Width="110px" DisplayFormat="n4" />
                }
            </Columns>
        </DxGrid>

        <div class="d-flex justify-content-between align-items-center mt-2">
            <span class="text-muted small">@_totalCount item(s)</span>
            <div class="d-flex gap-2">
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          Text="PREV"
                          Enabled="@(_skip > 0 && !_loading)"
                          Click="@PrevPageAsync" />
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          Text="NEXT"
                          Enabled="@(_skip + _pageSize < _totalCount && !_loading)"
                          Click="@NextPageAsync" />
            </div>
        </div>

        <div class="d-flex gap-2 mt-3" @onkeydown="OnKeyDown">
            <DxButton RenderStyle="ButtonRenderStyle.Primary"
                      Text="SELECT"
                      IconCssClass="fa-solid fa-check"
                      Click="@SelectFocusedAsync"
                      Enabled="@(_focused is not null)" />
            <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                      Text="CANCEL"
                      IconCssClass="fa-solid fa-xmark"
                      Click="@CloseAsync" />
        </div>
    </Content>
</DxPopup>
