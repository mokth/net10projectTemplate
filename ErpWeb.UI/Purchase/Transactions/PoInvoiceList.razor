@page "/purchase/invoices"
@inherits PageBase

<PageTitle>Purchase Invoice</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.PurchaseInvoice">
    <div class="iv-page">
        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <div class="iv-toast iv-toast--ok" role="status">
                <span>@StatusMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissStatus" aria-label="Dismiss">×</button>
            </div>
        }
        @if (OperatorFailure is not null)
        {
            <ErpOperatorFailureBanner Failure="OperatorFailure" OnDismiss="DismissError" />
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="iv-toast iv-toast--err" role="alert">
                <span>@ErrorMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissError" aria-label="Dismiss">×</button>
            </div>
        }

        <header class="iv-hero">
            <div class="iv-hero__mark" aria-hidden="true">
                <i class="fa-solid fa-file-invoice"></i>
            </div>
            <div class="iv-hero__copy">
                <p class="iv-eyebrow">Purchase</p>
                <h1 class="iv-title">Purchase Invoice</h1>
                <div class="iv-chips">
                    <span class="iv-chip">@TotalCountLabel</span>
                    @if (HasActiveFilters)
                    {
                        <span class="iv-chip">Filtered</span>
                    }
                </div>
            </div>
            <div class="iv-hero__kpi">
                <span>Documents</span>
                <strong>@TotalCount.ToString("N0")</strong>
            </div>
        </header>

        <section class="iv-card">
            <div class="po-invoice-type-tabs">
                <DxButton RenderStyle="@(AppliedType == "INV" ? ButtonRenderStyle.Primary : ButtonRenderStyle.Secondary)"
                          Text="Invoices" Click="@(() => SetTypeAsync("INV"))" />
                <DxButton RenderStyle="@(AppliedType == "CN" ? ButtonRenderStyle.Primary : ButtonRenderStyle.Secondary)"
                          Text="Quantity Corrections" Click="@(() => SetTypeAsync("CN"))" />
                <DxButton RenderStyle="@(string.IsNullOrEmpty(AppliedType) ? ButtonRenderStyle.Primary : ButtonRenderStyle.Secondary)"
                          Text="All" Click="@(() => SetTypeAsync(null))" />
            </div>

            <div class="iv-toolbar-row">
                <div class="iv-toolbar-row__search erp-inline-search">
                    <label class="erp-inline-search__caption" for="po-invoice-list-search">Search</label>
                    <div class="erp-inline-search__editor">
                        <DxTextBox InputId="po-invoice-list-search"
                                   Text="@SearchText"
                                   TextChanged="OnSearchTextChanged"
                                   TextExpression="@(() => SearchText)"
                                   BindValueMode="BindValueMode.OnInput"
                                   NullText="Search doc no, vendor, invoice…"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   CssClass="w-100" />
                    </div>
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              IconCssClass="fa-solid fa-magnifying-glass"
                              CssClass="erp-inline-search__button"
                              Click="@ApplySearchAsync"
                              aria-label="Search purchase invoices"
                              title="Search purchase invoices" />
                </div>
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          Text="FILTER"
                          IconCssClass="fa-solid fa-filter"
                          Click="@OpenFilterPopup" />
            </div>

            @if (IsBootstrapping)
            {
                <div class="iv-skeleton" aria-busy="true">
                    <div class="iv-skeleton__line iv-skeleton__line--lg"></div>
                    <div class="iv-skeleton__line iv-skeleton__line--md"></div>
                    <div class="iv-skeleton__line"></div>
                </div>
            }
            else
            {
                <CommonDataGridEx T="PoInvoiceListRow"
                                  Columns="@Columns"
                                  Buttons="@Buttons"
                                  ActionButtons="@ActionButtons"
                                  KeyName="@nameof(PoInvoiceListRow.DocNo)"
                                  GridKey="po-invoice-list"
                                  Title="Purchase Invoices"
                                  CustomDataSource="@DataSource"
                                  ShowToolbarText="true"
                                  ShowResetLayoutButton="true"
                                  UseBuiltInExport="false"
                                  ShowSearchBox="false"
                                  ShowFilterRow="false"
                                  ShowGroupPanel="false"
                                  allowSelect="true"
                                  OnGridInstance="@OnGridInstance"
                                  OnSelectionsEventHandle="@OnSelectionsEvent"
                                  OnButtonEventHandle="@OnButtonClick"
                                  OnActionEventHandle="@OnActionClick" />
            }
        </section>
    </div>

    <DxPopup HeaderText="Filter documents"
             CloseOnOutsideClick="false"
             Width="480px"
             CssClass="common-popup"
             @bind-Visible="@FilterPopupVisible">
        <Content>
            <div class="iv-popup-body">
                <DxFormLayout SizeMode="SizeMode.Small">
                    <DxFormLayoutItem Caption="Status" ColSpanMd="12">
                        <Template>
                            <DxComboBox Data="@StatusFilterOptions"
                                        TextFieldName="@nameof(StatusFilterOption.Name)"
                                        ValueFieldName="@nameof(StatusFilterOption.Key)"
                                        @bind-Value="@DraftStatusKey"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Date from" ColSpanMd="6">
                        <Template>
                            <DxDateEdit T="DateTime?"
                                        @bind-Date="@DraftDateFrom"
                                        DisplayFormat="dd/MM/yyyy"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Date to" ColSpanMd="6">
                        <Template>
                            <DxDateEdit T="DateTime?"
                                        @bind-Date="@DraftDateTo"
                                        DisplayFormat="dd/MM/yyyy"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayout>
            </div>
            <div class="iv-popup-footer">
                <div class="iv-popup-footer__actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Clear" Click="@ClearFiltersAsync" />
                    <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Apply" Click="@ApplyFiltersAsync" />
                </div>
            </div>
        </Content>
    </DxPopup>

    <DxPopup HeaderText="Confirm"
             CloseOnOutsideClick="false"
             Width="480px"
             CssClass="common-popup"
             @bind-Visible="@ConfirmVisible">
        <Content>
            <p class="iv-confirm__copy">@ConfirmMessage</p>
            <div class="iv-popup-footer">
                <div class="iv-popup-footer__actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="Cancel"
                              Click="@(() => ConfirmVisible = false)"
                              Enabled="@(!IsSubmitting)" />
                    <DxButton RenderStyle="@ConfirmButtonStyle"
                              Text="@ConfirmButtonText"
                              Click="@ConfirmActionAsync"
                              Enabled="@(!IsSubmitting)" />
                </div>
            </div>
        </Content>
    </DxPopup>
</MenuAuthorize>
