@page "/planning/product-definitions/explode/{ProdCode}"
@page "/planning/product-definitions/explode/{ProdCode}/{DefinitionCode}"
@inherits PageBase
@using ErpWeb.Core.Planning

<PageTitle>Material breakdown — @ProdCode</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.PlanningProductDef">
    <div class="iv-page">
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="iv-toast iv-toast--err" role="alert">
                <span>@ErrorMessage</span>
                <button type="button" class="iv-toast__close" @onclick="() => ErrorMessage = null" aria-label="Dismiss">×</button>
            </div>
        }

        @if (NeedsDefinitionChoice)
        {
            <section class="iv-card">
                <header class="pdf-section__head">
                    <div>
                        <h2 class="iv-card__title mb-0">Choose a production setup</h2>
                        <p>Product <span class="code-style">@ProdCode</span> has more than one way of being made. Choose the setup to review.</p>
                    </div>
                </header>
                <div class="pdf-editor__actions" style="flex-wrap:wrap;gap:.5rem">
                    @foreach (var row in DefinitionChoices)
                    {
                        <DxButton RenderStyle="@(row.IsDefaultDefinition ? ButtonRenderStyle.Primary : ButtonRenderStyle.Secondary)"
                                  Text="@(ProductionSetupText.CodeAndName(row.DefinitionCode, row.DefinitionName) + (row.IsDefaultDefinition ? " · Usual setup" : string.Empty))"
                                  Click="@(() => ChooseDefinition(row.DefinitionCode))" />
                    }
                </div>
            </section>
        }
        else
        {
            <header class="iv-hero">
                <div class="iv-hero__mark" aria-hidden="true">
                    <i class="fa-solid fa-sitemap"></i>
                </div>
                <div class="iv-hero__copy">
                    <p class="iv-eyebrow">Production · Product setup</p>
                    <h1 class="iv-title">Material breakdown</h1>
                    <p class="iv-subtitle">Review the materials needed to make this product using the version currently in use.</p>
                    <div class="iv-chips">
                        <span class="iv-chip code-style">@ProdCode</span>
                        @if (!string.IsNullOrWhiteSpace(ResolvedDefinitionCode))
                        {
                            <span class="iv-chip code-style">@ResolvedDefinitionCode</span>
                        }
                        @if (Result is not null)
                        {
                            <span class="iv-chip">Version @Result.RootBomVersion</span>
                            <span class="iv-chip">Setup makes @Result.RootBaseQty?.ToString("n4") @Result.RootBaseUom</span>
                        }
                    </div>
                </div>
            </header>

            <section class="iv-card">
                <h2 class="iv-card__title">What would you like to check?</h2>
                <div class="pdf-head">
                    <div class="iv-field">
                        <label class="iv-field__label">Quantity to make</label>
                        <DxSpinEdit @bind-Value="@Quantity" MinValue="0.0001m" DisplayFormat="n4" ShowSpinButtons="false" />
                    </div>
                    <div class="iv-field">
                        <label class="iv-field__label">Setup code</label>
                        <DxTextBox Text="@ResolvedDefinitionCode" ReadOnly="true" InputCssClass="code-style" ValidationEnabled="false" />
                    </div>
                    <div class="iv-field">
                        <label class="iv-field__label">View</label>
                        <DxComboBox Data="@ModeOptions"
                                    TextFieldName="Text"
                                    ValueFieldName="Value"
                                    @bind-Value="@SelectedMode"
                                    SearchMode="ListSearchMode.None" />
                    </div>
                    <div class="pdf-editor__actions" style="align-self:end">
                        <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                  Text="@(IsLoading ? "Calculating…" : "Show materials")"
                                  IconCssClass="fa-solid fa-bolt"
                                  Click="@ExplodeAsync"
                                  Enabled="@(!IsLoading && !string.IsNullOrWhiteSpace(ResolvedDefinitionCode))" />
                        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                  Text="Back to setup"
                                  Click="@GoBackAsync" />
                    </div>
                </div>
                <p class="pdf-hint">
                    This uses the saved production setup currently in use; draft changes are not included.
                    Material structure shows how items fit together. Materials needed shows the quantities of purchased and made items.
                    Materials to issue shows the items issued directly to a work order. Items made using another setup use that setup's version currently in use.
                </p>
            </section>

            @if (IsLoading)
            {
                <section class="iv-card">
                    <div class="iv-skeleton" aria-busy="true">
                        <div class="iv-skeleton__line iv-skeleton__line--lg"></div>
                        <div class="iv-skeleton__line"></div>
                    </div>
                </section>
            }
            else if (Result is not null)
            {
                <section class="iv-card">
                    <header class="pdf-section__head">
                        <h2 class="iv-card__title mb-0">@ModeTitle</h2>
                        <span class="pdf-count">@Result.Nodes.Count rows</span>
                    </header>
                    <div class="pdf-grid">
                        <DxGrid ColumnResizeMode="GridColumnResizeMode.ColumnsContainer" Data="@Result.Nodes"
                                KeyFieldName="@nameof(BomExplosionNode.Path)"
                                ShowFilterRow="false"
                                ShowGroupPanel="false"
                                ShowSearchBox="false"
                                TextWrapEnabled="false"
                                CustomizeCellDisplayText="OnCustomizeCellDisplayText"
                                CssClass="w-100">
                            <Columns>
                                <DxGridDataColumn FieldName="@nameof(BomExplosionNode.Level)" Caption="Level" Width="60px" />
                                <DxGridDataColumn FieldName="@nameof(BomExplosionNode.ItemCode)" Caption="Item" Width="120px" />
                                <DxGridDataColumn FieldName="@nameof(BomExplosionNode.ItemDesc)" Caption="Description" />
                                <DxGridDataColumn FieldName="@nameof(BomExplosionNode.ParentItemCode)" Caption="Used in" Width="110px" />
                                <DxGridDataColumn FieldName="@nameof(BomExplosionNode.MfgType)" Caption="Item supply" Width="140px" />
                                <DxGridDataColumn FieldName="@nameof(BomExplosionNode.DefinitionCode)" Caption="Setup code" Width="120px" />
                                <DxGridDataColumn FieldName="@nameof(BomExplosionNode.QtyPerParent)" Caption="Qty / parent" DisplayFormat="n4" Width="110px" />
                                <DxGridDataColumn FieldName="@nameof(BomExplosionNode.ExtendedQty)" Caption="Quantity needed" DisplayFormat="n4" Width="120px" />
                                <DxGridDataColumn FieldName="@nameof(BomExplosionNode.Uom)" Caption="Unit" Width="80px" />
                                <DxGridDataColumn FieldName="@nameof(BomExplosionNode.ScrapPercent)" Caption="Waste %" DisplayFormat="n4" Width="90px" />
                                <DxGridDataColumn FieldName="@nameof(BomExplosionNode.BomVersion)" Caption="Version" Width="90px" />
                                <DxGridDataColumn FieldName="@nameof(BomExplosionNode.Warehouse)" Caption="Warehouse" Width="100px" />
                            </Columns>
                        </DxGrid>
                    </div>
                </section>
            }
        }
    </div>
</MenuAuthorize>
