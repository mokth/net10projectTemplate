@page "/planning/machine-preventive"
@inherits PrRefListPageBase<PrPreventiveListRow>

<PageTitle>Machine Preventive</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.PlanningMacPreventive">
<div class="iv-page">
    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="iv-toast iv-toast--ok" role="status">
            <span>@StatusMessage</span>
            <button type="button" class="iv-toast__close" @onclick="DismissStatus" aria-label="Dismiss">×</button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(ErrorMessage) && !PopupVisible && !RangePopupVisible && !CompletePopupVisible)
    {
        <div class="iv-toast iv-toast--err" role="alert">
            <span>@ErrorMessage</span>
            <button type="button" class="iv-toast__close" @onclick="DismissError" aria-label="Dismiss">×</button>
        </div>
    }

    <header class="iv-hero">
        <div class="iv-hero__mark" aria-hidden="true"><i class="@HeroIconClass"></i></div>
        <div>
            <p class="iv-eyebrow">Planning</p>
            <h1 class="iv-title">@HeroTitle</h1>
        </div>
    </header>

    @if (IsLoading) { <p>Loading preventive rows…</p> }

    <CommonDataGridEx Columns="@Columns()"
                      Buttons="@ToolbarButtons"
                      ActionButtons="@RowActionButtons"
                      KeyName="@nameof(PrPreventiveListRow.Uid)"
                      GridKey="pln-preventive-list"
                      Title="Machine Preventive"
                      T="PrPreventiveListRow"
                      OnGridInstance="@OnGridInstance"
                      GridData="@Data"
                      allowSelect="true"
                      OnSelectionsEventHandle="@OnSelectionsEvent"
                      OnButtonEventHandle="@OnToolbarButtonAsync"
                      OnActionEventHandle="@OnRowActionAsync" />

    <DxPopup HeaderCssClass="code-style"
             HeaderText="@(IsEditMode ? (EditEnabled ? "Edit Preventive" : "View Preventive") : "New Preventive")"
             CloseOnOutsideClick="false" Width="50vw" CssClass="common-popup"
             @bind-Visible="@PopupVisible">
        <Content>
            <EditForm Model="@EditModel" Context="pvForm" OnValidSubmit="@HandleValidSubmitAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <DxFormLayout SizeMode="SizeMode.Small">
                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="Machine" ColSpanMd="6">
                        <Template>
                            <DxComboBox Data="@Machines" @bind-Value="@EditModel.MachineCd"
                                        TextFieldName="MachineCd" ValueFieldName="MachineCd"
                                        ReadOnly="@(!EditEnabled)" NullText="Select machine" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="Date" ColSpanMd="6">
                        <Template>
                            <DxDateEdit @bind-Date="@EditModel.DownDt" ReadOnly="@(!EditEnabled)" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="Start Time" ColSpanMd="3" BeginRow="true">
                        <Template>
                            <DxTextBox @bind-Text="@EditModel.StartText" NullText="HH:mm" ReadOnly="@(!EditEnabled)" InputCssClass="required-field code-style" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="End Time" ColSpanMd="3">
                        <Template>
                            <DxTextBox @bind-Text="@EditModel.EndText" NullText="HH:mm" ReadOnly="@(!EditEnabled)" InputCssClass="required-field code-style" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="Reason" ColSpanMd="6">
                        <Template>
                            <DxComboBox Data="@Reasons" @bind-Value="@EditModel.ReasonCd"
                                        TextFieldName="ReasonCd" ValueFieldName="ReasonCd"
                                        ReadOnly="@(!EditEnabled)" NullText="Reason" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="Status" ColSpanMd="6" BeginRow="true">
                        <Template>
                            <DxTextBox @bind-Text="@EditModel.Status" ReadOnly="true" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="Remark" ColSpanMd="12" BeginRow="true">
                        <Template>
                            <DxTextBox @bind-Text="@EditModel.Remark" maxlength="100" ReadOnly="@(!EditEnabled)" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem CaptionCssClass="code-style" ColSpanMd="12" BeginRow="true">
                        <Template>
                            <div class="iv-popup-actions">
                                @if (EditEnabled)
                                {
                                    <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="@(IsSubmitting ? "Saving…" : "Save")" SubmitFormOnClick="true" Enabled="@(!IsSubmitting)" />
                                    <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Cancel" Click="@ClosePopup" Enabled="@(!IsSubmitting)" />
                                }
                                else
                                {
                                    <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Close" Click="@ClosePopup" />
                                    @if (CanEditFromView)
                                    {
                                        <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Edit" Click="@SwitchViewToEditAsync" />
                                    }
                                }
                            </div>
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem CaptionCssClass="code-style" ColSpanMd="12">
                        <Template><small class="text-danger">@ErrorMessage</small></Template>
                    </DxFormLayoutItem>
                </DxFormLayout>
            </EditForm>
        </Content>
    </DxPopup>

    <DxPopup HeaderCssClass="code-style" HeaderText="Add Date Range" CloseOnOutsideClick="false" Width="50vw" CssClass="common-popup" @bind-Visible="@RangePopupVisible">
        <Content>
            <DxFormLayout SizeMode="SizeMode.Small">
                <DxFormLayoutItem CaptionCssClass="code-style" Caption="Machine" ColSpanMd="6">
                    <Template>
                        <DxComboBox Data="@Machines" @bind-Value="@_rangeMac" TextFieldName="MachineCd" ValueFieldName="MachineCd" NullText="Machine" />
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem CaptionCssClass="code-style" Caption="From" ColSpanMd="3">
                    <Template><DxDateEdit @bind-Date="@_from" /></Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem CaptionCssClass="code-style" Caption="To" ColSpanMd="3">
                    <Template><DxDateEdit @bind-Date="@_to" /></Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem CaptionCssClass="code-style" Caption="Start" ColSpanMd="3" BeginRow="true">
                    <Template><DxTextBox @bind-Text="@_startText" NullText="HH:mm" /></Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem CaptionCssClass="code-style" Caption="End" ColSpanMd="3">
                    <Template><DxTextBox @bind-Text="@_endText" NullText="HH:mm" /></Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem CaptionCssClass="code-style" Caption="Reason" ColSpanMd="6">
                    <Template>
                        <DxComboBox Data="@Reasons" @bind-Value="@_reasonCd" TextFieldName="ReasonCd" ValueFieldName="ReasonCd" NullText="Reason" />
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem CaptionCssClass="code-style" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <div class="iv-popup-actions">
                            <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="@(IsSubmitting ? "Saving…" : "Add Range")" Click="@AddRangeAsync" Enabled="@(!IsSubmitting)" />
                            <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Cancel" Click="@(() => RangePopupVisible = false)" Enabled="@(!IsSubmitting)" />
                        </div>
                        <small class="text-danger">@ErrorMessage</small>
                    </Template>
                </DxFormLayoutItem>
            </DxFormLayout>
        </Content>
    </DxPopup>

    <DxPopup HeaderCssClass="code-style" HeaderText="Complete Preventive" CloseOnOutsideClick="false" Width="50vw" CssClass="common-popup" @bind-Visible="@CompletePopupVisible">
        <Content>
            <DxFormLayout SizeMode="SizeMode.Small">
                <DxFormLayoutItem CaptionCssClass="code-style" Caption="Machine" ColSpanMd="6">
                    <Template><DxTextBox Text="@CompleteModel.MachineCd" ReadOnly="true" ValidationEnabled="false" /></Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem CaptionCssClass="code-style" Caption="Reason" ColSpanMd="6">
                    <Template><DxTextBox Text="@CompleteModel.ReasonCd" ReadOnly="true" ValidationEnabled="false" /></Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem CaptionCssClass="code-style" Caption="Actual Start" ColSpanMd="6" BeginRow="true">
                    <Template><DxDateEdit @bind-Date="@CompleteModel.ActualStart" TimeSectionVisible="true" /></Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem CaptionCssClass="code-style" Caption="Actual End" ColSpanMd="6">
                    <Template><DxDateEdit @bind-Date="@CompleteModel.ActualEnd" TimeSectionVisible="true" /></Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem CaptionCssClass="code-style" Caption="Action Taken" ColSpanMd="12" BeginRow="true">
                    <Template><DxTextBox @bind-Text="@CompleteModel.ActionTaken" /></Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem CaptionCssClass="code-style" Caption="Parts Cost" ColSpanMd="4" BeginRow="true">
                    <Template><DxSpinEdit @bind-Value="@CompleteModel.PartsCost" /></Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem CaptionCssClass="code-style" Caption="Labour Cost" ColSpanMd="4">
                    <Template><DxSpinEdit @bind-Value="@CompleteModel.LabourCost" /></Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem CaptionCssClass="code-style" Caption="Other Cost" ColSpanMd="4">
                    <Template><DxSpinEdit @bind-Value="@CompleteModel.OtherCost" /></Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem CaptionCssClass="code-style" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <div class="iv-popup-actions">
                            <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="@(IsSubmitting ? "Saving…" : "Complete")" Click="@CompleteAsync" Enabled="@(!IsSubmitting)" />
                            <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Cancel" Click="@(() => CompletePopupVisible = false)" Enabled="@(!IsSubmitting)" />
                        </div>
                        <small class="text-danger">@ErrorMessage</small>
                    </Template>
                </DxFormLayoutItem>
            </DxFormLayout>
        </Content>
    </DxPopup>

    <DxPopup HeaderCssClass="code-style" HeaderText="Confirm Delete" CloseOnOutsideClick="false" Width="420px" CssClass="common-popup" @bind-Visible="@ConfirmDeleteVisible">
        <Content>
            <p>@ConfirmDeleteMessage</p>
            <div class="iv-popup-actions">
                <DxButton RenderStyle="ButtonRenderStyle.Danger" Text="@(IsSubmitting ? "Deleting…" : "Delete")" Click="@ConfirmDeleteAsync" Enabled="@(!IsSubmitting)" />
                <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Cancel" Click="@CloseConfirmDelete" Enabled="@(!IsSubmitting)" />
            </div>
        </Content>
    </DxPopup>
</div>
</MenuAuthorize>
