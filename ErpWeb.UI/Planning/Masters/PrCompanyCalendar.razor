@page "/planning/company-calendar"
@inherits PageBase
@using ErpWeb.Model.Entities.Planning
@using ErpWeb.UI.Planning.Components
@inject IPrCalendarService CalendarService
@inject IPrHolidayService HolidayService

<PageTitle>Company Calendar</PageTitle>
<MenuAuthorize MenuCode="@MenuCodes.PlanningCompanyCal">
<div class="iv-page">
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="iv-toast @(_ok ? "iv-toast--ok" : "iv-toast--err")" role="status">
            <span>@_message</span>
            <button type="button" class="iv-toast__close" @onclick="(() => _message = null)" aria-label="Dismiss">×</button>
        </div>
    }
    <header class="iv-hero">
        <div class="iv-hero__mark" aria-hidden="true"><i class="fa-solid fa-calendar-days"></i></div>
        <div>
            <p class="iv-eyebrow">Planning</p>
            <h1 class="iv-title">Company Calendar @_year</h1>
        </div>
    </header>
    <section class="iv-card">
        <div class="iv-toolbar-row mb-2 flex-wrap gap-2 align-items-center">
            <DxSpinEdit @bind-Value="@_year" MinValue="2000" MaxValue="2100" />
            <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="LOAD" Click="@TryLoadAsync" Enabled="@(!_busy)" />
            <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="GENERATE" Click="@GenerateWeekdaysAsync" Enabled="@(!_busy)" />
            <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="SAVE (MISSING)" Click="@(() => SaveAsync(CalendarRegenMode.GenerateMissingOnly))" Enabled="@(!_busy)" />
            <DxButton RenderStyle="ButtonRenderStyle.Danger" Text="SAVE (REGEN ALL)" Click="@ConfirmRegenAllAsync" Enabled="@(!_busy)" />
            <span class="ms-2">Paint:</span>
            <label class="me-2"><input type="radio" name="paint" checked="@(_paintMode == "O")" @onchange="@(() => _paintMode = "O")" /> Off</label>
            <label><input type="radio" name="paint" checked="@(_paintMode == "W")" @onchange="@(() => _paintMode = "W")" /> Work</label>
        </div>
        <div class="mb-2">
            <span class="me-2">Weekly offs:</span>
            @foreach (DayOfWeek d in Enum.GetValues<DayOfWeek>())
            {
                var day = d;
                <label class="me-2">
                    <input type="checkbox" checked="@_offWeekdays.Contains(day)" @onchange="@(e => ToggleOff(day, (bool)(e.Value ?? false)))" />
                    @day.ToString()[..3]
                </label>
            }
            <span class="text-muted ms-2">(empty = 7-day working week)</span>
        </div>
        @if (_busy)
        {
            <p class="text-muted">Saving and updating machine calendars…</p>
        }
        <PlanningYearCalendar Year="@_year"
                              DayCodes="@_dayCodes"
                              Holidays="@_holidayMap"
                              PaintMode="@_paintMode"
                              Dirty="@_dirty"
                              DayPainted="@OnDayPainted" />
        <p class="text-muted mt-2">Fingerprint: @_fingerprint · Holidays force Off on Generate/Save. Regen-all overwrites machine calendars for the year.</p>
    </section>
    <section class="iv-card mt-3">
        <h2 class="h5">Holidays @_year</h2>
        <div class="row g-2 mb-2">
            <div class="col-md-3"><DxDateEdit @bind-Date="@_holDate" /></div>
            <div class="col-md-4"><DxTextBox @bind-Text="@_holDesc" NullText="Description" /></div>
            <div class="col-md-2"><DxButton Text="Add Holiday" Click="@AddHolidayAsync" Enabled="@(!_busy)" /></div>
            <div class="col-md-3"><DxButton Text="Fetch Calendarific (MY)" Click="@FetchCalendarificAsync" Enabled="@(_calendarificEnabled && !_busy)" /></div>
        </div>
        @if (_calendarificCandidates.Count > 0)
        {
            <div class="mb-2">
                <p class="text-muted">Review Calendarific candidates before save:</p>
                <DxGrid Data="@_calendarificCandidates" KeyFieldName="@nameof(CalendarificHolidayCandidate.DateOff)">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(CalendarificHolidayCandidate.DateOff)" Caption="Date" DisplayFormat="dd MMM yyyy" Width="140px" />
                        <DxGridDataColumn FieldName="@nameof(CalendarificHolidayCandidate.Description)" Caption="Name" />
                        <DxGridDataColumn FieldName="@nameof(CalendarificHolidayCandidate.State)" Caption="State" Width="100px" />
                    </Columns>
                </DxGrid>
                <DxButton Text="Persist reviewed holidays" Click="@PersistCandidatesAsync" CssClass="mt-2" Enabled="@(!_busy)" />
            </div>
        }
        <DxGrid Data="@_holidays" KeyFieldName="@nameof(PrHoliday.Uid)"
                DataItemDeleting="@(async e => { if (e.DataItem is PrHoliday h) await DeleteHolidayAsync(h.Uid); })">
            <Columns>
                <DxGridCommandColumn Width="80px" />
                <DxGridDataColumn FieldName="@nameof(PrHoliday.DateOff)" Caption="Date" DisplayFormat="dd MMM yyyy" Width="140px" />
                <DxGridDataColumn FieldName="@nameof(PrHoliday.Description)" Caption="Description" />
            </Columns>
        </DxGrid>
    </section>
</div>
</MenuAuthorize>
@code {
    private int _year = DateTime.Today.Year;
    private Dictionary<DateOnly, string> _dayCodes = new();
    private List<CompanyCalendarDayVm> _days = [];
    private List<PrHoliday> _holidays = [];
    private Dictionary<DateOnly, string> _holidayMap = new();
    private List<CalendarificHolidayCandidate> _calendarificCandidates = [];
    private string _fingerprint = "";
    private string? _message; private bool _ok;
    private DateTime _holDate = DateTime.Today;
    private string? _holDesc;
    private bool _calendarificEnabled;
    private bool _regenConfirm;
    private bool _dirty;
    private bool _busy;
    private string _paintMode = "O";
    private readonly HashSet<DayOfWeek> _offWeekdays = new() { DayOfWeek.Saturday, DayOfWeek.Sunday };

    protected override async Task OnInitializedAsync()
    {
        _calendarificEnabled = await HolidayService.IsCalendarificEnabledAsync();
        await LoadAsync();
    }

    private async Task TryLoadAsync()
    {
        if (_dirty)
        {
            _ok = false;
            _message = "You have unsaved changes. Generate/Save first, or click LOAD again to discard.";
            if (_regenConfirm) { /* noop */ }
            // second click path: clear dirty by forcing load if message already shown
            if (_message?.Contains("discard") == true && !_dirty) { }
        }
        _dirty = false;
        await LoadAsync();
    }

    private void ToggleOff(DayOfWeek day, bool on)
    {
        if (on) _offWeekdays.Add(day);
        else _offWeekdays.Remove(day);
    }

    private async Task LoadAsync()
    {
        var r = await CalendarService.LoadYearAsync(_year);
        if (!r.Succeeded) { _ok = false; _message = r.Message; return; }
        _days = r.Value.Days.ToList();
        _fingerprint = r.Value.Fingerprint;
        SyncDayCodes();
        var h = await HolidayService.ListAsync(_year);
        if (h.Succeeded)
        {
            _holidays = h.Value!.ToList();
            _holidayMap = _holidays
                .Where(x => x.DateOff is not null)
                .GroupBy(x => DateOnly.FromDateTime(x.DateOff!.Value))
                .ToDictionary(g => g.Key, g => g.First().Description ?? "Holiday");
        }
        _message = null;
        _calendarificCandidates.Clear();
        _regenConfirm = false;
        _dirty = false;
    }

    private void SyncDayCodes()
    {
        _dayCodes = _days.ToDictionary(d => DateOnly.FromDateTime(d.Date), d => d.DateCd == "O" ? "O" : "W");
    }

    private Task OnDayPainted((DateOnly Date, string DateCd) paint)
    {
        var existing = _days.FirstOrDefault(d => DateOnly.FromDateTime(d.Date) == paint.Date);
        if (existing is null)
        {
            _days.Add(new CompanyCalendarDayVm { Date = paint.Date.ToDateTime(TimeOnly.MinValue), DateCd = paint.DateCd });
        }
        else
        {
            existing.DateCd = paint.DateCd;
        }
        SyncDayCodes();
        _dirty = true;
        return Task.CompletedTask;
    }

    private async Task GenerateWeekdaysAsync()
    {
        var holidayDates = _holidayMap.Keys.ToHashSet();
        var generated = CompanyCalendarGenerator.Generate(new CompanyCalendarGenerator.GenerateRequest
        {
            Year = _year,
            WeeklyOffDays = _offWeekdays,
            HolidayDates = holidayDates,
            DayOverrides = _dayCodes.Where(kv => !_holidayMap.ContainsKey(kv.Key))
                .ToDictionary(kv => kv.Key, kv => kv.Value)
        });
        _days = generated.ToList();
        SyncDayCodes();
        _dirty = true;
        _message = "Generated weekday template with holiday overlay (not saved).";
        _ok = true;
        await Task.CompletedTask;
    }

    private async Task ConfirmRegenAllAsync()
    {
        if (!_regenConfirm)
        {
            _regenConfirm = true;
            _ok = false;
            _message = "Regenerate All will rebuild the selected year for every machine from the Company Calendar and default shift group. Existing machine-specific day and shift-group overrides for that year will be lost. Click again to confirm.";
            return;
        }
        await SaveAsync(CalendarRegenMode.RegenerateAll);
        _regenConfirm = false;
    }

    private async Task SaveAsync(CalendarRegenMode mode)
    {
        _busy = true;
        try
        {
            var r = await CalendarService.SaveYearAsync(_year, _days, _fingerprint, mode);
            _ok = r.Succeeded;
            _message = r.Message;
            if (r.Succeeded && r.Value is not null)
            {
                _fingerprint = r.Value.NewFingerprint;
                _dirty = false;
                await LoadAsync();
            }
        }
        finally { _busy = false; }
    }

    private async Task AddHolidayAsync()
    {
        var r = await HolidayService.UpsertAsync(new PrHoliday
        {
            DateOff = _holDate.Date,
            Description = _holDesc,
            Year = _holDate.Year
        });
        _ok = r.Succeeded; _message = r.Message;
        if (r.Succeeded) await LoadAsync();
    }

    private async Task DeleteHolidayAsync(int uid)
    {
        var r = await HolidayService.DeleteAsync(uid);
        _ok = r.Succeeded; _message = r.Message;
        if (r.Succeeded) await LoadAsync();
    }

    private async Task FetchCalendarificAsync()
    {
        var r = await HolidayService.FetchCalendarificCandidatesAsync(_year, "MY");
        _ok = r.Succeeded; _message = r.Message;
        if (r.Succeeded) _calendarificCandidates = r.Value!.ToList();
    }

    private async Task PersistCandidatesAsync()
    {
        var r = await HolidayService.PersistCandidatesAsync(_calendarificCandidates);
        _ok = r.Succeeded; _message = r.Message;
        if (r.Succeeded) { _calendarificCandidates.Clear(); await LoadAsync(); }
    }
}
