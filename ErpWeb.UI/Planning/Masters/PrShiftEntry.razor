@page "/planning/shifts/{ShiftCd?}"
@inherits PageBase
@inject IPrShiftService ShiftService
@inject NavigationManager Nav

<PageTitle>Shift Entry</PageTitle>
<MenuAuthorize MenuCode="@MenuCodes.PlanningShift">
<div class="iv-page">
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="iv-toast @(_ok ? "iv-toast--ok" : "iv-toast--err")" role="status">
            <span>@_message</span>
            <button type="button" class="iv-toast__close" @onclick="(() => _message = null)" aria-label="Dismiss">×</button>
        </div>
    }

    <header class="iv-hero">
        <div class="iv-hero__mark" aria-hidden="true"><i class="fa-solid fa-clock"></i></div>
        <div>
            <p class="iv-eyebrow">Planning</p>
            <h1 class="iv-title">@(_vm.IsNew ? "New Shift" : _vm.ShiftCd)</h1>
        </div>
    </header>

    <section class="iv-card">
        <header class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
            <h2 class="iv-card__title mb-0">WORK SHIFT</h2>
            <div class="iv-toolbar-row mb-0">
                <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="SAVE" IconCssClass="fa-solid fa-floppy-disk" Click="@SaveAsync" />
                <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="CANCEL" IconCssClass="fa-solid fa-arrow-left" Click="@(() => Nav.NavigateTo("/planning/shifts"))" />
            </div>
        </header>

        <DxFormLayout SizeMode="SizeMode.Small" CssClass="shift-entry-form">
            <DxFormLayoutItem CaptionCssClass="code-style" Caption="Shift Code" ColSpanMd="4">
                <Template>
                    <DxTextBox @bind-Text="@_vm.ShiftCd" maxlength="10" ReadOnly="@(!_vm.IsNew)" InputCssClass="required-field code-style" />
                </Template>
            </DxFormLayoutItem>
            <DxFormLayoutItem CaptionCssClass="code-style" Caption="Description" ColSpanMd="6" BeginRow="true">
                <Template>
                    <DxTextBox @bind-Text="@_vm.ShiftDes" maxlength="30" InputCssClass="required-field" />
                </Template>
            </DxFormLayoutItem>

            <DxFormLayoutItem CaptionCssClass="code-style" Caption="Start Time" ColSpanMd="3" BeginRow="true">
                <Template>
                    <DxTextBox @bind-Text="@_startText" NullText="HH:mm" InputCssClass="required-field code-style" />
                </Template>
            </DxFormLayoutItem>
            <DxFormLayoutItem CaptionCssClass="code-style" Caption="End Time" ColSpanMd="3">
                <Template>
                    <DxTextBox @bind-Text="@_endText" NullText="HH:mm" InputCssClass="required-field code-style" />
                </Template>
            </DxFormLayoutItem>
            <DxFormLayoutItem CaptionCssClass="code-style" Caption=" " ColSpanMd="6">
                <Template>
                    <small class="text-muted">24-hour format (e.g. 08:00, 17:30). Overnight End &lt; Start is allowed.</small>
                </Template>
            </DxFormLayoutItem>

            <DxFormLayoutItem CaptionCssClass="code-style" Caption="Breaks" ColSpanMd="12" BeginRow="true">
                <Template>
                    <div class="shift-breaks">
                        <div class="shift-breaks__toolbar">
                            <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                      Text="ADD BREAK"
                                      IconCssClass="fa-solid fa-plus"
                                      Enabled="@(_breakRows.Count < MaxBreaks)"
                                      Click="@AddBreak" />
                        </div>
                        @if (_breakRows.Count == 0)
                        {
                            <div class="shift-breaks__empty text-muted small">No breaks configured.</div>
                        }
                        @foreach (var row in _breakRows)
                        {
                            <div class="shift-breaks__row" @key="row.Key">
                                <span class="shift-breaks__label code-style">Break @(_breakRows.IndexOf(row) + 1)</span>
                                <DxTextBox Text="@row.FromText"
                                           TextChanged="@(v => row.FromText = v)"
                                           NullText="From HH:mm"
                                           CssClass="shift-breaks__input"
                                           InputCssClass="code-style" TextExpression="@(() => row.FromText)" />
                                <span class="shift-breaks__to">TO</span>
                                <DxTextBox Text="@row.ToText"
                                           TextChanged="@(v => row.ToText = v)"
                                           NullText="To HH:mm"
                                           CssClass="shift-breaks__input"
                                           InputCssClass="code-style" TextExpression="@(() => row.ToText)" />
                                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                          IconCssClass="fa-solid fa-trash"
                                          CssClass="shift-breaks__remove"
                                          Click="@(() => RemoveBreak(row))" />
                            </div>
                        }
                    </div>
                </Template>
            </DxFormLayoutItem>

            <DxFormLayoutItem CaptionCssClass="code-style" Caption="Total Working" ColSpanMd="3" BeginRow="true">
                <Template>
                    <DxSpinEdit @bind-Value="@_totalHours" ReadOnly="true" MinValue="0" MaxValue="24" CssClass="w-100" />
                </Template>
            </DxFormLayoutItem>
            <DxFormLayoutItem CaptionCssClass="code-style" Caption="Minutes" ColSpanMd="3">
                <Template>
                    <DxSpinEdit @bind-Value="@_totalMinutesPart" ReadOnly="true" MinValue="0" MaxValue="59" CssClass="w-100" />
                </Template>
            </DxFormLayoutItem>
            <DxFormLayoutItem CaptionCssClass="code-style" Caption=" " ColSpanMd="6">
                <Template>
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="GET TOTAL" IconCssClass="fa-solid fa-calculator" Click="@GetTotal" />
                </Template>
            </DxFormLayoutItem>
        </DxFormLayout>
    </section>
</div>
</MenuAuthorize>

@code {
    [Parameter] public string? ShiftCd { get; set; }
    private PrShiftEditVm _vm = new() { IsNew = true };
    private string _startText = "08:00", _endText = "17:00";
    private const int MaxBreaks = PrShiftBreakMapper.MaxBreaks;
    private readonly List<BreakEditRow> _breakRows = [];
    private int _totalHours;
    private int _totalMinutesPart;
    private string? _message; private bool _ok;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(ShiftCd) || ShiftCd.Equals("new", StringComparison.OrdinalIgnoreCase))
        {
            _vm = new PrShiftEditVm { IsNew = true };
            _breakRows.Clear();
            return;
        }
        var r = await ShiftService.GetAsync(ShiftCd);
        if (!r.Succeeded || r.Value is null) { _ok = false; _message = r.Message; return; }
        _vm = r.Value;
        _startText = _vm.Start.ToString("HH:mm");
        _endText = _vm.End.ToString("HH:mm");
        _breakRows.Clear();
        foreach (var pair in _vm.Breaks.Take(MaxBreaks))
            _breakRows.Add(new BreakEditRow(pair.Start?.ToString("HH:mm"), pair.End?.ToString("HH:mm")));
        GetTotal();
    }

    private static bool TryParseTime(string? text, out TimeOnly time)
    {
        time = default;
        return !string.IsNullOrWhiteSpace(text) && TimeOnly.TryParse(text, out time);
    }

    private bool TryBuildVmTimes(out string? error)
    {
        error = null;
        if (!TryParseTime(_startText, out var start) || !TryParseTime(_endText, out var end))
        {
            error = "Invalid start/end time.";
            return false;
        }
        if (start == end)
        {
            error = "Shift start and end times must differ.";
            return false;
        }
        _vm.Start = start;
        _vm.End = end;
        _vm.Breaks = _breakRows.Select(ParsePair).ToList();
        return true;
    }

    private void GetTotal()
    {
        if (!TryBuildVmTimes(out var err))
        {
            _ok = false; _message = err;
            return;
        }
        var breaks = _vm.Breaks;
        for (var i = 0; i < breaks.Count; i++)
        {
            var be = ShiftTimeCalculator.ValidateBreakPair(breaks[i], i + 1);
            if (be is not null) { _ok = false; _message = be; return; }
        }
        try
        {
            var net = ShiftTimeCalculator.ComputeNetMinutes(_vm.Start, _vm.End, breaks);
            _totalHours = net / 60;
            _totalMinutesPart = net % 60;
            _message = null;
            _ok = true;
        }
        catch (ArgumentException ex)
        {
            _ok = false;
            _message = ex.Message;
        }
    }

    private async Task SaveAsync()
    {
        if (!TryBuildVmTimes(out var err))
        {
            _ok = false; _message = err;
            return;
        }
        GetTotal();
        if (!_ok && !string.IsNullOrWhiteSpace(_message))
            return;
        var r = await ShiftService.SaveAsync(_vm);
        _ok = r.Succeeded; _message = r.Message;
        if (r.Succeeded) Nav.NavigateTo("/planning/shifts");
    }

    private void AddBreak()
    {
        if (_breakRows.Count < MaxBreaks)
            _breakRows.Add(new BreakEditRow());
    }

    private void RemoveBreak(BreakEditRow row) => _breakRows.Remove(row);

    private ShiftTimeCalculator.BreakPair ParsePair(BreakEditRow row)
    {
        var hasFrom = TryParseTime(row.FromText, out var f);
        var hasTo = TryParseTime(row.ToText, out var t);
        if (!hasFrom && !hasTo) return default;
        if (hasFrom && hasTo) return new ShiftTimeCalculator.BreakPair(f, t);
        return new ShiftTimeCalculator.BreakPair(hasFrom ? f : null, hasTo ? t : null);
    }

    private sealed class BreakEditRow
    {
        public BreakEditRow(string? fromText = null, string? toText = null)
        {
            FromText = fromText;
            ToText = toText;
        }

        public Guid Key { get; } = Guid.NewGuid();
        public string? FromText { get; set; }
        public string? ToText { get; set; }
    }
}
