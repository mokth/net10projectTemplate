@page "/planning/work-orders"
@inherits PageBase

<PageTitle>Production Work Orders</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.PlanningWorkOrder">
    <div class="iv-page">
        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <div class="iv-toast iv-toast--ok" role="status">
                <span>@StatusMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissStatus" aria-label="Dismiss">×</button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="iv-toast iv-toast--err" role="alert">
                <span>@ErrorMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissError" aria-label="Dismiss">×</button>
            </div>
        }

        <header class="iv-hero">
            <div class="iv-hero__mark" aria-hidden="true">
                <i class="fa-solid fa-clipboard-list"></i>
            </div>
            <div class="iv-hero__copy">
                <p class="iv-eyebrow">Planning · Production</p>
                <h1 class="iv-title">Work Orders</h1>
                <div class="iv-chips">
                    <span class="iv-chip">@TotalCountLabel</span>
                    @if (HasActiveFilters)
                    {
                        <span class="iv-chip">Filtered</span>
                    }
                </div>
            </div>
            <div class="iv-hero__kpi">
                <span>Orders</span>
                <strong>@TotalCount.ToString("N0")</strong>
            </div>
        </header>

        <section class="iv-card">
            <div class="iv-toolbar-row">
                <div class="iv-toolbar-row__search">
                    <DxTextBox Text="@SearchText"
                               TextChanged="OnSearchTextChanged"
                               NullText="Search Work Order, product or source reference…"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                               CssClass="w-100" TextExpression="@(() => SearchText)" />
                </div>
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          Text="FILTER"
                          IconCssClass="fa-solid fa-filter"
                          Click="@OpenFilterPopup" />
            </div>

            @if (IsBootstrapping)
            {
                <div class="iv-skeleton" aria-busy="true">
                    <div class="iv-skeleton__line iv-skeleton__line--lg"></div>
                    <div class="iv-skeleton__line iv-skeleton__line--md"></div>
                    <div class="iv-skeleton__line"></div>
                </div>
            }
            else
            {
                <div class="iv-list-desktop">
                    <CommonDataGridEx T="ProductionWorkOrderListRow"
                                      Columns="@Columns"
                                      Buttons="@Buttons"
                                      ActionButtons="@ActionButtons"
                                      KeyName="@nameof(ProductionWorkOrderListRow.WorkOrderNo)"
                                      GridKey="pln-work-order-list"
                                      Title="Production Work Orders"
                                      CustomDataSource="@DataSource"
                                      ShowToolbarText="true"
                                      ShowResetLayoutButton="true"
                                      UseBuiltInExport="false"
                                      ShowSearchBox="false"
                                      ShowFilterRow="false"
                                      ShowGroupPanel="false"
                                      allowSelect="false"
                                      OnGridInstance="@OnGridInstance"
                                      OnButtonEventHandle="@OnButtonClick"
                                      OnActionEventHandle="@OnActionClick" />
                </div>

                <div class="iv-list-compact">
                    @if (CompactRows.Count == 0)
                    {
                        <p class="text-muted mb-0">No Work Orders match the current filters.</p>
                    }
                    else
                    {
                        @foreach (var row in CompactRows)
                        {
                            <button type="button" class="iv-compact-row" @onclick="@(() => OpenView(row.WorkOrderNo))">
                                <div class="iv-compact-row__title">
                                    <span class="code-style">@row.WorkOrderNo</span>
                                    <span>@row.ProductCode · @row.ProductDescription</span>
                                </div>
                                <div class="iv-compact-row__meta">
                                    <span>@row.Status</span>
                                    @if (!string.IsNullOrWhiteSpace(row.SourceDefinitionCode))
                                    {
                                        <span class="code-style">@row.SourceDefinitionCode · V@row.BomVersion</span>
                                    }
                                    <span>@row.PlannedQty.ToString("n4") @row.OutputUom</span>
                                    <span>Due @row.PlannedCompletionDate.ToString("dd MMM yyyy")</span>
                                </div>
                            </button>
                        }
                    }
                </div>
            }
        </section>

        <DxPopup HeaderText="Filter Work Orders"
                 CloseOnOutsideClick="false"
                 Width="520px"
                 CssClass="common-popup"
                 ShowFooter="true"
                 @bind-Visible="@FilterPopupVisible">
            <Content>
                <div class="iv-popup-body">
                    <DxFormLayout SizeMode="SizeMode.Small">
                        <DxFormLayoutItem Caption="Work Order" ColSpanMd="12">
                            <Template>
                                <DxTextBox @bind-Text="@DraftWorkOrderNo" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Product code" ColSpanMd="12">
                            <Template>
                                <DxTextBox @bind-Text="@DraftProductCode" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Definition code" ColSpanMd="12">
                            <Template>
                                <DxTextBox @bind-Text="@DraftDefinitionCode" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Status" ColSpanMd="12">
                            <Template>
                                <DxComboBox Data="@StatusOptions"
                                            TextFieldName="@nameof(FilterOption.Name)"
                                            ValueFieldName="@nameof(FilterOption.Key)"
                                            @bind-Value="@DraftStatus"
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Start date from" ColSpanMd="6">
                            <Template><DxDateEdit @bind-Date="@DraftStartFrom" /></Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Start date to" ColSpanMd="6">
                            <Template><DxDateEdit @bind-Date="@DraftStartTo" /></Template>
                        </DxFormLayoutItem>
                    </DxFormLayout>
                </div>
            </Content>
            <FooterContentTemplate>
                <div class="d-flex gap-2 justify-content-end w-100">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Clear" Click="@ClearFiltersAsync" />
                    <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Apply" Click="@ApplyFiltersAsync" />
                </div>
            </FooterContentTemplate>
        </DxPopup>

        <DxPopup HeaderText="Reopen Work Order for Editing"
                 CloseOnOutsideClick="false"
                 Width="560px"
                 CssClass="common-popup"
                 ShowFooter="true"
                 @bind-Visible="@ReopenConfirmVisible">
            <Content>
                @if (ReopenTarget is not null)
                {
                    <div class="iv-popup-body">
                        <p class="iv-confirm__copy">
                            This Work Order is Released. Reopening returns it to Draft so quantity, schedule,
                            Product Definition, machine or material settings can be edited. This is allowed only
                            when no production activity has started.
                        </p>
                        <dl class="iv-confirm__meta">
                            <div><dt>Work Order</dt><dd class="code-style">@ReopenTarget.WorkOrderNo</dd></div>
                            <div><dt>Product</dt><dd>@ReopenTarget.ProductCode · @ReopenTarget.ProductDescription</dd></div>
                            <div><dt>Current status</dt><dd>@ReopenTarget.Status</dd></div>
                            <div><dt>Planned Qty</dt><dd>@ReopenTarget.PlannedQty.ToString("n4") @ReopenTarget.OutputUom</dd></div>
                            <div><dt>Planned Start</dt><dd>@ReopenTarget.PlannedStartDate.ToString("dd MMM yyyy")</dd></div>
                            <div><dt>Planned Completion</dt><dd>@ReopenTarget.PlannedCompletionDate.ToString("dd MMM yyyy")</dd></div>
                        </dl>
                        <div class="iv-field mt-3">
                            <label class="iv-field__label">Reason *</label>
                            <DxMemo @bind-Text="@ReopenReason"
                                    Rows="3"
                                    NullText="e.g. Customer changed required quantity / production date rescheduled"
                                    Enabled="@(!IsReopening)" />
                        </div>
                    </div>
                }
            </Content>
            <FooterContentTemplate>
                <div class="d-flex gap-2 justify-content-end w-100">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="KEEP RELEASED"
                              Click="@CloseReopenPopup"
                              Enabled="@(!IsReopening)" />
                    <DxButton RenderStyle="ButtonRenderStyle.Primary"
                              Text="REOPEN &amp; EDIT"
                              Click="@ReopenForEditAsync"
                              Enabled="@(!IsReopening)" />
                </div>
            </FooterContentTemplate>
        </DxPopup>

        <DxPopup HeaderText="Delete Draft Work Order"
                 CloseOnOutsideClick="false"
                 Width="560px"
                 CssClass="common-popup"
                 ShowFooter="true"
                 @bind-Visible="@DeleteConfirmVisible">
            <Content>
                @if (DeleteTarget is not null)
                {
                    <div class="iv-popup-body">
                        <p class="iv-confirm__copy">
                            Delete @DeleteTarget.WorkOrderNo? This permanently removes this never-executed Draft and its planning snapshot.
                            Use Cancel Draft instead when the Work Order is a valid business record that should remain in history.
                        </p>
                        <dl class="iv-confirm__meta">
                            <div><dt>Work Order</dt><dd class="code-style">@DeleteTarget.WorkOrderNo</dd></div>
                            <div><dt>Product</dt><dd>@DeleteTarget.ProductCode · @DeleteTarget.ProductDescription</dd></div>
                            <div><dt>Current status</dt><dd>@DeleteTarget.Status</dd></div>
                            <div><dt>Planned Qty</dt><dd>@DeleteTarget.PlannedQty.ToString("n4") @DeleteTarget.OutputUom</dd></div>
                        </dl>
                    </div>
                }
            </Content>
            <FooterContentTemplate>
                <div class="d-flex gap-2 justify-content-end w-100">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="KEEP DRAFT"
                              Click="@CloseDeletePopup"
                              Enabled="@(!IsDeleting)" />
                    <DxButton RenderStyle="ButtonRenderStyle.Danger"
                              Text="DELETE DRAFT"
                              Click="@ConfirmDeleteAsync"
                              Enabled="@(!IsDeleting && DeleteTarget is not null)" />
                </div>
            </FooterContentTemplate>
        </DxPopup>
    </div>
</MenuAuthorize>

