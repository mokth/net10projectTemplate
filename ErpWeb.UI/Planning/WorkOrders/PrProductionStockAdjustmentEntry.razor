@page "/planning/stock-adjustments/new"
@page "/planning/stock-adjustments/{Id:int}/edit"
@page "/planning/stock-adjustments/{Id:int}/view"
@using Microsoft.AspNetCore.Components.Routing
@using ErpWeb.Core.Inventory
@using ErpWeb.Core.Production
@using ErpWeb.Model.Entities.Inventory
@using ErpWeb.Model.Entities.Production
@using ErpWeb.UI.Planning.Lookups
@inherits PageBase

<PageTitle>@Heading</PageTitle>
<NavigationLock ConfirmExternalNavigation="Dirty" OnBeforeInternalNavigation="BeforeNavigate" />
<MenuAuthorize MenuCode="@MenuCodes.PlanningStockAdjustment">
    <div class="iv-page pr-stock-page">
        @if (!string.IsNullOrWhiteSpace(StatusMessage)) { <div class="iv-toast iv-toast--ok" role="status">@StatusMessage</div> }
        @if (!string.IsNullOrWhiteSpace(ErrorMessage)) { <div class="iv-toast iv-toast--err" role="alert">@ErrorMessage</div> }

        <header class="iv-hero">
            <div class="iv-hero__mark" aria-hidden="true"><i class="fa-solid fa-scale-balanced"></i></div>
            <div class="iv-hero__copy"><p class="iv-eyebrow">Planning · Production</p><h1 class="iv-title">@Heading</h1>
                <div class="iv-chips"><span class="iv-chip">@Document.Status</span>@if (Document.Id > 0) { <span class="iv-chip code-style">PADJ @Document.BatchNo</span> }</div>
            </div>
        </header>

        <section class="iv-card pr-stock-commandbar">
            <div class="pr-stock-commandbar__left">
                <DxButton Text="BACK" RenderStyle="ButtonRenderStyle.Secondary" Click="BackAsync" />
                @if (CanChangeWorkOrder) { <DxButton Text="CHANGE WORK ORDER" RenderStyle="ButtonRenderStyle.Secondary" Click="RequestChangeWorkOrder" Enabled="@(!Busy)" /> }
            </div>
            <div class="pr-stock-commandbar__right">
                @if (CanEditDraft) { <DxButton Text="EDIT DRAFT" RenderStyle="ButtonRenderStyle.Secondary" Click="EditDraft" /> }
                @if (CanSave) { <DxButton Text="SAVE DRAFT" IconCssClass="fa-solid fa-floppy-disk" RenderStyle="ButtonRenderStyle.Primary" Click="SaveAsync" Enabled="@(!Busy)" /> }
                @if (ShowPost) { <DxButton Text="POST" IconCssClass="fa-solid fa-check" RenderStyle="ButtonRenderStyle.Success" Click="BeginPost" Enabled="@(!Busy)" /> }
                @if (CanRollback) { <DxButton Text="ROLLBACK" IconCssClass="fa-solid fa-rotate-left" RenderStyle="ButtonRenderStyle.Warning" Click="BeginRollback" Enabled="@(!Busy)" /> }
                @if (CanDelete) { <DxButton Text="DELETE" IconCssClass="fa-solid fa-trash" RenderStyle="ButtonRenderStyle.Danger" Click="BeginDelete" Enabled="@(!Busy)" /> }
                @if (CanCorrection) { <DxButton Text="CREATE CORRECTION" RenderStyle="ButtonRenderStyle.Secondary" Click="CreateCorrectionAsync" Enabled="@(!Busy)" /> }
            </div>
        </section>

        @if (BusyLoading)
        {
            <section class="iv-card" aria-busy="true"><div class="iv-skeleton"><div class="iv-skeleton__line iv-skeleton__line--lg"></div><div class="iv-skeleton__line"></div></div></section>
        }
        else if (CanEditFields && Document.WorkOrderId == 0)
        {
            <section class="iv-card">
                <div class="pr-stock-section-head"><div><p class="iv-eyebrow">Phase 1</p><strong>Select Work Order</strong><small>Choose a RELEASED or IN_PROGRESS Work Order. The lookup shows Work Orders with candidate Production stock.</small></div></div>
                <div class="pr-stock-lookup"><label class="form-label">Work Order</label>
                    <PrProductionStockWorkOrderPicker WorkOrderNo="@Document.WorkOrderNo" ResolveAsync="@ResolveWorkOrderAsync" SearchAsync="@SearchWorkOrdersAsync" Selected="@OnWorkOrderSelectedAsync" Cleared="@OnWorkOrderClearedAsync" Enabled="@(!Busy)" />
                </div>
            </section>
        }
        else if (!CanEditFields && Document.Id == 0)
        {
            <section class="iv-card"><p class="mb-0" role="alert">You do not have permission to create a Production Stock Adjustment.</p></section>
        }

        @if (Document.WorkOrderId > 0 && !BusyLoading)
        {
            @if (IsView)
            {
                <section class="iv-card">
                    <div class="pr-stock-section-head"><div><p class="iv-eyebrow">Document facts</p><strong>Saved Production adjustment</strong></div></div>
                    <div class="pr-stock-meta">
                        <div class="pr-stock-meta__item"><span>Work Order</span><strong>@Document.WorkOrderNo</strong></div>
                        <div class="pr-stock-meta__item"><span>Product</span><strong>@Document.ProductCode — @Document.ProductDescription</strong></div>
                        <div class="pr-stock-meta__item"><span>Current WO status</span><strong>@Document.WorkOrderStatus</strong></div>
                        <div class="pr-stock-meta__item"><span>Snapshot</span><strong>@Document.SnapshotRevision</strong></div>
                        <div class="pr-stock-meta__item"><span>Document Date</span><strong>@Document.EffectiveDate.ToString("dd MMM yyyy")</strong></div>
                        <div class="pr-stock-meta__item"><span>Reference</span><strong>@(string.IsNullOrWhiteSpace(Document.RefNo) ? "—" : Document.RefNo)</strong></div>
                        <div class="pr-stock-meta__item"><span>Status</span><strong>@Document.Status · Revision @Document.Revision</strong></div>
                        <div class="pr-stock-meta__item"><span>Posting ID</span><strong>@(Document.PostingId?.ToString() ?? "—")</strong></div>
                        <div class="pr-stock-meta__item"><span>Reversal ID</span><strong>@(Document.ReversalPostingId?.ToString() ?? "—")</strong></div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Document.Remarks)) { <p class="pr-stock-view-remarks"><strong>Remarks:</strong> @Document.Remarks</p> }
                </section>
            }
            else
            {
                <section class="iv-card">
                    <div class="pr-stock-section-head"><div><p class="iv-eyebrow">Locked Work Order context</p><strong>@Document.WorkOrderNo</strong></div></div>
                    <div class="pr-stock-meta">
                        <div class="pr-stock-meta__item"><span>Product</span><strong>@Document.ProductCode — @Document.ProductDescription</strong></div>
                        <div class="pr-stock-meta__item"><span>Current WO status</span><strong>@Document.WorkOrderStatus</strong></div>
                        <div class="pr-stock-meta__item"><span>Snapshot</span><strong>@Document.SnapshotRevision</strong></div>
                    </div>
                    <DxFormLayout CssClass="pr-stock-form" SizeMode="SizeMode.Small">
                        <DxFormLayoutItem Caption="Effective Date" ColSpanMd="3"><Template><DxDateEdit @bind-Date="Document.EffectiveDate" Enabled="@CanEditFields" CssClass="pr-stock-date" /></Template></DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Reference" ColSpanMd="4"><Template><DxTextBox @bind-Text="Document.RefNo" Enabled="@CanEditFields" maxlength="30" CssClass="pr-stock-reference" /></Template></DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Remarks" ColSpanMd="5"><Template><DxMemo @bind-Text="Document.Remarks" Rows="2" Enabled="@CanEditFields" maxlength="200" /></Template></DxFormLayoutItem>
                    </DxFormLayout>
                </section>
            }

            <section class="iv-card pr-stock-lines">
                <div class="pr-stock-section-head"><div><p class="iv-eyebrow">Lines</p><strong>@(IsView ? "Historical Production adjustments" : "Adjustment workspace")</strong>
                    @if (!IsView) { <small>Selected @Editors.Count / 100 · Enter a positive quantity and choose ADD or REDUCE. Save and POST revalidate the pool.</small> }
                </div>
                @if (CanEditFields) { <DxButton Text="ADD POOL" IconCssClass="fa-solid fa-plus" RenderStyle="ButtonRenderStyle.Primary" Click="@(() => SourcePickerVisible = true)" Enabled="@(!Busy && CanAddMoreSources)" /> }
                </div>

                @if (IsView)
                {
                    <DxGrid Data="@Document.Lines" PageSize="20" TextWrapEnabled="false" ColumnResizeMode="GridColumnResizeMode.ColumnsContainer" CssClass="pr-stock-grid">
                        <Columns>
                            <DxGridDataColumn Caption="ITEM / POOL / LOT" Width="230px" MinWidth="190"><CellDisplayTemplate>@{var line=(ProductionStockAdjustmentLineDto)context.DataItem;}<strong>@line.ItemCode · @line.PoolKind</strong><div class="text-muted">@line.LotNo</div></CellDisplayTemplate></DxGridDataColumn>
                            <DxGridDataColumn Caption="SIGNED ADJUSTMENT" Width="165px"><CellDisplayTemplate>@{var line=(ProductionStockAdjustmentLineDto)context.DataItem;}@line.AdjustmentQty.ToString("+0.0000;-0.0000") @line.SourceUom</CellDisplayTemplate></DxGridDataColumn>
                            <DxGridDataColumn FieldName="@nameof(ProductionStockAdjustmentLineDto.Reason)" Caption="REASON" Width="145px" />
                            @if (Document.CanViewCost)
                            {
                                <DxGridDataColumn FieldName="@nameof(ProductionStockAdjustmentLineDto.CostBasisCode)" Caption="COST BASIS" Width="220px" />
                                <DxGridDataColumn FieldName="@nameof(ProductionStockAdjustmentLineDto.TotalValue)" Caption="HISTORICAL VALUE" DisplayFormat="n6" TextAlignment="GridTextAlignment.Right" Width="160px" />
                            }
                        </Columns>
                    </DxGrid>
                }
                else
                {
                    @if (Editors.Count == 0) { <div class="pr-stock-empty">No Production pool lines selected. Choose <strong>ADD POOL</strong> to find candidate pools.</div> }
                    else
                    {
                        <DxGrid Data="@Editors" PageSize="20" TextWrapEnabled="false" ColumnResizeMode="GridColumnResizeMode.ColumnsContainer" CssClass="pr-stock-grid">
                            <Columns>
                                <DxGridDataColumn Caption="ITEM / POOL / LOT" Width="190px" MinWidth="165"><CellDisplayTemplate>@{var row=(AdjustmentEditor)context.DataItem;}<strong>@row.Source.ItemCode · @row.Source.PoolKind</strong><div class="text-muted">@row.Source.Description · @row.Source.LotNo</div></CellDisplayTemplate></DxGridDataColumn>
                                <DxGridDataColumn Caption="CURRENT QTY" Width="135px"><CellDisplayTemplate>@{var row=(AdjustmentEditor)context.DataItem;}@row.Source.Qty.ToString("n4") @row.Source.Uom</CellDisplayTemplate></DxGridDataColumn>
                                <DxGridDataColumn Caption="DIRECTION" Width="130px"><CellDisplayTemplate>@{var row=(AdjustmentEditor)context.DataItem;}<DxComboBox Data="@DirectionOptions" TData="string" TValue="string" Value="@row.Direction" ValueChanged="@(value => SetDirection(row, value))" ValueExpression="@(() => row.Direction)" Enabled="@CanEditFields" /></CellDisplayTemplate></DxGridDataColumn>
                                <DxGridDataColumn Caption="QTY" Width="125px"><CellDisplayTemplate>@{var row=(AdjustmentEditor)context.DataItem;}<DxSpinEdit @bind-Value="row.InputQty" MinValue="0m" Increment="0.0001m" DisplayFormat="n4" Enabled="@CanEditFields" CssClass="pr-stock-qty" /></CellDisplayTemplate></DxGridDataColumn>
                                <DxGridDataColumn Caption="PROJECTED NEW QTY" Width="165px"><CellDisplayTemplate>@{var row=(AdjustmentEditor)context.DataItem;var projected=ProjectedQty(row);}<span class="@(projected < 0m ? "pr-stock-negative" : "")">@projected.ToString("n4") @row.Source.Uom</span><small class="d-block text-muted">Projected only</small></CellDisplayTemplate></DxGridDataColumn>
                                <DxGridDataColumn Caption="REASON" Width="150px"><CellDisplayTemplate>@{var row=(AdjustmentEditor)context.DataItem;}<DxComboBox Data="@ReasonOptions" TData="string" TValue="string" @bind-Value="row.Reason" Enabled="@CanEditFields" /></CellDisplayTemplate></DxGridDataColumn>
                                <DxGridDataColumn Caption="COST STATUS" Width="260px" MinWidth="225"><CellDisplayTemplate>@{var row=(AdjustmentEditor)context.DataItem;}<span>@CostStatus(row)</span>@if(row.Direction=="ADD"&&row.Source.PoolKind==ProductionBalLotKinds.Wip&&row.Source.BaseQty==0m&&row.CostEvidenceType is null){<small class="d-block text-muted">If no effective Standard Cost exists, POST will require an approved override.</small>}@if(CanSetCostOverride(row)){<DxButton Text="@(row.CostEvidenceType is null ? "SET COST OVERRIDE" : "EDIT COST OVERRIDE")" RenderStyle="ButtonRenderStyle.Secondary" CssClass="pr-stock-cost-button" Click="@(() => OpenCostOverride(row))" />}</CellDisplayTemplate></DxGridDataColumn>
                                <DxGridDataColumn Caption="REMARKS" Width="170px"><CellDisplayTemplate>@{var row=(AdjustmentEditor)context.DataItem;}<DxTextBox @bind-Text="row.Remarks" maxlength="250" Enabled="@CanEditFields" /></CellDisplayTemplate></DxGridDataColumn>
                                <DxGridDataColumn Caption="" Width="90px"><CellDisplayTemplate>@{var row=(AdjustmentEditor)context.DataItem;}<DxButton Text="REMOVE" RenderStyle="ButtonRenderStyle.Danger" Click="@(() => RemoveEditor(row))" Enabled="@CanEditFields" /></CellDisplayTemplate></DxGridDataColumn>
                            </Columns>
                        </DxGrid>
                    }
                    @if (Editors.Count >= 100) { <p class="pr-stock-limit" role="status">Maximum 100 lines reached.</p> }
                    <div class="pr-stock-readiness" role="@(GetUiIssues().Count == 0 ? "status" : "alert")">
                        @if (GetUiIssues().Count == 0) { <strong>Ready to save</strong><span>@Editors.Count line(s) selected.</span> }
                        else { <strong>Action required</strong><ul>@foreach (var issue in GetUiIssues()) { <li>@issue</li> }</ul> }
                    </div>
                    @if (Document.ReadinessErrors.Count > 0) { <div class="pr-stock-domain-readiness" role="alert"><strong>Server readiness</strong><ul>@foreach (var error in Document.ReadinessErrors) { <li>@error</li> }</ul></div> }
                }
            </section>
        }

        <DxPopup HeaderText="Add Production Stock Adjustment Pools" CloseOnOutsideClick="false" Width="90vw" CssClass="common-popup pr-popup-grid-dialog" @bind-Visible="SourcePickerVisible">
            <Content>
                <div class="d-flex gap-2 mb-2 align-items-end"><div class="flex-grow-1"><label class="form-label mb-0">Search source pools</label>
                    <DxTextBox Text="@SourceSearch" TextChanged="OnSourceSearchChanged" BindValueMode="BindValueMode.OnInput" NullText="Item / description / lot" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </div></div>
                <div class="pr-popup-grid-shell" aria-busy="@SourceLoading">
                    @if (SourceLoading) { <div class="iv-skeleton p-3"><div class="iv-skeleton__line iv-skeleton__line--lg"></div><div class="iv-skeleton__line"></div></div> }
                    else if (Sources.Count == 0) { <p class="text-muted p-3 mb-0">@(string.IsNullOrWhiteSpace(SourceSearch) ? "No candidate Production stock was found for this Work Order. Choose another Work Order." : "No Production stock matches the current search. Clear the search to show all source pools.")</p> }
                    else
                    {
                        <DxGrid Data="@Sources" PageSize="20" TextWrapEnabled="false" ColumnResizeMode="GridColumnResizeMode.ColumnsContainer" CssClass="pr-popup-grid">
                            <Columns>
                                <DxGridDataColumn Caption="ITEM / DESCRIPTION" Width="230px" MinWidth="195"><CellDisplayTemplate>@{var source=(ProductionStockAdjustmentSource)context.DataItem;}<strong>@source.ItemCode</strong><div class="text-muted">@source.Description</div></CellDisplayTemplate></DxGridDataColumn>
                                <DxGridDataColumn FieldName="@nameof(ProductionStockAdjustmentSource.PoolKind)" Caption="POOL" Width="120px" />
                                <DxGridDataColumn FieldName="@nameof(ProductionStockAdjustmentSource.LotNo)" Caption="LOT" Width="125px" />
                                <DxGridDataColumn Caption="CURRENT QTY" Width="145px"><CellDisplayTemplate>@{var source=(ProductionStockAdjustmentSource)context.DataItem;}@source.Qty.ToString("n4") @source.Uom</CellDisplayTemplate></DxGridDataColumn>
                                <DxGridDataColumn FieldName="@nameof(ProductionStockAdjustmentSource.Uom)" Caption="UOM" Width="75px" />
                                <DxGridDataColumn FieldName="@nameof(ProductionStockAdjustmentSource.Readiness)" Caption="READINESS" Width="300px" MinWidth="230" />
                                <DxGridDataColumn Caption="ACTION" Width="110px"><CellDisplayTemplate>@{var source=(ProductionStockAdjustmentSource)context.DataItem;var added=IsSourceAdded(source.ProductionBalLotId);}<DxButton Text="@(added ? "ADDED" : "ADD")" RenderStyle="@(added ? ButtonRenderStyle.Secondary : ButtonRenderStyle.Primary)" Click="@(() => AddSource(source))" Enabled="@(!added && source.Readiness=="READY" && CanAddMoreSources && !Busy)" /></CellDisplayTemplate></DxGridDataColumn>
                            </Columns>
                        </DxGrid>
                    }
                </div>
                <div class="d-flex justify-content-between align-items-center mt-2"><span class="text-muted small">@SourcePageLabel</span><div class="d-flex gap-2">
                    <DxButton Text="PREV" RenderStyle="ButtonRenderStyle.Secondary" Enabled="@(SourcePage > 0 && !SourceLoading)" Click="PreviousSourcePageAsync" />
                    <DxButton Text="NEXT" RenderStyle="ButtonRenderStyle.Secondary" Enabled="@(SourcePage + 1 < SourceTotalPages && !SourceLoading)" Click="NextSourcePageAsync" />
                </div></div>
                @if (Editors.Count >= 100) { <p class="pr-stock-limit mb-0 mt-2">Maximum 100 lines reached.</p> }
                <div class="iv-popup-footer"><div class="iv-popup-footer__actions"><DxButton Text="DONE" RenderStyle="ButtonRenderStyle.Primary" Click="@(() => SourcePickerVisible = false)" /></div></div>
            </Content>
        </DxPopup>

        <DxPopup HeaderText="Change Work Order?" CloseOnOutsideClick="false" Width="min(480px,95vw)" CssClass="common-popup" @bind-Visible="ChangeWorkOrderConfirmVisible"><Content><p class="iv-confirm__copy">Selected lines and unsaved entry details will be cleared.</p><div class="iv-popup-footer"><div class="iv-popup-footer__actions"><DxButton Text="CANCEL" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => ChangeWorkOrderConfirmVisible = false)" /><DxButton Text="CHANGE WORK ORDER" RenderStyle="ButtonRenderStyle.Warning" Click="ConfirmChangeWorkOrder" /></div></div></Content></DxPopup>
        <DxPopup HeaderText="Post Production Stock Adjustment?" CloseOnOutsideClick="false" Width="min(520px,95vw)" CssClass="common-popup" @bind-Visible="PostConfirmVisible"><Content><p class="iv-confirm__copy">Post PADJ @Document.BatchNo?<br />@Document.Lines.Count Production stock corrections will be posted. No Inventory quantity movement will be created by PADJ.</p><div class="iv-popup-footer"><div class="iv-popup-footer__actions"><DxButton Text="CANCEL" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => PostConfirmVisible = false)" /><DxButton Text="POST" RenderStyle="ButtonRenderStyle.Success" Click="ConfirmPostAsync" Enabled="@(!Busy)" /></div></div></Content></DxPopup>
        <DxPopup HeaderText="Delete NEW Production Stock Adjustment?" CloseOnOutsideClick="false" Width="min(480px,95vw)" CssClass="common-popup" @bind-Visible="DeleteConfirmVisible"><Content><p class="iv-confirm__copy">This permanently removes the saved NEW draft. No stock movement has been posted.</p><div class="iv-popup-footer"><div class="iv-popup-footer__actions"><DxButton Text="CANCEL" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => DeleteConfirmVisible = false)" /><DxButton Text="DELETE" RenderStyle="ButtonRenderStyle.Danger" Click="ConfirmDeleteAsync" Enabled="@(!Busy)" /></div></div></Content></DxPopup>
        <DxPopup HeaderText="Rollback Production Stock Adjustment" CloseOnOutsideClick="false" Width="min(520px,95vw)" CssClass="common-popup" @bind-Visible="RollbackVisible"><Content><div class="common-popup__body"><p>This appends inverse Production balance and material facts. No Inventory stock is changed.</p><DxMemo @bind-Text="RollbackReason" Rows="3" maxlength="250" NullText="Rollback reason (required)" /></div><div class="iv-popup-footer"><div class="iv-popup-footer__actions"><DxButton Text="CANCEL" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => RollbackVisible = false)" /><DxButton Text="ROLLBACK" RenderStyle="ButtonRenderStyle.Warning" Click="RollbackAsync" Enabled="@(!Busy && !string.IsNullOrWhiteSpace(RollbackReason))" /></div></div></Content></DxPopup>

        <DxPopup HeaderText="PADJ Cost Override" CloseOnOutsideClick="false" Width="min(560px,95vw)" CssClass="common-popup" @bind-Visible="CostOverrideVisible"><Content>
            <div class="common-popup__body">
                <p class="text-muted">Cost override is available only for ADD to an empty WIP pool. The Production posting service remains the final costing authority.</p>
                @if (!string.IsNullOrWhiteSpace(CostPopupError)) { <div class="alert alert-warning py-2" role="alert">@CostPopupError</div> }
                <DxFormLayout SizeMode="SizeMode.Small">
                    <DxFormLayoutItem Caption="Cost evidence" ColSpanMd="12"><Template><DxComboBox Data="@CostEvidenceOptions" TData="string" TValue="string" @bind-Value="_costEvidenceDraft" NullText="Select cost evidence" /></Template></DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Proposed unit cost" ColSpanMd="6"><Template><DxSpinEdit @bind-Value="_proposedUnitCostDraft" MinValue="0m" Increment="0.000001m" DisplayFormat="n6" Enabled="@(_costEvidenceDraft == InventoryCostEvidenceTypes.ManualApproved)" /></Template></DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Approval reason" ColSpanMd="6"><Template><DxTextBox @bind-Text="_costOverrideReasonDraft" maxlength="250" /></Template></DxFormLayoutItem>
                </DxFormLayout>
            </div>
            <div class="iv-popup-footer"><div class="iv-popup-footer__actions"><DxButton Text="CANCEL" RenderStyle="ButtonRenderStyle.Secondary" Click="CancelCostOverride" /><DxButton Text="APPLY" RenderStyle="ButtonRenderStyle.Primary" Click="ApplyCostOverride" /></div></div>
        </Content></DxPopup>
    </div>
</MenuAuthorize>
