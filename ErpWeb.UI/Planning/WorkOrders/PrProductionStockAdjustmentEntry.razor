@page "/planning/stock-adjustments/new"
@page "/planning/stock-adjustments/{Id:int}/edit"
@page "/planning/stock-adjustments/{Id:int}/view"
@using Microsoft.AspNetCore.Components.Routing
@inherits PageBase

<PageTitle>@Heading</PageTitle>
<NavigationLock ConfirmExternalNavigation="Dirty" OnBeforeInternalNavigation="BeforeNavigate" />
<MenuAuthorize MenuCode="@MenuCodes.PlanningStockAdjustment">
 <div class="iv-page pr-dp-page">
  @if(!string.IsNullOrWhiteSpace(StatusMessage)){<div class="iv-toast iv-toast--ok" role="status">@StatusMessage</div>}
  @if(!string.IsNullOrWhiteSpace(ErrorMessage)){<div class="iv-toast iv-toast--err" role="alert">@ErrorMessage</div>}
  <header class="iv-hero"><div class="iv-hero__mark" aria-hidden="true"><i class="fa-solid fa-scale-balanced"></i></div><div class="iv-hero__copy"><p class="iv-eyebrow">Planning · Production</p><h1 class="iv-title">@Heading</h1><div class="iv-chips"><span class="iv-chip">@Document.Status</span>@if(Document.Id>0){<span class="iv-chip code-style">PADJ @Document.BatchNo</span>}</div></div></header>
  <section class="iv-card pr-stock-command"><DxButton Text="BACK" RenderStyle="ButtonRenderStyle.Secondary" Click="BackAsync" /><span class="pr-stock-command__spacer"></span>
   @if(CanSave){<DxButton Text="SAVE DRAFT" IconCssClass="fa-solid fa-floppy-disk" RenderStyle="ButtonRenderStyle.Primary" Click="SaveAsync" Enabled="@(!Busy)" />}
   @if(CanPost){<DxButton Text="POST" IconCssClass="fa-solid fa-check" RenderStyle="ButtonRenderStyle.Success" Click="PostAsync" Enabled="@(!Busy&&!Dirty)" />}
   @if(CanRollback){<DxButton Text="ROLLBACK" IconCssClass="fa-solid fa-rotate-left" RenderStyle="ButtonRenderStyle.Warning" Click="@(()=>RollbackVisible=true)" Enabled="@(!Busy)" />}
   @if(CanDelete){<DxButton Text="DELETE" RenderStyle="ButtonRenderStyle.Danger" Click="DeleteAsync" Enabled="@(!Busy)" />}
   @if(CanCorrection){<DxButton Text="CREATE CORRECTION" RenderStyle="ButtonRenderStyle.Secondary" Click="CreateCorrectionAsync" Enabled="@(!Busy)" />}
   @if(CanEditDraft){<DxButton Text="EDIT DRAFT" RenderStyle="ButtonRenderStyle.Secondary" Click="EditDraft" />}
  </section>
  @if(BusyLoading){<section class="iv-card" aria-busy="true"><div class="iv-skeleton"><div class="iv-skeleton__line iv-skeleton__line--lg"></div><div class="iv-skeleton__line"></div></div></section>}
  else if(!IsView&&CanEditFields&&WorkOrder is null){<section class="iv-card"><div class="pr-dp-section-head"><div><p class="iv-eyebrow">Phase 1</p><strong>Select Work Order</strong><small>Choose a RELEASED or IN_PROGRESS Work Order to adjust its existing MATERIAL_IN or WIP pools.</small></div></div><div class="pr-stock-toolbar"><DxTextBox @bind-Text="WorkOrderInput" NullText="Work Order number" CssClass="w-100" /><DxButton Text="LOAD WORK ORDER" RenderStyle="ButtonRenderStyle.Primary" Click="LoadWorkOrderAsync" Enabled="@(!Busy)" /></div></section>}
  else if(!IsView&&CanEditFields&&WorkOrder is not null){<section class="iv-card"><div class="pr-dp-section-head"><div><p class="iv-eyebrow">Locked Work Order context</p><strong class="code-style">@WorkOrder.WorkOrderNo · @WorkOrder.ProductCode</strong><small>@WorkOrder.Status · Snapshot @Document.SnapshotRevision</small></div><DxButton Text="CHANGE WORK ORDER" RenderStyle="ButtonRenderStyle.Secondary" Click="ChangeWorkOrder" Enabled="@(Document.Id==0&&!Busy)" /></div><div class="pr-stock-toolbar"><DxTextBox @bind-Text="SourceSearch" NullText="Search item or Production lot" CssClass="w-100" /><DxButton Text="FIND POOLS" RenderStyle="ButtonRenderStyle.Secondary" Click="SearchPoolsAsync" Enabled="@(!Busy)" /></div>
   @if(Sources.Count>0){<DxGrid Data="@Sources" PageSize="10" TextWrapEnabled="false" ColumnResizeMode="GridColumnResizeMode.ColumnsContainer" CssClass="pr-dp-grid"><Columns><DxGridDataColumn FieldName="@nameof(ProductionStockAdjustmentSource.ItemCode)" Caption="Item" Width="170px" MinWidth="150" /><DxGridDataColumn FieldName="@nameof(ProductionStockAdjustmentSource.PoolKind)" Caption="Pool" Width="120px" /><DxGridDataColumn FieldName="@nameof(ProductionStockAdjustmentSource.LotNo)" Caption="Lot" Width="130px" /><DxGridDataColumn Caption="Current quantity" Width="170px"><CellDisplayTemplate>@{var s=(ProductionStockAdjustmentSource)context.DataItem;}@s.Qty.ToString("n4") @s.Uom</CellDisplayTemplate></DxGridDataColumn><DxGridDataColumn Caption="Readiness" Width="300px"><CellDisplayTemplate>@(((ProductionStockAdjustmentSource)context.DataItem).Readiness)</CellDisplayTemplate></DxGridDataColumn><DxGridDataColumn Caption="Action" Width="100px"><CellDisplayTemplate>@{var s=(ProductionStockAdjustmentSource)context.DataItem;}<DxButton Text="ADD" RenderStyle="ButtonRenderStyle.Primary" Click="@(()=>AddSource(s))" Enabled="@(s.Readiness=="READY"&&Editors.All(x=>x.Source.ProductionBalLotId!=s.ProductionBalLotId))" /></CellDisplayTemplate></DxGridDataColumn></Columns></DxGrid>}
  </section>}
  @if(IsView||CanEditFields&&WorkOrder is not null){<section class="iv-card"><div class="pr-dp-section-head"><div><p class="iv-eyebrow">Document</p><strong>@(IsView?"Saved adjustment facts":"Adjustment workspace")</strong><small>Signed quantities are in the Production pool UOM. Positive adds; negative removes.</small></div></div>
   <DxFormLayout CssClass="pr-stock-form"><DxFormLayoutItem Caption="Work Order" ColSpanMd="4"><DxTextBox Text="@Document.WorkOrderNo" ReadOnly="true" /></DxFormLayoutItem><DxFormLayoutItem Caption="Effective date" ColSpanMd="4"><DxDateEdit @bind-Date="Document.EffectiveDate" Enabled="@CanEditFields" /></DxFormLayoutItem><DxFormLayoutItem Caption="Reference" ColSpanMd="4"><DxTextBox @bind-Text="Document.RefNo" Enabled="@CanEditFields" /></DxFormLayoutItem><DxFormLayoutItem Caption="Remarks" ColSpanMd="12"><DxMemo @bind-Text="Document.Remarks" Rows="2" Enabled="@CanEditFields" /></DxFormLayoutItem></DxFormLayout>
   @if(IsView){<DxGrid Data="@Document.Lines" PageSize="20" TextWrapEnabled="false" ColumnResizeMode="GridColumnResizeMode.ColumnsContainer" CssClass="pr-dp-grid"><Columns><DxGridDataColumn FieldName="@nameof(ProductionStockAdjustmentLineDto.ItemCode)" Caption="Item" Width="170px" /><DxGridDataColumn FieldName="@nameof(ProductionStockAdjustmentLineDto.PoolKind)" Caption="Pool" Width="120px" /><DxGridDataColumn FieldName="@nameof(ProductionStockAdjustmentLineDto.LotNo)" Caption="Lot" Width="130px" /><DxGridDataColumn FieldName="@nameof(ProductionStockAdjustmentLineDto.AdjustmentQty)" Caption="Signed qty" DisplayFormat="+0.0000;-0.0000" TextAlignment="GridTextAlignment.Right" Width="150px" /><DxGridDataColumn FieldName="@nameof(ProductionStockAdjustmentLineDto.BaseUom)" Caption="Base UOM" Width="100px" /><DxGridDataColumn FieldName="@nameof(ProductionStockAdjustmentLineDto.Reason)" Caption="Reason" Width="150px" /><DxGridDataColumn FieldName="@nameof(ProductionStockAdjustmentLineDto.CostBasisCode)" Caption="Cost basis" Width="210px" /><DxGridDataColumn FieldName="@nameof(ProductionStockAdjustmentLineDto.TotalValue)" Caption="Historical value" DisplayFormat="n6" TextAlignment="GridTextAlignment.Right" Width="150px" /></Columns></DxGrid>}
   else{<DxGrid Data="@Editors" PageSize="20" TextWrapEnabled="false" ColumnResizeMode="GridColumnResizeMode.ColumnsContainer" CssClass="pr-dp-grid"><Columns>
    <DxGridDataColumn Caption="Item / pool" Width="210px"><CellDisplayTemplate>@{var e=(AdjustmentEditor)context.DataItem;}<strong>@e.Source.ItemCode</strong><div class="text-muted">@e.Source.PoolKind · @e.Source.LotNo</div></CellDisplayTemplate></DxGridDataColumn>
    <DxGridDataColumn Caption="Current qty" Width="140px"><CellDisplayTemplate>@{var e=(AdjustmentEditor)context.DataItem;}@e.Source.Qty.ToString("n4") @e.Source.Uom</CellDisplayTemplate></DxGridDataColumn>
    <DxGridDataColumn Caption="Signed adjustment" Width="170px"><CellDisplayTemplate>@{var e=(AdjustmentEditor)context.DataItem;}<DxSpinEdit @bind-Value="e.AdjustmentQty" MinValue="-100000000m" MaxValue="100000000m" Increment="0.0001m" DisplayFormat="+0.0000;-0.0000" Enabled="@CanEditFields" /></CellDisplayTemplate></DxGridDataColumn>
    <DxGridDataColumn Caption="Reason" Width="170px"><CellDisplayTemplate>@{var e=(AdjustmentEditor)context.DataItem;}<DxComboBox Data="@ReasonOptions" @bind-Value="e.Reason" Enabled="@CanEditFields" /></CellDisplayTemplate></DxGridDataColumn>
    <DxGridDataColumn Caption="Cost evidence" Width="190px"><CellDisplayTemplate>@{var e=(AdjustmentEditor)context.DataItem;}<DxComboBox Data="@CostEvidenceOptions" @bind-Value="e.CostEvidenceType" NullText="Automatic" Enabled="@(CanEditFields&&CanPriceOverride)" /></CellDisplayTemplate></DxGridDataColumn>
    <DxGridDataColumn Caption="Proposed unit cost" Width="170px"><CellDisplayTemplate>@{var e=(AdjustmentEditor)context.DataItem;}<DxSpinEdit @bind-Value="e.ProposedUnitCost" MinValue="0m" Increment="0.000001m" DisplayFormat="n6" Enabled="@(CanEditFields&&CanPriceOverride)" /></CellDisplayTemplate></DxGridDataColumn>
    <DxGridDataColumn Caption="Approval reason" Width="210px"><CellDisplayTemplate>@{var e=(AdjustmentEditor)context.DataItem;}<DxTextBox @bind-Text="e.CostOverrideReason" Enabled="@(CanEditFields&&CanPriceOverride)" /></CellDisplayTemplate></DxGridDataColumn>
    <DxGridDataColumn Caption="Remarks" Width="180px"><CellDisplayTemplate>@{var e=(AdjustmentEditor)context.DataItem;}<DxTextBox @bind-Text="e.Remarks" Enabled="@CanEditFields" /></CellDisplayTemplate></DxGridDataColumn>
    <DxGridDataColumn Caption="" Width="80px"><CellDisplayTemplate>@{var e=(AdjustmentEditor)context.DataItem;}<DxButton Text="REMOVE" RenderStyle="ButtonRenderStyle.Danger" Click="@(()=>Editors.Remove(e))" Enabled="@CanEditFields" /></CellDisplayTemplate></DxGridDataColumn>
   </Columns></DxGrid>}
   @if(CanEditFields&&CanPriceOverride){<p class="pr-stock-note">Manual and zero cost approval is available only for a positive adjustment into an empty WIP pool. Saving requires Price Override permission.</p>}
   @if(Document.ReadinessErrors.Count>0){<ul class="pr-stock-readiness">@foreach(var error in Document.ReadinessErrors){<li>@error</li>}</ul>}
  </section>}
  @if(RollbackVisible){<DxPopup Visible="true" VisibleChanged="@(v=>RollbackVisible=v)" HeaderText="Rollback Production Stock Adjustment" Width="min(520px,95vw)" CloseOnOutsideClick="false"><BodyContentTemplate><div class="common-popup__body"><p>This appends inverse Production balance and material facts. No Inventory stock is changed.</p><DxMemo @bind-Text="RollbackReason" Rows="3" NullText="Rollback reason (required)" /></div></BodyContentTemplate><FooterContentTemplate><div class="common-popup__footer"><DxButton Text="CANCEL" RenderStyle="ButtonRenderStyle.Secondary" Click="@(()=>RollbackVisible=false)" /><DxButton Text="ROLLBACK" RenderStyle="ButtonRenderStyle.Warning" Click="RollbackAsync" Enabled="@(!Busy)" /></div></FooterContentTemplate></DxPopup>}
 </div>
</MenuAuthorize>
