@page "/planning/stock-returns/new"
@page "/planning/stock-returns/{Id:int}/edit"
@page "/planning/stock-returns/{Id:int}/view"
@using Microsoft.AspNetCore.Components.Routing
@using ErpWeb.Core.Production
@using ErpWeb.UI.Planning.Lookups
@inherits PageBase

<PageTitle>@Heading</PageTitle>
<NavigationLock ConfirmExternalNavigation="Dirty" OnBeforeInternalNavigation="BeforeNavigate" />
<MenuAuthorize MenuCode="@MenuCodes.PlanningStockReturn">
    <div class="iv-page pr-stock-page">
        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <div class="iv-toast iv-toast--ok" role="status">
                <span>@StatusMessage</span>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="iv-toast iv-toast--err" role="alert">
                <span>@ErrorMessage</span>
            </div>
        }

        <header class="iv-hero">
            <div class="iv-hero__mark" aria-hidden="true">
                <i class="fa-solid fa-arrow-rotate-left"></i>
            </div>
            <div class="iv-hero__copy">
                <p class="iv-eyebrow">Planning · Production</p>
                <h1 class="iv-title">@Heading</h1>
                <div class="iv-chips">
                    <span class="iv-chip">@Document.Status</span>
                    @if (Document.Id > 0)
                    {
                        <span class="iv-chip code-style">PRTN @Document.BatchNo</span>
                    }
                    @if (Document.WorkOrderId > 0)
                    {
                        <span class="iv-chip code-style">@Document.WorkOrderNo</span>
                    }
                </div>
            </div>
            <div class="iv-hero__kpi">
                <span>@(IsView ? "Returned lines" : "Selected lines")</span>
                <strong>@LineCount</strong>
            </div>
        </header>

        <section class="iv-card pr-stock-commandbar">
            <div class="pr-stock-commandbar__left">
                <DxButton Text="BACK"
                          IconCssClass="fa-solid fa-arrow-left"
                          RenderStyle="ButtonRenderStyle.Secondary"
                          Click="BackAsync"
                          Enabled="@(!Busy)" />
                @if (CanChangeWorkOrder)
                {
                    <DxButton Text="CHANGE WORK ORDER"
                              IconCssClass="fa-solid fa-right-left"
                              RenderStyle="ButtonRenderStyle.Secondary"
                              Click="RequestChangeWorkOrder"
                              Enabled="@(!Busy)" />
                }
            </div>
            <div class="pr-stock-commandbar__right">
                @if (CanEditDraft)
                {
                    <DxButton Text="EDIT DRAFT"
                              IconCssClass="far fa-edit"
                              RenderStyle="ButtonRenderStyle.Primary"
                              Click="EditDraft"
                              Enabled="@(!Busy)" />
                }
                @if (CanEditFields)
                {
                    <DxButton Text="SAVE DRAFT"
                              IconCssClass="fa-solid fa-floppy-disk"
                              RenderStyle="ButtonRenderStyle.Primary"
                              Click="SaveAsync"
                              Enabled="@(CanSave && !Busy)" />
                }
                @if (ShowPost)
                {
                    <DxButton Text="POST"
                              IconCssClass="fa-solid fa-check"
                              RenderStyle="ButtonRenderStyle.Success"
                              Click="BeginPost"
                              Enabled="@(!Busy)" />
                }
                @if (CanRollback)
                {
                    <DxButton Text="ROLLBACK"
                              IconCssClass="fa-solid fa-rotate-left"
                              RenderStyle="ButtonRenderStyle.Warning"
                              Click="BeginRollback"
                              Enabled="@(!Busy)" />
                }
                @if (CanDelete)
                {
                    <DxButton Text="DELETE"
                              IconCssClass="fa-solid fa-trash"
                              RenderStyle="ButtonRenderStyle.Danger"
                              Click="BeginDelete"
                              Enabled="@(!Busy)" />
                }
            </div>
        </section>

        @if (BusyLoading)
        {
            <section class="iv-card" aria-busy="true">
                <div class="iv-skeleton">
                    <div class="iv-skeleton__line iv-skeleton__line--lg"></div>
                    <div class="iv-skeleton__line iv-skeleton__line--md"></div>
                    <div class="iv-skeleton__line"></div>
                </div>
            </section>
        }
        else if (CanEditFields && Document.WorkOrderId == 0)
        {
            <section class="iv-card">
                <header class="pr-stock-section-head">
                    <div>
                        <p class="iv-eyebrow">Step 1</p>
                        <h2 class="pr-stock-section-title">Choose a Work Order</h2>
                        <small>Select a released or in-progress Work Order with eligible Production stock. Search starts blank so all eligible Work Orders are available.</small>
                    </div>
                    <span class="pr-stock-step">1 of 3</span>
                </header>
                <div class="pr-stock-lookup">
                    <label class="form-label">Work Order</label>
                    <PrProductionStockWorkOrderPicker WorkOrderNo="@Document.WorkOrderNo"
                                                      ResolveAsync="@ResolveWorkOrderAsync"
                                                      SearchAsync="@SearchWorkOrdersAsync"
                                                      Selected="@OnWorkOrderSelectedAsync"
                                                      Cleared="@OnWorkOrderClearedAsync"
                                                      Enabled="@(!Busy)"
                                                      InputCssClass="pr-stock-work-order-input" />
                    <p class="pr-stock-field-hint">Use the search button to browse Work Orders by number, product, or description.</p>
                </div>
            </section>
        }
        else if (!CanEditFields && Document.Id == 0)
        {
            <section class="iv-card">
                <div class="pr-stock-empty" role="alert">
                    <div class="pr-stock-empty__icon" aria-hidden="true"><i class="fa-solid fa-lock"></i></div>
                    <h2>You do not have permission to create a Production Stock Return</h2>
                    <p>Contact your administrator if you need access to this transaction.</p>
                </div>
            </section>
        }

        @if (Document.WorkOrderId > 0 && !BusyLoading)
        {
            @if (IsView)
            {
                <section class="iv-card">
                    <header class="pr-stock-section-head">
                        <div>
                            <p class="iv-eyebrow">Document</p>
                            <h2 class="pr-stock-section-title">Return details</h2>
                        </div>
                        <span class="pr-stock-step">Revision @Document.Revision</span>
                    </header>
                    <div class="pr-stock-meta">
                        <div class="pr-stock-meta__item">
                            <span>Work Order</span>
                            <strong class="code-style">@Document.WorkOrderNo</strong>
                        </div>
                        <div class="pr-stock-meta__item">
                            <span>Product</span>
                            <strong>@Document.ProductCode</strong>
                            <small>@(string.IsNullOrWhiteSpace(Document.ProductDescription) ? "—" : Document.ProductDescription)</small>
                        </div>
                        <div class="pr-stock-meta__item">
                            <span>Work Order status</span>
                            <strong>@Document.WorkOrderStatus</strong>
                        </div>
                        <div class="pr-stock-meta__item">
                            <span>Snapshot revision</span>
                            <strong>@Document.SnapshotRevision</strong>
                        </div>
                        <div class="pr-stock-meta__item">
                            <span>Effective date</span>
                            <strong>@Document.EffectiveDate.ToString("dd MMM yyyy")</strong>
                        </div>
                        <div class="pr-stock-meta__item">
                            <span>Reference</span>
                            <strong>@(string.IsNullOrWhiteSpace(Document.RefNo) ? "—" : Document.RefNo)</strong>
                        </div>
                        <div class="pr-stock-meta__item">
                            <span>Posting ID</span>
                            <strong>@(Document.PostingId?.ToString() ?? "—")</strong>
                        </div>
                        <div class="pr-stock-meta__item">
                            <span>Reversal ID</span>
                            <strong>@(Document.ReversalPostingId?.ToString() ?? "—")</strong>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Document.Remarks))
                    {
                        <p class="pr-stock-view-remarks"><strong>Remarks</strong><span>@Document.Remarks</span></p>
                    }
                </section>
            }
            else
            {
                <section class="iv-card">
                    <header class="pr-stock-section-head">
                        <div>
                            <p class="iv-eyebrow">Step 1 · Work Order context</p>
                            <h2 class="pr-stock-section-title">@Document.WorkOrderNo</h2>
                            <small>Stock returns go back to the source Inventory balance recorded by the original issue.</small>
                        </div>
                        <span class="pr-stock-status">@Document.WorkOrderStatus</span>
                    </header>
                    <div class="pr-stock-meta pr-stock-meta--context">
                        <div class="pr-stock-meta__item">
                            <span>Product</span>
                            <strong>@Document.ProductCode</strong>
                            <small>@(string.IsNullOrWhiteSpace(Document.ProductDescription) ? "—" : Document.ProductDescription)</small>
                        </div>
                        <div class="pr-stock-meta__item">
                            <span>Snapshot revision</span>
                            <strong>@Document.SnapshotRevision</strong>
                            <small>Used to validate the return against this Work Order.</small>
                        </div>
                    </div>

                    <DxFormLayout CssClass="pr-stock-form" SizeMode="SizeMode.Small">
                        <DxFormLayoutItem Caption="Effective date" ColSpanMd="3">
                            <Template>
                                <DxDateEdit @bind-Date="Document.EffectiveDate"
                                            Enabled="@CanEditFields"
                                            CssClass="pr-stock-date" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Reference" ColSpanMd="4">
                            <Template>
                                <DxTextBox @bind-Text="Document.RefNo"
                                           Enabled="@CanEditFields"
                                           maxlength="30"
                                           NullText="Optional reference"
                                           CssClass="pr-stock-reference" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Remarks" ColSpanMd="5">
                            <Template>
                                <DxMemo @bind-Text="Document.Remarks"
                                        Rows="2"
                                        Enabled="@CanEditFields"
                                        maxlength="200"
                                        NullText="Optional note for this return" />
                            </Template>
                        </DxFormLayoutItem>
                    </DxFormLayout>
                </section>
            }

            <section class="iv-card pr-stock-lines">
                <header class="pr-stock-section-head pr-stock-lines__head">
                    <div>
                        <p class="iv-eyebrow">@(IsView ? "Return lines" : "Step 2 · Return lines")</p>
                        <h2 class="pr-stock-section-title">@(IsView ? "Materials returned" : "Choose materials to return")</h2>
                        @if (!IsView)
                        {
                            <small>Return quantity cannot exceed the remaining quantity from the original Production issue. Inventory destination is fixed to that issue.</small>
                        }
                    </div>
                    <div class="pr-stock-lines__actions">
                        @if (!IsView)
                        {
                            <span class="pr-stock-step">@Editors.Count / 100 lines</span>
                        }
                        @if (CanEditFields)
                        {
                            <DxButton Text="ADD MATERIAL"
                                      IconCssClass="fa-solid fa-plus"
                                      RenderStyle="ButtonRenderStyle.Primary"
                                      Click="OpenSourcePickerAsync"
                                      Enabled="@(!Busy && CanAddMoreSources)" />
                        }
                    </div>
                </header>

                @if (IsView)
                {
                    @if (Document.Lines.Count == 0)
                    {
                        <div class="pr-stock-empty">
                            <div class="pr-stock-empty__icon" aria-hidden="true"><i class="fa-solid fa-box-open"></i></div>
                            <h3>No return lines</h3>
                            <p>This document does not contain any saved material lines.</p>
                        </div>
                    }
                    else
                    {
                        <DxGrid Data="@Document.Lines"
                                KeyFieldName="@nameof(ProductionStockReturnLineDto.ProductionBalLotId)"
                                PageSize="20"
                                TextWrapEnabled="false"
                                ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                CssClass="pr-stock-grid">
                            <Columns>
                                <DxGridDataColumn Caption="ITEM / PRODUCTION LOT" Width="210px" MinWidth="170">
                                    <CellDisplayTemplate>
                                        @{
                                            var line = (ProductionStockReturnLineDto)context.DataItem;
                                        }
                                        <div class="pr-stock-cell">
                                            <strong class="code-style">@line.ItemCode</strong>
                                            <span>@line.ItemDescription</span>
                                            <small>Lot @line.LotNo</small>
                                        </div>
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn Caption="RETURNED QTY" Width="150px" TextAlignment="GridTextAlignment.Right">
                                    <CellDisplayTemplate>
                                        @{
                                            var line = (ProductionStockReturnLineDto)context.DataItem;
                                        }
                                        <strong>@line.RequestedQty.ToString("n4") @line.SourceUom</strong>
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn Caption="INVENTORY DESTINATION" Width="250px">
                                    <CellDisplayTemplate>
                                        @{
                                            var line = (ProductionStockReturnLineDto)context.DataItem;
                                        }
                                        <div class="pr-stock-cell">
                                            <strong>@line.Warehouse / @line.Location</strong>
                                            <small>Lot @line.InventoryLotNo · @line.ItemStatus</small>
                                        </div>
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn FieldName="@nameof(ProductionStockReturnLineDto.Reason)" Caption="REASON" Width="145px" />
                                @if (Document.CanViewCost)
                                {
                                    <DxGridDataColumn FieldName="@nameof(ProductionStockReturnLineDto.TotalValue)"
                                                      Caption="HISTORICAL VALUE"
                                                      DisplayFormat="n6"
                                                      TextAlignment="GridTextAlignment.Right"
                                                      Width="165px" />
                                }
                            </Columns>
                        </DxGrid>
                    }
                }
                else
                {
                    @if (Editors.Count == 0)
                    {
                        <div class="pr-stock-empty">
                            <div class="pr-stock-empty__icon" aria-hidden="true"><i class="fa-solid fa-boxes-stacked"></i></div>
                            <h3>No materials selected</h3>
                            <p>Add an eligible source pool to begin this return. The original Inventory destination is shown before you add it.</p>
                            @if (CanEditFields)
                            {
                                <DxButton Text="FIND MATERIALS"
                                          IconCssClass="fa-solid fa-magnifying-glass"
                                          RenderStyle="ButtonRenderStyle.Primary"
                                          Click="OpenSourcePickerAsync"
                                          Enabled="@(!Busy && CanAddMoreSources)" />
                            }
                        </div>
                    }
                    else
                    {
                        <DxGrid Data="@Editors"
                                KeyFieldName="@nameof(ReturnEditor.ProductionBalLotId)"
                                PageSize="20"
                                TextWrapEnabled="false"
                                ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                CssClass="pr-stock-grid">
                            <Columns>
                                <DxGridDataColumn Caption="ITEM / PRODUCTION LOT" Width="210px" MinWidth="170">
                                    <CellDisplayTemplate>
                                        @{
                                            var row = (ReturnEditor)context.DataItem;
                                        }
                                        <div class="pr-stock-cell">
                                            <strong class="code-style">@row.Source.ItemCode</strong>
                                            <span>@row.Source.Description</span>
                                            <small>Lot @row.Source.LotNo</small>
                                        </div>
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn Caption="PRODUCTION QTY" Width="145px" TextAlignment="GridTextAlignment.Right">
                                    <CellDisplayTemplate>
                                        @{
                                            var row = (ReturnEditor)context.DataItem;
                                        }
                                        <strong>@row.Source.ProductionQty.ToString("n4") @row.Source.Uom</strong>
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn Caption="RETURNABLE NOW" Width="150px" TextAlignment="GridTextAlignment.Right">
                                    <CellDisplayTemplate>
                                        @{
                                            var row = (ReturnEditor)context.DataItem;
                                        }
                                        <strong>@row.Source.ReturnableQty.ToString("n4") @row.Source.Uom</strong>
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn Caption="RETURN QTY" Width="160px">
                                    <CellDisplayTemplate>
                                        @{
                                            var row = (ReturnEditor)context.DataItem;
                                        }
                                        <DxSpinEdit @bind-Value="row.Quantity"
                                                    MinValue="0m"
                                                    MaxValue="row.Source.ReturnableQty"
                                                    Increment="0.0001m"
                                                    DisplayFormat="n4"
                                                    ShowSpinButtons="false"
                                                    Enabled="@CanEditFields"
                                                    CssClass="pr-stock-qty" />
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn Caption="AFTER RETURN" Width="145px" TextAlignment="GridTextAlignment.Right">
                                    <CellDisplayTemplate>
                                        @{
                                            var row = (ReturnEditor)context.DataItem;
                                        }
                                        <div class="pr-stock-cell pr-stock-cell--end">
                                            <strong>@ProjectedAfterReturn(row).ToString("n4") @row.Source.Uom</strong>
                                            <small>Projected balance</small>
                                        </div>
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn Caption="INVENTORY DESTINATION" Width="230px" MinWidth="185">
                                    <CellDisplayTemplate>
                                        @{
                                            var row = (ReturnEditor)context.DataItem;
                                        }
                                        <div class="pr-stock-cell">
                                            <strong>@row.Source.Warehouse / @row.Source.Location</strong>
                                            <small>Lot @row.Source.InventoryLotNo · @row.Source.ItemStatus</small>
                                        </div>
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn Caption="REASON" Width="165px">
                                    <CellDisplayTemplate>
                                        @{
                                            var row = (ReturnEditor)context.DataItem;
                                        }
                                        <DxComboBox Data="@ReasonOptions"
                                                    TData="string"
                                                    TValue="string"
                                                    @bind-Value="row.Reason"
                                                    Enabled="@CanEditFields" />
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn Caption="REMARKS" Width="190px">
                                    <CellDisplayTemplate>
                                        @{
                                            var row = (ReturnEditor)context.DataItem;
                                        }
                                        <DxTextBox @bind-Text="row.Remarks"
                                                   maxlength="250"
                                                   NullText="Required for Other"
                                                   Enabled="@CanEditFields" />
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn Caption="" Width="92px">
                                    <CellDisplayTemplate>
                                        @{
                                            var row = (ReturnEditor)context.DataItem;
                                        }
                                        <DxButton Text="REMOVE"
                                                  IconCssClass="fa-solid fa-xmark"
                                                  RenderStyle="ButtonRenderStyle.Danger"
                                                  Click="@(() => RemoveEditor(row))"
                                                  Enabled="@CanEditFields" />
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                            </Columns>
                        </DxGrid>
                    }

                    @if (Editors.Count >= 100)
                    {
                        <p class="pr-stock-limit" role="status">Maximum 100 lines reached.</p>
                    }

                    <div class="pr-stock-readiness @(UiIssues.Count == 0 ? "pr-stock-readiness--ready" : "pr-stock-readiness--needs-action")"
                         role="@(UiIssues.Count == 0 ? "status" : "alert")">
                        <div class="pr-stock-readiness__icon" aria-hidden="true">
                            <i class="@(UiIssues.Count == 0 ? "fa-solid fa-circle-check" : "fa-solid fa-triangle-exclamation")"></i>
                        </div>
                        <div>
                            <strong>@(UiIssues.Count == 0 ? "Ready to save" : "Action required")</strong>
                            @if (UiIssues.Count == 0)
                            {
                                <span>@Editors.Count line(s) selected. Save creates a draft; posting revalidates current stock.</span>
                            }
                            else
                            {
                                <ul>
                                    @foreach (var issue in UiIssues)
                                    {
                                        <li>@issue</li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                    @if (Document.ReadinessErrors.Count > 0)
                    {
                        <div class="pr-stock-domain-readiness" role="alert">
                            <strong>Server readiness checks</strong>
                            <ul>
                                @foreach (var error in Document.ReadinessErrors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        </div>
                    }
                }
            </section>
        }

        <DxPopup HeaderText="Find Production stock to return"
                 CloseOnOutsideClick="false"
                 Width="min(1500px, 96vw)"
                 CssClass="common-popup pr-popup-grid-dialog pr-stock-source-popup"
                 @bind-Visible="SourcePickerVisible">
            <Content>
                <div class="pr-stock-source-search">
                    <div class="pr-stock-source-search__field">
                        <label class="form-label">Search source pools</label>
                        <DxTextBox Text="@SourceSearch"
                                   TextChanged="OnSourceSearchChanged"
                                   BindValueMode="BindValueMode.OnInput"
                                   NullText="Item code, description, or production lot"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   CssClass="w-100" />
                        <small>Search is blank by default. Leave it blank to see all eligible source pools for @Document.WorkOrderNo.</small>
                    </div>
                    <div class="pr-stock-source-search__summary">
                        <span>@SourceTotalCount.ToString("N0") source pools</span>
                        <span>@Editors.Count selected</span>
                    </div>
                </div>

                <div class="pr-popup-grid-shell pr-stock-source-grid-shell" aria-busy="@SourceLoading">
                    @if (SourceLoading)
                    {
                        <div class="iv-skeleton p-3" aria-label="Loading source pools">
                            <div class="iv-skeleton__line iv-skeleton__line--lg"></div>
                            <div class="iv-skeleton__line iv-skeleton__line--md"></div>
                            <div class="iv-skeleton__line"></div>
                        </div>
                    }
                    else if (Sources.Count == 0)
                    {
                        <div class="pr-stock-empty pr-stock-empty--compact">
                            <div class="pr-stock-empty__icon" aria-hidden="true"><i class="fa-solid fa-magnifying-glass"></i></div>
                            <h3>@(string.IsNullOrWhiteSpace(SourceSearch) ? "No eligible Production stock" : "No matching source pools")</h3>
                            <p>@(string.IsNullOrWhiteSpace(SourceSearch)
                                ? "This Work Order has no candidate Production stock to return. Check another Work Order or review its issue history."
                                : "Try a different item, description, or lot, or clear the search to show every source pool.")</p>
                        </div>
                    }
                    else
                    {
                        <DxGrid Data="@Sources"
                                KeyFieldName="@nameof(ProductionStockReturnSource.ProductionBalLotId)"
                                PageSize="20"
                                TextWrapEnabled="false"
                                ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                                CssClass="pr-stock-grid pr-stock-source-grid">
                            <Columns>
                                <DxGridDataColumn Caption="ITEM / DESCRIPTION" Width="240px" MinWidth="200">
                                    <CellDisplayTemplate>
                                        @{
                                            var source = (ProductionStockReturnSource)context.DataItem;
                                        }
                                        <div class="pr-stock-cell">
                                            <strong class="code-style">@source.ItemCode</strong>
                                            <span>@source.Description</span>
                                        </div>
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn Caption="PRODUCTION LOT" Width="145px">
                                    <CellDisplayTemplate>
                                        @{
                                            var source = (ProductionStockReturnSource)context.DataItem;
                                        }
                                        <span class="code-style">@source.LotNo</span>
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn Caption="PRODUCTION QTY" Width="165px" TextAlignment="GridTextAlignment.Right">
                                    <CellDisplayTemplate>
                                        @{
                                            var source = (ProductionStockReturnSource)context.DataItem;
                                        }
                                        <strong>@source.ProductionQty.ToString("n4") @source.Uom</strong>
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn Caption="RETURNABLE NOW" Width="165px" TextAlignment="GridTextAlignment.Right">
                                    <CellDisplayTemplate>
                                        @{
                                            var source = (ProductionStockReturnSource)context.DataItem;
                                        }
                                        <strong>@source.ReturnableQty.ToString("n4") @source.Uom</strong>
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn Caption="INVENTORY DESTINATION" Width="235px" MinWidth="200">
                                    <CellDisplayTemplate>
                                        @{
                                            var source = (ProductionStockReturnSource)context.DataItem;
                                        }
                                        <div class="pr-stock-cell">
                                            <strong>@source.Warehouse / @source.Location</strong>
                                            <small>Lot @source.InventoryLotNo · @source.ItemStatus</small>
                                        </div>
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn Caption="READINESS" Width="265px" MinWidth="220">
                                    <CellDisplayTemplate>
                                        @{
                                            var source = (ProductionStockReturnSource)context.DataItem;
                                            var ready = SourceCanBeAdded(source);
                                        }
                                        <span class="pr-stock-source-status @(ready ? "pr-stock-source-status--ready" : "pr-stock-source-status--blocked")">
                                            <i class="@(ready ? "fa-solid fa-circle-check" : "fa-solid fa-circle-exclamation")" aria-hidden="true"></i>
                                            @source.Readiness
                                        </span>
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                                <DxGridDataColumn Caption="ACTION" Width="120px">
                                    <CellDisplayTemplate>
                                        @{
                                            var source = (ProductionStockReturnSource)context.DataItem;
                                            var added = IsSourceAdded(source.ProductionBalLotId);
                                        }
                                        <DxButton Text="@(added ? "ADDED" : "ADD")"
                                                  IconCssClass="@(added ? "fa-solid fa-check" : "fa-solid fa-plus")"
                                                  RenderStyle="@(added ? ButtonRenderStyle.Secondary : ButtonRenderStyle.Primary)"
                                                  Click="@(() => AddSource(source))"
                                                  Enabled="@(!added && SourceCanBeAdded(source) && CanAddMoreSources && !Busy)" />
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                            </Columns>
                        </DxGrid>
                    }
                </div>

                <div class="pr-stock-source-pager">
                    <span>@SourcePageLabel</span>
                    <div>
                        <DxButton Text="PREVIOUS"
                                  RenderStyle="ButtonRenderStyle.Secondary"
                                  Enabled="@(SourcePage > 0 && !SourceLoading)"
                                  Click="PreviousSourcePageAsync" />
                        <DxButton Text="NEXT"
                                  RenderStyle="ButtonRenderStyle.Secondary"
                                  Enabled="@(SourcePage + 1 < SourceTotalPages && !SourceLoading)"
                                  Click="NextSourcePageAsync" />
                    </div>
                </div>
                @if (Editors.Count >= 100)
                {
                    <p class="pr-stock-limit mb-0 mt-2">Maximum 100 lines reached.</p>
                }
                <div class="iv-popup-footer">
                    <div class="pr-stock-source-footer-hint">Add one or more pools, then review quantities and reasons on the entry.</div>
                    <div class="iv-popup-footer__actions">
                        <DxButton Text="DONE"
                                  IconCssClass="fa-solid fa-check"
                                  RenderStyle="ButtonRenderStyle.Primary"
                                  Click="@(() => SourcePickerVisible = false)" />
                    </div>
                </div>
            </Content>
        </DxPopup>

        <DxPopup HeaderText="Change Work Order?"
                 CloseOnOutsideClick="false"
                 Width="min(480px,95vw)"
                 CssClass="common-popup"
                 @bind-Visible="ChangeWorkOrderConfirmVisible">
            <Content>
                <div class="common-popup__body">
                    <p class="iv-confirm__copy">Selected lines and unsaved entry details will be cleared.</p>
                </div>
                <div class="iv-popup-footer">
                    <div class="iv-popup-footer__actions">
                        <DxButton Text="CANCEL" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => ChangeWorkOrderConfirmVisible = false)" />
                        <DxButton Text="CHANGE WORK ORDER" RenderStyle="ButtonRenderStyle.Warning" Click="ConfirmChangeWorkOrder" />
                    </div>
                </div>
            </Content>
        </DxPopup>

        <DxPopup HeaderText="Post Production Stock Return?"
                 CloseOnOutsideClick="false"
                 Width="min(560px,95vw)"
                 CssClass="common-popup"
                 @bind-Visible="PostConfirmVisible">
            <Content>
                <div class="common-popup__body">
                    <p class="iv-confirm__copy">
                        Post PRTN @Document.BatchNo? @Document.Lines.Count material line(s) will move from Production to their original Inventory balances. Destinations cannot be changed after posting.
                    </p>
                </div>
                <div class="iv-popup-footer">
                    <div class="iv-popup-footer__actions">
                        <DxButton Text="CANCEL" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => PostConfirmVisible = false)" />
                        <DxButton Text="POST" RenderStyle="ButtonRenderStyle.Success" Click="ConfirmPostAsync" Enabled="@(!Busy)" />
                    </div>
                </div>
            </Content>
        </DxPopup>

        <DxPopup HeaderText="Delete NEW Production Stock Return?"
                 CloseOnOutsideClick="false"
                 Width="min(480px,95vw)"
                 CssClass="common-popup"
                 @bind-Visible="DeleteConfirmVisible">
            <Content>
                <div class="common-popup__body">
                    <p class="iv-confirm__copy">This permanently removes the saved NEW draft. No stock movement has been posted.</p>
                </div>
                <div class="iv-popup-footer">
                    <div class="iv-popup-footer__actions">
                        <DxButton Text="CANCEL" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => DeleteConfirmVisible = false)" />
                        <DxButton Text="DELETE" RenderStyle="ButtonRenderStyle.Danger" Click="ConfirmDeleteAsync" Enabled="@(!Busy)" />
                    </div>
                </div>
            </Content>
        </DxPopup>

        <DxPopup HeaderText="Rollback Production Stock Return"
                 CloseOnOutsideClick="false"
                 Width="min(520px,95vw)"
                 CssClass="common-popup"
                 @bind-Visible="RollbackVisible">
            <Content>
                <div class="common-popup__body">
                    <p>This appends a reversal for the linked Inventory and Production movements.</p>
                    <DxMemo @bind-Text="RollbackReason"
                            Rows="3"
                            maxlength="250"
                            NullText="Rollback reason (required)" />
                </div>
                <div class="iv-popup-footer">
                    <div class="iv-popup-footer__actions">
                        <DxButton Text="CANCEL" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => RollbackVisible = false)" />
                        <DxButton Text="ROLLBACK" RenderStyle="ButtonRenderStyle.Warning" Click="RollbackAsync" Enabled="@(!Busy && !string.IsNullOrWhiteSpace(RollbackReason))" />
                    </div>
                </div>
            </Content>
        </DxPopup>
    </div>
</MenuAuthorize>
