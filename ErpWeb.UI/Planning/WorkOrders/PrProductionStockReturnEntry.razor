@page "/planning/stock-returns/new"
@page "/planning/stock-returns/{Id:int}/edit"
@page "/planning/stock-returns/{Id:int}/view"
@using Microsoft.AspNetCore.Components.Routing
@inherits PageBase

<PageTitle>@Heading</PageTitle>
<NavigationLock ConfirmExternalNavigation="Dirty" OnBeforeInternalNavigation="BeforeNavigate" />
<MenuAuthorize MenuCode="@MenuCodes.PlanningStockReturn">
    <div class="iv-page pr-dp-page">
        @if(!string.IsNullOrWhiteSpace(StatusMessage)){<div class="iv-toast iv-toast--ok" role="status">@StatusMessage</div>}
        @if(!string.IsNullOrWhiteSpace(ErrorMessage)){<div class="iv-toast iv-toast--err" role="alert">@ErrorMessage</div>}
        <header class="iv-hero"><div class="iv-hero__mark" aria-hidden="true"><i class="fa-solid fa-arrow-rotate-left"></i></div><div class="iv-hero__copy"><p class="iv-eyebrow">Planning · Production</p><h1 class="iv-title">@Heading</h1><div class="iv-chips"><span class="iv-chip">@Document.Status</span>@if(Document.Id>0){<span class="iv-chip code-style">PRTN @Document.BatchNo</span>}</div></div></header>
        <section class="iv-card pr-stock-command"><DxButton Text="BACK" RenderStyle="ButtonRenderStyle.Secondary" Click="BackAsync" /><span class="pr-stock-command__spacer"></span>
            @if(CanSave){<DxButton Text="SAVE DRAFT" IconCssClass="fa-solid fa-floppy-disk" RenderStyle="ButtonRenderStyle.Primary" Click="SaveAsync" Enabled="@(!Busy)" />}
            @if(CanPost){<DxButton Text="POST" IconCssClass="fa-solid fa-check" RenderStyle="ButtonRenderStyle.Success" Click="PostAsync" Enabled="@(!Busy && !Dirty)" />}
            @if(CanRollback){<DxButton Text="ROLLBACK" IconCssClass="fa-solid fa-rotate-left" RenderStyle="ButtonRenderStyle.Warning" Click="BeginRollback" Enabled="@(!Busy)" />}
            @if(CanDelete){<DxButton Text="DELETE" IconCssClass="fa-solid fa-trash" RenderStyle="ButtonRenderStyle.Danger" Click="DeleteAsync" Enabled="@(!Busy)" />}
            @if(CanCorrection){<DxButton Text="CREATE CORRECTION" RenderStyle="ButtonRenderStyle.Secondary" Click="CreateCorrectionAsync" Enabled="@(!Busy)" />}
            @if(CanEditDraft){<DxButton Text="EDIT DRAFT" RenderStyle="ButtonRenderStyle.Secondary" Click="EditDraft" />}
        </section>
        @if(BusyLoading){<section class="iv-card" aria-busy="true"><div class="iv-skeleton"><div class="iv-skeleton__line iv-skeleton__line--lg"></div><div class="iv-skeleton__line"></div></div></section>}
        else if(!IsView && CanEditFields && WorkOrder is null)
        {
            <section class="iv-card"><div class="pr-dp-section-head"><div><p class="iv-eyebrow">Phase 1</p><strong>Select Work Order</strong><small>Choose a RELEASED or IN_PROGRESS Work Order before selecting a material pool.</small></div></div><div class="pr-stock-toolbar"><DxTextBox @bind-Text="WorkOrderInput" NullText="Work Order number" CssClass="w-100" /><DxButton Text="LOAD WORK ORDER" RenderStyle="ButtonRenderStyle.Primary" Click="LoadWorkOrderAsync" Enabled="@(!Busy)" /></div></section>
        }
        else if(!IsView && CanEditFields && WorkOrder is not null)
        {
            <section class="iv-card"><div class="pr-dp-section-head"><div><p class="iv-eyebrow">Locked Work Order context</p><strong class="code-style">@WorkOrder.WorkOrderNo · @WorkOrder.ProductCode</strong><small>@WorkOrder.Status · Snapshot @Document.SnapshotRevision</small></div><DxButton Text="CHANGE WORK ORDER" RenderStyle="ButtonRenderStyle.Secondary" Click="ChangeWorkOrder" Enabled="@(!Busy && Document.Id==0)" /></div>
                <div class="pr-stock-toolbar"><DxTextBox @bind-Text="SourceSearch" NullText="Search item or lot" CssClass="w-100" /><DxButton Text="FIND POOLS" RenderStyle="ButtonRenderStyle.Secondary" Click="SearchPoolsAsync" Enabled="@(!Busy)" /></div>
                @if(Sources.Count>0){<DxGrid Data="@Sources" PageSize="10" TextWrapEnabled="false" ColumnResizeMode="GridColumnResizeMode.ColumnsContainer" CssClass="pr-dp-grid"><Columns>
                    <DxGridDataColumn FieldName="@nameof(ProductionStockReturnSource.ItemCode)" Caption="Item" Width="170px" MinWidth="150" />
                    <DxGridDataColumn FieldName="@nameof(ProductionStockReturnSource.LotNo)" Caption="Lot" Width="140px" />
                    <DxGridDataColumn FieldName="@nameof(ProductionStockReturnSource.ReturnableQty)" Caption="Unused ISSUE available" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" Width="180px" />
                    <DxGridDataColumn FieldName="@nameof(ProductionStockReturnSource.Uom)" Caption="UOM" Width="90px" />
                    <DxGridDataColumn Caption="Readiness" Width="280px"><CellDisplayTemplate>@(((ProductionStockReturnSource)context.DataItem).Readiness)</CellDisplayTemplate></DxGridDataColumn>
                    <DxGridDataColumn Caption="Action" Width="100px"><CellDisplayTemplate>@{var source=(ProductionStockReturnSource)context.DataItem;}<DxButton Text="ADD" RenderStyle="ButtonRenderStyle.Primary" Click="@(()=>AddSource(source))" Enabled="@(source.ReturnableQty>0 && Editors.All(x=>x.Source.ProductionBalLotId!=source.ProductionBalLotId))" /></CellDisplayTemplate></DxGridDataColumn>
                </Columns></DxGrid>}
            </section>
        }
        @if(IsView || CanEditFields && WorkOrder is not null)
        {
            <section class="iv-card"><div class="pr-dp-section-head"><div><p class="iv-eyebrow">Document</p><strong>@(IsView?"Saved return facts":"Return workspace")</strong><small>@(IsView?"Posted values below are historical facts.":"Current source availability is revalidated at Save and POST.")</small></div></div>
                <DxFormLayout CssClass="pr-stock-form"><DxFormLayoutItem Caption="Work Order" ColSpanMd="4"><DxTextBox Text="@Document.WorkOrderNo" ReadOnly="true" /></DxFormLayoutItem><DxFormLayoutItem Caption="Effective date" ColSpanMd="4"><DxDateEdit @bind-Date="Document.EffectiveDate" Enabled="@CanEditFields" /></DxFormLayoutItem><DxFormLayoutItem Caption="Reference" ColSpanMd="4"><DxTextBox @bind-Text="Document.RefNo" Enabled="@CanEditFields" /></DxFormLayoutItem><DxFormLayoutItem Caption="Remarks" ColSpanMd="12"><DxMemo @bind-Text="Document.Remarks" Rows="2" Enabled="@CanEditFields" /></DxFormLayoutItem></DxFormLayout>
                @if(IsView){<DxGrid Data="@Document.Lines" PageSize="20" TextWrapEnabled="false" ColumnResizeMode="GridColumnResizeMode.ColumnsContainer" CssClass="pr-dp-grid"><Columns><DxGridDataColumn FieldName="@nameof(ProductionStockReturnLineDto.ItemCode)" Caption="Item" Width="170px" /><DxGridDataColumn FieldName="@nameof(ProductionStockReturnLineDto.LotNo)" Caption="Lot" Width="130px" /><DxGridDataColumn FieldName="@nameof(ProductionStockReturnLineDto.RequestedQty)" Caption="Returned Qty" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" Width="150px" /><DxGridDataColumn FieldName="@nameof(ProductionStockReturnLineDto.BaseUom)" Caption="Base UOM" Width="100px" /><DxGridDataColumn FieldName="@nameof(ProductionStockReturnLineDto.Reason)" Caption="Reason" Width="150px" /><DxGridDataColumn FieldName="@nameof(ProductionStockReturnLineDto.TotalValue)" Caption="Historical value" DisplayFormat="n6" TextAlignment="GridTextAlignment.Right" Width="160px" /></Columns></DxGrid>}
                else {<DxGrid Data="@Editors" PageSize="20" TextWrapEnabled="false" ColumnResizeMode="GridColumnResizeMode.ColumnsContainer" CssClass="pr-dp-grid"><Columns>
                    <DxGridDataColumn Caption="Item / Lot" Width="220px"><CellDisplayTemplate>@{var row=(ReturnEditor)context.DataItem;}<strong>@row.Source.ItemCode</strong><div class="text-muted">@row.Source.LotNo</div></CellDisplayTemplate></DxGridDataColumn>
                    <DxGridDataColumn Caption="Current unused ISSUE" Width="170px"><CellDisplayTemplate>@{var row=(ReturnEditor)context.DataItem;}@row.Source.ReturnableQty.ToString("n4") @row.Source.Uom</CellDisplayTemplate></DxGridDataColumn>
                    <DxGridDataColumn Caption="Return qty" Width="170px"><CellDisplayTemplate>@{var row=(ReturnEditor)context.DataItem;}<DxSpinEdit @bind-Value="row.Quantity" MinValue="0.0001m" MaxValue="row.Source.ReturnableQty" Increment="0.0001m" DisplayFormat="n4" Enabled="@CanEditFields" /></CellDisplayTemplate></DxGridDataColumn>
                    <DxGridDataColumn Caption="Reason" Width="190px"><CellDisplayTemplate>@{var row=(ReturnEditor)context.DataItem;}<DxComboBox Data="@ReasonOptions" @bind-Value="row.Reason" Enabled="@CanEditFields" /></CellDisplayTemplate></DxGridDataColumn>
                    <DxGridDataColumn Caption="Remarks" Width="220px"><CellDisplayTemplate>@{var row=(ReturnEditor)context.DataItem;}<DxTextBox @bind-Text="row.Remarks" Enabled="@CanEditFields" /></CellDisplayTemplate></DxGridDataColumn>
                    <DxGridDataColumn Caption="" Width="80px"><CellDisplayTemplate>@{var row=(ReturnEditor)context.DataItem;}<DxButton Text="REMOVE" RenderStyle="ButtonRenderStyle.Danger" Click="@(()=>Editors.Remove(row))" Enabled="@CanEditFields" /></CellDisplayTemplate></DxGridDataColumn>
                </Columns></DxGrid>}
                @if(Document.ReadinessErrors.Count>0){<ul class="pr-stock-readiness">@foreach(var error in Document.ReadinessErrors){<li>@error</li>}</ul>}
            </section>
        }
        @if(RollbackVisible){<DxPopup Visible="true" VisibleChanged="@(v=>RollbackVisible=v)" HeaderText="Rollback Production Stock Return" Width="min(520px,95vw)" CloseOnOutsideClick="false"><BodyContentTemplate><div class="common-popup__body"><p>This appends a reversal for the linked Inventory and Production movements.</p><DxMemo @bind-Text="RollbackReason" Rows="3" NullText="Rollback reason (required)" /></div></BodyContentTemplate><FooterContentTemplate><div class="common-popup__footer"><DxButton Text="CANCEL" RenderStyle="ButtonRenderStyle.Secondary" Click="@(()=>RollbackVisible=false)" /><DxButton Text="ROLLBACK" RenderStyle="ButtonRenderStyle.Warning" Click="RollbackAsync" Enabled="@(!Busy)" /></div></FooterContentTemplate></DxPopup>}
    </div>
</MenuAuthorize>
