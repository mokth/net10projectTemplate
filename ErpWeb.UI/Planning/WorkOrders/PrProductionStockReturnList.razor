@page "/planning/stock-returns"
@inherits PageBase

<PageTitle>Production Stock Return</PageTitle>
<MenuAuthorize MenuCode="@MenuCodes.PlanningStockReturn">
    <div class="iv-page">
        @if (!string.IsNullOrWhiteSpace(StatusMessage)) { <div class="iv-toast iv-toast--ok" role="status">@StatusMessage</div> }
        @if (!string.IsNullOrWhiteSpace(ErrorMessage)) { <div class="iv-toast iv-toast--err" role="alert">@ErrorMessage</div> }
        <header class="iv-hero">
            <div class="iv-hero__mark" aria-hidden="true"><i class="fa-solid fa-arrow-rotate-left"></i></div>
            <div class="iv-hero__copy"><p class="iv-eyebrow">Planning · Production</p><h1 class="iv-title">Production Stock Return</h1>
                <div class="iv-chips"><span class="iv-chip">@TotalCount documents</span>@if (HasActiveFilters){<span class="iv-chip">Filtered</span>}</div></div>
            <div class="iv-hero__kpi"><span>Documents</span><strong>@TotalCount.ToString("N0")</strong></div>
        </header>
        <section class="iv-card">
            <div class="iv-toolbar-row">
                <div class="iv-toolbar-row__search"><DxTextBox Text="@SearchText" TextChanged="OnSearchChanged" NullText="Search return, Work Order or reference…" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" CssClass="w-100" /></div>
                <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="FILTER" IconCssClass="fa-solid fa-filter" Click="OpenFilterPopup" />
            </div>
            @if (Loading) { <div class="iv-skeleton" aria-busy="true"><div class="iv-skeleton__line iv-skeleton__line--lg"></div><div class="iv-skeleton__line"></div></div> }
            else
            {
                <div class="iv-list-desktop"><CommonDataGridEx T="ProductionStockReturnSummary" Columns="@Columns" Buttons="@Buttons" ActionButtons="@ActionButtons"
                    KeyName="@nameof(ProductionStockReturnSummary.Id)" GridKey="pln-stock-returns" Title="Production Stock Return"
                    CustomDataSource="@DataSource" ShowToolbarText="true" ShowResetLayoutButton="true" UseBuiltInExport="false"
                    ShowSearchBox="false" ShowFilterRow="false" ShowGroupPanel="false" allowSelect="true" OnGridInstance="@OnGridInstance"
                    OnSelectionsEventHandle="@OnSelections" OnButtonEventHandle="@OnButton" OnActionEventHandle="@OnAction" /></div>
                <div class="iv-list-compact">
                    @if (CompactRows.Count == 0) { <p class="text-muted mb-0">No Production Stock Returns match the search.</p> }
                    @foreach (var row in CompactRows) { <button type="button" class="iv-compact-row" @onclick="@(() => OpenView(row.Id))"><div class="iv-compact-row__title"><span class="code-style">PRTN @row.BatchNo</span><span>@row.WorkOrderNo · @row.ItemSummary</span></div><div class="iv-compact-row__meta"><span>@row.QtySummary</span><span>@row.Status</span><span>@row.EffectiveDate.ToString("dd MMM yyyy")</span></div></button> }
                </div>
            }
        </section>
        <DxPopup HeaderText="Filter Production Stock Returns" CloseOnOutsideClick="false" Width="540px" CssClass="common-popup" @bind-Visible="FilterPopupVisible">
            <Content>
                <div class="iv-popup-body"><DxFormLayout SizeMode="SizeMode.Small"><DxFormLayoutItem Caption="Status" ColSpanMd="12"><Template>
                    <DxComboBox Data="@Statuses" TData="StatusChoice" TValue="string" TextFieldName="Text" ValueFieldName="Value" @bind-Value="DraftStatus" />
                </Template></DxFormLayoutItem></DxFormLayout></div>
                <div class="iv-popup-footer"><div class="iv-popup-footer__actions"><DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Clear" Click="ClearFiltersAsync" /><DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Apply" Click="ApplyFiltersAsync" /></div></div>
            </Content>
        </DxPopup>
        @if (ConfirmVisible)
        {
            <DxPopup Visible="true" VisibleChanged="@(v => ConfirmVisible = v)" HeaderText="@(ConfirmAction + " Production Stock Return")" Width="min(520px, 95vw)" CloseOnOutsideClick="false">
                <BodyContentTemplate><div class="common-popup__body"><p>@ConfirmCopy</p>@if (ConfirmAction == "ROLLBACK") { <DxMemo @bind-Text="RollbackReason" Rows="3" NullText="Rollback reason (required)" CssClass="w-100" /> }</div></BodyContentTemplate>
                <FooterContentTemplate><div class="common-popup__footer"><DxButton Text="CANCEL" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => ConfirmVisible = false)" /><DxButton Text="@ConfirmAction" RenderStyle="@(ConfirmAction == "ROLLBACK" ? ButtonRenderStyle.Warning : ButtonRenderStyle.Success)" Click="ConfirmAsync" Enabled="@(!Busy)" /></div></FooterContentTemplate>
            </DxPopup>
        }
    </div>
</MenuAuthorize>
