@page "/planning/material-issues/{Mode:regex(^(new|edit|view)$)}"
@page "/planning/material-issues/{Mode:regex(^(new|edit|view)$)}/{BatchNo:int}"
@page "/planning/material-issues/new/{WorkOrderNo}"
@inherits PageBase

<PageTitle>@PageHeading</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.PlanningMaterialIssue">
    <div class="iv-page pr-issue-page">
        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <div class="iv-toast iv-toast--ok" role="status">
                <span>@StatusMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissStatus" aria-label="Dismiss">×</button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="iv-toast iv-toast--err" role="alert">
                <span>@ErrorMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissError" aria-label="Dismiss">×</button>
            </div>
        }

        <header class="iv-hero">
            <div class="iv-hero__mark" aria-hidden="true">
                <i class="fa-solid fa-dolly"></i>
            </div>
            <div class="iv-hero__copy">
                <p class="iv-eyebrow">Planning · Production</p>
                <h1 class="iv-title">@PageHeading</h1>
                <div class="iv-chips">
                    <span class="iv-chip">@ModeChip</span>
                    @if (BatchNo is > 0 && (IsViewMode || IsEditMode))
                    {
                        <span class="iv-chip code-style">IP @BatchNo</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(ActiveWorkOrderNo))
                    {
                        <span class="iv-chip code-style">@ActiveWorkOrderNo</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(ActiveProductCode))
                    {
                        <span class="iv-chip code-style">@ActiveProductCode</span>
                    }
                    <span class="iv-chip">@HeaderStatus</span>
                </div>
            </div>
            <div class="iv-hero__kpi">
                <span>@(IsViewMode ? "Materials" : "Selected")</span>
                <strong>@SelectedLineCount</strong>
            </div>
        </header>

        <section class="iv-card pr-issue-commandbar">
            <div class="pr-issue-commandbar__left">
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          Text="BACK"
                          IconCssClass="fa-solid fa-arrow-left"
                          Click="@BackToList"
                          Enabled="@(!IsSubmitting)" />
                @if (Workspace is not null && !IsViewMode && !IsEditMode)
                {
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="CHANGE OPERATION"
                              IconCssClass="fa-solid fa-right-left"
                              Click="@ClearWorkspace"
                              Enabled="@(!IsSubmitting)" />
                }
            </div>
            <div class="pr-issue-commandbar__right">
                @if (CanOpenEditFromView)
                {
                    <DxButton RenderStyle="ButtonRenderStyle.Primary"
                              Text="EDIT DRAFT"
                              IconCssClass="far fa-edit"
                              Click="@OpenEdit"
                              Enabled="@(!IsSubmitting)" />
                }
                @if (Workspace is not null && !IsViewMode)
                {
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="BOM / CALCULATE"
                              IconCssClass="fa-solid fa-calculator"
                              Click="@OpenBom"
                              Enabled="@(SelectedOperationRow is not null && SelectedOperationRow.RemainingBasisQty > 0m && !IsSubmitting)" />
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="APPLY &amp; AUTO ALLOCATE"
                              IconCssClass="fa-solid fa-wand-magic-sparkles"
                              Click="@ApplyDesiredOutputAndAllocateAsync"
                              Enabled="@CanApplyDesiredOutput" />
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="FILL OUTSTANDING"
                              IconCssClass="fa-solid fa-fill-drip"
                              Click="@AutoFillOutstanding"
                              Enabled="@CanFillOutstanding" />
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="AUTO ALLOCATE"
                              IconCssClass="fa-solid fa-layer-group"
                              Click="@AllocateAllAsync"
                              Enabled="@(CanFillOutstanding && SelectedIssueLines.Any())" />
                }
            </div>
        </section>

        @if (IsLoading)
        {
            <section class="iv-card">
                <div class="iv-skeleton" aria-busy="true">
                    <div class="iv-skeleton__line iv-skeleton__line--lg"></div>
                    <div class="iv-skeleton__line iv-skeleton__line--md"></div>
                    <div class="iv-skeleton__line"></div>
                </div>
            </section>
        }
        else if (IsViewMode && Document is not null)
        {
            <section class="iv-card">
                <h2 class="iv-card__title">Document</h2>
                <div class="pr-issue-meta">
                    <div class="pr-issue-meta__item">
                        <span class="iv-field__label">Work Order</span>
                        <strong class="code-style">@Document.WorkOrderNo</strong>
                    </div>
                    <div class="pr-issue-meta__item">
                        <span class="iv-field__label">Product</span>
                        <strong class="code-style">@Document.ProductCode</strong>
                        <small>@Document.ProductDescription</small>
                    </div>
                    <div class="pr-issue-meta__item">
                        <span class="iv-field__label">Issue date</span>
                        <strong>@Document.IssueDate.ToString("dd MMM yyyy HH:mm")</strong>
                    </div>
                    <div class="pr-issue-meta__item">
                        <span class="iv-field__label">Planned</span>
                        <strong>@Document.PlannedQty.ToString("n4") @Document.OutputUom</strong>
                    </div>
                    <div class="pr-issue-meta__item">
                        <span class="iv-field__label">Material requirement basis</span>
                        <strong>@(Document.ProductionQtyThisIssue?.ToString("n4") ?? "—")</strong>
                    </div>
                    <div class="pr-issue-meta__item">
                        <span class="iv-field__label">Posted by</span>
                        <strong>@(string.IsNullOrWhiteSpace(Document.PostedBy) ? "—" : Document.PostedBy)</strong>
                        <small>@(Document.PostedDate?.ToString("dd MMM yyyy HH:mm") ?? "—")</small>
                    </div>
                    <div class="pr-issue-meta__item pr-issue-meta__item--wide">
                        <span class="iv-field__label">Remark</span>
                        <strong>@(string.IsNullOrWhiteSpace(Document.Remark) ? "—" : Document.Remark)</strong>
                    </div>
                </div>
            </section>

            <section class="iv-card pr-issue-lines">
                <div class="pr-issue-lines__head">
                    <div>
                        <p class="iv-eyebrow">Lines</p>
                        <h2 class="pr-issue-lines__title">Issued materials</h2>
                    </div>
                </div>
                <DxGrid Data="@Document.Lines"
                        KeyFieldName="@nameof(ProductionMaterialIssueDocumentLine.InventoryLineNo)"
                        ShowFilterRow="false"
                        ShowGroupPanel="false"
                        ShowSearchBox="false"
                        TextWrapEnabled="false"
                        PageSize="20"
                        ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                        CssClass="pr-issue-grid">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialIssueDocumentLine.InventoryLineNo)" Caption="#" Width="56px" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialIssueDocumentLine.ItemCode)" Caption="Item" MinWidth="180">
                            <CellDisplayTemplate>
                                @{
                                    var line = (ProductionMaterialIssueDocumentLine)context.DataItem;
                                }
                                <div class="pr-issue-cell">
                                    <span class="pr-issue-cell__primary code-style">@line.ItemCode</span>
                                    <span class="pr-issue-cell__secondary">@line.Warehouse / @line.Location · @(string.IsNullOrWhiteSpace(line.LotNo) ? "No lot" : line.LotNo)</span>
                                </div>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialIssueDocumentLine.IssueQty)" Caption="Issue qty" Width="130px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right">
                            <CellDisplayTemplate>
                                @{
                                    var qtyLine = (ProductionMaterialIssueDocumentLine)context.DataItem;
                                }
                                <span>@qtyLine.IssueQty.ToString("n4") @qtyLine.Uom</span>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialIssueDocumentLine.BaseQty)" Caption="Base qty" Width="130px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right">
                            <CellDisplayTemplate>
                                @{
                                    var baseLine = (ProductionMaterialIssueDocumentLine)context.DataItem;
                                }
                                <span>@baseLine.BaseQty.ToString("n4") @baseLine.BaseUom</span>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialIssueDocumentLine.ItemStatus)" Caption="Status" Width="100px">
                            <CellDisplayTemplate>
                                <span class="iv-status">@(((ProductionMaterialIssueDocumentLine)context.DataItem).ItemStatus)</span>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        @if (Document.CanViewCost)
                        {
                            <DxGridDataColumn FieldName="@nameof(ProductionMaterialIssueDocumentLine.UnitCost)" Caption="Unit cost" Width="110px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                            <DxGridDataColumn FieldName="@nameof(ProductionMaterialIssueDocumentLine.TotalCost)" Caption="Total cost" Width="110px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        }
                    </Columns>
                </DxGrid>
            </section>
        }
        else if (Workspace is null)
        {
            <section class="iv-card">
                <header class="pr-issue-section-head">
                    <div>
                        <strong>Find Work Order operation</strong>
                        <small>Select an eligible released operation to issue materials against.</small>
                    </div>
                </header>

                <DxFormLayout SizeMode="SizeMode.Small" CssClass="pr-issue-form">
                    <DxFormLayoutItem Caption="Work Order" ColSpanMd="4">
                        <Template>
                            <DxComboBox Data="@FilterOptions.WorkOrders"
                                        TextFieldName="@nameof(ProductionMaterialIssueFilterChoice.Label)"
                                        ValueFieldName="@nameof(ProductionMaterialIssueFilterChoice.Code)"
                                        @bind-Value="@SearchWo"
                                        NullText="All eligible Work Orders"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                        SearchMode="ListSearchMode.AutoSearch"
                                        SearchFilterCondition="ListSearchFilterCondition.Contains" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Work Centre" ColSpanMd="4">
                        <Template>
                            <DxComboBox Data="@FilterOptions.WorkCentres"
                                        @bind-Value="@SearchWorkCentre"
                                        NullText="All work centres"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                        SearchMode="ListSearchMode.AutoSearch"
                                        SearchFilterCondition="ListSearchFilterCondition.Contains" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Process" ColSpanMd="4">
                        <Template>
                            <DxComboBox Data="@FilterOptions.Processes"
                                        TextFieldName="@nameof(ProductionMaterialIssueFilterChoice.Label)"
                                        ValueFieldName="@nameof(ProductionMaterialIssueFilterChoice.Code)"
                                        @bind-Value="@SearchProcess"
                                        NullText="All processes"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                        SearchMode="ListSearchMode.AutoSearch"
                                        SearchFilterCondition="ListSearchFilterCondition.Contains" />
                        </Template>
                    </DxFormLayoutItem>
                    @if (MoreFiltersVisible)
                    {
                        <DxFormLayoutItem Caption="Product" ColSpanMd="3">
                            <Template>
                                <DxComboBox Data="@FilterOptions.Products"
                                            @bind-Value="@SearchProduct"
                                            NullText="All products"
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                            SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.Contains" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Output Item" ColSpanMd="3">
                            <Template>
                                <DxComboBox Data="@FilterOptions.OutputItems"
                                            @bind-Value="@SearchOutputItem"
                                            NullText="All output items"
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                            SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.Contains" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Raw Material" ColSpanMd="3">
                            <Template>
                                <DxComboBox Data="@FilterOptions.RawMaterials"
                                            @bind-Value="@SearchRawMaterial"
                                            NullText="All raw materials"
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                            SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.Contains" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Machine" ColSpanMd="3">
                            <Template>
                                <DxComboBox Data="@FilterOptions.Machines"
                                            @bind-Value="@SearchMachine"
                                            NullText="All machines"
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                            SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.Contains" />
                            </Template>
                        </DxFormLayoutItem>
                    }
                </DxFormLayout>

                <div class="pr-issue-filter-actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="@(MoreFiltersVisible ? "Fewer filters" : "More filters")"
                              IconCssClass="fa-solid fa-sliders"
                              Click="@ToggleMoreFilters" />
                    <div class="pr-issue-filter-actions__right">
                        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                  Text="CLEAR"
                                  Click="@ClearOperationFilters"
                                  Enabled="@(!IsSubmitting)" />
                        <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                  Text="FIND"
                                  IconCssClass="fa-solid fa-magnifying-glass"
                                  Click="@ApplyOperationFiltersAsync"
                                  Enabled="@(!IsSubmitting)" />
                    </div>
                </div>
            </section>

            <section class="iv-card pr-issue-lines">
                <div class="pr-issue-lines__head">
                    <div>
                        <p class="iv-eyebrow">Results</p>
                        <h2 class="pr-issue-lines__title">Matching operations</h2>
                    </div>
                    <span class="pr-issue-count">@OperationResultLabel · page @(OperationPage + 1) / @OperationPageCount</span>
                </div>

                @if (IsSubmitting)
                {
                    <div class="iv-skeleton" aria-busy="true">
                        <div class="iv-skeleton__line iv-skeleton__line--lg"></div>
                        <div class="iv-skeleton__line"></div>
                    </div>
                }
                else if (OperationRows.Count == 0)
                {
                    <div class="pr-issue-empty">
                        <div class="pr-issue-empty__icon" aria-hidden="true">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </div>
                        <h3>No eligible operations</h3>
                        <p>Change or clear the filters to see more Work Orders.</p>
                    </div>
                }
                else
                {
                    <div class="pr-issue-ops">
                        @foreach (var op in OperationRows)
                        {
                            <article class="pr-issue-op">
                                <div class="pr-issue-op__main">
                                    <div class="pr-issue-cell">
                                        <span class="pr-issue-cell__primary code-style">@op.WorkOrderNo</span>
                                        <span class="pr-issue-cell__secondary">@op.ProductCode · @op.ProductDescription</span>
                                    </div>
                                    <div class="pr-issue-cell">
                                        <span class="pr-issue-cell__primary">@(op.WorkCentreCode ?? "—") / @op.OperationCode</span>
                                        <span class="pr-issue-cell__secondary">@(op.OperationDescription ?? "—")</span>
                                    </div>
                                    <div class="pr-issue-cell">
                                        <span class="pr-issue-cell__primary code-style">@(op.OutputItemCode ?? "—")</span>
                                        <span class="pr-issue-cell__secondary">@(string.IsNullOrWhiteSpace(op.SelectedMachineCode) ? "No machine" : op.SelectedMachineCode)</span>
                                    </div>
                                    <div class="pr-issue-op__qty">
                                        <span class="iv-field__label">Planned</span>
                                        <strong>@op.PlannedOutputQty.ToString("n4") @op.PlannedOutputUom</strong>
                                    </div>
                                </div>
                                @if (!op.IsSequenceEligible)
                                {
                                    <span class="pr-issue-cell__warn">@op.SequenceBlockingReason</span>
                                }
                                else if (op.RemainingBasisQty <= 0m)
                                {
                                    <span class="pr-issue-cell__warn">No remaining basis quantity</span>
                                }
                                <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                          Text="@(op.IsSequenceEligible ? (op.RemainingBasisQty > 0m ? "SELECT" : "FULL") : "BLOCKED")"
                                          Click="@(() => ApplyOperationAsync(op))"
                                          Enabled="@(op.IsSequenceEligible && op.RemainingBasisQty > 0m && !IsSubmitting)" />
                            </article>
                        }
                    </div>

                    <div class="pr-issue-pager">
                        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                  Text="Previous"
                                  Click="@(() => ChangeOperationPageAsync(-1))"
                                  Enabled="@(OperationPage > 0 && !IsSubmitting)" />
                        <span>Page @(OperationPage + 1) of @OperationPageCount</span>
                        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                  Text="Next"
                                  Click="@(() => ChangeOperationPageAsync(1))"
                                  Enabled="@(OperationPage + 1 < OperationPageCount && !IsSubmitting)" />
                    </div>
                }
            </section>
        }
        else
        {
            <section class="iv-card">
                <header class="pr-issue-section-head">
                    <div>
                        <strong>Operation</strong>
                        <small>@Workspace.WorkOrderNo · @SelectedOperationRow?.OperationCode — @SelectedOperationRow?.OperationDescription</small>
                    </div>
                    <span class="pr-issue-pill">@Workspace.Status</span>
                </header>

                <div class="pr-issue-meta">
                    <div class="pr-issue-meta__item">
                        <span class="iv-field__label">Product</span>
                        <strong class="code-style">@Workspace.ProductCode</strong>
                        <small>@Workspace.ProductDescription</small>
                    </div>
                    <div class="pr-issue-meta__item">
                        <span class="iv-field__label">Work Centre</span>
                        <strong>@(SelectedOperationRow?.WorkCentreCode ?? "—")</strong>
                        <small>Stage @SelectedOperationRow?.StageSequence · Process @SelectedOperationRow?.ProcessSequence</small>
                    </div>
                    <div class="pr-issue-meta__item">
                        <span class="iv-field__label">Planned output</span>
                        <strong>@SelectedOperationRow?.PlannedOutputQty.ToString("n4") @SelectedOperationRow?.PlannedOutputUom</strong>
                        <small>Actual @SelectedOperationRow?.ActualOutputQty.ToString("n4") · Remaining basis @SelectedOperationRow?.RemainingBasisQty.ToString("n4")</small>
                    </div>
                    <div class="pr-issue-meta__item">
                        <span class="iv-field__label">Issue date &amp; time</span>
                        <DxDateEdit @bind-Date="@IssueDate"
                                    DisplayFormat="dd/MM/yyyy HH:mm"
                                    TimeSectionVisible="true"
                                    Enabled="@(!IsSubmitting)" />
                    </div>
                    <div class="pr-issue-meta__item pr-issue-meta__item--wide">
                        <span class="iv-field__label">Remark</span>
                        <DxMemo @bind-Text="@Remark"
                                Rows="2"
                                Enabled="@(!IsSubmitting)"
                                NullText="Optional note for this issue draft" />
                    </div>
                </div>
            </section>

            <section class="iv-card pr-issue-lines">
                <div class="pr-issue-lines__head">
                    <div>
                        <p class="iv-eyebrow">Materials</p>
                        <h2 class="pr-issue-lines__title">Choose what to issue</h2>
                    </div>
                    <label class="pr-issue-toggle">
                        <DxCheckBox @bind-Checked="@ShowShortageOnly" AllowIndeterminateState="false" />
                        <span>Shortage only</span>
                    </label>
                </div>

                <div class="pr-issue-desired">
                    <div class="pr-issue-desired__field">
                        <span class="iv-field__label">Material Requirement Basis Qty</span>
                        <div class="pr-issue-desired__input">
                            @if (SelectedOperationRow is { } selectedOperation && selectedOperation.RemainingBasisQty > 0m)
                            {
                                <DxSpinEdit @bind-Value="@DesiredOutputInput"
                                            MinValue="0m"
                                            MaxValue="@selectedOperation.RemainingBasisQty"
                                            Increment="0.0001m"
                                            DisplayFormat="n4"
                                            ShowSpinButtons="false"
                                            Enabled="@(!IsSubmitting)" />
                            }
                            else
                            {
                                <span class="pr-issue-desired__unavailable">No remaining basis quantity</span>
                            }
                            <span>@SelectedOperationRow?.PlannedOutputUom</span>
                        </div>
                        <small>Used only to calculate this issue’s BOM requirement — not recorded production output. Posted @SelectedOperationRow?.PostedBasisQty.ToString("n4") · Open drafts @SelectedOperationRow?.OpenDraftBasisQty.ToString("n4")</small>
                        @if (DesiredOutputDirty)
                        {
                            <small class="pr-issue-desired__warn">Desired output changed — run APPLY &amp; AUTO ALLOCATE again.</small>
                        }
                        else if (AppliedProductionQtyThisIssue is > 0)
                        {
                            <small>Applied @AppliedProductionQtyThisIssue.Value.ToString("n4")</small>
                        }
                    </div>
                    <DxButton RenderStyle="ButtonRenderStyle.Primary"
                              Text="APPLY &amp; AUTO ALLOCATE"
                              IconCssClass="fa-solid fa-wand-magic-sparkles"
                              Click="@ApplyDesiredOutputAndAllocateAsync"
                              Enabled="@CanApplyDesiredOutput" />
                </div>

                <DxGrid Data="@VisibleLineList"
                        KeyFieldName="@nameof(MaterialLineVm.Key)"
                        ShowFilterRow="false"
                        ShowGroupPanel="false"
                        ShowSearchBox="false"
                        TextWrapEnabled="false"
                        PageSize="30"
                        ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                        CssClass="pr-issue-grid">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(MaterialLineVm.ComponentCode)" Caption="Material" MinWidth="200">
                            <CellDisplayTemplate>
                                @{
                                    var line = (MaterialLineVm)context.DataItem;
                                }
                                <div class="pr-issue-cell @(line.Material.CanManualIssue ? null : "pr-issue-cell--muted")">
                                    <span class="pr-issue-cell__primary code-style">@line.Material.ComponentCode</span>
                                    <span class="pr-issue-cell__secondary">@line.Material.Description</span>
                                    <span class="pr-issue-cell__secondary">@line.Material.WarehouseCode · @line.Material.RequiredUom</span>
                                    @if (!line.Material.CanManualIssue && !string.IsNullOrWhiteSpace(line.Material.BlockingReason))
                                    {
                                        <span class="pr-issue-cell__warn">@line.Material.BlockingReason</span>
                                    }
                                </div>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(MaterialLineVm.RequiredQty)" Caption="Required" Width="100px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(MaterialLineVm.NetIssuedQty)" Caption="Issued" Width="100px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(MaterialLineVm.BomRequestedQty)" Caption="For this output" Width="120px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(MaterialLineVm.MaxIssueQty)" Caption="Max incl. tol." Width="120px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(MaterialLineVm.OtherDraftReservedBaseQty)" Caption="Reserved other IP" Width="130px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(MaterialLineVm.AvailableAfterDraftReservations)" Caption="Available to allocate" Width="135px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(MaterialLineVm.IssueQty)" Caption="Issue now" Width="150px">
                            <CellDisplayTemplate>
                                @{
                                    var editLine = (MaterialLineVm)context.DataItem;
                                    var maxIssueQty = editLine.MaxIssueQty > 0m
                                        ? editLine.MaxIssueQty
                                        : editLine.Material.AvailableToDraft + editLine.OriginalIssueQty;
                                }
                                <div class="pr-issue-qty">
                                    @if (maxIssueQty > 0m)
                                    {
                                        <DxSpinEdit @bind-Value="@editLine.IssueQty"
                                                    @bind-Value:after="OnIssueQtyEdited"
                                                    MinValue="0m"
                                                    MaxValue="@maxIssueQty"
                                                    Increment="0.0001m"
                                                    DisplayFormat="n4"
                                                    ShowSpinButtons="false"
                                                    Enabled="@(editLine.Material.CanManualIssue && !IsSubmitting)"
                                                    CssClass="pr-issue-qty__input" />
                                    }
                                    else
                                    {
                                        <span class="pr-issue-qty__unavailable">@editLine.IssueQty.ToString("n4")</span>
                                    }
                                    <span>@editLine.Material.RequiredUom</span>
                                </div>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn Caption="Excess reason" MinWidth="200">
                            <CellDisplayTemplate>
                                @{ var reasonLine = (MaterialLineVm)context.DataItem; }
                                @if (reasonLine.RequiresExcessReason)
                                {
                                    <DxTextBox @bind-Text="reasonLine.ExcessIssueReason" NullText="Required above BOM standard" Enabled="@(!IsSubmitting)" />
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn Caption="Allocation" Width="160px">
                            <CellDisplayTemplate>
                                @{
                                    var allocLine = (MaterialLineVm)context.DataItem;
                                }
                                <div class="pr-issue-alloc">
                                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                              RenderStyleMode="ButtonRenderStyleMode.Outline"
                                              Text="STOCK"
                                              IconCssClass="fa-solid fa-layer-group"
                                              Click="@(() => OpenAllocation(allocLine))"
                                              Enabled="@(allocLine.Material.CanManualIssue && allocLine.IssueQty > 0 && !IsSubmitting)" />
                                    @if (allocLine.IssueQty > 0)
                                    {
                                        <span class="@(IsFullyAllocated(allocLine) ? "pr-issue-alloc__ok" : "pr-issue-alloc__warn")">
                                            @AllocationHint(allocLine)
                                        </span>
                                    }
                                </div>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                    </Columns>
                    <EmptyDataAreaTemplate>
                        <div class="pr-issue-empty">
                            <div class="pr-issue-empty__icon" aria-hidden="true">
                                <i class="fa-solid fa-boxes-stacked"></i>
                            </div>
                            <h3>No materials</h3>
                            <p>@(ShowShortageOnly ? "No shortage lines for this filter." : "This operation has no issuable materials.")</p>
                        </div>
                    </EmptyDataAreaTemplate>
                </DxGrid>
            </section>

            <footer class="pr-issue-footer">
                <p class="pr-issue-footer__hint">
                    @if (SelectedLineCount == 0)
                    {
                        @:Enter issue quantities, allocate stock, then save the draft.
                    }
                    else if (UnallocatedLineCount > 0)
                    {
                        @($"{SelectedLineCount} material(s) selected · {UnallocatedLineCount} still need stock allocation")
                    }
                    else
                    {
                        @($"{SelectedLineCount} material(s) selected · all allocated")
                    }
                </p>
                <div class="pr-issue-footer__actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="CANCEL"
                              IconCssClass="fa-solid fa-xmark"
                              Click="@BackToList"
                              Enabled="@(!IsSubmitting)" />
                    <DxButton RenderStyle="ButtonRenderStyle.Primary"
                              Text="@(IsSubmitting ? "Saving…" : "SAVE DRAFT")"
                              IconCssClass="fa-solid fa-floppy-disk"
                              Click="@SaveAsync"
                              Enabled="@(!IsViewMode && CanSaveDocument && !IsSubmitting)" />
                </div>
            </footer>
        }
    </div>

    <PrMaterialAllocationDialog @bind-Visible="@AllocationVisible"
                                Material="@AllocationLine?.Material"
                                IssueDate="@IssueDate"
                                RequestedQty="@(AllocationLine?.IssueQty ?? 0m)"
                                Allocations="@(AllocationLine?.Allocations ?? [])"
                                ReservedByOtherLines="@ReservedByOtherLines"
                                ExcludeBatchNo="@(IsEditMode ? BatchNo : null)"
                                Applied="@ApplyAllocations" />
    <PrMaterialIssueBomDialog @bind-Visible="@BomVisible"
                              Operation="@SelectedOperationRow"
                              TrxDateTime="@IssueDate"
                              ExcludeBatchNo="@(IsEditMode ? BatchNo : null)"
                              Applied="@ApplyBomResult" />
</MenuAuthorize>
