@page "/planning/work-orders/machine-schedule"
@using DevExpress.Blazor
@using ErpWeb.Core.Menus
@using ErpWeb.Core.Production
@using ErpWeb.Model.Entities.Production
@using ErpWeb.UI.Components.Pages
@inherits PageBase
<PageTitle>Machine Schedule</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.PlanningMachineSchedulePlanner">
    <div class="iv-page pr-machine-schedule-page" aria-busy="@IsLoading">
        <header class="iv-hero">
            <div class="iv-hero__mark" aria-hidden="true"><i class="fa-solid fa-calendar-week"></i></div>
            <div class="iv-hero__copy">
                <span class="iv-hero__eyebrow">Planning · Production</span>
                <h1>Machine Schedule</h1>
                <p>Review machine load, Work Order timing and maintenance. Move eligible jobs only after schedule preview.</p>
            </div>
            <div class="pr-machine-schedule-hero-meta">
                <div class="pr-machine-schedule-mode" role="status">
                    <i class="fa-solid @(CanDragAppointments ? "fa-calendar-check" : "fa-lock")" aria-hidden="true"></i>
                    <span>@ScheduleModeText</span>
                </div>
                <span class="pr-machine-schedule-period-chip">@PeriodLabel</span>
            </div>
            <div class="iv-hero__kpi">
                <span>Late vs DR date</span>
                <strong>@(Board?.LateWorkOrderCount.ToString("N0") ?? "—")</strong>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="pr-machine-schedule-feedback" role="alert">@ErrorMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <div class="pr-machine-schedule-feedback pr-machine-schedule-feedback--info" role="status">@StatusMessage</div>
        }

        @if (!CanDragAppointments)
        {
            <section class="pr-machine-schedule-readonly" role="status">
                <i class="fa-solid fa-lock" aria-hidden="true"></i>
                <div>
                    <strong>Schedule changes are currently disabled</strong>
                    <span>You can still review machine load, reserved time and Work Order timing.</span>
                    <span>@ViewOnlyReason</span>
                </div>
            </section>
        }

        @if (Board is { NeedsCapacityAttention: true })
        {
            <section class="pr-machine-schedule-capacity-warning" role="alert">
                <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
                <div>
                    <strong>Machine capacity data needs attention</strong>
                    <span>Some reserved time may be incomplete; schedule changes remain disabled until verification passes.</span>
                </div>
            </section>
        }

        <section class="iv-card pr-machine-schedule-toolbar" aria-label="Schedule planner controls">
            <div class="pr-machine-schedule-toolbar__top">
                <div class="pr-machine-schedule-toolbar__nav">
                    <DxButton Text="Previous" RenderStyle="ButtonRenderStyle.Secondary" Click="PreviousPeriodAsync" />
                    <DxButton Text="Today" RenderStyle="ButtonRenderStyle.Secondary" Click="TodayAsync" />
                    <DxButton Text="Next" RenderStyle="ButtonRenderStyle.Secondary" Click="NextPeriodAsync" />
                    <span class="pr-machine-schedule-period">@PeriodLabel</span>
                </div>
                <div class="pr-machine-schedule-toolbar__views" role="group" aria-label="Timeline range">
                    <DxButton Text="Day" RenderStyle="@ViewButtonStyle(PlannerView.Day)" Click="@(() => ChangeViewAsync(PlannerView.Day))" />
                    <DxButton Text="Week" RenderStyle="@ViewButtonStyle(PlannerView.Week)" Click="@(() => ChangeViewAsync(PlannerView.Week))" />
                    <DxButton Text="Month" RenderStyle="@ViewButtonStyle(PlannerView.Month)" Click="@(() => ChangeViewAsync(PlannerView.Month))" />
                </div>
                <div class="pr-machine-schedule-toolbar__zoom" role="group" aria-label="Timeline zoom">
                    <span>Zoom</span>
                    <DxButton Text="−" Title="Zoom out" RenderStyle="ButtonRenderStyle.Secondary" Click="ZoomOut" Enabled="@(ZoomLevel > MinimumZoomLevel)" />
                    <DxButton Text="+" Title="Zoom in" RenderStyle="ButtonRenderStyle.Secondary" Click="ZoomIn" Enabled="@(ZoomLevel < 3)" />
                    <DxButton Text="Reset" RenderStyle="ButtonRenderStyle.Secondary" Click="ResetZoom" Enabled="@(ZoomLevel != 0)" />
                </div>
            </div>

            <div class="pr-machine-schedule-toolbar__filters" aria-label="Schedule filters">
                <label class="pr-machine-schedule-filter pr-machine-schedule-filter--search">
                    <span>Search</span>
                    <DxTextBox Text="@SearchText" TextChanged="@OnSearchTextChangedAsync"
                               NullText="WO, DR, product or process"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </label>
                <label class="pr-machine-schedule-filter pr-machine-schedule-filter--centre">
                    <span>Work Centre</span>
                    <DxComboBox TData="MachineSchedulePlannerLookupOption" TValue="string"
                                CustomData="@LoadWorkCentreOptionsAsync"
                                TextFieldName="@nameof(MachineSchedulePlannerLookupOption.DisplayText)"
                                ValueFieldName="@nameof(MachineSchedulePlannerLookupOption.Key)"
                                @bind-Value="SelectedWorkCentre" @bind-Value:after="ReloadAsync"
                                NullText="All work centres" SearchMode="ListSearchMode.AutoSearch"
                                ListRenderMode="ListRenderMode.Virtual"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </label>
                <label class="pr-machine-schedule-filter pr-machine-schedule-filter--machine">
                    <span>Machine</span>
                    <DxComboBox TData="MachineSchedulePlannerLookupOption" TValue="string"
                                CustomData="@LoadMachineOptionsAsync"
                                TextFieldName="@nameof(MachineSchedulePlannerLookupOption.DisplayText)"
                                ValueFieldName="@nameof(MachineSchedulePlannerLookupOption.Key)"
                                @bind-Value="SelectedMachine" @bind-Value:after="ReloadAsync"
                                NullText="All machines" SearchMode="ListSearchMode.AutoSearch"
                                ListRenderMode="ListRenderMode.Virtual"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </label>
                <label class="pr-machine-schedule-filter pr-machine-schedule-filter--workorder">
                    <span>Work Order</span>
                    <DxComboBox TData="MachineSchedulePlannerLookupOption" TValue="string"
                                CustomData="@LoadWorkOrderOptionsAsync"
                                TextFieldName="@nameof(MachineSchedulePlannerLookupOption.DisplayText)"
                                ValueFieldName="@nameof(MachineSchedulePlannerLookupOption.Key)"
                                @bind-Value="SelectedWorkOrder" @bind-Value:after="OnWorkOrderSelectionChangedAsync"
                                NullText="Search Work Order" SearchMode="ListSearchMode.AutoSearch"
                                ListRenderMode="ListRenderMode.Virtual"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </label>
                <label class="pr-machine-schedule-filter pr-machine-schedule-filter--idle">
                    <span>Idle machines</span>
                    <span class="pr-machine-schedule-idle-toggle">
                        <DxCheckBox Checked="ShowIdleMachines" CheckedChanged="@((bool value) => OnShowIdleMachinesChanged(value))"
                                    AllowIndeterminateState="false" />
                        <span>Show idle machines</span>
                    </span>
                </label>
                <div class="pr-machine-schedule-filter-actions">
                    <DxButton Text="@MoreFiltersText" RenderStyle="ButtonRenderStyle.Secondary" Click="OpenMoreFilters" />
                    <DxButton Text="Refresh" RenderStyle="ButtonRenderStyle.Primary" Click="ReloadAsync" Enabled="@(!IsLoading)" />
                </div>
            </div>
        </section>

        @if (IsLoading && Board is null)
        {
            <section class="iv-card pr-machine-schedule-loading" role="status">
                <span class="pr-machine-schedule-spinner" aria-hidden="true"></span>
                <span>Loading the visible machine schedule…</span>
            </section>
        }
        else if (Board is { } board)
        {
            <div class="pr-machine-schedule-summary" aria-label="Schedule summary">
                <span><strong>@board.Machines.Count</strong> machines</span>
                <span><strong>@board.Jobs.Count</strong> scheduled operations</span>
                <span><strong>@board.LockedJobCount</strong> locked by execution state</span>
                <span><strong>@board.LateWorkOrderCount</strong> late vs DR date</span>
                <span title="Distinct Work Orders whose active DR required date falls inside this period."><strong>@board.DueThisWindowWorkOrderCount</strong> DR due this period</span>
                <span><strong>@board.VisibleMaintenanceMachineCount</strong> machines with maintenance</span>
                <span><strong>@board.ExternalCapacityMachineCount</strong> machines reserved by other branches</span>
                @if (board.AttentionCountsArePartial)
                {
                    <span class="pr-machine-schedule-summary__warning">Counts are based on loaded operations.</span>
                }
                @if (board.HasMoreJobsThanLimit)
                {
                    <span class="pr-machine-schedule-summary__warning">Showing the first 3,000 operations; narrow the date range or filters.</span>
                }
                @if (board.HasMoreIdleMachinesThanLimit)
                {
                    <span class="pr-machine-schedule-summary__warning">More than 500 idle machines exist; scheduled machines in this window remain included.</span>
                }
                @if (board.UnverifiedJobCount > 0)
                {
                    <span class="pr-machine-schedule-summary__warning"><strong>@board.UnverifiedJobCount</strong> scheduled operation(s) could not be verified against the current machine calendar.</span>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(SelectedWorkOrder) && !IsSelectedWorkOrderVisibleInPeriod)
            {
                <section class="pr-machine-schedule-period-note" role="status">
                    <i class="fa-regular fa-calendar" aria-hidden="true"></i>
                    <span>Selected Work Order is not scheduled in this period.</span>
                    <DxButton Text="Go to WO schedule" RenderStyle="ButtonRenderStyle.Secondary" Click="GoToWorkOrderScheduleAsync" />
                </section>
            }

            @if (board.Machines.Count == 0)
            {
                <section class="iv-card pr-machine-schedule-empty" role="status">
                    <i class="fa-regular fa-calendar-xmark" aria-hidden="true"></i>
                    <strong>No machines are visible for this scope</strong>
                    <span>Clear the current filters, enable idle machines, or choose another date range.</span>
                </section>
            }
            else
            {
                @if (board.Jobs.Count == 0)
                {
                    <section class="pr-machine-schedule-period-note" role="status">
                        <i class="fa-regular fa-rectangle-list" aria-hidden="true"></i>
                        <span>@NoJobsInPeriodMessage</span>
                    </section>
                }

                <section class="iv-card pr-machine-schedule-board" aria-label="Machine timeline">
                    <DxScheduler DataStorage="@DataStorage"
                                 StartDate="@board.WindowStart"
                                 ActiveViewType="SchedulerViewType.Timeline"
                                 GroupType="SchedulerGroupType.Resource"
                                 AllowCreateAppointment="false"
                                 AllowDeleteAppointment="false"
                                 AllowEditAppointment="@CanDragAppointments"
                                 AllowDragAppointment="@CanDragAppointments"
                                 AllowDragAppointmentBetweenResources="false"
                                 AllowResizeAppointment="false"
                                 AppointmentDragMode="SchedulerAppointmentDragMode.Server"
                                 AppointmentStartDragging="OnAppointmentStartDragging"
                                 AppointmentUpdating="OnAppointmentUpdating"
                                 AppointmentFormShowing="OnAppointmentFormShowing"
                                 HtmlCellDecoration="DecorateCalendarCell"
                                 @bind-SelectedAppointment="SelectedAppointment"
                                 @bind-SelectedAppointment:after="OnAppointmentSelectedAsync">
                        <DxSchedulerTimelineView Duration="@ViewDuration" CellMinWidth="@TimelineCellWidth" VerticalResourceCellWidth="200">
                            <Scales>
                                @if (CurrentView == PlannerView.Month)
                                {
                                    <DxSchedulerTimeScale Unit="SchedulerTimeScaleUnit.Week" UnitCount="1" />
                                    <DxSchedulerTimeScale Unit="SchedulerTimeScaleUnit.Day" UnitCount="1" />
                                }
                                else if (CurrentView == PlannerView.Day)
                                {
                                    <DxSchedulerTimeScale Unit="SchedulerTimeScaleUnit.Day" UnitCount="1" />
                                    <DxSchedulerTimeScale Unit="SchedulerTimeScaleUnit.Hour" UnitCount="1" />
                                }
                                else
                                {
                                    <DxSchedulerTimeScale Unit="SchedulerTimeScaleUnit.Day" UnitCount="1" />
                                    <DxSchedulerTimeScale Unit="SchedulerTimeScaleUnit.Hour" UnitCount="6" />
                                }
                            </Scales>
                            <DateHeaderCellTemplate>
                                <div class="pr-machine-schedule-date-header"
                                     title="@($"{context.Interval.Start:dddd, dd MMMM yyyy HH:mm} – {context.Interval.End:dddd, dd MMMM yyyy HH:mm}")">
                                    @if (context.Scale.Unit == SchedulerTimeScaleUnit.Hour)
                                    {
                                        <span>@context.Interval.Start.ToString("HH:mm")</span>
                                    }
                                    else if (context.Scale.Unit == SchedulerTimeScaleUnit.Week)
                                    {
                                        <span>Week of @context.Interval.Start.ToString("dd MMM")</span>
                                    }
                                    else if (context.Scale.Unit == SchedulerTimeScaleUnit.Month)
                                    {
                                        <span>@context.Interval.Start.ToString("MMMM yyyy")</span>
                                    }
                                    else if (CurrentView == PlannerView.Month)
                                    {
                                        <span>@context.Interval.Start.ToString("dd ddd")</span>
                                    }
                                    else
                                    {
                                        <span>@context.Interval.Start.ToString("ddd, dd MMM")</span>
                                    }
                                </div>
                            </DateHeaderCellTemplate>
                            <ResourceHeaderCellTemplate>
                                @{
                                    var machineCode = context.Resource.Id?.ToString();
                                    var resourceMachine = board.Machines.FirstOrDefault(x =>
                                        string.Equals(x.MachineCode, machineCode, StringComparison.OrdinalIgnoreCase));
                                }
                                @if (resourceMachine is null)
                                {
                                    <div class="pr-machine-schedule-resource" title="@context.Resource.Caption">
                                        <strong>@context.Resource.Caption</strong>
                                    </div>
                                }
                                else
                                {
                                    <div class="pr-machine-schedule-resource" title="@resourceMachine.DisplayName">
                                        <strong>@resourceMachine.MachineCode</strong>
                                        @if (!string.IsNullOrWhiteSpace(resourceMachine.MachineDescription))
                                        {
                                            <span>@resourceMachine.MachineDescription</span>
                                        }
                                    </div>
                                }
                            </ResourceHeaderCellTemplate>
                        </DxSchedulerTimelineView>
                    </DxScheduler>
                </section>

                <section class="iv-card pr-machine-schedule-details" aria-label="Selected schedule details">
                    <button class="pr-machine-schedule-details__toggle" type="button"
                            aria-expanded="@IsDetailsOpen" @onclick="ToggleDetails">
                        <span>
                            <strong>@DetailsHeading</strong>
                            <small>@DetailsSubheading</small>
                        </span>
                        <i class="fa-solid @(IsDetailsOpen ? "fa-chevron-up" : "fa-chevron-down")" aria-hidden="true"></i>
                    </button>
                    @if (IsDetailsOpen)
                    {
                        @if (SelectedJob is { } job)
                        {
                            <div class="pr-machine-schedule-details__body">
                                <div class="pr-machine-schedule-details__head">
                                    <span class="pr-machine-schedule-details__eyebrow">@(CanOpenReschedule ? "Selected operation · Change allowed" : "Selected operation · View only")</span>
                                    <h2>@job.WorkOrderNo</h2>
                                    <span class="pr-machine-schedule-status">@job.WorkOrderStatus · @job.ExecutionStatus</span>
                                </div>
                                <dl>
                                    <div><dt>Product</dt><dd>@job.ProductCode @DescriptionSuffix(job.ProductDescription)</dd></div>
                                    <div><dt>Work Order status</dt><dd>@job.WorkOrderStatus</dd></div>
                                    <div><dt>Execution status</dt><dd>@job.ExecutionStatus</dd></div>
                                    <div><dt>Demand source</dt><dd>@DemandSourceText(job)</dd></div>
                                    <div><dt>DR No</dt><dd>@(job.DeliveryRequestNo ?? "—")</dd></div>
                                    <div><dt>DR header status</dt><dd>@(job.DeliveryRequestStatus ?? "—")</dd></div>
                                    <div><dt>Current DR Required Date</dt><dd>@(job.RequiredDate?.ToString("dd MMM yyyy") ?? "—")</dd></div>
                                    <div><dt>Current Priority</dt><dd>@(job.Priority ?? "—")</dd></div>
                                    <div><dt>Project</dt><dd>@(job.ProjectCode ?? "—")</dd></div>
                                    <div><dt>WO planned start</dt><dd>@job.WorkOrderPlannedStart.ToString("dd MMM yyyy HH:mm")</dd></div>
                                    <div><dt>WO planned completion</dt><dd>@job.WorkOrderPlannedCompletion.ToString("dd MMM yyyy HH:mm")</dd></div>
                                    <div><dt>Late vs DR date</dt><dd>@LateText(job)</dd></div>
                                    <div><dt>Work Centre</dt><dd>@job.WorkCentreCode @DescriptionSuffix(job.WorkCentreDescription)</dd></div>
                                    <div><dt>Operation</dt><dd>@job.OperationCode @DescriptionSuffix(job.OperationDescription)</dd></div>
                                    <div><dt>Machine</dt><dd>@job.MachineCode @DescriptionSuffix(job.MachineDescription)</dd></div>
                                    <div><dt>Planned quantity</dt><dd>@job.PlannedQuantity.ToString("n4") @job.OutputUom</dd></div>
                                    <div><dt>Productive duration</dt><dd>@job.ProductiveDurationMinutes.ToString("n1") min</dd></div>
                                    <div><dt>Operation planned start</dt><dd>@job.PlannedStart.ToString("dd MMM yyyy HH:mm")</dd></div>
                                    <div><dt>Operation planned completion</dt><dd>@job.PlannedCompletion.ToString("dd MMM yyyy HH:mm")</dd></div>
                                </dl>
                                @if (job.IsLocked && !string.IsNullOrWhiteSpace(job.LockReason))
                                {
                                    <p class="pr-machine-schedule-lock-reason"><i class="fa-solid fa-lock" aria-hidden="true"></i> @job.LockReason</p>
                                }
                                <div class="pr-machine-schedule-details__actions">
                                    <DxButton Text="Open Work Order" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => OpenWorkOrder(job))" Enabled="@CanOpenWorkOrders" />
                                    <DxButton Text="Change Schedule" RenderStyle="ButtonRenderStyle.Primary"
                                              Click="OpenRescheduleDialog" Enabled="@CanOpenReschedule" />
                                    @if (!CanOpenReschedule)
                                    {
                                        <span>@RescheduleUnavailableReason</span>
                                    }
                                </div>
                            </div>
                        }
                        else if (SelectedExternalCapacityAppointment is { } external)
                        {
                            <div class="pr-machine-schedule-details__body">
                                <div class="pr-machine-schedule-details__head">
                                    <span class="pr-machine-schedule-details__eyebrow">Reserved capacity · other branch</span>
                                    <h2>Reserved · other branch</h2>
                                    <span class="pr-machine-schedule-status">@external.ResourceId · @external.Start.ToString("dd MMM yyyy HH:mm") → @external.End.ToString("dd MMM yyyy HH:mm")</span>
                                </div>
                                <p class="pr-machine-schedule-external-note">
                                    This physical machine capacity is already reserved outside the current branch.
                                    Another branch owns this time; its Work Order, product, customer and quantity are not shown here.
                                </p>
                                <div class="pr-machine-schedule-details__actions">
                                    <span>This reserved capacity cannot be opened or changed from this branch.</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="pr-machine-schedule-details__empty">
                                <i class="fa-regular fa-hand-pointer" aria-hidden="true"></i>
                                <strong>Select a schedule bar</strong>
                                <span>Work Order, operation, machine and execution details will appear here.</span>
                            </div>
                        }
                    }
                </section>
            }

            <section class="pr-machine-schedule-legend" aria-label="Timeline legend">
                <span><i class="pr-machine-schedule-legend__swatch pr-machine-schedule-legend__swatch--scheduled"></i>Scheduled</span>
                <span><i class="pr-machine-schedule-legend__swatch pr-machine-schedule-legend__swatch--locked"></i>Execution locked</span>
                <span><i class="pr-machine-schedule-legend__swatch pr-machine-schedule-legend__swatch--maintenance"></i>Preventive maintenance</span>
                <span><i class="pr-machine-schedule-legend__swatch pr-machine-schedule-legend__swatch--late"></i>Late vs DR date</span>
                <span><i class="pr-machine-schedule-legend__swatch pr-machine-schedule-legend__swatch--external"></i>Reserved · other branch</span>
                <span><i class="pr-machine-schedule-legend__swatch pr-machine-schedule-legend__swatch--off"></i>Nonworking</span>
            </section>

            <details class="iv-card pr-machine-schedule-diagnostics">
                <summary>
                    <span>Planner diagnostics</span>
                    <small>Readiness evidence, allocation verification and backfill maintenance.</small>
                </summary>
                <div class="pr-machine-schedule-diagnostics__body">
                    <div class="pr-machine-schedule-diagnostics__status">
                        <span>Runtime readiness: <strong>@(board.Readiness.IsWriteReady ? "Write ready" : "View only")</strong></span>
                        <span>Write setting: <strong>@(board.Readiness.WriteSettingEnabled ? "Enabled" : "Disabled")</strong></span>
                        <span>Allocation schema: <strong>@(board.Readiness.AllocationSchemaReady ? "Ready" : "Not ready")</strong></span>
                        <span>Missing allocations: <strong>@board.Readiness.UnverifiedActiveAllocations</strong></span>
                        <span>Stale provenance: <strong>@board.Readiness.StaleAllocations</strong></span>
                        <span>Unexplained overlaps: <strong>@board.Readiness.UnexplainedActiveMachineOverlaps</strong></span>
                    </div>
                    @if (board.Readiness.BlockingReasons.Count > 0)
                    {
                        <ul class="pr-machine-schedule-diagnostics__reasons">
                            @foreach (var reason in board.Readiness.BlockingReasons)
                            {
                                <li>@reason</li>
                            }
                        </ul>
                    }
                    <div class="pr-machine-schedule-diagnostics__actions">
                        @if (CanManageAllocationBackfill)
                        {
                            <DxButton Text="Dry-run allocations" RenderStyle="ButtonRenderStyle.Secondary"
                                      Click="PreviewAllocationBackfillAsync" Enabled="@(!IsBackfillBusy)" />
                        }
                        @if (CanRefreshReadinessEvidence)
                        {
                            <DxButton Text="Refresh readiness evidence" RenderStyle="ButtonRenderStyle.Secondary"
                                      Click="RefreshReadinessEvidenceAsync" Enabled="@(!IsBackfillBusy && !IsLoading)" />
                        }
                    </div>
                </div>
            </details>

            @if (IsRescheduleDialogOpen && RescheduleDialogJob is { } rescheduleJob)
            {
                <div class="pr-machine-schedule-dialog-backdrop">
                    <section class="pr-machine-schedule-dialog iv-card" role="dialog" aria-modal="true"
                             aria-labelledby="pr-machine-schedule-dialog-title">
                        <header class="pr-machine-schedule-dialog__header">
                            <div>
                                <span class="iv-hero__eyebrow">Schedule preview</span>
                                <h2 id="pr-machine-schedule-dialog-title">Change @rescheduleJob.WorkOrderNo · @rescheduleJob.OperationCode</h2>
                                <p>@rescheduleJob.MachineCode · @rescheduleJob.PlannedStart.ToString("dd MMM yyyy HH:mm") to @rescheduleJob.PlannedCompletion.ToString("dd MMM yyyy HH:mm")</p>
                            </div>
                            <button type="button" class="pr-machine-schedule-dialog__close" aria-label="Close" @onclick="CloseRescheduleDialog" disabled="@IsRescheduleBusy">×</button>
                        </header>

                        <div class="pr-machine-schedule-dialog__inputs">
                            <label>
                                <span>Requested date</span>
                                <input type="date" value="@RequestedDateText" @onchange="OnRequestedDateChanged" disabled="@IsRescheduleBusy" />
                            </label>
                            <label>
                                <span>Requested time</span>
                                <input type="time" step="60" value="@RequestedTimeText" @onchange="OnRequestedTimeChanged" disabled="@IsRescheduleBusy" />
                            </label>
                            <label class="pr-machine-schedule-dialog__reason">
                                <span>Reason</span>
                                <textarea maxlength="500" rows="3" @bind="RescheduleReason" @bind:after="InvalidateReschedulePreview"
                                          placeholder="Why does this schedule need to change?" disabled="@IsRescheduleBusy"></textarea>
                            </label>
                        </div>

                        @if (ReschedulePreview is { } preview)
                        {
                            <div class="pr-machine-schedule-preview" aria-live="polite">
                                <div class="pr-machine-schedule-preview__summary">
                                    <strong>Target operation</strong>
                                    <span>@(preview.ProposedStart?.ToString("dd MMM yyyy HH:mm") ?? "—") → @(preview.ProposedCompletion?.ToString("dd MMM yyyy HH:mm") ?? "—")</span>
                                </div>
                                <div class="pr-machine-schedule-preview__summary">
                                    <strong>Work Order window</strong>
                                    <span>@preview.WorkOrderStartBefore.ToString("dd MMM HH:mm") – @preview.WorkOrderCompletionBefore.ToString("dd MMM HH:mm")
                                        → @(preview.WorkOrderStartAfter?.ToString("dd MMM HH:mm") ?? "—") – @(preview.WorkOrderCompletionAfter?.ToString("dd MMM HH:mm") ?? "—")</span>
                                </div>
                                @if (RescheduleDemandAdvisory is { } advisory)
                                {
                                    <div class="pr-machine-schedule-preview__summary pr-machine-schedule-preview__advisory">
                                        <strong>DR required date comparison</strong>
                                        <span>@advisory</span>
                                    </div>
                                }
                                @if (preview.Changes.Count > 0)
                                {
                                    <div class="pr-machine-schedule-preview__changes">
                                        <strong>Operations affected (@preview.Changes.Count)</strong>
                                        <ul>
                                            @foreach (var change in preview.Changes)
                                            {
                                                <li>
                                                    <span>@change.OperationCode @DescriptionSuffix(change.OperationDescription) · @change.MachineCode</span>
                                                    <small>@change.BeforeStart.ToString("dd MMM HH:mm") – @change.BeforeCompletion.ToString("dd MMM HH:mm") → @change.AfterStart.ToString("dd MMM HH:mm") – @change.AfterCompletion.ToString("dd MMM HH:mm")</small>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                                @if (preview.Warnings.Count > 0)
                                {
                                    <div class="pr-machine-schedule-preview__messages">
                                        <strong>Warnings</strong>
                                        <ul>@foreach (var warning in preview.Warnings) { <li>@warning</li> }</ul>
                                    </div>
                                }
                                @if (preview.Blockers.Count > 0)
                                {
                                    <div class="pr-machine-schedule-preview__messages pr-machine-schedule-preview__messages--blocked">
                                        <strong>Cannot commit</strong>
                                        <ul>@foreach (var blocker in preview.Blockers) { <li>@blocker</li> }</ul>
                                    </div>
                                }
                            </div>
                        }

                        <footer class="pr-machine-schedule-dialog__actions">
                            <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary" Click="CloseRescheduleDialog" Enabled="@(!IsRescheduleBusy)" />
                            <DxButton Text="Preview" RenderStyle="ButtonRenderStyle.Primary" Click="PreviewRescheduleAsync" Enabled="@(!IsRescheduleBusy && CanEditRescheduleDialog)" />
                            <DxButton Text="Commit schedule" RenderStyle="ButtonRenderStyle.Primary" Click="CommitRescheduleAsync"
                                      Enabled="@(!IsRescheduleBusy && CanEditRescheduleDialog && ReschedulePreview?.CanCommit == true)" />
                        </footer>
                    </section>
                </div>
            }
        }

        @if (IsBackfillDialogOpen && BackfillReport is { } backfill)
        {
            <div class="pr-machine-schedule-dialog-backdrop">
                <section class="pr-machine-schedule-dialog iv-card" role="dialog" aria-modal="true"
                         aria-labelledby="pr-machine-schedule-backfill-title">
                    <header class="pr-machine-schedule-dialog__header">
                        <div>
                            <span class="iv-hero__eyebrow">Maintenance command · dry-run first</span>
                            <h2 id="pr-machine-schedule-backfill-title">Allocation backfill</h2>
                            <p>Verified fragments reserve existing schedules. This does not change Work Order dates.</p>
                        </div>
                        <button type="button" class="pr-machine-schedule-dialog__close" aria-label="Close"
                                @onclick="CloseBackfillDialog" disabled="@IsBackfillBusy">×</button>
                    </header>

                    <div class="pr-machine-schedule-preview__summary">
                        <strong>Active machine operations in this branch</strong>
                        <span>@backfill.ActiveMachineOperationCount</span>
                    </div>
                    <div class="pr-machine-schedule-preview__summary">
                        <strong>Already verified</strong>
                        <span>@backfill.AlreadyVerifiedCount</span>
                    </div>
                    <div class="pr-machine-schedule-preview__summary">
                        <strong>Missing allocations eligible for backfill</strong>
                        <span>@backfill.MissingAllocationCount</span>
                    </div>
                    <div class="pr-machine-schedule-preview__summary">
                        <strong>Unverified / overlapping</strong>
                        <span>@backfill.UnverifiedCount / @backfill.OverlappingMachineCount machine(s)</span>
                    </div>

                    @if (backfill.Findings.Count > 0)
                    {
                        <div class="pr-machine-schedule-preview__changes">
                            <strong>Dry-run findings</strong>
                            <ul>
                                @foreach (var finding in backfill.Findings)
                                {
                                    <li class="@(finding.IsBlocking ? "pr-machine-schedule-preview__finding--blocked" : string.Empty)">
                                        <span><strong>@finding.Code</strong>@(finding.WorkOrderNo is null ? string.Empty : $" · {finding.WorkOrderNo}")@(finding.MachineCode is null ? string.Empty : $" · {finding.MachineCode}")</span>
                                        <small>@finding.Message</small>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                    else
                    {
                        <p class="pr-machine-schedule-backfill-clear">All active schedules in this company scope are reproducible and allocation fragments match.</p>
                    }

                    <footer class="pr-machine-schedule-dialog__actions">
                        <DxButton Text="Close" RenderStyle="ButtonRenderStyle.Secondary" Click="CloseBackfillDialog" Enabled="@(!IsBackfillBusy)" />
                        <DxButton Text="Apply verified fragments" RenderStyle="ButtonRenderStyle.Primary"
                                  Click="ApplyAllocationBackfillAsync"
                                  Enabled="@(!IsBackfillBusy && backfill.CanApply && backfill.MissingAllocationCount > 0)" />
                    </footer>
                </section>
            </div>
        }
    </div>

    <DxPopup HeaderText="More filters"
             CloseOnOutsideClick="false"
             Width="520px"
             CssClass="common-popup"
             @bind-Visible="@IsMoreFiltersOpen">
        <Content>
            <div class="iv-popup-body">
                <DxFormLayout SizeMode="SizeMode.Small">
                    <DxFormLayoutItem Caption="Process" ColSpanMd="6">
                        <Template>
                            <DxComboBox TData="MachineSchedulePlannerLookupOption" TValue="string"
                                        CustomData="@LoadProcessOptionsAsync"
                                        TextFieldName="@nameof(MachineSchedulePlannerLookupOption.DisplayText)"
                                        ValueFieldName="@nameof(MachineSchedulePlannerLookupOption.Key)"
                                        @bind-Value="DraftProcess"
                                        NullText="All processes" SearchMode="ListSearchMode.AutoSearch"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Product" ColSpanMd="6">
                        <Template>
                            <DxComboBox TData="MachineSchedulePlannerLookupOption" TValue="string"
                                        CustomData="@LoadProductOptionsAsync"
                                        TextFieldName="@nameof(MachineSchedulePlannerLookupOption.DisplayText)"
                                        ValueFieldName="@nameof(MachineSchedulePlannerLookupOption.Key)"
                                        @bind-Value="DraftProduct"
                                        NullText="All products" SearchMode="ListSearchMode.AutoSearch"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="WO status" ColSpanMd="6">
                        <Template>
                            <DxComboBox Data="@StatusOptions" TData="PlannerFilterOption" TValue="string"
                                        TextFieldName="@nameof(PlannerFilterOption.Name)"
                                        ValueFieldName="@nameof(PlannerFilterOption.Key)"
                                        @bind-Value="DraftStatus"
                                        NullText="All statuses" SearchMode="ListSearchMode.AutoSearch"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Priority" ColSpanMd="6">
                        <Template>
                            <DxComboBox Data="@PriorityOptions" TData="PlannerFilterOption" TValue="string"
                                        TextFieldName="@nameof(PlannerFilterOption.Name)"
                                        ValueFieldName="@nameof(PlannerFilterOption.Key)"
                                        @bind-Value="DraftPriority"
                                        NullText="All priorities" SearchMode="ListSearchMode.AutoSearch"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Attention" ColSpanMd="12">
                        <Template>
                            <DxCheckBox Checked="DraftLateOnly" CheckedChanged="@((bool value) => { DraftLateOnly = value; })"
                                        AllowIndeterminateState="false">Late vs DR date only</DxCheckBox>
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayout>
            </div>
            <div class="iv-popup-footer">
                <div class="iv-popup-footer__actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Clear" Click="ClearMoreFiltersAsync" Enabled="@(!IsLoading)" />
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Cancel" Click="CancelMoreFilters" />
                    <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Apply" Click="ApplyMoreFiltersAsync" Enabled="@(!IsLoading)" />
                </div>
            </div>
        </Content>
    </DxPopup>
</MenuAuthorize>
