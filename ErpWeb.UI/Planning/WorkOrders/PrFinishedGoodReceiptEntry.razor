@page "/planning/finished-good-receipts/new"
@page "/planning/finished-good-receipts/{Id:int}/edit"
@page "/planning/finished-good-receipts/{Id:int}/view"
@using Microsoft.AspNetCore.Components.Routing
@inherits PageBase

<PageTitle>@PageHeading</PageTitle>
<NavigationLock ConfirmExternalNavigation="Dirty" OnBeforeInternalNavigation="BeforeNavigate" />

<MenuAuthorize MenuCode="@MenuCodes.PlanningFinishedGoodReceipt">
    <div class="iv-page pr-dp-page">
        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <div class="iv-toast iv-toast--ok" role="status">
                <span>@StatusMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissStatus" aria-label="Dismiss">×</button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="iv-toast iv-toast--err" role="alert">
                <span>@ErrorMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissError" aria-label="Dismiss">×</button>
            </div>
        }

        <header class="iv-hero">
            <div class="iv-hero__mark" aria-hidden="true"><i class="fa-solid fa-boxes-stacked"></i></div>
            <div class="iv-hero__copy">
                <p class="iv-eyebrow">Planning · Production</p>
                <h1 class="iv-title">@PageHeading</h1>
                <div class="iv-chips">
                    <span class="iv-chip">@ModeChip</span>
                    @if (Document.BatchNo > 0)
                    {
                        <span class="iv-chip code-style">FG @Document.BatchNo</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Document.WorkOrderNo))
                    {
                        <span class="iv-chip code-style">@Document.WorkOrderNo</span>
                    }
                    <span class="iv-chip">@Document.Status</span>
                </div>
            </div>
            <div class="iv-hero__kpi">
                <span>Lines</span>
                <strong>@LineCount</strong>
            </div>
        </header>

        <section class="iv-card pr-dp-commandbar">
            <div class="pr-dp-commandbar__left">
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          Text="BACK"
                          IconCssClass="fa-solid fa-arrow-left"
                          Click="@BackToList"
                          Enabled="@(!IsSubmitting)" />
                @if (CanChangeWorkOrder)
                {
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="CHANGE WORK ORDER"
                              IconCssClass="fa-solid fa-right-left"
                              Click="@OpenChangeWorkOrderConfirm"
                              Enabled="@(!IsSubmitting)" />
                }
            </div>
            <div class="pr-dp-commandbar__right">
                @if (CanOpenEditFromView)
                {
                    <DxButton RenderStyle="ButtonRenderStyle.Primary"
                              Text="EDIT DRAFT"
                              IconCssClass="far fa-edit"
                              Click="@OpenEdit"
                              Enabled="@(!IsSubmitting)" />
                }
                @if (ShowPost)
                {
                    <DxButton RenderStyle="ButtonRenderStyle.Success"
                              Text="POST"
                              IconCssClass="fa-solid fa-check"
                              Click="@OpenPostConfirm"
                              Enabled="@CanPost" />
                }
                @if (CanRollback)
                {
                    <DxButton RenderStyle="ButtonRenderStyle.Warning"
                              Text="ROLLBACK"
                              IconCssClass="fa-solid fa-rotate-left"
                              Click="@OpenRollbackConfirm"
                              Enabled="@(!IsSubmitting)" />
                }
                @if (CanDelete)
                {
                    <DxButton RenderStyle="ButtonRenderStyle.Danger"
                              Text="DELETE"
                              IconCssClass="fa-solid fa-trash"
                              Click="@OpenDeleteConfirm"
                              Enabled="@(!IsSubmitting)" />
                }
                @if (CanCreateCorrection)
                {
                    <DxButton RenderStyle="ButtonRenderStyle.Primary"
                              Text="CREATE CORRECTION"
                              IconCssClass="fa-solid fa-plus"
                              Click="@CreateCorrectionAsync"
                              Enabled="@(!IsSubmitting)" />
                }
            </div>
        </section>

        @if (IsBootstrapping)
        {
            <section class="iv-card">
                <div class="iv-skeleton" aria-busy="true">
                    <div class="iv-skeleton__line iv-skeleton__line--lg"></div>
                    <div class="iv-skeleton__line iv-skeleton__line--md"></div>
                    <div class="iv-skeleton__line"></div>
                </div>
            </section>
        }
        else if (LoadFailed)
        {
            <section class="iv-card">
                <div class="pr-dp-empty">
                    <div class="pr-dp-empty__icon" aria-hidden="true"><i class="fa-solid fa-triangle-exclamation"></i></div>
                    <h3>Finished good receipt could not be loaded</h3>
                    <p>@(string.IsNullOrWhiteSpace(ErrorMessage) ? "Return to the list and try again." : ErrorMessage)</p>
                </div>
            </section>
        }
        else if (IsViewMode)
        {
            <section class="iv-card">
                <h2 class="iv-card__title">Document</h2>
                <div class="pr-dp-meta">
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Work Order</span>
                        <strong class="code-style">@(string.IsNullOrWhiteSpace(Document.WorkOrderNo) ? "—" : Document.WorkOrderNo)</strong>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Receipt date</span>
                        <strong>@Document.EffectiveDate.ToString("dd MMM yyyy")</strong>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Reference</span>
                        <strong>@(string.IsNullOrWhiteSpace(Document.RefNo) ? "—" : Document.RefNo)</strong>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Remarks</span>
                        <strong>@(string.IsNullOrWhiteSpace(Document.Remarks) ? "—" : Document.Remarks)</strong>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Revision</span>
                        <strong>@Document.Revision</strong>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Status</span>
                        <strong>@Document.Status</strong>
                    </div>
                </div>
            </section>

            <section class="iv-card pr-dp-grid">
                <div class="pr-dp-section-head">
                    <div>
                        <p class="iv-eyebrow">Lines</p>
                        <strong>Received finished goods</strong>
                        <small>Values are the saved receipt snapshot.</small>
                    </div>
                </div>
                @if (Document.Lines.Count == 0)
                {
                    <div class="pr-dp-empty">
                        <h3>No receipt lines</h3>
                    </div>
                }
                else
                {
                    <DxGrid Data="@Document.Lines"
                            KeyFieldName="@nameof(FinishedGoodReceiptLine.SourceId)"
                            ShowFilterRow="false"
                            ShowGroupPanel="false"
                            ShowSearchBox="false"
                            TextWrapEnabled="false"
                            PageSize="20"
                            ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                            CssClass="pr-dp-grid">
                        <Columns>
                            <DxGridDataColumn Caption="Source" MinWidth="170">
                                <CellDisplayTemplate>
                                    @{
                                        var line = (FinishedGoodReceiptLine)context.DataItem;
                                    }
                                    <div class="pr-dp-cell">
                                        <span class="pr-dp-cell__primary code-style">@line.ItemCode</span>
                                        <span class="pr-dp-cell__secondary">@line.WorkCentre / @line.Process</span>
                                    </div>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn Caption="Source Lot" Width="140px">
                                <CellDisplayTemplate>
                                    @{
                                        var line = (FinishedGoodReceiptLine)context.DataItem;
                                    }
                                    <span>@(string.IsNullOrWhiteSpace(line.SourceLot) ? "—" : line.SourceLot)</span>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn Caption="Available" Width="130px" TextAlignment="GridTextAlignment.Right">
                                <CellDisplayTemplate>
                                    @{
                                        var line = (FinishedGoodReceiptLine)context.DataItem;
                                    }
                                    <span>@line.AvailableQty.ToString("n4") @line.SourceUom</span>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn Caption="Receipt Qty" Width="150px" TextAlignment="GridTextAlignment.Right">
                                <CellDisplayTemplate>
                                    @{
                                        var line = (FinishedGoodReceiptLine)context.DataItem;
                                    }
                                    <span>@line.Quantity.ToString("n4") @line.SourceUom</span>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn FieldName="@nameof(FinishedGoodReceiptLine.Warehouse)" Caption="Warehouse" Width="180px" />
                            <DxGridDataColumn Caption="Location" Width="170px">
                                <CellDisplayTemplate>
                                    @{
                                        var line = (FinishedGoodReceiptLine)context.DataItem;
                                    }
                                    <span>@(string.IsNullOrWhiteSpace(line.Location) ? "—" : line.Location)</span>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn Caption="Destination Lot" Width="170px">
                                <CellDisplayTemplate>
                                    @{
                                        var line = (FinishedGoodReceiptLine)context.DataItem;
                                    }
                                    <span>@(line.LotControl ? (string.IsNullOrWhiteSpace(line.LotNo) ? "—" : line.LotNo) : "—")</span>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn Caption="Expiry" Width="140px">
                                <CellDisplayTemplate>
                                    @{
                                        var line = (FinishedGoodReceiptLine)context.DataItem;
                                    }
                                    <span>@(line.LotControl && line.ExpiryDate is not null ? line.ExpiryDate.Value.ToString("dd MMM yyyy") : "—")</span>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn Caption="Destination Qty" Width="150px" TextAlignment="GridTextAlignment.Right">
                                <CellDisplayTemplate>
                                    @{
                                        var line = (FinishedGoodReceiptLine)context.DataItem;
                                    }
                                    <span>@line.DestinationQty.ToString("n4") @line.DestinationUom</span>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            @if (Document.CanViewCost)
                            {
                                <DxGridDataColumn Caption="Value" Width="140px" TextAlignment="GridTextAlignment.Right">
                                    <CellDisplayTemplate>
                                        @{
                                            var line = (FinishedGoodReceiptLine)context.DataItem;
                                        }
                                        <span>@(line.TotalValue?.ToString("n4") ?? "Unverified")</span>
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                            }
                        </Columns>
                    </DxGrid>
                }
            </section>

            @if (ShowCompactReadiness)
            {
                @ReadinessBlock
            }
        }
        else if (EntryPermissionDenied)
        {
            <section class="iv-card">
                <div class="pr-dp-empty">
                    <div class="pr-dp-empty__icon" aria-hidden="true"><i class="fa-solid fa-lock"></i></div>
                    <h3>Access denied</h3>
                    <p>@PermissionDeniedCopy</p>
                </div>
            </section>
        }
        else if (IsSelectingSource)
        {
            <section class="iv-card">
                <header class="pr-dp-section-head">
                    <div>
                        <strong>Find eligible source lots</strong>
                        <small>Select a final production lot. Non-ready sources can be added; POST is the readiness gate.</small>
                    </div>
                </header>

                @SourceFilterForm(lockedWorkOrder: false)

                <div class="pr-dp-filter-actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="@(MoreFiltersVisible ? "Fewer filters" : "More filters")"
                              IconCssClass="fa-solid fa-sliders"
                              Click="@(() => MoreFiltersVisible = !MoreFiltersVisible)" />
                    <div class="pr-dp-filter-actions__right">
                        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                  Text="CLEAR"
                                  Click="@ClearInitialSourceFiltersAsync"
                                  Enabled="@(!IsSubmitting)" />
                        <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                  Text="FIND"
                                  IconCssClass="fa-solid fa-magnifying-glass"
                                  Click="@FindSourcesAsync"
                                  Enabled="@(!IsSubmitting)" />
                    </div>
                </div>
            </section>

            <section class="iv-card pr-dp-lines">
                <div class="pr-dp-section-head">
                    <div>
                        <p class="iv-eyebrow">Results</p>
                        <strong>Matching production lots</strong>
                    </div>
                    <span class="pr-dp-count">@SourceResultLabel · page @(SourcePage + 1) / @SourcePageCount</span>
                </div>
                @SourceResults
            </section>
        }
        else if (IsReceiptWorkspace)
        {
            <section class="iv-card">
                <div class="pr-dp-section-head">
                    <div>
                        <p class="iv-eyebrow">Context</p>
                        <strong>Work Order / source</strong>
                        <small>This receipt is locked to one Work Order. Use CHANGE WORK ORDER to start over.</small>
                    </div>
                    <span class="pr-dp-pill">@Document.Status</span>
                </div>
                <div class="pr-dp-meta">
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Work Order</span>
                        <strong class="code-style">@(string.IsNullOrWhiteSpace(Document.WorkOrderNo) ? "—" : Document.WorkOrderNo)</strong>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Selected source lines</span>
                        <strong>@Editors.Count</strong>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Item</span>
                        <strong class="code-style">@SourceItemSummary</strong>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Source lot</span>
                        <strong>@SourceLotSummary</strong>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Work Centre</span>
                        <strong>@SourceWorkCentreSummary</strong>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Process</span>
                        <strong>@SourceProcessSummary</strong>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Status</span>
                        <strong>@Document.Status</strong>
                    </div>
                </div>
            </section>

            <section class="iv-card">
                <div class="pr-dp-section-head">
                    <div>
                        <p class="iv-eyebrow">Entry</p>
                        <strong>Receipt details</strong>
                        <small>One Work Order per document. Drafts do not reserve production stock.</small>
                    </div>
                </div>
                <DxFormLayout SizeMode="SizeMode.Small" CssClass="pr-dp-form">
                    <DxFormLayoutItem Caption="Receipt date" ColSpanMd="4">
                        <Template>
                            <DxDateEdit @bind-Date="@Document.EffectiveDate"
                                        DisplayFormat="dd/MM/yyyy"
                                        Enabled="@CanEditFields"
                                        CssClass="w-100" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Reference" ColSpanMd="4">
                        <Template>
                            <DxTextBox @bind-Text="@RefNo"
                                       NullText="Optional reference"
                                       Enabled="@CanEditFields" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Remarks" ColSpanMd="12">
                        <Template>
                            <DxMemo @bind-Text="@Remarks" Rows="2" maxlength="200" Enabled="@CanEditFields" />
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayout>
            </section>

            <section class="iv-card pr-dp-grid">
                <div class="pr-dp-section-head">
                    <div>
                        <p class="iv-eyebrow">Lines</p>
                        <strong>Destination</strong>
                        <small>Warehouse is required. Location is optional and depends on the warehouse.</small>
                    </div>
                    @if (CanAddSourceLot)
                    {
                        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                  Text="ADD SOURCE LOT"
                                  IconCssClass="fa-solid fa-plus"
                                  Click="@OpenSourcePickerAsync"
                                  Enabled="@(!IsSubmitting)" />
                    }
                </div>
                @if (Editors.Count == 0)
                {
                    <div class="pr-dp-empty">
                        <h3>No destination lines</h3>
                        <p>Use ADD SOURCE LOT to add an eligible lot from this Work Order, or CHANGE WORK ORDER to start over.</p>
                    </div>
                }
                else
                {
                    <DxGrid Data="@Editors"
                            KeyFieldName="@nameof(ReceiptLineEditor.Key)"
                            ShowFilterRow="false"
                            ShowGroupPanel="false"
                            ShowSearchBox="false"
                            TextWrapEnabled="false"
                            PageSize="20"
                            ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                            CssClass="pr-dp-grid">
                        <Columns>
                            <DxGridDataColumn Caption="Source" MinWidth="170">
                                <CellDisplayTemplate>
                                    @{
                                        var editor = (ReceiptLineEditor)context.DataItem;
                                    }
                                    <div class="pr-dp-cell">
                                        <span class="pr-dp-cell__primary code-style">@editor.Line.ItemCode</span>
                                        <span class="pr-dp-cell__secondary">@editor.Line.WorkCentre / @editor.Line.Process</span>
                                    </div>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn Caption="Source Lot" Width="140px">
                                <CellDisplayTemplate>
                                    @{
                                        var editor = (ReceiptLineEditor)context.DataItem;
                                    }
                                    <span>@(string.IsNullOrWhiteSpace(editor.Line.SourceLot) ? "—" : editor.Line.SourceLot)</span>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn Caption="Available" Width="130px" TextAlignment="GridTextAlignment.Right">
                                <CellDisplayTemplate>
                                    @{
                                        var editor = (ReceiptLineEditor)context.DataItem;
                                    }
                                    <span>@editor.Line.AvailableQty.ToString("n4") @editor.Line.SourceUom</span>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn Caption="Receipt Qty" Width="150px">
                                <CellDisplayTemplate>
                                    @{
                                        var editor = (ReceiptLineEditor)context.DataItem;
                                    }
                                    <DxSpinEdit Value="@editor.Line.Quantity"
                                                ValueChanged="@((decimal value) => editor.Line.Quantity = value)"
                                                Enabled="@CanEditFields"
                                                MinValue="0m"
                                                Increment="0.0001m"
                                                DisplayFormat="n4"
                                                ShowSpinButtons="false" />
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn Caption="Warehouse" Width="190px">
                                <CellDisplayTemplate>
                                    @{
                                        var editor = (ReceiptLineEditor)context.DataItem;
                                    }
                                    <DxComboBox Data="@Warehouses"
                                                TextFieldName="@nameof(ProductionOutputChoice.Label)"
                                                ValueFieldName="@nameof(ProductionOutputChoice.Code)"
                                                Value="@editor.Line.Warehouse"
                                                ValueChanged="@(async (string? value) => await OnWarehouseChangedAsync(editor, value))"
                                                NullText="Required warehouse"
                                                SearchMode="ListSearchMode.AutoSearch"
                                                SearchFilterCondition="ListSearchFilterCondition.Contains"
                                                Enabled="@CanEditFields" />
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn Caption="Location" Width="180px">
                                <CellDisplayTemplate>
                                    @{
                                        var editor = (ReceiptLineEditor)context.DataItem;
                                    }
                                    <div @key="editor.LookupRevision">
                                        <DxComboBox Data="@editor.Locations"
                                                    TextFieldName="@nameof(ProductionOutputChoice.Label)"
                                                    ValueFieldName="@nameof(ProductionOutputChoice.Code)"
                                                    Value="@editor.Line.Location"
                                                    ValueChanged="@((string? value) => editor.Line.Location = value ?? "")"
                                                    NullText="Optional location"
                                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                                    SearchMode="ListSearchMode.AutoSearch"
                                                    SearchFilterCondition="ListSearchFilterCondition.Contains"
                                                    Enabled="@(CanEditFields && !string.IsNullOrWhiteSpace(editor.Line.Warehouse))" />
                                    </div>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn Caption="Destination Lot" Width="170px">
                                <CellDisplayTemplate>
                                    @{
                                        var editor = (ReceiptLineEditor)context.DataItem;
                                    }
                                    @if (editor.Line.LotControl)
                                    {
                                        <DxTextBox @bind-Text="@editor.Line.LotNo" Enabled="@CanEditFields" NullText="Required lot" />
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn Caption="Expiry" Width="140px">
                                <CellDisplayTemplate>
                                    @{
                                        var editor = (ReceiptLineEditor)context.DataItem;
                                    }
                                    @if (editor.Line.LotControl)
                                    {
                                        <DxDateEdit Date="@editor.Line.ExpiryDate"
                                                    DateChanged="@((DateTime? value) => editor.Line.ExpiryDate = value)"
                                                    Enabled="@CanEditFields"
                                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            <DxGridDataColumn Caption="Destination Qty" Width="150px" TextAlignment="GridTextAlignment.Right">
                                <CellDisplayTemplate>
                                    @{
                                        var editor = (ReceiptLineEditor)context.DataItem;
                                    }
                                    <span>@(Dirty ? "Recalculated on save" : $"{editor.Line.DestinationQty.ToString("n4")} {editor.Line.DestinationUom}")</span>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                            @if (Document.CanViewCost)
                            {
                                <DxGridDataColumn Caption="Value" Width="140px" TextAlignment="GridTextAlignment.Right">
                                    <CellDisplayTemplate>
                                        @{
                                            var editor = (ReceiptLineEditor)context.DataItem;
                                        }
                                        <span>@(Document.Status == "NEW" ? "Estimated" : "Posted"): @(editor.Line.TotalValue?.ToString("n4") ?? "Unverified")</span>
                                    </CellDisplayTemplate>
                                </DxGridDataColumn>
                            }
                            <DxGridDataColumn Caption="" Width="110px">
                                <CellDisplayTemplate>
                                    @{
                                        var editor = (ReceiptLineEditor)context.DataItem;
                                    }
                                    <div class="pr-dp-grid-action">
                                        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                                  Text="REMOVE"
                                                  Click="@(() => RemoveLine(editor))"
                                                  Enabled="@(!IsSubmitting)" />
                                    </div>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                        </Columns>
                    </DxGrid>
                }
            </section>

            @if (ShowCompactReadiness)
            {
                @ReadinessBlock
            }

            <footer class="pr-dp-footer">
                <p class="pr-dp-footer__hint">
                    @if (Editors.Count == 0)
                    {
                        @:Use ADD SOURCE LOT to add a line, then save the draft.
                    }
                    else if (Document.Id == 0)
                    {
                        @:Save the draft before posting checks are available.
                    }
                    else
                    {
                        @:Drafts do not reserve stock. Save to capture the destination snapshot.
                    }
                </p>
                <div class="pr-dp-footer__actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="CANCEL"
                              IconCssClass="fa-solid fa-xmark"
                              Click="@BackToList"
                              Enabled="@(!IsSubmitting)" />
                    <DxButton RenderStyle="ButtonRenderStyle.Primary"
                              Text="@(IsSubmitting ? "Saving…" : "SAVE DRAFT")"
                              IconCssClass="fa-solid fa-floppy-disk"
                              Click="@SaveAsync"
                              Enabled="@(!IsSubmitting && CanSave)" />
                </div>
            </footer>
        }
        else
        {
            <section class="iv-card">
                <div class="pr-dp-empty">
                    <div class="pr-dp-empty__icon" aria-hidden="true"><i class="fa-solid fa-circle-exclamation"></i></div>
                    <h3>Unable to show this receipt</h3>
                    <p>This page could not determine its current state. Return to the list and try again.</p>
                </div>
            </section>
        }
    </div>

    <DxPopup Visible="@SourcePickerVisible"
             HeaderText="Add source lot"
             CloseOnOutsideClick="false"
             ShowCloseButton="true"
             Width="90vw"
             MaxWidth="1200px"
             MaxHeight="90vh"
             CssClass="common-popup pr-popup-grid-dialog"
             Closed="@CloseSourcePicker">
        <BodyContentTemplate>
            <div class="pr-dp-picker">
                <div class="pr-dp-meta">
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Work Order</span>
                        <strong class="code-style">@Document.WorkOrderNo</strong>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Lines</span>
                        <strong>@Editors.Count / 200</strong>
                    </div>
                </div>

                @SourceFilterForm(lockedWorkOrder: true)

                <div class="pr-dp-filter-actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="@(MoreFiltersVisible ? "Fewer filters" : "More filters")"
                              IconCssClass="fa-solid fa-sliders"
                              Click="@(() => MoreFiltersVisible = !MoreFiltersVisible)" />
                    <div class="pr-dp-filter-actions__right">
                        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                  Text="CLEAR"
                                  Click="@ClearPickerFiltersAsync"
                                  Enabled="@(!IsSubmitting)" />
                        <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                  Text="FIND"
                                  IconCssClass="fa-solid fa-magnifying-glass"
                                  Click="@FindSourcesAsync"
                                  Enabled="@(!IsSubmitting)" />
                    </div>
                </div>

                <div class="pr-dp-section-head">
                    <div>
                        <p class="iv-eyebrow">Results</p>
                        <strong>Matching production lots</strong>
                    </div>
                    <span class="pr-dp-count">@SourceResultLabel · page @(SourcePage + 1) / @SourcePageCount</span>
                </div>
                @SourceResults
            </div>
        </BodyContentTemplate>
        <FooterContentTemplate>
            <DxButton Text="Close" RenderStyle="ButtonRenderStyle.Secondary" Click="@CloseSourcePicker" Enabled="@(!IsSubmitting)" />
        </FooterContentTemplate>
    </DxPopup>

    <DxPopup Visible="@PostConfirmationVisible"
             HeaderText="Confirm Post"
             CloseOnOutsideClick="false"
             ShowCloseButton="true"
             Closed="@(() => PostConfirmationVisible = false)">
        <BodyContentTemplate>
            <p>Post finished good receipt <strong>FG @Document.BatchNo</strong>?</p>
            @if (!Document.PostingEnabled)
            {
                <p>FG posting is disabled pending release acceptance.</p>
            }
        </BodyContentTemplate>
        <FooterContentTemplate>
            <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => PostConfirmationVisible = false)" Enabled="@(!IsSubmitting)" />
            <DxButton Text="Post" RenderStyle="ButtonRenderStyle.Success" Click="@PostAsync" Enabled="@(!IsSubmitting && Document.PostingEnabled)" />
        </FooterContentTemplate>
    </DxPopup>

    <DxPopup Visible="@DeleteConfirmationVisible"
             HeaderText="Confirm Delete"
             CloseOnOutsideClick="false"
             ShowCloseButton="true"
             Closed="@(() => DeleteConfirmationVisible = false)">
        <BodyContentTemplate>
            <p>Delete the NEW draft <strong>FG @Document.BatchNo</strong>?</p>
        </BodyContentTemplate>
        <FooterContentTemplate>
            <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => DeleteConfirmationVisible = false)" Enabled="@(!IsSubmitting)" />
            <DxButton Text="Delete" RenderStyle="ButtonRenderStyle.Danger" Click="@DeleteAsync" Enabled="@(!IsSubmitting)" />
        </FooterContentTemplate>
    </DxPopup>

    <DxPopup Visible="@RollbackConfirmVisible"
             HeaderText="Rollback Finished Good Receipt"
             CloseOnOutsideClick="false"
             ShowCloseButton="true"
             Closed="@(() => RollbackConfirmVisible = false)">
        <BodyContentTemplate>
            <p>Enter a reason to roll back this posted document.</p>
            <DxMemo @bind-Text="@RollbackReason" Rows="3" maxlength="500" CssClass="w-100" />
        </BodyContentTemplate>
        <FooterContentTemplate>
            <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => RollbackConfirmVisible = false)" Enabled="@(!IsSubmitting)" />
            <DxButton Text="Rollback" RenderStyle="ButtonRenderStyle.Warning" Click="@RollbackAsync" Enabled="@(!IsSubmitting)" />
        </FooterContentTemplate>
    </DxPopup>

    <DxPopup Visible="@ChangeWorkOrderVisible"
             HeaderText="Change Work Order"
             CloseOnOutsideClick="false"
             ShowCloseButton="true"
             Closed="@(() => ChangeWorkOrderVisible = false)">
        <BodyContentTemplate>
            <p>Changing the Work Order clears every receipt line on this document.</p>
        </BodyContentTemplate>
        <FooterContentTemplate>
            <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => ChangeWorkOrderVisible = false)" Enabled="@(!IsSubmitting)" />
            <DxButton Text="Change" RenderStyle="ButtonRenderStyle.Warning" Click="@ChangeWorkOrderAsync" Enabled="@(!IsSubmitting)" />
        </FooterContentTemplate>
    </DxPopup>
</MenuAuthorize>

@code {
    private RenderFragment SourceFilterForm(bool lockedWorkOrder) => __builder =>
    {
        <DxFormLayout SizeMode="SizeMode.Small" CssClass="pr-dp-form">
            @if (!lockedWorkOrder)
            {
                <DxFormLayoutItem Caption="Work Order" ColSpanMd="4">
                    <Template>
                        <DxComboBox Data="@FilterOptions.WorkOrders"
                                    TextFieldName="@nameof(ProductionOutputChoice.Label)"
                                    ValueFieldName="@nameof(ProductionOutputChoice.Code)"
                                    @bind-Value="@SearchWo"
                                    NullText="All eligible Work Orders"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    SearchMode="ListSearchMode.AutoSearch"
                                    SearchFilterCondition="ListSearchFilterCondition.Contains" />
                    </Template>
                </DxFormLayoutItem>
            }
            <DxFormLayoutItem Caption="Work Centre" ColSpanMd="4">
                <Template>
                    <DxComboBox Data="@FilterOptions.WorkCentres"
                                TextFieldName="@nameof(ProductionOutputChoice.Label)"
                                ValueFieldName="@nameof(ProductionOutputChoice.Code)"
                                @bind-Value="@SearchWorkCentre"
                                NullText="All work centres"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                SearchMode="ListSearchMode.AutoSearch"
                                SearchFilterCondition="ListSearchFilterCondition.Contains" />
                </Template>
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="Process" ColSpanMd="4">
                <Template>
                    <DxComboBox Data="@FilterOptions.Processes"
                                TextFieldName="@nameof(ProductionOutputChoice.Label)"
                                ValueFieldName="@nameof(ProductionOutputChoice.Code)"
                                @bind-Value="@SearchProcess"
                                NullText="All processes"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                SearchMode="ListSearchMode.AutoSearch"
                                SearchFilterCondition="ListSearchFilterCondition.Contains" />
                </Template>
            </DxFormLayoutItem>
            @if (MoreFiltersVisible)
            {
                <DxFormLayoutItem Caption="Item" ColSpanMd="4">
                    <Template>
                        <DxComboBox Data="@FilterOptions.Items"
                                    TextFieldName="@nameof(ProductionOutputChoice.Label)"
                                    ValueFieldName="@nameof(ProductionOutputChoice.Code)"
                                    @bind-Value="@SearchItem"
                                    NullText="All items"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    SearchMode="ListSearchMode.AutoSearch"
                                    SearchFilterCondition="ListSearchFilterCondition.Contains" />
                    </Template>
                </DxFormLayoutItem>
            }
        </DxFormLayout>
    };

    private RenderFragment SourceResults => __builder =>
    {
        @if (IsSearchingSources)
        {
            <div class="iv-skeleton" aria-busy="true">
                <div class="iv-skeleton__line iv-skeleton__line--lg"></div>
                <div class="iv-skeleton__line"></div>
            </div>
        }
        else if (Sources.Count == 0)
        {
            <div class="pr-dp-empty">
                <div class="pr-dp-empty__icon" aria-hidden="true"><i class="fa-solid fa-magnifying-glass"></i></div>
                <h3>No eligible sources</h3>
                <p>Change or clear the filters to see more production lots.</p>
            </div>
        }
        else
        {
            <div class="pr-popup-grid-shell">
                <table class="pr-popup-grid">
                    <thead>
                        <tr>
                            <th>Work Order</th>
                            <th>Item / Lot</th>
                            <th>Work centre / Process</th>
                            <th class="pr-popup-grid__num">Available</th>
                            <th>Readiness</th>
                            <th class="pr-popup-grid__action">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var source in Sources)
                    {
                        <tr>
                            <td>
                                <span class="pr-popup-grid__primary code-style">@source.WorkOrderNo</span>
                            </td>
                            <td>
                                <span class="pr-popup-grid__primary">@source.ItemCode</span>
                                <span class="pr-popup-grid__secondary">Lot @(string.IsNullOrWhiteSpace(source.LotNo) ? "—" : source.LotNo)</span>
                            </td>
                            <td>
                                <span class="pr-popup-grid__primary">@source.WorkCentre / @source.Process</span>
                                <span class="pr-popup-grid__secondary">@(source.LotControl ? "Lot-controlled" : "Non-lot")</span>
                            </td>
                            <td class="pr-popup-grid__num pr-popup-grid__num--emphasis">@source.AvailableQty.ToString("n4") @source.Uom</td>
                            <td>@source.Readiness</td>
                            <td class="pr-popup-grid__action">
                                <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                          Text="SELECT"
                                          Click="@(() => AddSourceAsync(source))"
                                          Enabled="@(!IsSubmitting)" />
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="pr-dp-pager">
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          Text="Previous"
                          Click="@(() => ChangeSourcePageAsync(-1))"
                          Enabled="@(SourcePage > 0 && !IsSubmitting)" />
                <span>Page @(SourcePage + 1) of @SourcePageCount</span>
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          Text="Next"
                          Click="@(() => ChangeSourcePageAsync(1))"
                          Enabled="@(SourcePage + 1 < SourcePageCount && !IsSubmitting)" />
            </div>
        }
    };

    private RenderFragment ReadinessBlock => __builder =>
    {
        <section class="pr-dp-readiness" aria-live="polite">
            @if (Document.Id == 0)
            {
                <p class="pr-dp-readiness__copy">Save the draft before posting checks are available.</p>
            }
            else if (!Document.PostingEnabled)
            {
                <p class="pr-dp-readiness__copy">FG posting is disabled pending release acceptance.</p>
            }
            else if (Document.ReadinessErrors.Count > 0)
            {
                <strong class="pr-dp-readiness__title">Posting readiness</strong>
                <ul class="pr-dp-readiness__list">
                    @foreach (var error in Document.ReadinessErrors)
                    {
                        <li>@error</li>
                    }
                </ul>
            }
            else
            {
                <p class="pr-dp-readiness__copy">No known posting-readiness issues.</p>
            }
        </section>
    };
}
