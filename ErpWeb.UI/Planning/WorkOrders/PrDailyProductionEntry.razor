@page "/planning/daily-production/{Mode:regex(^(new|edit|view)$)}"
@page "/planning/daily-production/{Mode:regex(^(edit|view)$)}/{OutputId:long}"
@page "/planning/daily-production/new/{WorkOrderOperationId:long}"
@inherits PageBase

<PageTitle>@PageHeading</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.PlanningDailyProduction">
    <div class="iv-page pr-dp-page">
        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <div class="iv-toast iv-toast--ok" role="status">
                <span>@StatusMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissStatus" aria-label="Dismiss">×</button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="iv-toast iv-toast--err" role="alert">
                <span>@ErrorMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissError" aria-label="Dismiss">×</button>
            </div>
        }

        <header class="iv-hero">
            <div class="iv-hero__mark" aria-hidden="true">
                <i class="fa-solid fa-industry"></i>
            </div>
            <div class="iv-hero__copy">
                <p class="iv-eyebrow">Planning · Production</p>
                <h1 class="iv-title">@PageHeading</h1>
                <div class="iv-chips">
                    <span class="iv-chip">@ModeChip</span>
                    @if (!string.IsNullOrWhiteSpace(DocumentNo))
                    {
                        <span class="iv-chip code-style">@DocumentNo</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(WorkOrderNo))
                    {
                        <span class="iv-chip code-style">@WorkOrderNo</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(OutputItemCode))
                    {
                        <span class="iv-chip code-style">@OutputItemCode</span>
                    }
                    <span class="iv-chip">@HeaderStatus</span>
                </div>
            </div>
            <div class="iv-hero__kpi">
                <span>@(IsViewMode ? "Materials" : "Material lines")</span>
                <strong>@(MaterialEdits.Count > 0 ? MaterialEdits.Count : Workspace?.Materials.Count ?? 0)</strong>
            </div>
        </header>

        <section class="iv-card pr-dp-commandbar">
            <div class="pr-dp-commandbar__left">
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          Text="BACK"
                          IconCssClass="fa-solid fa-arrow-left"
                          Click="@BackToList"
                          Enabled="@(!IsSubmitting)" />
                @if (IsNewMode && Workspace is not null)
                {
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="CHANGE OPERATION"
                              IconCssClass="fa-solid fa-right-left"
                              Click="@ClearWorkspace"
                              Enabled="@(!IsSubmitting)" />
                }
            </div>
            <div class="pr-dp-commandbar__right">
                @if (CanOpenEditFromView)
                {
                    <DxButton RenderStyle="ButtonRenderStyle.Primary"
                              Text="EDIT DRAFT"
                              IconCssClass="far fa-edit"
                              Click="@OpenEdit"
                              Enabled="@(!IsSubmitting)" />
                }
                @if (CanPost)
                {
                    <DxButton RenderStyle="ButtonRenderStyle.Success"
                              Text="POST"
                              IconCssClass="fa-solid fa-check"
                              Click="@OpenPostConfirm"
                              Enabled="@(!IsSubmitting)" />
                }
                @if (CanRollback)
                {
                    <DxButton RenderStyle="ButtonRenderStyle.Warning"
                              Text="ROLLBACK"
                              IconCssClass="fa-solid fa-rotate-left"
                              Click="@OpenRollbackConfirm"
                              Enabled="@(!IsSubmitting)" />
                }
                @if (CanDelete)
                {
                    <DxButton RenderStyle="ButtonRenderStyle.Danger"
                              Text="DELETE"
                              IconCssClass="fa-solid fa-trash"
                              Click="@OpenDeleteConfirm"
                              Enabled="@(!IsSubmitting)" />
                }
            </div>
        </section>

        @if (IsBootstrapping)
        {
            <section class="iv-card">
                <div class="iv-skeleton" aria-busy="true">
                    <div class="iv-skeleton__line iv-skeleton__line--lg"></div>
                    <div class="iv-skeleton__line iv-skeleton__line--md"></div>
                    <div class="iv-skeleton__line"></div>
                </div>
            </section>
        }
        else if (IsViewMode && Document is not null)
        {
            <section class="iv-card">
                <h2 class="iv-card__title">Document</h2>
                <div class="pr-dp-meta">
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Work Order</span>
                        <strong class="code-style">@Document.WorkOrderNo</strong>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Product</span>
                        <strong class="code-style">@Document.ProductCode</strong>
                        <small>@Document.ProductDescription</small>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Operation</span>
                        <strong>@Document.OperationCode</strong>
                        <small>@Document.OperationDescription</small>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Work Centre</span>
                        <strong>@Document.WorkCentreCode</strong>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Production date</span>
                        <strong>@Document.ProductionDate.ToString("dd MMM yyyy HH:mm")</strong>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Shift</span>
                        <strong>@(Document.ShiftCode ?? "—")</strong>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Planned machine</span>
                        <strong class="code-style">@(Document.PlannedMachineCode ?? "—")</strong>
                        <small>@(Document.PlannedMachineDescription ?? "—")</small>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Actual machine / operator</span>
                        <strong>@(Document.ActualMachineCode ?? "—") / @(Document.OperatorCode ?? "—")</strong>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Output</span>
                        <strong>@Document.OutputItemCode · @Document.OutputUom</strong>
                        <small>Lot @(string.IsNullOrWhiteSpace(Document.OutputLotNo) ? "—" : Document.OutputLotNo)</small>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Good / Scrap</span>
                        <strong>@Document.GoodQty.ToString("n4") / @Document.ScrapQty.ToString("n4")</strong>
                        <small>Reject @Document.RejectQty.ToString("n4") · Hold @Document.HoldQty.ToString("n4")</small>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Posted</span>
                        <strong>@(Document.PostedBy ?? "—")</strong>
                        <small>@(Document.PostedDate?.ToString("dd MMM yyyy HH:mm") ?? "—")</small>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Reversed</span>
                        <strong>@(Document.ReversedBy ?? "—")</strong>
                        <small>@(Document.ReversedDate?.ToString("dd MMM yyyy HH:mm") ?? "—")</small>
                    </div>
                </div>
            </section>

            <section class="iv-card pr-dp-grid">
                <div class="pr-dp-section-head">
                    <div>
                        <p class="iv-eyebrow">Consumption</p>
                        <strong>Saved material facts</strong>
                        <small>Standard, consume, variance, and reason are historical. Current Available is the live balance as of now.</small>
                    </div>
                </div>
                <DxGrid Data="@MaterialEdits"
                        KeyFieldName="@nameof(MaterialLineEdit.WorkOrderMaterialId)"
                        ShowFilterRow="false"
                        ShowGroupPanel="false"
                        ShowSearchBox="false"
                        TextWrapEnabled="false"
                        PageSize="20"
                        ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                        CssClass="pr-dp-grid">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(MaterialLineEdit.ComponentCode)" Caption="Material" MinWidth="150" />
                        <DxGridDataColumn FieldName="@nameof(MaterialLineEdit.Description)" Caption="Description" MinWidth="160" />
                        <DxGridDataColumn Caption="Supply / Issue" MinWidth="160">
                            <CellDisplayTemplate>
                                @{
                                    var line = (MaterialLineEdit)context.DataItem;
                                }
                                <span>@line.SupplySource / @line.IssueMethod</span>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(MaterialLineEdit.WoBomRequiredQty)" Caption="WO BOM Required" Width="130px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(MaterialLineEdit.StandardQty)" Caption="Standard This Post" Width="140px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(MaterialLineEdit.MaxConsumeQty)" Caption="Max incl. Tolerance" Width="140px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(MaterialLineEdit.ConsumeQty)" Caption="Consume" Width="120px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(MaterialLineEdit.VarianceQty)" Caption="Variance" Width="110px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(MaterialLineEdit.VarianceReasonCode)" Caption="Reason" Width="140px" />
                        <DxGridDataColumn FieldName="@nameof(MaterialLineEdit.VarianceReasonText)" Caption="Reason detail" MinWidth="140" />
                        <DxGridDataColumn FieldName="@nameof(MaterialLineEdit.AvailableQty)" Caption="Current Available" Width="140px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(MaterialLineEdit.RemainingAfterConsume)" Caption="Remaining After" Width="130px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(MaterialLineEdit.RequiredUom)" Caption="UOM" Width="80px" />
                        <DxGridDataColumn FieldName="@nameof(MaterialLineEdit.StatusText)" Caption="Status" MinWidth="160" />
                    </Columns>
                </DxGrid>
            </section>
        }
        else if (IsSelectingOperation)
        {
            <section class="iv-card">
                <header class="pr-dp-section-head">
                    <div>
                        <strong>Find Work Order operation</strong>
                        <small>Select an eligible released or in-progress operation for Daily Production.</small>
                    </div>
                </header>

                <DxFormLayout SizeMode="SizeMode.Small" CssClass="pr-dp-form">
                    <DxFormLayoutItem Caption="Work Order" ColSpanMd="4">
                        <Template>
                            <DxComboBox Data="@FilterOptions.WorkOrders"
                                        TextFieldName="@nameof(ProductionOutputChoice.Label)"
                                        ValueFieldName="@nameof(ProductionOutputChoice.Code)"
                                        @bind-Value="@SearchWo"
                                        NullText="All eligible Work Orders"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                        SearchMode="ListSearchMode.AutoSearch"
                                        SearchFilterCondition="ListSearchFilterCondition.Contains" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Work Centre" ColSpanMd="4">
                        <Template>
                            <DxComboBox Data="@FilterOptions.WorkCentres"
                                        TextFieldName="@nameof(ProductionOutputChoice.Label)"
                                        ValueFieldName="@nameof(ProductionOutputChoice.Code)"
                                        @bind-Value="@SearchWorkCentre"
                                        NullText="All work centres"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                        SearchMode="ListSearchMode.AutoSearch"
                                        SearchFilterCondition="ListSearchFilterCondition.Contains" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Process" ColSpanMd="4">
                        <Template>
                            <DxComboBox Data="@FilterOptions.Processes"
                                        TextFieldName="@nameof(ProductionOutputChoice.Label)"
                                        ValueFieldName="@nameof(ProductionOutputChoice.Code)"
                                        @bind-Value="@SearchProcess"
                                        NullText="All processes"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                        SearchMode="ListSearchMode.AutoSearch"
                                        SearchFilterCondition="ListSearchFilterCondition.Contains" />
                        </Template>
                    </DxFormLayoutItem>
                    @if (MoreFiltersVisible)
                    {
                        <DxFormLayoutItem Caption="Product" ColSpanMd="3">
                            <Template>
                                <DxComboBox Data="@FilterOptions.Products"
                                            TextFieldName="@nameof(ProductionOutputChoice.Label)"
                                            ValueFieldName="@nameof(ProductionOutputChoice.Code)"
                                            @bind-Value="@SearchProduct"
                                            NullText="All products"
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                            SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.Contains" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Output Item" ColSpanMd="3">
                            <Template>
                                <DxComboBox Data="@FilterOptions.OutputItems"
                                            TextFieldName="@nameof(ProductionOutputChoice.Label)"
                                            ValueFieldName="@nameof(ProductionOutputChoice.Code)"
                                            @bind-Value="@SearchOutputItem"
                                            NullText="All output items"
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                            SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.Contains" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Raw Material" ColSpanMd="3">
                            <Template>
                                <DxComboBox Data="@FilterOptions.RawMaterials"
                                            TextFieldName="@nameof(ProductionOutputChoice.Label)"
                                            ValueFieldName="@nameof(ProductionOutputChoice.Code)"
                                            @bind-Value="@SearchRawMaterial"
                                            NullText="All materials"
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                            SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.Contains" />
                            </Template>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Planned Machine" ColSpanMd="3">
                            <Template>
                                <DxComboBox Data="@FilterOptions.Machines"
                                            TextFieldName="@nameof(ProductionOutputChoice.Label)"
                                            ValueFieldName="@nameof(ProductionOutputChoice.Code)"
                                            @bind-Value="@SearchMachine"
                                            NullText="All planned machines"
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                            SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.Contains" />
                            </Template>
                        </DxFormLayoutItem>
                    }
                </DxFormLayout>

                <div class="pr-dp-filter-actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="@(MoreFiltersVisible ? "Fewer filters" : "More filters")"
                              IconCssClass="fa-solid fa-sliders"
                              Click="@(() => MoreFiltersVisible = !MoreFiltersVisible)" />
                    <div class="pr-dp-filter-actions__right">
                        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                  Text="CLEAR"
                                  Click="@ClearOperationFilters"
                                  Enabled="@(!IsSubmitting)" />
                        <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                  Text="FIND"
                                  IconCssClass="fa-solid fa-magnifying-glass"
                                  Click="@ApplyOperationFiltersAsync"
                                  Enabled="@(!IsSubmitting)" />
                    </div>
                </div>
            </section>

            <section class="iv-card pr-dp-lines">
                <div class="pr-dp-section-head">
                    <div>
                        <p class="iv-eyebrow">Results</p>
                        <strong>Matching operations</strong>
                    </div>
                    <span class="pr-dp-count">@OperationResultLabel · page @(OperationPage + 1) / @OperationPageCount</span>
                </div>
                @if (IsSubmitting)
                {
                    <div class="iv-skeleton" aria-busy="true">
                        <div class="iv-skeleton__line iv-skeleton__line--lg"></div>
                        <div class="iv-skeleton__line"></div>
                    </div>
                }
                else if (OperationRows.Count == 0)
                {
                    <div class="pr-dp-empty">
                        <div class="pr-dp-empty__icon" aria-hidden="true"><i class="fa-solid fa-magnifying-glass"></i></div>
                        <h3>No eligible operations</h3>
                        <p>Change or clear the filters to see more Work Orders.</p>
                    </div>
                }
                else
                {
                    <div class="pr-popup-grid-shell">
                        <table class="pr-popup-grid">
                            <thead>
                                <tr>
                                    <th>Work Order</th>
                                    <th>Operation</th>
                                    <th>Output</th>
                                    <th class="pr-popup-grid__num">Planned</th>
                                    <th class="pr-popup-grid__action">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var op in OperationRows)
                            {
                                <tr>
                                    <td>
                                        <span class="pr-popup-grid__primary code-style">@op.WorkOrderNo</span>
                                        <span class="pr-popup-grid__secondary">@op.ProductCode · @op.ProductDescription</span>
                                    </td>
                                    <td>
                                        <span class="pr-popup-grid__primary">@op.WorkCentreCode / @op.OperationCode</span>
                                        <span class="pr-popup-grid__secondary">Stage @op.StageSequence · Process Seq @op.ProcessSequence · @op.OperationDescription</span>
                                    </td>
                                    <td>
                                        <span class="pr-popup-grid__primary code-style">@op.OutputItemCode</span>
                                        <span class="pr-popup-grid__secondary">Planned machine: @(op.SelectedMachineCode ?? "—")</span>
                                    </td>
                                    <td class="pr-popup-grid__num">
                                        <span class="pr-popup-grid__primary">@op.PlannedOutputQty.ToString("n4") @op.OutputUom</span>
                                        <span class="pr-popup-grid__secondary">Good completed @op.GoodQty.ToString("n4") · Remaining @op.RemainingQty.ToString("n4")</span>
                                    </td>
                                    <td class="pr-popup-grid__action">
                                        <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                                  Text="SELECT"
                                                  Click="@(() => ApplyOperationAsync(op))"
                                                  Enabled="@(!IsSubmitting)" />
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <div class="pr-dp-pager">
                        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                  Text="Previous"
                                  Click="@(() => ChangeOperationPageAsync(-1))"
                                  Enabled="@(OperationPage > 0 && !IsSubmitting)" />
                        <span>Page @(OperationPage + 1) of @OperationPageCount</span>
                        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                  Text="Next"
                                  Click="@(() => ChangeOperationPageAsync(1))"
                                  Enabled="@(OperationPage + 1 < OperationPageCount && !IsSubmitting)" />
                    </div>
                }
            </section>
        }
        else if (Workspace is not null)
        {
            <section class="iv-card">
                <header class="pr-dp-section-head">
                    <div>
                        <strong>Operation</strong>
                        <small>@Workspace.Operation.WorkOrderNo · @Workspace.Operation.OperationCode — @Workspace.Operation.OperationDescription</small>
                    </div>
                    <span class="pr-dp-pill">@ModeStatus</span>
                </header>
                <div class="pr-dp-meta">
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Product</span>
                        <strong class="code-style">@Workspace.Operation.ProductCode</strong>
                        <small>@Workspace.Operation.ProductDescription</small>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Work Centre</span>
                        <strong>@Workspace.Operation.WorkCentreCode</strong>
                        <small>Stage @Workspace.Operation.StageSequence</small>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Process</span>
                        <strong>@Workspace.Operation.OperationCode</strong>
                        <small>Process Seq @Workspace.Operation.ProcessSequence</small>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Planned output</span>
                        <strong>@Workspace.Operation.PlannedOutputQty.ToString("n4") @Workspace.Operation.OutputUom</strong>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Good completed / remaining</span>
                        <strong>@Workspace.Operation.GoodQty.ToString("n4") / @Workspace.Operation.RemainingQty.ToString("n4")</strong>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Planned machine</span>
                        <strong class="code-style">@(string.IsNullOrWhiteSpace(PlannedMachineCode) ? "—" : PlannedMachineCode)</strong>
                        <small>@(string.IsNullOrWhiteSpace(PlannedMachineDescription) ? "Work Order snapshot" : PlannedMachineDescription)</small>
                    </div>
                    <div class="pr-dp-meta__item">
                        <span class="iv-field__label">Output</span>
                        <strong class="code-style">@Workspace.Operation.OutputItemCode</strong>
                        <small>@Workspace.Operation.OutputType · @Workspace.Operation.OutputUom</small>
                    </div>
                </div>
            </section>

            <section class="iv-card">
                <div class="pr-dp-section-head">
                    <div>
                        <p class="iv-eyebrow">Entry</p>
                        <strong>Production details</strong>
                        <small>Choose existing master values, then enter the production quantities.</small>
                    </div>
                </div>
                <DxFormLayout SizeMode="SizeMode.Small" CssClass="pr-dp-form">
                    <DxFormLayoutItem Caption="Production date &amp; time" ColSpanMd="3">
                        <Template>
                            <DxDateEdit Date="@ProductionDate"
                                        DateChanged="@((DateTime v) => OnProductionDateChanged(v))"
                                        DisplayFormat="dd/MM/yyyy HH:mm"
                                        TimeSectionVisible="true"
                                        Enabled="@CanEditFields"
                                        CssClass="w-100" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Shift" ColSpanMd="3">
                        <Template>
                            <DxComboBox Data="@Lookups.Shifts"
                                        TextFieldName="@nameof(ProductionOutputChoice.Label)"
                                        ValueFieldName="@nameof(ProductionOutputChoice.Code)"
                                        @bind-Value="@ShiftCode"
                                        NullText="Optional shift"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                        SearchMode="ListSearchMode.AutoSearch"
                                        SearchFilterCondition="ListSearchFilterCondition.Contains"
                                        Enabled="@CanEditFields" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Actual machine" ColSpanMd="3">
                        <Template>
                            <DxComboBox Data="@Lookups.Machines"
                                        TextFieldName="@nameof(ProductionOutputChoice.Label)"
                                        ValueFieldName="@nameof(ProductionOutputChoice.Code)"
                                        @bind-Value="@ActualMachineCode"
                                        NullText="Optional actual machine"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                        SearchMode="ListSearchMode.AutoSearch"
                                        SearchFilterCondition="ListSearchFilterCondition.Contains"
                                        Enabled="@CanEditFields" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Operator" ColSpanMd="3">
                        <Template>
                            <DxComboBox Data="@Lookups.Operators"
                                        TextFieldName="@nameof(ProductionOutputChoice.Label)"
                                        ValueFieldName="@nameof(ProductionOutputChoice.Code)"
                                        @bind-Value="@OperatorCode"
                                        NullText="Optional operator"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                        SearchMode="ListSearchMode.AutoSearch"
                                        SearchFilterCondition="ListSearchFilterCondition.Contains"
                                        Enabled="@CanEditFields" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Output lot" ColSpanMd="4">
                        <Template>
                            <DxTextBox @bind-Text="@OutputLotNo" NullText="Enter output lot" Enabled="@CanEditFields" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Output item / UOM" ColSpanMd="4">
                        <Template>
                            <div class="pr-dp-readonly code-style">@OutputItemCode · @OutputUom</div>
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Planned machine" ColSpanMd="4">
                        <Template>
                            <div class="pr-dp-readonly">@PlannedMachineCode @(string.IsNullOrWhiteSpace(PlannedMachineDescription) ? "" : $"· {PlannedMachineDescription}")</div>
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayout>
            </section>

            <section class="iv-card pr-dp-grid">
                <div class="pr-dp-section-head">
                    <div>
                        <p class="iv-eyebrow">Output quantities</p>
                        <strong>Record production</strong>
                        <small>Good Completed drives the remaining quantity; Scrap, Reject, and Hold are tracked separately.</small>
                    </div>
                </div>
                <div class="pr-dp-qty-grid">
                    <div class="pr-dp-qty-field">
                        <span class="iv-field__label">Good</span>
                        <DxSpinEdit Value="@GoodQty"
                                    ValueChanged="@((decimal v) => OnOutputQtyChanged(v, ScrapQty, RejectQty, HoldQty))"
                                    Enabled="@CanEditFields" MinValue="0m" Increment="0.0001m" DisplayFormat="n4" ShowSpinButtons="false" />
                        <small>@OutputUom</small>
                    </div>
                    <div class="pr-dp-qty-field">
                        <span class="iv-field__label">Scrap</span>
                        <DxSpinEdit Value="@ScrapQty"
                                    ValueChanged="@((decimal v) => OnOutputQtyChanged(GoodQty, v, RejectQty, HoldQty))"
                                    Enabled="@CanEditFields" MinValue="0m" Increment="0.0001m" DisplayFormat="n4" ShowSpinButtons="false" />
                        <small>@OutputUom</small>
                    </div>
                    <div class="pr-dp-qty-field">
                        <span class="iv-field__label">Reject</span>
                        <DxSpinEdit Value="@RejectQty"
                                    ValueChanged="@((decimal v) => OnOutputQtyChanged(GoodQty, ScrapQty, v, HoldQty))"
                                    Enabled="@CanEditFields" MinValue="0m" Increment="0.0001m" DisplayFormat="n4" ShowSpinButtons="false" />
                        <small>@OutputUom</small>
                    </div>
                    <div class="pr-dp-qty-field">
                        <span class="iv-field__label">Hold</span>
                        <DxSpinEdit Value="@HoldQty"
                                    ValueChanged="@((decimal v) => OnOutputQtyChanged(GoodQty, ScrapQty, RejectQty, v))"
                                    Enabled="@CanEditFields" MinValue="0m" Increment="0.0001m" DisplayFormat="n4" ShowSpinButtons="false" />
                        <small>@OutputUom</small>
                    </div>
                </div>
            </section>

            <section class="iv-card pr-dp-grid">
                <div class="pr-dp-section-head">
                    <div>
                        <p class="iv-eyebrow">Consumption</p>
                        <strong>Materials this post</strong>
                        <small>Standard follows Good + Scrap + Reject + Hold. Override consume only for real materials; previous-process handoff stays locked.</small>
                    </div>
                    @if (CanEditFields)
                    {
                        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                  Text="RESET CONSUMES TO STANDARD"
                                  IconCssClass="fa-solid fa-rotate-left"
                                  Click="@ResetConsumesToStandard"
                                  Enabled="@(!IsSubmitting)" />
                    }
                </div>
                <DxGrid Data="@MaterialEdits"
                        KeyFieldName="@nameof(MaterialLineEdit.WorkOrderMaterialId)"
                        ShowFilterRow="false"
                        ShowGroupPanel="false"
                        ShowSearchBox="false"
                        TextWrapEnabled="false"
                        PageSize="20"
                        ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                        CssClass="pr-dp-grid">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(MaterialLineEdit.ComponentCode)" Caption="Material" MinWidth="140" />
                        <DxGridDataColumn FieldName="@nameof(MaterialLineEdit.Description)" Caption="Description" MinWidth="150" />
                        <DxGridDataColumn Caption="Supply / Issue" MinWidth="150">
                            <CellDisplayTemplate>
                                @{
                                    var line = (MaterialLineEdit)context.DataItem;
                                }
                                <span>@line.SupplySource / @line.IssueMethod</span>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(MaterialLineEdit.WoBomRequiredQty)" Caption="WO BOM Required" Width="130px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(MaterialLineEdit.StandardQty)" Caption="Standard This Post" Width="140px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(MaterialLineEdit.MaxConsumeQty)" Caption="Max incl. Tolerance" Width="140px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn Caption="Consume Now" Width="140px">
                            <CellDisplayTemplate>
                                @{
                                    var line = (MaterialLineEdit)context.DataItem;
                                }
                                <DxSpinEdit Value="@line.ConsumeQty"
                                            ValueChanged="@((decimal v) => OnConsumeChanged(line, v))"
                                            Enabled="@(CanEditFields && line.IsConsumeEditable)"
                                            MinValue="0m"
                                            Increment="0.0001m"
                                            DisplayFormat="n4"
                                            ShowSpinButtons="false" />
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(MaterialLineEdit.VarianceQty)" Caption="Variance" Width="110px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn Caption="Reason" Width="160px">
                            <CellDisplayTemplate>
                                @{
                                    var line = (MaterialLineEdit)context.DataItem;
                                }
                                <DxComboBox Data="@VarianceReasonChoices"
                                            TextFieldName="@nameof(ProductionOutputChoice.Label)"
                                            ValueFieldName="@nameof(ProductionOutputChoice.Code)"
                                            Value="@line.VarianceReasonCode"
                                            ValueChanged="@((string? v) => OnReasonChanged(line, v))"
                                            NullText="Select reason"
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                            Enabled="@(CanEditFields && line.IsConsumeEditable && line.VarianceQty != 0m)" />
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn Caption="Reason detail" MinWidth="160">
                            <CellDisplayTemplate>
                                @{
                                    var line = (MaterialLineEdit)context.DataItem;
                                }
                                <DxTextBox Text="@line.VarianceReasonText"
                                           TextChanged="@((string v) => line.VarianceReasonText = v)"
                                           NullText="Required for OTHER"
                                           Enabled="@(CanEditFields && line.IsConsumeEditable && string.Equals(line.VarianceReasonCode, ProductionMaterialVarianceReasonCodes.Other, StringComparison.Ordinal))" />
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(MaterialLineEdit.AvailableQty)" Caption="Current Available" Width="140px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(MaterialLineEdit.RemainingAfterConsume)" Caption="Remaining After" Width="130px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(MaterialLineEdit.RequiredUom)" Caption="UOM" Width="80px" />
                        <DxGridDataColumn FieldName="@nameof(MaterialLineEdit.StatusText)" Caption="Status" MinWidth="160" />
                    </Columns>
                </DxGrid>
            </section>

            <footer class="pr-dp-footer">
                <p class="pr-dp-footer__hint">
                    @if (!CanEditFields)
                    {
                        @:This document is read-only in its current status.
                    }
                    else if (GoodQty + ScrapQty + RejectQty + HoldQty <= 0m)
                    {
                        @:Enter at least one production quantity, then save the draft.
                    }
                    else
                    {
                        @:Review the operation and material readiness, then save the draft.
                    }
                </p>
                <div class="pr-dp-footer__actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="CANCEL"
                              IconCssClass="fa-solid fa-xmark"
                              Click="@BackToList"
                              Enabled="@(!IsSubmitting)" />
                    <DxButton RenderStyle="ButtonRenderStyle.Primary"
                              Text="@(IsSubmitting ? "Saving…" : "SAVE DRAFT")"
                              IconCssClass="fa-solid fa-floppy-disk"
                              Click="@SaveAsync"
                              Enabled="@(!IsSubmitting && CanSave)" />
                </div>
            </footer>
        }
    </div>

    <DxPopup Visible="@PostConfirmationVisible"
             HeaderText="Confirm Post"
             CloseOnOutsideClick="false"
             ShowCloseButton="true"
             ShowFooter="true"
             Closed="@(() => PostConfirmationVisible = false)">
        <BodyContentTemplate>
            <p>Post daily production document <strong>@DocumentNo</strong>?</p>
        </BodyContentTemplate>
        <FooterContentTemplate>
            <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => PostConfirmationVisible = false)" Enabled="@(!IsSubmitting)" />
            <DxButton Text="Post" RenderStyle="ButtonRenderStyle.Success" Click="@PostAsync" Enabled="@(!IsSubmitting)" />
        </FooterContentTemplate>
    </DxPopup>

    <DxPopup Visible="@DeleteConfirmationVisible"
             HeaderText="Confirm Delete"
             CloseOnOutsideClick="false"
             ShowCloseButton="true"
             ShowFooter="true"
             Closed="@(() => DeleteConfirmationVisible = false)">
        <BodyContentTemplate>
            <p>Delete the NEW draft <strong>@DocumentNo</strong>?</p>
        </BodyContentTemplate>
        <FooterContentTemplate>
            <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => DeleteConfirmationVisible = false)" Enabled="@(!IsSubmitting)" />
            <DxButton Text="Delete" RenderStyle="ButtonRenderStyle.Danger" Click="@DeleteAsync" Enabled="@(!IsSubmitting)" />
        </FooterContentTemplate>
    </DxPopup>

    <DxPopup Visible="@RollbackConfirmVisible"
             HeaderText="Rollback Daily Production"
             CloseOnOutsideClick="false"
             ShowCloseButton="true"
             ShowFooter="true"
             Closed="@(() => RollbackConfirmVisible = false)">
        <BodyContentTemplate>
            <p>Enter a reason to roll back this posted document.</p>
            <DxMemo @bind-Text="@RollbackReason" Rows="3" maxlength="250" CssClass="w-100" />
        </BodyContentTemplate>
        <FooterContentTemplate>
            <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary" Click="@(() => RollbackConfirmVisible = false)" Enabled="@(!IsSubmitting)" />
            <DxButton Text="Rollback" RenderStyle="ButtonRenderStyle.Warning" Click="@RollbackAsync" Enabled="@(!IsSubmitting)" />
        </FooterContentTemplate>
    </DxPopup>
</MenuAuthorize>
