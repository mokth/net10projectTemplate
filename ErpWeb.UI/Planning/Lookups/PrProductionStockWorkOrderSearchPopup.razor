@namespace ErpWeb.UI.Planning.Lookups
@using ErpWeb.Core.Production
@using Microsoft.AspNetCore.Components.Web

<DxPopup HeaderCssClass="code-style"
         HeaderText="SELECT WORK ORDER"
         CloseOnOutsideClick="false"
         Width="90vw"
         CssClass="common-popup pr-popup-grid-dialog"
         @bind-Visible="Visible"
         Closing="@OnClosing">
    <Content>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-warning py-2" role="alert">@_error</div>
        }

        <div class="d-flex gap-2 mb-2 align-items-end">
            <div class="flex-grow-1">
                <label class="form-label mb-0">Search</label>
                <DxTextBox @bind-Text="_searchText"
                           NullText="WO / product / description"
                           ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                           @onkeydown="OnSearchKeyDownAsync" />
            </div>
            <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                      Text="SEARCH"
                      IconCssClass="fa-solid fa-magnifying-glass"
                      Click="@SearchPageAsync" />
        </div>

        <div class="pr-popup-grid-shell" @onkeydown="OnGridKeyDownAsync">
            <DxGrid ColumnResizeMode="GridColumnResizeMode.ColumnsContainer" @ref="_grid"
                    Data="@_items"
                    KeyFieldName="@nameof(ProductionStockWorkOrderLookupRow.WorkOrderId)"
                    ShowFilterRow="false"
                    ShowGroupPanel="false"
                    TextWrapEnabled="false"
                    FocusedRowEnabled="true"
                    CssClass="pr-popup-grid"
                    RowDoubleClick="@OnRowDoubleClick"
                    SelectedDataItemChanged="@OnSelectedItemChanged">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(ProductionStockWorkOrderLookupRow.WorkOrderNo)" Caption="WORK ORDER" Width="150px" MinWidth="130" />
                    <DxGridDataColumn FieldName="@nameof(ProductionStockWorkOrderLookupRow.ProductCode)" Caption="PRODUCT" Width="135px" MinWidth="120" />
                    <DxGridDataColumn FieldName="@nameof(ProductionStockWorkOrderLookupRow.ProductDescription)" Caption="DESCRIPTION" Width="220px" MinWidth="180" />
                    <DxGridDataColumn FieldName="@nameof(ProductionStockWorkOrderLookupRow.Status)" Caption="STATUS" Width="115px" />
                    <DxGridDataColumn FieldName="@nameof(ProductionStockWorkOrderLookupRow.PlannedQty)" Caption="PLANNED" DisplayFormat="n4" Width="120px" />
                    <DxGridDataColumn FieldName="@nameof(ProductionStockWorkOrderLookupRow.RemainingQty)" Caption="REMAINING" DisplayFormat="n4" Width="125px" />
                    <DxGridDataColumn FieldName="@nameof(ProductionStockWorkOrderLookupRow.OutputUom)" Caption="UOM" Width="80px" />
                    <DxGridDataColumn FieldName="@nameof(ProductionStockWorkOrderLookupRow.CandidateSourceCount)" Caption="SOURCE POOLS" DisplayFormat="n0" Width="115px" />
                </Columns>
            </DxGrid>
            @if (!_loading && _items.Count == 0)
            {
                <p class="text-muted p-3 mb-0">@(_searchText is null || _searchText.Length == 0 ? "No eligible Work Orders with candidate Production stock were found." : "No eligible Work Orders match this search.")</p>
            }
        </div>

        <div class="d-flex justify-content-between align-items-center mt-2">
            <span class="text-muted small">@_totalCount Work Order(s) · page @CurrentPage / @TotalPages</span>
            <div class="d-flex gap-2">
                <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="PREV" Enabled="@(_skip > 0 && !_loading)" Click="@PrevPageAsync" />
                <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="NEXT" Enabled="@(_skip + _pageSize < _totalCount && !_loading)" Click="@NextPageAsync" />
            </div>
        </div>

        <div class="d-flex gap-2 mt-3">
            <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="SELECT" IconCssClass="fa-solid fa-check"
                      Click="@SelectFocusedAsync" Enabled="@(_focused is not null && !_loading)" />
            <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="CANCEL" IconCssClass="fa-solid fa-xmark" Click="@CloseAsync" />
        </div>
    </Content>
</DxPopup>
