@page "/planning/stock-card"
@inherits PageBase

<PageTitle>Production Stock Card</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.PlanningStockCard">
    <div class="iv-page">
        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <div class="iv-toast iv-toast--ok" role="status">
                <span>@StatusMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissStatus" aria-label="Dismiss">×</button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="iv-toast iv-toast--err" role="alert">
                <span>@ErrorMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissError" aria-label="Dismiss">×</button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(CoverageWarning))
        {
            <div class="iv-toast iv-toast--wait" role="status">
                <span>@CoverageWarning</span>
            </div>
        }

        <header class="iv-hero">
            <div class="iv-hero__mark" aria-hidden="true">
                <i class="fa-solid fa-book"></i>
            </div>
            <div class="iv-hero__copy">
                <p class="iv-eyebrow">Planning · Inquiry</p>
                <h1 class="iv-title">Production Stock Card</h1>
                <p class="iv-subtitle">
                    Sealed V2 production movements for one item and base UOM, with opening, running and
                    closing balances. Document-type filters change the displayed rows only.
                </p>
                <div class="iv-chips">
                    <span class="iv-chip">@TotalCountLabel</span>
                    <span class="iv-chip">Opening: @OpeningQty.ToString("N4")</span>
                    <span class="iv-chip">In: @PeriodInQty.ToString("N4")</span>
                    <span class="iv-chip">Out: @PeriodOutQty.ToString("N4")</span>
                    <span class="iv-chip">Watermark: @Watermark.ToString("N0")</span>
                </div>
            </div>
            <div class="iv-hero__kpi">
                <span>Closing</span>
                <strong>@ClosingQty.ToString("N4")</strong>
            </div>
        </header>

        <section class="iv-card">
            <DxFormLayout SizeMode="SizeMode.Small">
                <DxFormLayoutItem Caption="Item" ColSpanMd="4">
                    <DxTextBox @bind-Text="@ItemCode"
                               NullText="Item code"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Base UOM" ColSpanMd="2">
                    <DxTextBox @bind-Text="@BaseUom"
                               NullText="EA"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="From" ColSpanMd="3">
                    <DxDateEdit @bind-Date="@DateFrom"
                                DisplayFormat="dd/MM/yyyy"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="To" ColSpanMd="3">
                    <DxDateEdit @bind-Date="@DateTo"
                                DisplayFormat="dd/MM/yyyy"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Work order" ColSpanMd="3">
                    <DxTextBox @bind-Text="@WorkOrderNo"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Stage" ColSpanMd="3">
                    <DxTextBox @bind-Text="@BalanceStage"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Location" ColSpanMd="3">
                    <DxTextBox @bind-Text="@ProductionLocationCode"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Lot" ColSpanMd="3">
                    <DxTextBox @bind-Text="@LotIdentity"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>
            </DxFormLayout>
            <div class="iv-toolbar-row">
                <DxButton RenderStyle="ButtonRenderStyle.Primary"
                          Text="APPLY"
                          IconCssClass="fa-solid fa-filter"
                          Click="@ReloadAsync" />
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          Text="REFRESH"
                          IconCssClass="fa-solid fa-rotate"
                          Click="@ReloadAsync" />
            </div>

            @if (IsBootstrapping)
            {
                <div class="iv-skeleton" aria-busy="true">
                    <div class="iv-skeleton__line iv-skeleton__line--lg"></div>
                    <div class="iv-skeleton__line"></div>
                </div>
            }
            else
            {
                <div class="iv-list-desktop">
                    <CommonDataGridEx T="ProductionStockHistoryRow"
                                      Columns="@Columns"
                                      Buttons="@Buttons"
                                      ActionButtons="@ActionButtons"
                                      KeyName="@nameof(ProductionStockHistoryRow.MovementId)"
                                      GridKey="pln-stock-card"
                                      Title="Movements"
                                      CustomDataSource="@DataSource"
                                      ShowToolbarText="true"
                                      ShowResetLayoutButton="true"
                                      UseBuiltInExport="false"
                                      ShowSearchBox="false"
                                      ShowFilterRow="false"
                                      ShowGroupPanel="false"
                                      allowSelect="false"
                                      OnGridInstance="@OnGridInstance"
                                      OnButtonEventHandle="@OnButtonClick" />
                </div>
            }
        </section>
    </div>
</MenuAuthorize>
