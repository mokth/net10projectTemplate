@page "/planning/material-consume-variance"
@inherits PageBase

<PageTitle>Material Consume Variance</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.PlanningMaterialConsumeVariance">
    <div class="iv-page pr-var-page">
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="iv-toast iv-toast--err" role="alert">
                <span>@ErrorMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissError" aria-label="Dismiss">×</button>
            </div>
        }

        <header class="iv-hero">
            <div class="iv-hero__mark" aria-hidden="true">
                <i class="fa-solid fa-chart-column"></i>
            </div>
            <div class="iv-hero__copy">
                <p class="iv-eyebrow">Planning · Inquiry</p>
                <h1 class="iv-title">Material Consume Variance</h1>
                <p class="iv-subtitle">Daily Production standard vs actual consume. Quantity totals stay grouped by component and UOM.</p>
                <div class="iv-chips">
                    <span class="iv-chip">@TotalCountLabel</span>
                    <span class="iv-chip">@DocumentStatus</span>
                    <span class="iv-chip">@VarianceDirection</span>
                </div>
            </div>
            <div class="iv-hero__kpi">
                <span>Lines</span>
                <strong>@Detail.TotalCount.ToString("N0")</strong>
            </div>
        </header>

        <section class="iv-card">
            <DxFormLayout SizeMode="SizeMode.Small">
                <DxFormLayoutItem Caption="From" ColSpanMd="2">
                    <DxDateEdit @bind-Date="@DateFrom" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="To" ColSpanMd="2">
                    <DxDateEdit @bind-Date="@DateTo" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Work Order" ColSpanMd="2">
                    <DxTextBox @bind-Text="@WorkOrderNo" NullText="WO no." ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Product" ColSpanMd="2">
                    <DxTextBox @bind-Text="@ProductCode" NullText="Product" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Component" ColSpanMd="2">
                    <DxTextBox @bind-Text="@ComponentCode" NullText="Material" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Work Centre" ColSpanMd="2">
                    <DxTextBox @bind-Text="@WorkCentreCode" NullText="WC" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Process" ColSpanMd="2">
                    <DxTextBox @bind-Text="@OperationCode" NullText="Process" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Direction" ColSpanMd="2">
                    <DxComboBox Data="@DirectionChoices"
                                TextFieldName="@nameof(ProductionOutputChoice.Label)"
                                ValueFieldName="@nameof(ProductionOutputChoice.Code)"
                                @bind-Value="@VarianceDirection" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Reason" ColSpanMd="2">
                    <DxComboBox Data="@ReasonChoices"
                                TextFieldName="@nameof(ProductionOutputChoice.Label)"
                                ValueFieldName="@nameof(ProductionOutputChoice.Code)"
                                @bind-Value="@VarianceReasonCode"
                                NullText="All reasons"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Status" ColSpanMd="2">
                    <DxComboBox Data="@StatusChoices"
                                TextFieldName="@nameof(ProductionOutputChoice.Label)"
                                ValueFieldName="@nameof(ProductionOutputChoice.Code)"
                                @bind-Value="@DocumentStatus" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Posted by" ColSpanMd="2">
                    <DxTextBox @bind-Text="@PostedBy" NullText="User" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>
            </DxFormLayout>
            <div class="pr-var-actions">
                <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="CLEAR" Click="@ClearFiltersAsync" Enabled="@(!IsSearching)" />
                <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="SEARCH" IconCssClass="fa-solid fa-magnifying-glass" Click="@ApplyFiltersAsync" Enabled="@(!IsSearching)" />
            </div>
        </section>

        <section class="iv-card">
            <div class="pr-var-tabs">
                <button type="button" class="@(ActiveTab == "detail" ? "is-active" : null)" @onclick="@(() => ActiveTab = "detail")">Detail</button>
                <button type="button" class="@(ActiveTab == "component" ? "is-active" : null)" @onclick="@(() => ActiveTab = "component")">By component + UOM</button>
                <button type="button" class="@(ActiveTab == "reason" ? "is-active" : null)" @onclick="@(() => ActiveTab = "reason")">By reason (counts)</button>
                <button type="button" class="@(ActiveTab == "reason-comp" ? "is-active" : null)" @onclick="@(() => ActiveTab = "reason-comp")">Reason + component</button>
                <button type="button" class="@(ActiveTab == "wo" ? "is-active" : null)" @onclick="@(() => ActiveTab = "wo")">By Work Order (counts)</button>
                <button type="button" class="@(ActiveTab == "wo-comp" ? "is-active" : null)" @onclick="@(() => ActiveTab = "wo-comp")">WO + component</button>
            </div>

            @if (IsBootstrapping || IsSearching)
            {
                <div class="iv-skeleton" aria-busy="true">
                    <div class="iv-skeleton__line iv-skeleton__line--lg"></div>
                    <div class="iv-skeleton__line"></div>
                </div>
            }
            else if (ActiveTab == "detail")
            {
                <DxGrid Data="@Detail.Rows"
                        TextWrapEnabled="false"
                        KeyFieldName="@nameof(ProductionMaterialConsumeVarianceRow.ProductionOutputId)"
                        ShowFilterRow="false"
                        PageSize="50"
                        ColumnResizeMode="GridColumnResizeMode.ColumnsContainer">
                    <Columns>
                        <DxGridDataColumn Caption="Document" MinWidth="130">
                            <CellDisplayTemplate>
                                @{
                                    var row = (ProductionMaterialConsumeVarianceRow)context.DataItem;
                                }
                                <button type="button" class="pr-var-link" @onclick="@(() => OpenDailyProduction(row.ProductionOutputId))">@row.DocumentNo</button>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceRow.ProductionDate)" Caption="Date" Width="140px" DisplayFormat="dd/MM/yyyy HH:mm" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceRow.DocumentStatus)" Caption="Status" Width="100px" />
                        <DxGridDataColumn Caption="Work Order" MinWidth="120">
                            <CellDisplayTemplate>
                                @{
                                    var row = (ProductionMaterialConsumeVarianceRow)context.DataItem;
                                }
                                <button type="button" class="pr-var-link" @onclick="@(() => OpenWorkOrder(row.WorkOrderNo))">@row.WorkOrderNo</button>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceRow.ProductCode)" Caption="Product" Width="110px" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceRow.WorkCentreCode)" Caption="WC" Width="90px" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceRow.OperationCode)" Caption="Process" Width="90px" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceRow.ComponentCode)" Caption="Component" Width="120px" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceRow.RequiredUom)" Caption="UOM" Width="70px" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceRow.StandardQty)" Caption="Standard" Width="110px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceRow.ConsumeQty)" Caption="Consume" Width="110px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceRow.VarianceQty)" Caption="Variance" Width="110px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceRow.VariancePct)" Caption="Var %" Width="90px" DisplayFormat="n2" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceRow.VarianceReasonCode)" Caption="Reason" Width="140px" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceRow.PostedBy)" Caption="Posted by" Width="100px" />
                    </Columns>
                </DxGrid>
                <div class="pr-var-pager">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Previous" Click="@(() => ChangePageAsync(-1))" Enabled="@(PageIndex > 0 && !IsSearching)" />
                    <span>Page @(PageIndex + 1) of @PageCount</span>
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Next" Click="@(() => ChangePageAsync(1))" Enabled="@(PageIndex + 1 < PageCount && !IsSearching)" />
                </div>
            }
            else if (ActiveTab == "component")
            {
                <DxGrid ColumnResizeMode="GridColumnResizeMode.ColumnsContainer" Data="@Summaries.ByComponent" ShowFilterRow="false" PageSize="50" TextWrapEnabled="false">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByComponent.ComponentCode)" Caption="Component" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByComponent.RequiredUom)" Caption="UOM" Width="80px" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByComponent.TotalStandardQty)" Caption="Total standard" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByComponent.TotalConsumeQty)" Caption="Total consume" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByComponent.TotalVarianceQty)" Caption="Total variance" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByComponent.OverDocumentCount)" Caption="Over docs" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByComponent.UnderDocumentCount)" Caption="Under docs" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByComponent.ExactDocumentCount)" Caption="Exact docs" TextAlignment="GridTextAlignment.Right" />
                    </Columns>
                </DxGrid>
            }
            else if (ActiveTab == "reason")
            {
                <p class="pr-var-note">Counts only. Quantity is never mixed across UOMs on this tab.</p>
                <DxGrid ColumnResizeMode="GridColumnResizeMode.ColumnsContainer" Data="@Summaries.ByReason" ShowFilterRow="false" PageSize="50" TextWrapEnabled="false">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByReason.VarianceReasonCode)" Caption="Reason" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByReason.DocumentLineCount)" Caption="Lines" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByReason.OverLineCount)" Caption="Over" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByReason.UnderLineCount)" Caption="Under" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByReason.ExactLineCount)" Caption="Exact" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByReason.AffectedWorkOrderCount)" Caption="Work Orders" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByReason.AffectedComponentCount)" Caption="Components" TextAlignment="GridTextAlignment.Right" />
                    </Columns>
                </DxGrid>
            }
            else if (ActiveTab == "reason-comp")
            {
                <DxGrid ColumnResizeMode="GridColumnResizeMode.ColumnsContainer" Data="@Summaries.ByReasonComponent" ShowFilterRow="false" PageSize="50" TextWrapEnabled="false">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByReasonComponent.VarianceReasonCode)" Caption="Reason" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByReasonComponent.ComponentCode)" Caption="Component" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByReasonComponent.RequiredUom)" Caption="UOM" Width="80px" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByReasonComponent.TotalVarianceQty)" Caption="Total variance" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByReasonComponent.TotalAbsoluteVarianceQty)" Caption="Abs. variance" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                    </Columns>
                </DxGrid>
            }
            else if (ActiveTab == "wo")
            {
                <p class="pr-var-note">Counts only. Use WO + component for quantity drill-down.</p>
                <DxGrid ColumnResizeMode="GridColumnResizeMode.ColumnsContainer" Data="@Summaries.ByWorkOrder" ShowFilterRow="false" PageSize="50" TextWrapEnabled="false">
                    <Columns>
                        <DxGridDataColumn Caption="Work Order">
                            <CellDisplayTemplate>
                                @{
                                    var row = (ProductionMaterialConsumeVarianceByWorkOrder)context.DataItem;
                                }
                                <button type="button" class="pr-var-link" @onclick="@(() => OpenWorkOrder(row.WorkOrderNo))">@row.WorkOrderNo</button>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByWorkOrder.ProductCode)" Caption="Product" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByWorkOrder.VarianceLineCount)" Caption="Lines" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByWorkOrder.OverLineCount)" Caption="Over" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByWorkOrder.UnderLineCount)" Caption="Under" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByWorkOrder.ExactLineCount)" Caption="Exact" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByWorkOrder.AffectedComponentCount)" Caption="Components" TextAlignment="GridTextAlignment.Right" />
                    </Columns>
                </DxGrid>
            }
            else
            {
                <DxGrid ColumnResizeMode="GridColumnResizeMode.ColumnsContainer" Data="@Summaries.ByWorkOrderComponent" ShowFilterRow="false" PageSize="50" TextWrapEnabled="false">
                    <Columns>
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByWorkOrderComponent.WorkOrderNo)" Caption="Work Order" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByWorkOrderComponent.ComponentCode)" Caption="Component" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByWorkOrderComponent.RequiredUom)" Caption="UOM" Width="80px" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByWorkOrderComponent.TotalStandardQty)" Caption="Total standard" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByWorkOrderComponent.TotalConsumeQty)" Caption="Total consume" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(ProductionMaterialConsumeVarianceByWorkOrderComponent.TotalVarianceQty)" Caption="Total variance" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                    </Columns>
                </DxGrid>
            }
        </section>
    </div>
</MenuAuthorize>
