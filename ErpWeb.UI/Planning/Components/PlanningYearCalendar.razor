@namespace ErpWeb.UI.Planning.Components
@using ErpWeb.Core.Planning

<div class="pyc">
    <div class="pyc-legend" aria-hidden="true">
        <span class="pyc-legend__item"><i class="pyc-swatch pyc-swatch--work"></i> Work</span>
        <span class="pyc-legend__item"><i class="pyc-swatch pyc-swatch--off"></i> Off</span>
        <span class="pyc-legend__item"><i class="pyc-swatch pyc-swatch--holiday"></i> Holiday</span>
        <span class="pyc-legend__item"><i class="pyc-swatch pyc-swatch--today"></i> Today</span>
    </div>
    <div class="pyc-summary">
        Work @_work · Off @_off · Holiday @_holiday
        @if (Dirty) { <span class="pyc-dirty">· unsaved</span> }
    </div>
    <div class="pyc-year" role="grid" aria-label="@($"Calendar {Year}")">
        @for (var m = 1; m <= 12; m++)
        {
            var month = m;
            <div class="pyc-month" role="rowgroup">
                <div class="pyc-month__title">@_monthNames[month - 1]</div>
                <div class="pyc-weekdays" aria-hidden="true">
                    @foreach (var wd in _weekHeaders)
                    {
                        <span>@wd</span>
                    }
                </div>
                <div class="pyc-days">
                    @{
                        var first = new DateTime(Year, month, 1);
                        // Monday-first: Mon=0 … Sun=6
                        var pad = ((int)first.DayOfWeek + 6) % 7;
                    }
                    @for (var i = 0; i < pad; i++)
                    {
                        <span class="pyc-day pyc-day--empty"></span>
                    }
                    @for (var day = 1; day <= DateTime.DaysInMonth(Year, month); day++)
                    {
                        var dt = new DateTime(Year, month, day);
                        var key = DateOnly.FromDateTime(dt);
                        var code = DayCodes.GetValueOrDefault(key, "W");
                        var isHoliday = Holidays.ContainsKey(key);
                        var isToday = dt.Date == DateTime.Today;
                        var isOff = code == "O" || isHoliday;
                        var holidayName = isHoliday ? Holidays[key] : null;
                        var aria = $"{dt:d MMMM yyyy}" + (isHoliday ? $", Holiday, {holidayName}, Off" : isOff ? ", Off" : ", Work");
                        var css = "pyc-day"
                            + (isHoliday ? " pyc-day--holiday" : isOff ? " pyc-day--off" : " pyc-day--work")
                            + (isToday ? " pyc-day--today" : "");
                        var color = ShiftColors.GetValueOrDefault(key);
                        <button type="button"
                                class="@css"
                                style="@(string.IsNullOrEmpty(color) || isOff ? null : $"--pyc-shift:{color}")"
                                aria-label="@aria"
                                title="@(holidayName ?? (isOff ? "Off" : "Work"))"
                                disabled="@(ReadOnly || (isHoliday && PaintMode == "W"))"
                                @onclick="(() => OnDayClick(key, isHoliday))">
                            <span class="pyc-day__n">@day</span>
                            @if (isHoliday)
                            {
                                <span class="pyc-day__mark" aria-hidden="true">★</span>
                            }
                        </button>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    private static readonly string[] _weekHeaders = ["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"];
    private static readonly string[] _monthNames =
        ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

    [Parameter] public int Year { get; set; } = DateTime.Today.Year;
    [Parameter] public IReadOnlyDictionary<DateOnly, string> DayCodes { get; set; } = new Dictionary<DateOnly, string>();
    [Parameter] public IReadOnlyDictionary<DateOnly, string> Holidays { get; set; } = new Dictionary<DateOnly, string>();
    [Parameter] public IReadOnlyDictionary<DateOnly, string> ShiftColors { get; set; } = new Dictionary<DateOnly, string>();
    [Parameter] public string PaintMode { get; set; } = "O"; // W or O
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Dirty { get; set; }
    [Parameter] public EventCallback<(DateOnly Date, string DateCd)> DayPainted { get; set; }

    private int _work;
    private int _off;
    private int _holiday;

    protected override void OnParametersSet()
    {
        _holiday = Holidays.Count;
        _off = DayCodes.Count(kv => kv.Value == "O" || Holidays.ContainsKey(kv.Key));
        _work = DayCodes.Count(kv => kv.Value == "W" && !Holidays.ContainsKey(kv.Key));
        if (DayCodes.Count == 0 && DateTime.IsLeapYear(Year))
        { /* summary stays zero until generated */ }
    }

    private async Task OnDayClick(DateOnly date, bool isHoliday)
    {
        if (ReadOnly) return;
        if (isHoliday && PaintMode == "W") return;
        var code = isHoliday ? "O" : PaintMode;
        await DayPainted.InvokeAsync((date, code));
    }
}
