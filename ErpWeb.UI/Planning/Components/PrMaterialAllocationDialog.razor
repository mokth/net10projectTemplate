<DxPopup HeaderText="Allocate stock" CloseOnOutsideClick="false" CloseOnEscape="false"
         Width="90vw" MaxWidth="1200px" MaxHeight="90vh"
         CssClass="common-popup pr-allocation-popup pr-popup-grid-dialog" ShowFooter="true"
         Visible="@Visible" VisibleChanged="@OnVisibleChanged">
    <Content>
        <div class="pr-allocation">
            @if (Material is not null)
            {
                <div class="pr-allocation__header">
                    <div><span>Material</span><strong>@Material.ComponentCode</strong><small>@Material.Description</small></div>
                    <div><span>Issue quantity</span><strong>@RequestedQty.ToString("n4") @Material.RequiredUom</strong><small>@RequestedBaseQty.ToString("n4") @Material.BaseUom required</small></div>
                    <div><span>Allocated</span><strong>@AllocatedBaseQty.ToString("n4") @Material.BaseUom</strong><small class="@(AllocationDifference != 0 ? "text-warning" : "text-success")">@(AllocationDifference == 0 ? "Exact quantity allocated" : AllocationDifference > 0 ? $"{AllocationDifference:n4} still needed" : $"{Math.Abs(AllocationDifference):n4} over-allocated")</small></div>
                </div>
            }
            <p class="pr-allocation__help"><i class="fa-solid fa-circle-info"></i> Auto allocation uses FEFO for expiring lots and FIFO when expiry dates are unavailable.</p>
            @if (IsLoading) { <p class="text-muted">Loading eligible stock…</p> }
            else if (!string.IsNullOrWhiteSpace(DialogError)) { <div class="alert alert-danger">@DialogError</div> }
            else if (Rows.Count == 0) { <p class="text-muted">No eligible stock is available for this material.</p> }
            else
            {
                <div class="pr-popup-grid-shell">
                    <table class="pr-popup-grid pr-popup-grid--wide">
                        <thead>
                            <tr>
                                <th>Warehouse</th>
                                <th>Location</th>
                                <th>Lot</th>
                                <th class="pr-popup-grid__num">Current</th>
                                <th class="pr-popup-grid__num" title="Quantity at issue time">At issue</th>
                                <th class="pr-popup-grid__num" title="Reserved by other in-progress issues">Reserved</th>
                                <th class="pr-popup-grid__num">Available</th>
                                <th>Expiry</th>
                                <th>Stock date</th>
                                <th class="pr-popup-grid__num">Suggested</th>
                                <th class="pr-popup-grid__allocate">Allocate</th>
                                <th>UOM</th>
                                @if (CanViewCost) { <th class="pr-popup-grid__num">Unit cost</th> }
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Rows)
                        {
                            <tr class="@(row.IssueBaseQty > 0 ? "is-selected" : null)">
                                <td>@row.Warehouse</td>
                                <td>@row.Location</td>
                                <td>@(string.IsNullOrWhiteSpace(row.LotNo) ? "—" : row.LotNo)</td>
                                <td class="pr-popup-grid__num">@row.CurrentBaseQty.ToString("n4")</td>
                                <td class="pr-popup-grid__num">@row.AsOfBaseQty.ToString("n4")</td>
                                <td class="pr-popup-grid__num">@row.ReservedOtherDraftBaseQty.ToString("n4")</td>
                                <td class="pr-popup-grid__num pr-popup-grid__num--emphasis">@row.AvailableBaseQty.ToString("n4")</td>
                                <td>@DateText(row.ExpiryDate)</td>
                                <td>@DateText(row.StockDate)</td>
                                <td class="pr-popup-grid__num">@row.SuggestedBaseQty.ToString("n4")</td>
                                <td class="pr-popup-grid__allocate">
                                    <InputNumber TValue="decimal" class="form-control form-control-sm text-end" @bind-Value="row.IssueBaseQty" min="0" step="0.0001" />
                                </td>
                                <td>@row.BaseUom</td>
                                @if (CanViewCost) { <td class="pr-popup-grid__num">@row.UnitPrice?.ToString("n4")</td> }
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </Content>
    <FooterContentTemplate>
        <div class="d-flex gap-2 justify-content-end w-100">
            <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Clear" Click="@Clear" Enabled="@(!IsLoading)" />
            <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Auto Allocate" IconCssClass="fa-solid fa-wand-magic-sparkles" Click="@AutoAllocateAsync" Enabled="@(!IsLoading)" />
            <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Cancel" Click="@CancelAsync" />
            <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Apply allocation" Click="@ApplyAsync" Enabled="@(!IsLoading && Math.Abs(AllocationDifference) <= 0.0001m)" />
        </div>
    </FooterContentTemplate>
</DxPopup>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public ProductionMaterialIssueMaterial? Material { get; set; }
    [Parameter] public DateTime IssueDate { get; set; }
    [Parameter] public decimal RequestedQty { get; set; }
    [Parameter] public IReadOnlyList<ProductionMaterialIssueAllocationRequest> Allocations { get; set; } = [];
    [Parameter] public IReadOnlyDictionary<int, decimal> ReservedByOtherLines { get; set; } = new Dictionary<int, decimal>();
    [Parameter] public int? ExcludeBatchNo { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<ProductionMaterialIssueAllocationRequest>> Applied { get; set; }
    [Inject] private IProductionMaterialAllocationService AllocationService { get; set; } = default!;

    private long? _loadedMaterialId;
    private DateTime _loadedDate;
    private bool IsLoading;
    private string? DialogError;
    private List<AllocationRow> Rows { get; set; } = [];
    private bool CanViewCost => Material?.CanManualIssue == true && Rows.Any(x => x.UnitPrice.HasValue);
    private decimal RequestedBaseQty => Material is null ? 0m : IvQty.Round(RequestedQty * Material.ConversionFactorToBase);
    private decimal AllocatedBaseQty => IvQty.Round(Rows.Sum(x => x.IssueBaseQty));
    private decimal AllocationDifference => IvQty.Round(RequestedBaseQty - AllocatedBaseQty);

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && Material is not null && (_loadedMaterialId != Material.WorkOrderMaterialId || _loadedDate != IssueDate))
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true; DialogError = null; Rows = [];
        _loadedMaterialId = Material!.WorkOrderMaterialId; _loadedDate = IssueDate;
        var result = await AllocationService.GetStockCandidatesAsync(
            Material.WorkOrderMaterialId, IssueDate, reservedBaseQtyByBalance: ReservedByOtherLines,
            excludeInventoryBatchNo: ExcludeBatchNo);
        if (!result.Succeeded || result.Data is null) DialogError = result.Message ?? "Unable to load eligible stock.";
        else
        {
            var existing = Allocations.ToDictionary(x => x.FromBalLocId, x => x.BaseQty);
            Rows = result.Data.Select(x => new AllocationRow(x) { IssueBaseQty = existing.GetValueOrDefault(x.FromBalLocId) }).ToList();
        }
        IsLoading = false;
    }

    private async Task AutoAllocateAsync()
    {
        if (Material is null) return;
        IsLoading = true; DialogError = null;
        var result = await AllocationService.AutoAllocateAsync(new ProductionMaterialAllocationRequest
        {
            WorkOrderMaterialId = Material.WorkOrderMaterialId,
            IssueDate = IssueDate,
            RequestedQty = RequestedQty,
            ReservedBaseQtyByBalance = ReservedByOtherLines,
            ExcludeInventoryBatchNo = ExcludeBatchNo
        });
        if (!result.Succeeded || result.Data is null) DialogError = result.Message ?? "Unable to allocate stock.";
        else
        {
            var allocated = result.Data.Allocations.ToDictionary(x => x.FromBalLocId, x => x.SuggestedBaseQty);
            foreach (var row in Rows) row.IssueBaseQty = allocated.GetValueOrDefault(row.FromBalLocId);
        }
        IsLoading = false;
    }

    private void Clear() { foreach (var row in Rows) row.IssueBaseQty = 0m; DialogError = null; }
    private async Task ApplyAsync()
    {
        if (Rows.Any(x => x.IssueBaseQty < 0m || x.IssueBaseQty > x.AvailableBaseQty)) { DialogError = "Allocation must be between zero and usable quantity."; return; }
        if (Math.Abs(AllocatedBaseQty - RequestedBaseQty) > 0.0001m) { DialogError = $"Allocate exactly {RequestedBaseQty:n4} {Material?.BaseUom}."; return; }
        await Applied.InvokeAsync(Rows.Where(x => x.IssueBaseQty > 0m).Select(x => new ProductionMaterialIssueAllocationRequest { FromBalLocId = x.FromBalLocId, BaseQty = IvQty.Round(x.IssueBaseQty) }).ToList());
        await CloseAsync();
    }
    private async Task CancelAsync() => await CloseAsync();
    private async Task CloseAsync() { _loadedMaterialId = null; await VisibleChanged.InvokeAsync(false); }
    private Task OnVisibleChanged(bool value) => VisibleChanged.InvokeAsync(value);
    private static string DateText(DateTime? value) => value?.ToString("dd MMM yyyy") ?? "—";

    private sealed class AllocationRow
    {
        public AllocationRow(ProductionMaterialStockCandidate x) { FromBalLocId = x.FromBalLocId; Warehouse = x.Warehouse; Location = x.Location; LotNo = x.LotNo; ExpiryDate = x.ExpiryDate; StockDate = x.StockDate; CurrentBaseQty = x.CurrentBaseQty; AsOfBaseQty = x.AsOfBaseQty; ReservedOtherDraftBaseQty = x.ReservedOtherDraftBaseQty; AvailableBaseQty = x.AvailableToAllocateBaseQty; BaseUom = x.BaseUom; SuggestedBaseQty = x.SuggestedBaseQty; UnitPrice = x.UnitPrice; }
        public int FromBalLocId { get; }
        public string Warehouse { get; }
        public string Location { get; }
        public string LotNo { get; }
        public DateTime? ExpiryDate { get; }
        public DateTime? StockDate { get; }
        public decimal CurrentBaseQty { get; }
        public decimal AsOfBaseQty { get; }
        public decimal ReservedOtherDraftBaseQty { get; }
        public decimal AvailableBaseQty { get; }
        public string BaseUom { get; }
        public decimal SuggestedBaseQty { get; }
        public decimal? UnitPrice { get; }
        public decimal IssueBaseQty { get; set; }
    }
}
