@page "/inventory/misc-issue/{Mode:regex(^(new|edit|view)$)}"
@page "/inventory/misc-issue/{Mode:regex(^(new|edit|view)$)}/{BatchNo:int}"

@inherits PageBase
@using ErpWeb.UI.Inventory.Lookups

<PageTitle>@PageHeading</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.InventoryMiscIssue">
    <div class="mi-page">
        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <div class="mi-toast mi-toast--ok" role="status">
                <span>@StatusMessage</span>
                <button type="button" class="mi-toast__close" @onclick="DismissStatus" aria-label="Dismiss">×</button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="mi-toast mi-toast--err" role="alert">
                <span>@ErrorMessage</span>
                <button type="button" class="mi-toast__close" @onclick="DismissError" aria-label="Dismiss">×</button>
            </div>
        }

        @if (IsLoading)
        {
            <div class="mi-card">
                <p class="mb-0">Loading issue…</p>
            </div>
        }
        else
        {
            <header class="mi-hero">
                <div class="mi-hero__mark" aria-hidden="true">
                    <i class="fa-solid fa-box-open"></i>
                </div>
                <div class="mi-hero__copy">
                    <p class="mi-eyebrow">Inventory</p>
                    <h1 class="mi-title">@PageHeading</h1>
                    <div class="mi-chips">
                        <span class="mi-chip">@ModeChip</span>
                        <span class="mi-chip">Batch @BatchNoDisplay</span>
                        <span class="mi-chip">@LineCountLabel</span>
                        <span class="mi-chip">@BatchStatusDisplay</span>
                    </div>
                </div>
                <div class="mi-hero__kpi">
                    <span>Document total</span>
                    <strong>@DocumentTotal.ToString("n2")</strong>
                </div>
            </header>

            <section class="mi-card">
                <DxFormLayout SizeMode="SizeMode.Small" CssClass="mi-header-form">
                    <DxFormLayoutItem Caption="Transaction date" ColSpanMd="4">
                        <Template>
                            <DxDateEdit @bind-Date="@Header.TrxDate"
                                        DisplayFormat="dd/MM/yyyy"
                                        Enabled="@CanEditDocument" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Status" ColSpanMd="4">
                        <Template>
                            <DxTextBox Text="@BatchStatusDisplay" ReadOnly="true" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Ref No" ColSpanMd="4">
                        <Template>
                            <DxTextBox @bind-Text="@Header.RefNo"
                                       NullText="AUTO"
                                       maxlength="50"
                                       ReadOnly="@(!CanEditDocument)" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Remark" ColSpanMd="12">
                        <Template>
                            <DxMemo @bind-Text="@Header.Remark"
                                    Rows="2"
                                    maxlength="250"
                                    ReadOnly="@(!CanEditDocument)"
                                    NullText="Optional notes for this issue" />
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayout>
            </section>

            <section class="mi-card mi-lines">
                <div class="mi-lines__head">
                    <div>
                        <p class="mi-eyebrow">Lines</p>
                        <h2 class="mi-lines__title">Issue items</h2>
                    </div>
                    @if (CanEditDocument)
                    {
                        <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                  Text="Add item"
                                  IconCssClass="fa-solid fa-plus"
                                  Click="@OnNewLineClickAsync"
                                  Enabled="@(!IsSubmitting)" />
                    }
                </div>

                <DxGrid Data="@Lines"
                        KeyFieldName="@nameof(IvMiscIssueLineVm.LineNo)"
                        ShowFilterRow="false"
                        ShowGroupPanel="false"
                        ShowSearchBox="false"
                        TextWrapEnabled="false"
                        PageSize="20"
                        ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                        CssClass="mi-line-grid"
                        RowDoubleClick="@OnLineRowDoubleClick">
                    <Columns>
                        @if (CanEditDocument)
                        {
                            <DxGridCommandColumn Width="88px" Caption=" " NewButtonVisible="false" EditButtonVisible="false" DeleteButtonVisible="false">
                                <CellDisplayTemplate>
                                    @{
                                        var line = (IvMiscIssueLineVm)context.DataItem;
                                    }
                                    <div class="mi-row-actions">
                                        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                                  RenderStyleMode="ButtonRenderStyleMode.Text"
                                                  IconCssClass="fa-solid fa-pen"
                                                  title="Edit"
                                                  Click="@(() => EditLineAsync(line))"
                                                  Enabled="@(!IsSubmitting)" />
                                        <DxButton RenderStyle="ButtonRenderStyle.Danger"
                                                  RenderStyleMode="ButtonRenderStyleMode.Text"
                                                  IconCssClass="fa-solid fa-trash"
                                                  title="Remove"
                                                  Click="@(() => RemoveLine(line))"
                                                  Enabled="@(!IsSubmitting)" />
                                    </div>
                                </CellDisplayTemplate>
                            </DxGridCommandColumn>
                        }
                        <DxGridDataColumn FieldName="@nameof(IvMiscIssueLineVm.LineNo)" Caption="#" Width="56px" />
                        <DxGridDataColumn FieldName="@nameof(IvMiscIssueLineVm.ICode)" Caption="Item" Width="130px">
                            <CellDisplayTemplate>
                                @{
                                    var itemLine = (IvMiscIssueLineVm)context.DataItem;
                                }
                                <div class="mi-cell-stack">
                                    <span class="mi-cell-stack__primary">@itemLine.ICode</span>
                                    <span class="mi-cell-stack__secondary">@itemLine.IDesc</span>
                                </div>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn Caption="Issue From" MinWidth="180">
                            <CellDisplayTemplate>
                                @{
                                    var fromLine = (IvMiscIssueLineVm)context.DataItem;
                                }
                                <div class="mi-cell-stack">
                                    <span class="mi-cell-stack__primary">@fromLine.FrWarehouse / @DisplayOrDash(fromLine.FrLocation)</span>
                                    <span class="mi-cell-stack__secondary">
                                        Lot: @DisplayOrDash(fromLine.FrLotNo)
                                        · Avail: @fromLine.AvailableQty.ToString("n4") @fromLine.Uom
                                    </span>
                                </div>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(IvMiscIssueLineVm.Quantity)" Caption="Issue Qty" Width="100px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(IvMiscIssueLineVm.IStatus)" Caption="Status" Width="90px">
                            <CellDisplayTemplate>
                                <span class="@StatusChipClass(((IvMiscIssueLineVm)context.DataItem).IStatus)">
                                    @(((IvMiscIssueLineVm)context.DataItem).IStatus)
                                </span>
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(IvMiscIssueLineVm.UnitPrice)" Caption="Unit Price" Width="100px" DisplayFormat="n4" TextAlignment="GridTextAlignment.Right" />
                        <DxGridDataColumn FieldName="@nameof(IvMiscIssueLineVm.Reason)" Caption="Reason" Width="100px">
                            <CellDisplayTemplate>
                                @DisplayOrDash(((IvMiscIssueLineVm)context.DataItem).Reason)
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(IvMiscIssueLineVm.Remarks)" Caption="Remark" MinWidth="120">
                            <CellDisplayTemplate>
                                @DisplayOrDash(((IvMiscIssueLineVm)context.DataItem).Remarks)
                            </CellDisplayTemplate>
                        </DxGridDataColumn>
                        <DxGridDataColumn FieldName="@nameof(IvMiscIssueLineVm.Amount)" Caption="Amount" Width="110px" DisplayFormat="n2" TextAlignment="GridTextAlignment.Right" />
                    </Columns>
                    <TotalSummary>
                        <DxGridSummaryItem FieldName="@nameof(IvMiscIssueLineVm.AvailableQty)"
                                           SummaryType="GridSummaryItemType.Sum"
                                           ValueDisplayFormat="n4"
                                           FooterColumnName="@nameof(IvMiscIssueLineVm.AvailableQty)" />
                        <DxGridSummaryItem FieldName="@nameof(IvMiscIssueLineVm.Quantity)"
                                           SummaryType="GridSummaryItemType.Sum"
                                           ValueDisplayFormat="n4"
                                           FooterColumnName="@nameof(IvMiscIssueLineVm.Quantity)" />
                        <DxGridSummaryItem FieldName="@nameof(IvMiscIssueLineVm.Amount)"
                                           SummaryType="GridSummaryItemType.Sum"
                                           ValueDisplayFormat="n2"
                                           FooterColumnName="@nameof(IvMiscIssueLineVm.Amount)" />
                    </TotalSummary>
                    <EmptyDataAreaTemplate>
                        <div class="mi-empty">
                            <div class="mi-empty__icon" aria-hidden="true">
                                <i class="fa-solid fa-box-open"></i>
                            </div>
                            <h3>No items yet</h3>
                            <p>@(CanEditDocument ? "Add items to issue stock from a warehouse location." : "This issue has no lines.")</p>
                            @if (CanEditDocument)
                            {
                                <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                          Text="Add item"
                                          IconCssClass="fa-solid fa-plus"
                                          Click="@OnNewLineClickAsync"
                                          Enabled="@(!IsSubmitting)" />
                            }
                        </div>
                    </EmptyDataAreaTemplate>
                </DxGrid>
            </section>

            <footer class="mi-footer">
                <p class="mi-footer__hint">
                    @if (IsViewMode)
                    {
                        @($"{LineCountLabel} · Total {DocumentTotal:n2}")
                    }
                    else
                    {
                        @(Lines.Count == 0 ? "Add at least one item to save this issue." : $"{LineCountLabel} · Total {DocumentTotal:n2}")
                    }
                </p>
                <div class="mi-footer__actions">
                    @if (IsViewMode)
                    {
                        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                  Text="Close"
                                  IconCssClass="fa-solid fa-xmark"
                                  Click="@OnCloseAsync" />
                        @if (CanEditFromView)
                        {
                            <PermissionAuthorize MenuCode="@MenuCodes.InventoryMiscIssue" Permission="@PermissionCodes.Edit">
                                <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                          Text="Edit"
                                          IconCssClass="fa-solid fa-pen"
                                          Click="@OnEditFromView" />
                            </PermissionAuthorize>
                        }
                    }
                    else
                    {
                        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                  Text="Cancel"
                                  IconCssClass="fa-solid fa-xmark"
                                  Click="@OnCancelAsync"
                                  Enabled="@(!IsSubmitting)" />
                        <PermissionAuthorize MenuCode="@MenuCodes.InventoryMiscIssue" Permission="@(IsNewMode ? PermissionCodes.Add : PermissionCodes.Edit)">
                            <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                      Text="@(IsSubmitting ? "Saving…" : "Save")"
                                      IconCssClass="fa-solid fa-floppy-disk"
                                      Click="@OnSaveAsync"
                                      Enabled="@CanSave" />
                        </PermissionAuthorize>
                    }
                </div>
            </footer>
        }
    </div>

    <DxPopup HeaderText="@PopupTitle"
             CloseOnOutsideClick="false"
             CloseOnEscape="true"
             Width="760px"
             CssClass="mi-popup common-popup"
             @bind-Visible="@PopupVisible">
        <Content>
            <div class="mi-popup-body">
                <DxFormLayout SizeMode="SizeMode.Small" CssClass="mi-popup-form">
                    <DxFormLayoutGroup ColSpanMd="12">
                        <HeaderContentTemplate>Item</HeaderContentTemplate>
                        <Items>
                            <DxFormLayoutItem Caption="Item code" ColSpanMd="6">
                                <Template>
                                    <IvStockMasterPicker ICode="@Popup.ICode"
                                                         Selected="OnItemSelectedAsync"
                                                         InputCssClass="required-field" />
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Barcode" ColSpanMd="6">
                                <Template>
                                    <div class="d-flex gap-1" @onkeydown="OnBarcodeKeyDown">
                                        <DxTextBox @bind-Text="@Popup.Barcode"
                                                   NullText="Scan or enter barcode"
                                                   CssClass="flex-grow-1"
                                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                                        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                                  Text="Go"
                                                  Click="@OnBarcodeResolveAsync"
                                                  Enabled="@(!IsSubmitting)" />
                                    </div>
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Description" ColSpanMd="6">
                                <Template>
                                    <DxTextBox @bind-Text="@Popup.IDesc" ReadOnly="true" NullText="Selected item description" />
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Item class" ColSpanMd="6">
                                <Template>
                                    <DxTextBox @bind-Text="@Popup.IClassCode" ReadOnly="true" NullText="—" />
                                </Template>
                            </DxFormLayoutItem>
                        </Items>
                    </DxFormLayoutGroup>

                    <DxFormLayoutGroup ColSpanMd="12">
                        <HeaderContentTemplate>Issue From</HeaderContentTemplate>
                        <Items>
                            <DxFormLayoutItem Caption="Balance location (Fr Lot)" ColSpanMd="12">
                                <Template>
                                    <IvBalLocPicker BalLocId="@Popup.FromBalLocId"
                                                    DisplayLotNo="@Popup.BalLocDisplay"
                                                    ICodeFilter="@Popup.ICode"
                                                    Selected="OnBalLocSelectedAsync"
                                                    Enabled="@(!string.IsNullOrWhiteSpace(Popup.ICode) && !IsSubmitting)"
                                                    InputCssClass="required-field" />
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Warehouse" ColSpanMd="4">
                                <Template>
                                    <DxTextBox Text="@Popup.FrWarehouse" ReadOnly="true" NullText="—" />
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Location" ColSpanMd="4">
                                <Template>
                                    <DxTextBox Text="@Popup.FrLocation" ReadOnly="true" NullText="—" />
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Lot" ColSpanMd="4">
                                <Template>
                                    <DxTextBox Text="@Popup.FrLotNo" ReadOnly="true" NullText="—" />
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Available Qty" ColSpanMd="4">
                                <Template>
                                    <DxTextBox Text="@Popup.AvailableQty.ToString("n4")" ReadOnly="true" />
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="UOM" ColSpanMd="4">
                                <Template>
                                    <DxTextBox Text="@Popup.Uom" ReadOnly="true" NullText="—" />
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Item status" ColSpanMd="4">
                                <Template>
                                    <DxTextBox Text="@Popup.IStatus" ReadOnly="true" NullText="—" />
                                </Template>
                            </DxFormLayoutItem>
                            @if (Popup.LotControl && Popup.ExpiryDate.HasValue)
                            {
                                <DxFormLayoutItem Caption="Expiry date" ColSpanMd="4">
                                    <Template>
                                        <DxTextBox Text="@Popup.ExpiryDate.Value.ToString("dd/MM/yyyy")" ReadOnly="true" />
                                    </Template>
                                </DxFormLayoutItem>
                            }
                        </Items>
                    </DxFormLayoutGroup>

                    <DxFormLayoutGroup ColSpanMd="12">
                        <HeaderContentTemplate>Issue Details</HeaderContentTemplate>
                        <Items>
                            <DxFormLayoutItem Caption="Issue qty" ColSpanMd="4">
                                <Template>
                                    <DxSpinEdit @bind-Value="@Popup.Quantity"
                                                Increment="1m"
                                                MinValue="0.0001m"
                                                DisplayFormat="n4"
                                                BindValueMode="BindValueMode.OnInput"
                                                InputCssClass="required-field" />
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Unit price" ColSpanMd="4">
                                <Template>
                                    <DxSpinEdit @bind-Value="@Popup.UnitPrice"
                                                Increment="0.0001m"
                                                MinValue="0m"
                                                DisplayFormat="n4"
                                                BindValueMode="BindValueMode.OnInput" />
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Line amount" ColSpanMd="4">
                                <Template>
                                    <div class="mi-amount-preview">
                                        <span>Qty × unit price</span>
                                        <strong>@PopupAmount.ToString("n2")</strong>
                                    </div>
                                </Template>
                            </DxFormLayoutItem>
                            @if (Popup.FromBalLocId > 0)
                            {
                                <DxFormLayoutItem ColSpanMd="12">
                                    <Template>
                                        <div class="mi-avail-advisory @(Popup.Quantity > PopupMaxIssueQty ? "mi-avail-advisory--warn" : "")">
                                            <i class="fa-solid fa-circle-info"></i>
                                            Max issuable from this lot: <strong>@PopupMaxIssueQty.ToString("n4")</strong> @Popup.Uom
                                            @if (Popup.Quantity > PopupMaxIssueQty)
                                            {
                                                <span class="mi-avail-advisory__warn"> — issue qty exceeds available</span>
                                            }
                                        </div>
                                    </Template>
                                </DxFormLayoutItem>
                            }
                            <DxFormLayoutItem Caption="Reason" ColSpanMd="6">
                                <Template>
                                    <DxComboBox Data="@IvTrxReasons.All"
                                                @bind-Value="@Popup.Reason"
                                                AllowUserInput="true"
                                                NullText="Optional"
                                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Remarks" ColSpanMd="12">
                                <Template>
                                    <DxMemo @bind-Text="@Popup.Remarks" Rows="3" NullText="Optional notes for this line" />
                                </Template>
                            </DxFormLayoutItem>
                        </Items>
                    </DxFormLayoutGroup>
                </DxFormLayout>
            </div>

            <div class="mi-popup-footer">
                @if (!string.IsNullOrWhiteSpace(PopupError))
                {
                    <p class="mi-popup-error">@PopupError</p>
                }
                <div class="mi-popup-footer__actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="Cancel"
                              IconCssClass="fa-solid fa-xmark"
                              Click="@OnPopupCancel" />
                    <DxButton RenderStyle="ButtonRenderStyle.Primary"
                              Text="@PopupPrimaryText"
                              IconCssClass="@(IsEditingLine ? "fa-solid fa-check" : "fa-solid fa-plus")"
                              Click="@OnCommitLine" />
                </div>
            </div>
        </Content>
    </DxPopup>

    <DxPopup HeaderText="Discard this issue?"
             CloseOnOutsideClick="false"
             CloseOnEscape="true"
             Width="440px"
             CssClass="mi-confirm common-popup"
             @bind-Visible="@ConfirmDiscardVisible">
        <Content>
            <p class="mi-confirm__copy">Unsaved changes will be lost. This cannot be undone.</p>
            <div class="mi-popup-footer__actions">
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          Text="Keep editing"
                          Click="@OnKeepEditing" />
                <DxButton RenderStyle="ButtonRenderStyle.Danger"
                          Text="Discard"
                          IconCssClass="fa-solid fa-trash"
                          Click="@ConfirmDiscardAsync" />
            </div>
        </Content>
    </DxPopup>
</MenuAuthorize>
