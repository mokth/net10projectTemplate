@namespace ErpWeb.UI.Inventory.Lookups
@using Microsoft.AspNetCore.Components.Web

<DxPopup HeaderCssClass="code-style"
         HeaderText="SELECT ON-HAND BALANCE"
         CloseOnOutsideClick="false"
         Width="90vw"
         CssClass="common-popup"
         @bind-Visible="@Visible"
         Closing="@OnClosing">
    <Content>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-warning py-2">@_error</div>
        }

        <div class="d-flex gap-2 mb-2 align-items-end">
            <div class="flex-grow-1">
                <label class="form-label mb-0">Search</label>
                <DxTextBox @bind-Text="@_searchText"
                           NullText="Item / warehouse / location / lot"
                           ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </div>
            <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                      Text="SEARCH"
                      IconCssClass="fa-solid fa-magnifying-glass"
                      Click="@SearchAsync" />
        </div>

        <DxGrid @ref="_grid"
                Data="@_items"
                KeyFieldName="@nameof(IvBalLocLookupRow.Id)"
                ShowFilterRow="false"
                ShowGroupPanel="false"
                PageSize="20"
                TextWrapEnabled="false"
                FocusedRowEnabled="true"
                RowDoubleClick="@OnRowDoubleClick"
                SelectedDataItemChanged="@OnSelectedItemChanged">
            <Columns>
                <DxGridDataColumn FieldName="@nameof(IvBalLocLookupRow.ICode)" Caption="ITEM CODE" Width="120px" />
                <DxGridDataColumn FieldName="@nameof(IvBalLocLookupRow.IDesc)" Caption="DESCRIPTION" />
                <DxGridDataColumn FieldName="@nameof(IvBalLocLookupRow.WhCode)" Caption="WH" Width="90px" />
                <DxGridDataColumn FieldName="@nameof(IvBalLocLookupRow.LocCode)" Caption="LOC" Width="90px" />
                <DxGridDataColumn FieldName="@nameof(IvBalLocLookupRow.LotNo)" Caption="LOT" Width="120px" />
                <DxGridDataColumn FieldName="@nameof(IvBalLocLookupRow.StdQty)" Caption="QTY" Width="100px" DisplayFormat="n4" />
                <DxGridDataColumn FieldName="@nameof(IvBalLocLookupRow.StdUom)" Caption="UOM" Width="70px" />
                <DxGridDataColumn FieldName="@nameof(IvBalLocLookupRow.IStatus)" Caption="STATUS" Width="90px" />
                <DxGridDataColumn FieldName="@nameof(IvBalLocLookupRow.ExpiryDate)" Caption="EXPIRY" Width="110px" DisplayFormat="d" />
            </Columns>
        </DxGrid>

        <div class="d-flex justify-content-between align-items-center mt-2">
            <span class="text-muted small">@_totalCount on-hand row(s)</span>
            <div class="d-flex gap-2">
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          Text="PREV"
                          Enabled="@(_skip > 0)"
                          Click="@PrevPageAsync" />
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          Text="NEXT"
                          Enabled="@(_skip + _pageSize < _totalCount)"
                          Click="@NextPageAsync" />
            </div>
        </div>

        <div class="d-flex gap-2 mt-3" @onkeydown="OnKeyDown">
            <DxButton RenderStyle="ButtonRenderStyle.Primary"
                      Text="SELECT"
                      IconCssClass="fa-solid fa-check"
                      Click="@SelectFocusedAsync"
                      Enabled="@(_focused is not null)" />
            <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                      Text="CANCEL"
                      IconCssClass="fa-solid fa-xmark"
                      Click="@CloseAsync" />
        </div>
    </Content>
</DxPopup>
