@namespace ErpWeb.UI.Inventory.Lookups
@using ErpWeb.UI.Components.Common.Lookups

<SmartLookupInput @ref="_smartLookup"
                  TItem="IvStockMasterLookupRow"
                  Value="@ICode"
                  DisplayText="@ICode"
                  SecondaryText="@_secondaryText"
                  Enabled="@Enabled"
                  InputCssClass="@InputCssClass"
                  NullText="@NullText"
                  SearchButtonAriaLabel="Search items"
                  NotFoundMessage="Item not found"
                  ResolveAsync="@ResolveItemAsync"
                  GetCode="@(static x => x.ICode)"
                  GetDisplayText="@(static x => x.ICode)"
                  GetSecondaryText="@(static x => x.IDesc)"
                  ItemResolved="@CommitSelectionAsync"
                  Cleared="@OnClearedAsync"
                  OpenSearch="@OpenSearchAsync" />

<IvStockMasterSearchPopup @bind-Visible="@_popupVisible"
                          InitialSearchText="@_popupSearchText"
                          Selected="OnPopupSelectedAsync" />
