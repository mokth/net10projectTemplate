@page "/inventory/stock-card"
@inherits PageBase

<PageTitle>Stock Card</PageTitle>
<MenuAuthorize MenuCode="@MenuCodes.InvStockCard">
@if (!string.IsNullOrWhiteSpace(StatusMessage)) { <div class="alert alert-info">@StatusMessage</div> }
<div class="mb-3"><h4>Stock Card</h4></div>
<EditForm Model="@Model" Context="formCtx" OnValidSubmit="@LoadAsync">
    <DxFormLayout SizeMode="SizeMode.Small">
        <DxFormLayoutItem Caption="Item Variant Id" ColSpanMd="4">
            <Template><DxSpinEdit @bind-Value="@Model.ItemVariantId" /></Template>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="Warehouse Id (optional)" ColSpanMd="4">
            <Template><DxSpinEdit @bind-Value="@Model.WarehouseId" /></Template>
        </DxFormLayoutItem>
        <DxFormLayoutItem ColSpanMd="4">
            <Template><DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Load" SubmitFormOnClick="true" /></Template>
        </DxFormLayoutItem>
    </DxFormLayout>
</EditForm>
@if (Rows.Count > 0)
{
    <table class="table table-sm mt-3">
        <thead><tr><th>Date</th><th>Seq</th><th>Doc</th><th class="text-end">In</th><th class="text-end">Out</th><th class="text-end">Cost</th><th>Lot</th></tr></thead>
        <tbody>
        @foreach (var r in Rows)
        {
            <tr>
                <td>@r.TransactionDate:d</td><td>@r.LedgerSequence</td><td>@r.DocType @r.DocNo</td>
                <td class="text-end">@r.QtyInBase</td><td class="text-end">@r.QtyOutBase</td>
                <td class="text-end">@(r.UnitCost?.ToString("N4") ?? "—")</td><td>@r.LotNo</td>
            </tr>
        }
        </tbody>
    </table>
}
</MenuAuthorize>
