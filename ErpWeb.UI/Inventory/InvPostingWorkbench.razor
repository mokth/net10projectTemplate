@page "/inventory/ob"
@page "/inventory/grn"
@page "/inventory/gi"
@page "/inventory/st"
@page "/inventory/sa"
@inherits PageBase

<PageTitle>@Title</PageTitle>

<MenuAuthorize MenuCode="@MenuCode">
@if (!string.IsNullOrWhiteSpace(StatusMessage))
{
    <div class="alert alert-info">@StatusMessage</div>
}

<div class="mb-3">
    <h4 class="mb-1">@Title</h4>
    <p class="text-muted mb-0">Phase 2 posting workbench (non-lot). Create a draft then Post.</p>
</div>

<EditForm Model="@Model" Context="formCtx" OnValidSubmit="@CreateAndPostAsync">
    <DxFormLayout SizeMode="SizeMode.Small">
        <DxFormLayoutItem Caption="Doc Date" ColSpanMd="3">
            <Template><DxDateEdit @bind-Date="@Model.DocDate" /></Template>
        </DxFormLayoutItem>
        @if (DocType == DocumentType.ST)
        {
            <DxFormLayoutItem Caption="Source WH Id" ColSpanMd="3">
                <Template><DxSpinEdit @bind-Value="@Model.SourceWarehouseId" /></Template>
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="Dest WH Id" ColSpanMd="3">
                <Template><DxSpinEdit @bind-Value="@Model.DestinationWarehouseId" /></Template>
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="Source Loc Id" ColSpanMd="3">
                <Template><DxSpinEdit @bind-Value="@Model.SourceLocationId" /></Template>
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="Dest Loc Id" ColSpanMd="3">
                <Template><DxSpinEdit @bind-Value="@Model.DestinationLocationId" /></Template>
            </DxFormLayoutItem>
        }
        else
        {
            <DxFormLayoutItem Caption="Warehouse Id" ColSpanMd="3">
                <Template><DxSpinEdit @bind-Value="@Model.WarehouseId" /></Template>
            </DxFormLayoutItem>
        }
        <DxFormLayoutItem Caption="Item Variant Id" ColSpanMd="3">
            <Template><DxSpinEdit @bind-Value="@Model.ItemVariantId" /></Template>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="UOM Id" ColSpanMd="3">
            <Template><DxSpinEdit @bind-Value="@Model.UomId" /></Template>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="Location Id" ColSpanMd="3">
            <Template><DxSpinEdit @bind-Value="@Model.LocationId" /></Template>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="Qty" ColSpanMd="3">
            <Template><DxSpinEdit @bind-Value="@Model.Qty" MinValue="0.000001m" /></Template>
        </DxFormLayoutItem>
        @if (DocType is DocumentType.OB or DocumentType.GRN or DocumentType.SA)
        {
            <DxFormLayoutItem Caption="Unit Cost" ColSpanMd="3">
                <Template><DxSpinEdit @bind-Value="@Model.UnitCost" /></Template>
            </DxFormLayoutItem>
        }
        @if (DocType == DocumentType.GRN)
        {
            <DxFormLayoutItem Caption="Allow Zero Cost" ColSpanMd="3">
                <Template><DxCheckBox @bind-Checked="@Model.AllowZeroCost" AllowIndeterminateState="false" /></Template>
            </DxFormLayoutItem>
        }
        @if (DocType == DocumentType.SA)
        {
            <DxFormLayoutItem Caption="Direction (1=Inc,2=Dec)" ColSpanMd="3">
                <Template><DxSpinEdit @bind-Value="@Model.DirectionValue" MinValue="1" MaxValue="2" /></Template>
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="Reason Code Id" ColSpanMd="3">
                <Template><DxSpinEdit @bind-Value="@Model.ReasonCodeId" /></Template>
            </DxFormLayoutItem>
        }
        <DxFormLayoutItem ColSpanMd="12" BeginRow="true">
            <Template>
                <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="@(IsSubmitting ? "Posting…" : "Create & Post")"
                          SubmitFormOnClick="true" Enabled="@(!IsSubmitting)" />
                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="text-danger mt-2">@ErrorMessage</div>
                }
                @if (!string.IsNullOrWhiteSpace(LastDocNo))
                {
                    <div class="text-success mt-2">Posted @LastDocNo (Id @LastDocId)</div>
                }
            </Template>
        </DxFormLayoutItem>
    </DxFormLayout>
</EditForm>
</MenuAuthorize>
