@page "/inventory/stock-take"
@inherits PageBase

<PageTitle>Stock Take</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.InvStockTake">
@if (!string.IsNullOrWhiteSpace(StatusMessage))
{
    <div class="alert alert-info">@StatusMessage</div>
}

<div class="mb-3">
    <h4 class="mb-1">Stock Take</h4>
    <p class="text-muted mb-0">Phase 2 flow: Create → Count → Complete → Approve → Generate SA → Post SA.</p>
</div>

<EditForm Model="@Model" Context="formCtx" OnValidSubmit="@RunFlowAsync">
    <DxFormLayout SizeMode="SizeMode.Small">
        <DxFormLayoutItem Caption="Count Date" ColSpanMd="3">
            <Template><DxDateEdit @bind-Date="@Model.CountDate" /></Template>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="Warehouse Id" ColSpanMd="3">
            <Template><DxSpinEdit @bind-Value="@Model.WarehouseId" /></Template>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="Item Variant Id" ColSpanMd="3">
            <Template><DxSpinEdit @bind-Value="@Model.ItemVariantId" /></Template>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="Location Id" ColSpanMd="3">
            <Template><DxSpinEdit @bind-Value="@Model.LocationId" /></Template>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="System Qty" ColSpanMd="3">
            <Template><DxSpinEdit @bind-Value="@Model.SystemQty" /></Template>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="Counted Qty" ColSpanMd="3">
            <Template><DxSpinEdit @bind-Value="@Model.CountedQty" /></Template>
        </DxFormLayoutItem>
        <DxFormLayoutItem Caption="Reason Code Id" ColSpanMd="3">
            <Template><DxSpinEdit @bind-Value="@Model.ReasonCodeId" /></Template>
        </DxFormLayoutItem>
        <DxFormLayoutItem ColSpanMd="12" BeginRow="true">
            <Template>
                <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="@(IsSubmitting ? "Running…" : "Run full stock-take flow")"
                          SubmitFormOnClick="true" Enabled="@(!IsSubmitting)" />
                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="text-danger mt-2">@ErrorMessage</div>
                }
            </Template>
        </DxFormLayoutItem>
    </DxFormLayout>
</EditForm>
</MenuAuthorize>
