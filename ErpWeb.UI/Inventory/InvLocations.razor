@page "/inventory/locations"
@inherits PageBase

<PageTitle>Locations</PageTitle>
<style>.code-style { text-transform: uppercase !important; }</style>

<MenuAuthorize MenuCode="@MenuCodes.InvLocations">
@if (!string.IsNullOrWhiteSpace(StatusMessage)) { <div class="alert alert-info">@StatusMessage</div> }
@if (IsLoading) { <p>Loading…</p> }

<CommonDataGridEx Columns="@Columns()" Buttons="@Buttons" ActionButtons="@ActionButtons"
                  KeyName="@nameof(WarehouseLocation.Id)" GridKey="inv-loc-list" Title="Warehouse Locations" T="WarehouseLocation"
                  OnGridInstance="@OnGridInstance" GridData="@Data" allowSelect="true"
                  OnSelectionsEventHandle="@OnSelectionsEvent" OnButtonEventHandle="@OnButtonClick"
                  OnActionEventHandle="@OnActionClick" />

<DxPopup HeaderText="Location" CloseOnOutsideClick="false" Width="40vw" CssClass="common-popup" @bind-Visible="@PopupVisible">
    <Content>
        <EditForm Model="@selectedRow" Context="formCtx" OnValidSubmit="@HandleValidSubmit">
            <DxFormLayout SizeMode="SizeMode.Small">
                <DxFormLayoutItem Caption="Warehouse" ColSpanMd="8">
                    <Template>
                        <DxComboBox Data="@WarehouseOptions" TextFieldName="@nameof(Warehouse.WarehouseCode)" ValueFieldName="@nameof(Warehouse.Id)"
                                    @bind-Value="@selectedRow.WarehouseId" ReadOnly="@(IsEditMode || !editEnable)" />
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Active" ColSpanMd="4">
                    <Template><DxCheckBox @bind-Checked="@selectedRow.IsActive" AllowIndeterminateState="false" ReadOnly="@(!editEnable)" /></Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Location Code" ColSpanMd="6" BeginRow="true">
                    <Template><DxTextBox @bind-Text="@selectedRow.LocationCode" maxlength="20" ReadOnly="@IsEditMode" InputCssClass="required-field code-style" /></Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Name" ColSpanMd="6">
                    <Template><DxTextBox @bind-Text="@selectedRow.LocationName" maxlength="100" ReadOnly="@(!editEnable)" /></Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem ColSpanMd="12" BeginRow="true">
                    <Template>
                        <div class="d-flex gap-2">
                            @if (editEnable) { <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="@(IsSubmitting ? "Saving…" : "Save")" SubmitFormOnClick="true" Enabled="@(!IsSubmitting)" /> }
                            <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Cancel" Click="@OnCancel" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(ErrorMessage)) { <div class="text-danger mt-2">@ErrorMessage</div> }
                    </Template>
                </DxFormLayoutItem>
            </DxFormLayout>
        </EditForm>
    </Content>
</DxPopup>
</MenuAuthorize>
