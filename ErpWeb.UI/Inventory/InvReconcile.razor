@page "/inventory/reconcile"
@inherits PageBase

<PageTitle>Inventory Reconciliation</PageTitle>
<MenuAuthorize MenuCode="@MenuCodes.InvReconcile">
@if (!string.IsNullOrWhiteSpace(StatusMessage)) { <div class="alert alert-info">@StatusMessage</div> }
<div class="mb-3">
    <h4>Reconciliation</h4>
    <p class="text-muted">Ledger vs StockBalance / LotBalance / ItemCost. Rebuild is admin-only and audited.</p>
</div>
<div class="d-flex gap-2 mb-3">
    <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Find Issues" Click="@FindAsync" Enabled="@(!Busy)" />
    <DxButton RenderStyle="ButtonRenderStyle.Danger" Text="Rebuild from Ledger" Click="@RebuildAsync" Enabled="@(!Busy)" />
</div>
@if (!string.IsNullOrWhiteSpace(ErrorMessage)) { <div class="text-danger">@ErrorMessage</div> }
@if (Issues.Count > 0)
{
    <ul>@foreach (var i in Issues) { <li>@i.Kind: @i.Message</li> }</ul>
}
else if (_ran) { <p class="text-success">No integrity issues.</p> }
</MenuAuthorize>
