@namespace ErpWeb.UI.Components.Common.Lookups
@using ErpWeb.Core.Admin
@using ErpWeb.Core.Inventory
@using ErpWeb.Core.Menus
@using ErpWeb.Core.Security
@using ErpWeb.UI.Components.Common.DataGrid

@*
    Shared AdLookupValue maintenance surface.

    The routable wrapper owns authorization (MenuAuthorize on the family's own menu code); this
    component owns the list/grid/edit/activate behaviour. It is never routable itself, and it refuses
    to query when the requested family is not registered, not maintainable, or not owned by the
    supplied menu code — so a mis-wired wrapper shows nothing instead of the wrong family's values.
*@

<div class="iv-page">
    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="iv-toast iv-toast--ok" role="status">
            <span>@StatusMessage</span>
            <button type="button" class="iv-toast__close" @onclick="DismissStatus" aria-label="Dismiss">&times;</button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(ErrorMessage) && !PopupVisible)
    {
        <div class="iv-toast iv-toast--err" role="alert">
            <span>@ErrorMessage</span>
            <button type="button" class="iv-toast__close" @onclick="DismissError" aria-label="Dismiss">&times;</button>
        </div>
    }

    <header class="iv-hero">
        <div class="iv-hero__mark" aria-hidden="true"><i class="fa-solid fa-list-check"></i></div>
        <div>
            <p class="iv-eyebrow">@Eyebrow</p>
            <h1 class="iv-title">@Heading</h1>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_guardError))
    {
        <section class="iv-card">
            <p class="iv-field__error" role="alert">@_guardError</p>
        </section>
    }
    else
    {
        @if (ShowFamilySelector)
        {
            <DxFormLayout SizeMode="SizeMode.Small">
                <DxFormLayoutItem CaptionCssClass="code-style" Caption="Lookup Type" ColSpanMd="4">
                    <Template>
                        <DxComboBox Data="@LookupTypes"
                                    TextFieldName="DisplayName"
                                    ValueFieldName="Code"
                                    Value="@SelectedLookupType"
                                    ValueChanged="@(async (string? v) => await OnLookupTypeChanged(v))"
                                    NullText="Select lookup type" />
                    </Template>
                </DxFormLayoutItem>
            </DxFormLayout>
        }

        @if (IsLoading)
        {
            <p>Loading lookup values&hellip;</p>
        }

        <CommonDataGridEx @key="GridKeyValue"
                          Columns="@Columns()"
                          Buttons="@ToolbarButtons"
                          ActionButtons="@RowActionButtons"
                          KeyName="@nameof(AdLookupRow.Uid)"
                          GridKey="@GridKeyValue"
                          Title="@Heading"
                          T="AdLookupRow"
                          OnGridInstance="@OnGridInstance"
                          GridData="@Data"
                          allowSelect="true"
                          OnSelectionsEventHandle="@OnSelectionsEvent"
                          OnButtonEventHandle="@OnToolbarButtonAsync"
                          OnActionEventHandle="@OnRowActionAsync" />
    }

    <DxPopup HeaderCssClass="code-style"
             HeaderText="@(IsEditMode ? (EditEnabled ? "Edit Lookup Value" : "View Lookup Value") : "New Lookup Value")"
             CloseOnOutsideClick="false"
             Width="@PopupWidth"
             CssClass="common-popup"
             @bind-Visible="@PopupVisible">
        <Content>
            <EditForm Model="@EditModel" Context="lookupForm" OnValidSubmit="@HandleValidSubmitAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <DxFormLayout SizeMode="SizeMode.Small">
                    @* Plain text: a DxTextBox with Text and no TextExpression throws at render time. *@
                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="Lookup Type" ColSpanMd="12">
                        <Template>
                            <div class="iv-detail-row__value code-style">@EditDefinition?.DisplayName</div>
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="Code" ColSpanMd="6">
                        <Template>
                            <DxTextBox @bind-Text="@EditModel.Code"
                                       maxlength="@EditModel.MaxCodeLength"
                                       ReadOnly="@IsEditMode"
                                       InputCssClass="required-field code-style" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="Sort Order" ColSpanMd="6">
                        <Template>
                            <DxSpinEdit @bind-Value="@EditModel.SortOrder" ReadOnly="@(!EditEnabled)" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="Description" ColSpanMd="12" BeginRow="true">
                        <Template>
                            <DxTextBox @bind-Text="@EditModel.Description"
                                       maxlength="150"
                                       ReadOnly="@(!EditEnabled)"
                                       InputCssClass="required-field" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem CaptionCssClass="code-style" Caption="Active" ColSpanMd="6" BeginRow="true">
                        <Template>
                            <DxCheckBox @bind-Checked="@EditModel.IsActive"
                                        AllowIndeterminateState="false"
                                        ReadOnly="@(!EditEnabled)" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem CaptionCssClass="code-style" ColSpanMd="12" BeginRow="true">
                        <Template>
                            <div class="iv-popup-actions">
                                @if (EditEnabled)
                                {
                                    <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                              Text="@(IsSubmitting ? "Saving…" : "Save")"
                                              SubmitFormOnClick="true"
                                              Enabled="@(!IsSubmitting)" />
                                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                              Text="Cancel"
                                              Click="@ClosePopup"
                                              Enabled="@(!IsSubmitting)" />
                                }
                                else
                                {
                                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                              Text="Close"
                                              Click="@ClosePopup" />
                                    @if (CanEditFromView)
                                    {
                                        <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                                  Text="Edit"
                                                  Click="@SwitchViewToEdit" />
                                    }
                                }
                            </div>
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem CaptionCssClass="code-style" ColSpanMd="12">
                        <Template>
                            <small class="text-danger">@ErrorMessage</small>
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayout>
            </EditForm>
        </Content>
    </DxPopup>
</div>
