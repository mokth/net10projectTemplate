@page "/forgot-password"
@layout EmptyLayout
@attribute [AllowAnonymous]

<PageTitle>Forgot password · ErpWeb</PageTitle>

<div class="login-shell">
    <aside class="login-visual" aria-hidden="true">
        <img class="login-visual-img" src="images/login-hero.svg" alt="" />
        <div class="login-visual-content">
            <div class="login-visual-brand">
                <span class="login-logo" aria-hidden="true">EW</span>
                <span class="login-visual-product">ErpWeb</span>
            </div>
            <p class="login-visual-tagline">Secure account recovery starts with your company administrator.</p>
            <ul class="login-visual-points">
                <li>Passwords are never emailed in plain text</li>
                <li>Resets are handled from User Accounts by admins</li>
                <li>Forced change on next sign-in when required</li>
            </ul>
        </div>
    </aside>

    <section class="login-panel">
        <div class="login-panel-inner">
            <header class="login-header">
                <div class="login-mobile-brand">
                    <span class="login-logo" aria-hidden="true">EW</span>
                    <span>ErpWeb</span>
                </div>
                <h1>Reset password</h1>
                <p>Enter your details and we’ll show you the next step.</p>
            </header>

            @if (Submitted)
            {
                <div class="login-success" role="status">
                    <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                    <div>
                        <strong>Request received</strong>
                        <p>If an account matches, your company administrator can reset the password from User Accounts. Contact them with your company code and username.</p>
                    </div>
                </div>
                <a class="login-btn login-btn-secondary" href="/login">Back to sign in</a>
            }
            else
            {
                <EditForm Model="Model" OnValidSubmit="SubmitAsync" class="login-form">
                    <DataAnnotationsValidator />

                    <label class="field" for="ForgotCompanyCode">
                        <span>Company code</span>
                        <InputText id="ForgotCompanyCode"
                                   @bind-Value="Model.CompanyCode"
                                   maxlength="5"
                                   class="form-control-reset"
                                   autocomplete="organization"
                                   placeholder="e.g. DEMO" />
                        <ValidationMessage For="() => Model.CompanyCode" />
                    </label>

                    <label class="field" for="ForgotUsername">
                        <span>Username</span>
                        <InputText id="ForgotUsername"
                                   @bind-Value="Model.Username"
                                   maxlength="10"
                                   class="form-control-reset"
                                   autocomplete="username"
                                   placeholder="Enter your username" />
                        <ValidationMessage For="() => Model.Username" />
                    </label>

                    <button class="login-btn" type="submit" disabled="@IsSubmitting">
                        @(IsSubmitting ? "Submitting…" : "Continue")
                    </button>
                </EditForm>

                <p class="login-footnote">
                    <a class="forgot-link" href="/login">← Back to sign in</a>
                </p>
            }
        </div>
    </section>
</div>
