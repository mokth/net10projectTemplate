@page "/forgot-password"
@layout EmptyLayout
@attribute [AllowAnonymous]
@inject NavigationManager NavigationManager

<PageTitle>Forgot password · Wincom ERP</PageTitle>

<div class="login-shell">
    <!-- Left Panel - Brand & Features -->
    <aside class="login-visual" aria-hidden="true">
        <div class="login-visual-bg"></div>
        <div class="login-visual-content">
            <div class="login-visual-brand">
                <div class="login-logo-container">
                    <span class="login-logo" aria-hidden="true">ERP</span>
                </div>
                <div class="login-brand-text">
                    <span class="login-visual-product">Wincom ERP</span>
                    <span class="login-visual-version">Enterprise Edition</span>
                </div>
            </div>

            <div class="login-visual-hero">
                <h1 class="login-visual-tagline">Secure Account Recovery</h1>
                <p class="login-visual-subtitle">Your company administrator handles password resets securely through User Accounts.</p>
            </div>

            <ul class="login-visual-points">
                <li>
                    <div class="feature-icon">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <div class="feature-content">
                        <strong>Secure Process</strong>
                        <span>Passwords are never emailed in plain text</span>
                    </div>
                </li>
                <li>
                    <div class="feature-icon">
                        <i class="fa-solid fa-user-shield"></i>
                    </div>
                    <div class="feature-content">
                        <strong>Admin Control</strong>
                        <span>Resets are handled from User Accounts by admins</span>
                    </div>
                </li>
                <li>
                    <div class="feature-icon">
                        <i class="fa-solid fa-key"></i>
                    </div>
                    <div class="feature-content">
                        <strong>Forced Change</strong>
                        <span>Password change on next sign-in when required</span>
                    </div>
                </li>
            </ul>

            <div class="login-visual-footer">
                <span class="login-trust-badge">
                    <i class="fa-solid fa-lock"></i>
                    Enterprise-grade Security
                </span>
            </div>
        </div>
    </aside>

    <!-- Right Panel - Form -->
    <section class="login-panel">
        <div class="login-panel-inner">
            <header class="login-header">
                <div class="login-mobile-brand">
                    <span class="login-logo" aria-hidden="true">ERP</span>
                    <span>Wincom ERP</span>
                </div>
                <h1>Reset your password</h1>
                <p>Enter your company and username. If the account has an email address on file we'll email you a reset link.</p>
            </header>

            @if (RequestSubmitted)
            {
                <div class="login-success" role="status">
                    <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                    <div>
                        <strong>Check your email</strong>
                        <p>If the details you entered match an active account, a password reset link is on its way to the address on file. The link can be used once and expires shortly.</p>
                    </div>
                </div>

                <div class="login-form">
                    <p class="field-label">What to do next</p>
                    <ol class="forgot-next-steps">
                        <li>Open the email and click the reset link.</li>
                        <li>Choose your new password on the page that opens.</li>
                        <li>Sign in with the new password.</li>
                    </ol>
                    <p class="login-footnote">
                        No email? Your password can also be reset by your company administrator from
                        <strong>Admin &rsaquo; User Accounts</strong> — give them your company code and username.
                    </p>
                </div>

                <a class="login-btn login-btn-secondary" href="login">Back to sign in</a>
            }
            else
            {
                <form class="login-form" method="post" action="@($"{NavigationManager.BaseUri}account/forgot-password")">
                    <AntiforgeryToken />

                    <div class="form-group">
                        <label class="field" for="ForgotCompanyCode">
                            <span class="field-label">Company Code</span>
                            <div class="input-wrapper">
                                <i class="fa-solid fa-building input-icon" aria-hidden="true"></i>
                                <input id="ForgotCompanyCode"
                                       name="CompanyCode"
                                       maxlength="5"
                                       required
                                       autocomplete="organization"
                                       placeholder="e.g. DEMO" />
                            </div>
                        </label>
                    </div>

                    <div class="form-group">
                        <label class="field" for="ForgotUsername">
                            <span class="field-label">Username</span>
                            <div class="input-wrapper">
                                <i class="fa-solid fa-user input-icon" aria-hidden="true"></i>
                                <input id="ForgotUsername"
                                       name="Username"
                                       maxlength="10"
                                       required
                                       autocomplete="username"
                                       placeholder="Enter your username" />
                            </div>
                        </label>
                    </div>

                    <button class="login-btn" type="submit">
                        <span>Send reset link</span>
                        <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
                    </button>
                </form>

                <p class="login-footnote">
                    <a class="forgot-link" href="login">← Back to sign in</a>
                </p>
            }
        </div>
    </section>
</div>
