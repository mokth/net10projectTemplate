@page "/change-password"
@layout EmptyLayout
@inherits PageBase

<PageTitle>Change password · Wincom ERP</PageTitle>

<div class="login-shell">
    <!-- Left Panel - Brand & Features -->
    <aside class="login-visual" aria-hidden="true">
        <div class="login-visual-bg"></div>
        <div class="login-visual-content">
            <div class="login-visual-brand">
                <div class="login-logo-container">
                    <span class="login-logo" aria-hidden="true">ERP</span>
                </div>
                <div class="login-brand-text">
                    <span class="login-visual-product">Wincom ERP</span>
                    <span class="login-visual-version">Enterprise Edition</span>
                </div>
            </div>
            
            <div class="login-visual-hero">
                <h1 class="login-visual-tagline">@VisualTagline</h1>
                <p class="login-visual-subtitle">Keep your account secure with a strong, unique password.</p>
            </div>
            
            <ul class="login-visual-points">
                <li>
                    <div class="feature-icon">
                        <i class="fa-solid fa-key"></i>
                    </div>
                    <div class="feature-content">
                        <strong>Strong Password</strong>
                        <span>Use a strong, unique password</span>
                    </div>
                </li>
                <li>
                    <div class="feature-icon">
                        <i class="fa-solid fa-ban"></i>
                    </div>
                    <div class="feature-content">
                        <strong>No Reuse</strong>
                        <span>Don't reuse passwords across systems</span>
                    </div>
                </li>
                <li>
                    <div class="feature-icon">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <div class="feature-content">
                        <strong>Stay Signed In</strong>
                        <span>You'll stay signed in after updating</span>
                    </div>
                </li>
            </ul>
            
            <div class="login-visual-footer">
                <span class="login-trust-badge">
                    <i class="fa-solid fa-lock"></i>
                    Enterprise-grade Security
                </span>
            </div>
        </div>
    </aside>

    <!-- Right Panel - Form -->
    <section class="login-panel">
        <div class="login-panel-inner">
            <header class="login-header">
                <div class="login-mobile-brand">
                    <span class="login-logo" aria-hidden="true">ERP</span>
                    <span>Wincom ERP</span>
                </div>
                <h1>@Heading</h1>
                <p>@Subheading</p>
            </header>

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="login-error" role="alert">
                    <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
                    <span>@ErrorMessage</span>
                </div>
            }

            <form class="login-form" method="post" action="/account/change-password">
                <div class="form-group">
                    <label class="field" for="CurrentPassword">
                        <span class="field-label">Current Password</span>
                        <div class="input-wrapper">
                            <i class="fa-solid fa-lock input-icon" aria-hidden="true"></i>
                            <input id="CurrentPassword"
                                   name="CurrentPassword"
                                   type="@(ShowCurrentPassword ? "text" : "password")"
                                   required
                                   autocomplete="current-password"
                                   placeholder="Enter current password" />
                            <button type="button"
                                    class="password-toggle"
                                    @onclick="ToggleCurrentPassword"
                                    aria-label="@(ShowCurrentPassword ? "Hide current password" : "Show current password")">
                                <i class="fa-solid @(ShowCurrentPassword ? "fa-eye-slash" : "fa-eye")" aria-hidden="true"></i>
                            </button>
                        </div>
                    </label>
                </div>

                <div class="form-group">
                    <label class="field" for="NewPassword">
                        <span class="field-label">New Password</span>
                        <div class="input-wrapper">
                            <i class="fa-solid fa-key input-icon" aria-hidden="true"></i>
                            <input id="NewPassword"
                                   name="NewPassword"
                                   type="@(ShowNewPassword ? "text" : "password")"
                                   required
                                   minlength="8"
                                   autocomplete="new-password"
                                   placeholder="At least 8 characters" />
                            <button type="button"
                                    class="password-toggle"
                                    @onclick="ToggleNewPassword"
                                    aria-label="@(ShowNewPassword ? "Hide new password" : "Show new password")">
                                <i class="fa-solid @(ShowNewPassword ? "fa-eye-slash" : "fa-eye")" aria-hidden="true"></i>
                            </button>
                        </div>
                    </label>
                </div>

                <div class="form-group">
                    <label class="field" for="ConfirmPassword">
                        <span class="field-label">Confirm New Password</span>
                        <div class="input-wrapper">
                            <i class="fa-solid fa-key input-icon" aria-hidden="true"></i>
                            <input id="ConfirmPassword"
                                   name="ConfirmPassword"
                                   type="@(ShowConfirmPassword ? "text" : "password")"
                                   required
                                   minlength="8"
                                   autocomplete="new-password"
                                   placeholder="Re-enter new password" />
                            <button type="button"
                                    class="password-toggle"
                                    @onclick="ToggleConfirmPassword"
                                    aria-label="@(ShowConfirmPassword ? "Hide confirm password" : "Show confirm password")">
                                <i class="fa-solid @(ShowConfirmPassword ? "fa-eye-slash" : "fa-eye")" aria-hidden="true"></i>
                            </button>
                        </div>
                    </label>
                </div>

                <button class="login-btn" type="submit">
                    <span>Update password</span>
                    <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </button>
            </form>

            @if (!CurrentUser.MustChangePassword)
            {
                <p class="login-footnote">
                    <a class="forgot-link" href="home">← Back to home</a>
                </p>
            }
            else
            {
                <p class="login-footnote">
                    Signed in as <strong>@CurrentUser.FullName</strong>
                    · <a class="forgot-link" href="account/logout">Sign out</a>
                </p>
            }
        </div>
    </section>
</div>