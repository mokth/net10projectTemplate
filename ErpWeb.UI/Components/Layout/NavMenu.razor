@using ErpWeb.Core.Menus
@implements IDisposable

<nav class="nav-tree-wrap" aria-label="Primary">
    @if (_items is null)
    {
        <span class="nav-tree-loading">Loading…</span>
    }
    else
    {
        <div class="nav-tree-scroll">
            @* When a document was opened from Purchase Inquiry (returnUrl present), disable
               Prefix URL matching so /purchase/orders/view/… does not expand Transactions. *@
            <DxTreeView Data="@_items"
                        CssClass="nav-tree"
                        AllowSelectNodes="true"
                        UrlMatchMode="@_urlMatchMode"
                        AnimationType="LayoutAnimationType.Slide">
                <DataMappings>
                    <DxTreeViewDataMapping Text="Name"
                                           Name="Code"
                                           Children="Children"
                                           IconCssClass="Icon"
                                           NavigateUrl="Route" />
                </DataMappings>
            </DxTreeView>
        </div>
    }

    <div class="nav-utilities">
        <a href="@ChangePasswordRoute" class="nav-utilities__link">
            <i class="fa-solid fa-key"></i>
            <span>Change Password</span>
        </a>
    </div>
</nav>
