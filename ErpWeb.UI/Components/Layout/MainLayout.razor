@inherits LayoutComponentBase

<NavigationLock ConfirmExternalNavigation="@Guard.IsBlocking"
                OnBeforeInternalNavigation="OnBeforeInternalNav" />

@if (!string.IsNullOrWhiteSpace(_leaveBlockedToast))
{
    <div class="shell-nav-lock-toast" role="status">
        <div class="iv-toast iv-toast--wait">
            <span>@_leaveBlockedToast</span>
            <button type="button" class="iv-toast__close" @onclick="DismissLeaveBlockedToast" aria-label="Dismiss">×</button>
        </div>
    </div>
}

<div class="shell @NavShellClass" data-bs-theme="@BootstrapMode">
    <Header @bind-SidebarOpen="_sidebarOpen" />

    <div class="shell-body">
        <aside class="shell-nav" aria-label="Sidebar">
            <NavMenu />
        </aside>

        <main class="shell-page">
            @Body
        </main>
    </div>

    @if (_sidebarOpen)
    {
        <div class="shell-backdrop" @onclick="CloseNav"></div>
    }
</div>
