@page "/admin/lookups"
@inherits PageBase

<PageTitle>Lookup Values</PageTitle>

@*
    All-family superuser screen. The family selector, grid, popup and activation behaviour all live in
    the shared AdLookupMaintenance component; this wrapper supplies only the route, the page title and
    the ADMIN_LOOKUPS grant.
*@

<MenuAuthorize MenuCode="@MenuCodes.AdminLookups">
    <AdLookupMaintenance MenuCode="@MenuCodes.AdminLookups"
                         Heading="Lookup Values"
                         Eyebrow="Admin"
                         ShowFamilySelector="true"
                         GridKey="ad-lookup-list" />
</MenuAuthorize>
