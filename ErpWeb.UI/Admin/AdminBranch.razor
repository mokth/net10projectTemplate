@page "/admin/branch"
@inherits PageBase

<PageTitle>Branches</PageTitle>

<style>
    .code-style {
        text-transform: uppercase !important;
    }
</style>

<MenuAuthorize MenuCode="@MenuCodes.AdminBranch">
@if (!string.IsNullOrWhiteSpace(StatusMessage))
{
    <div class="alert alert-info">@StatusMessage</div>
}

@if (IsLoading)
{
    <p>Loading branches…</p>
}

<CommonDataGridEx Columns="@Columns()"
                  Buttons="@Buttons"
                  ActionButtons="@ActionButtons"
                  KeyName="@nameof(Branch.Id)"
                  GridKey="admin-branch-list"
                  Title="Branches"
                  T="Branch"
                  OnGridInstance="@OnGridInstance"
                  GridData="@Data"
                  allowSelect="true"
                  OnSelectionsEventHandle="@OnSelectionsEvent"
                  OnButtonEventHandle="@OnButtonClick"
                  OnActionEventHandle="@OnActionClick">
</CommonDataGridEx>

<DxPopup HeaderCssClass="code-style" HeaderText="Branch Info"
         CloseOnOutsideClick="false"
         Width="40vw"
         CssClass="common-popup"
         @bind-Visible="@PopupVisible">
    <Content>
        <EditForm Model="@selectedRow" Context="branchForm" OnValidSubmit="@HandleValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <DxFormLayout SizeMode="SizeMode.Small">
                <DxFormLayoutItem CaptionCssClass="code-style" Caption="Branch Code" ColSpanMd="6">
                    <Template>
                        <DxTextBox @bind-Text="@selectedRow.BranchCode"
                                   maxlength="5"
                                   ReadOnly="@IsEditMode"
                                   InputCssClass="required-field code-style" />
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem CaptionCssClass="code-style" Caption="Active" ColSpanMd="3">
                    <Template>
                        <DxCheckBox @bind-Checked="@selectedRow.IsActive"
                                    AllowIndeterminateState="false"
                                    ReadOnly="@(!editEnable)" />
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem CaptionCssClass="code-style" Caption="Branch Name" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <DxTextBox @bind-Text="@selectedRow.BranchName"
                                   maxlength="100"
                                   ReadOnly="@(!editEnable)"
                                   InputCssClass="required-field" />
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem CaptionCssClass="code-style" ColSpanMd="12" BeginRow="true">
                    <Template>
                        <div class="d-flex gap-2">
                            @if (editEnable)
                            {
                                <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                          Text="@(IsSubmitting ? "Saving…" : "Save")"
                                          SubmitFormOnClick="true"
                                          Enabled="@(!IsSubmitting)" />
                            }
                            <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                      Text="Cancel"
                                      Click="@OnCancel" />
                        </div>
                    </Template>
                </DxFormLayoutItem>
            </DxFormLayout>
        </EditForm>
    </Content>
</DxPopup>
</MenuAuthorize>
