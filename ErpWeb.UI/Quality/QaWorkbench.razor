@page "/quality/cases"
@using ErpWeb.Core.Quality
@inherits PageBase

<PageTitle>Quality Workbench</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.QualityWorkbench">
    <div class="iv-page">
        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <div class="iv-toast iv-toast--ok" role="status">
                <span>@StatusMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissStatus" aria-label="Dismiss">×</button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="iv-toast iv-toast--err" role="alert">
                <span>@ErrorMessage</span>
                <button type="button" class="iv-toast__close" @onclick="DismissError" aria-label="Dismiss">×</button>
            </div>
        }

        <header class="iv-hero">
            <div class="iv-hero__mark" aria-hidden="true">
                <i class="fa-solid fa-clipboard-check"></i>
            </div>
            <div class="iv-hero__copy">
                <p class="iv-eyebrow">Quality</p>
                <h1 class="iv-title">Quality Workbench</h1>
                <div class="iv-chips">
                    <span class="iv-chip">Open @Workload.OpenCaseCount.ToString("N0")</span>
                    <span class="iv-chip">Pending inspection @Workload.PendingInspectionCount.ToString("N0")</span>
                    @if (PendingReviewCount > 0)
                    {
                        <span class="iv-chip qa-badge qa-badge--pending">@PendingReviewLabel</span>
                    }
                    @if (Workload.FollowUpReady && Workload.OverdueActionCount > 0)
                    {
                        <span class="iv-chip">Overdue tasks @Workload.OverdueActionCount.ToString("N0")</span>
                    }
                    <span class="iv-chip">@TotalCountLabel</span>
                    <span class="iv-chip">Record-only</span>
                    @if (HasActiveFilters)
                    {
                        <span class="iv-chip">Filtered</span>
                    }
                </div>
            </div>
            <div class="iv-hero__kpi">
                <span>Cases</span>
                <strong>@TotalCount.ToString("N0")</strong>
            </div>
        </header>

        <section class="iv-card">
            <QaRecordOnlyBanner />
            <div class="iv-toolbar-row">
                <div class="iv-toolbar-row__search erp-inline-search">
                    <label class="erp-inline-search__caption" for="qa-workbench-search">Search</label>
                    <div class="erp-inline-search__editor">
                        <DxTextBox InputId="qa-workbench-search"
                                   Text="@SearchText"
                                   TextChanged="OnSearchTextChanged"
                                   NullText="Search case no, source, supplier, work order…"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                   CssClass="w-100"
                                   TextExpression="@(() => SearchText)"
                                   BindValueMode="BindValueMode.OnInput" />
                    </div>
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              IconCssClass="fa-solid fa-magnifying-glass"
                              CssClass="erp-inline-search__button"
                              Click="@ApplySearchAsync"
                              aria-label="Search quality cases"
                              title="Search quality cases" />
                </div>
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          Text="Filter"
                          IconCssClass="fa-solid fa-filter"
                          Click="@OpenFilterPopup" />
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          Text="How to use"
                          IconCssClass="fa-solid fa-circle-info"
                          Click="@(() => HelpVisible = true)" />
            </div>

            @if (IsBootstrapping)
            {
                <div class="iv-skeleton" aria-busy="true">
                    <div class="iv-skeleton__line iv-skeleton__line--lg"></div>
                    <div class="iv-skeleton__line iv-skeleton__line--md"></div>
                    <div class="iv-skeleton__line"></div>
                </div>
            }
            else if (TotalCount == 0)
            {
                <div class="qa-empty">
                    <h3>@(HasActiveFilters ? "No quality cases match the current filters." : "No quality cases yet.")</h3>
                    <p>
                        @(HasActiveFilters
                            ? "Clear the filters or search for a different case, source, supplier, or work order."
                            : "Start a case from Request QA on a source document, or create one here and look up the live source.")
                    </p>
                    @if (CanAdd && !HasActiveFilters)
                    {
                        <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                  Text="New QA"
                                  IconCssClass="fas fa-plus"
                                  Click="@NavigateNew" />
                    }
                </div>
            }
            else
            {
                <div class="iv-list-desktop">
                    <CommonDataGridEx T="QaCaseListRow"
                                      Columns="@Columns"
                                      Buttons="@Buttons"
                                      ActionButtons="@ActionButtons"
                                      KeyName="@nameof(QaCaseListRow.CaseNo)"
                                      GridKey="qa-workbench-list"
                                      Title="Cases"
                                      CustomDataSource="@DataSource"
                                      ShowToolbarText="true"
                                      ShowResetLayoutButton="true"
                                      UseBuiltInExport="false"
                                      ShowSearchBox="false"
                                      ShowFilterRow="false"
                                      ShowGroupPanel="false"
                                      allowSelect="true"
                                      OnGridInstance="@OnGridInstance"
                                      OnSelectionsEventHandle="@OnSelectionsEvent"
                                      OnButtonEventHandle="@OnButtonClick"
                                      OnActionEventHandle="@OnActionClick" />
                </div>

                <div class="iv-list-compact">
                    @foreach (var row in CompactRows)
                    {
                        <button type="button"
                                class="iv-list-compact__item"
                                @onclick="() => NavigateView(row.CaseNo)">
                            <span class="iv-list-compact__code">@row.CaseNo</span>
                            <span class="iv-list-compact__desc">
                                @row.SourceTypeLabel
                                · @row.CaseDate.ToString("dd/MM/yyyy")
                            </span>
                            <div class="iv-list-compact__meta">
                                <span class="iv-status @(row.IsPendingReview ? "qa-badge qa-badge--pending" : null)">@row.StatusLabel</span>
                                <span class="iv-chip">@row.NextAction</span>
                                <span class="iv-chip">@row.LineCount line(s)</span>
                            </div>
                        </button>
                    }
                </div>
            }
        </section>
    </div>

    <DxPopup HeaderText="Filter cases"
             CloseOnOutsideClick="false"
             Width="480px"
             CssClass="common-popup"
             ShowFooter="true"
             @bind-Visible="@FilterPopupVisible">
        <BodyContentTemplate>
            <div class="iv-popup-body">
                <DxFormLayout SizeMode="SizeMode.Small">
                    <DxFormLayoutItem Caption="Status" ColSpanMd="12">
                        <Template Context="field">
                            <DxComboBox Data="@StatusFilterOptions"
                                        TextFieldName="@nameof(StatusFilterOption.Name)"
                                        ValueFieldName="@nameof(StatusFilterOption.Key)"
                                        @bind-Value="@DraftStatusKey"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Source" ColSpanMd="12">
                        <Template Context="field">
                            <DxComboBox Data="@SourceFilterOptions"
                                        TextFieldName="@nameof(StatusFilterOption.Name)"
                                        ValueFieldName="@nameof(StatusFilterOption.Key)"
                                        @bind-Value="@DraftSourceKey"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Date from" ColSpanMd="6">
                        <Template Context="field">
                            <DxDateEdit @bind-Date="@DraftDateFrom"
                                        DisplayFormat="dd/MM/yyyy"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Date to" ColSpanMd="6">
                        <Template Context="field">
                            <DxDateEdit @bind-Date="@DraftDateTo"
                                        DisplayFormat="dd/MM/yyyy"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayout>
            </div>
        </BodyContentTemplate>
        <FooterContentTemplate>
            <div class="iv-popup-footer__actions">
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          Text="Clear"
                          Click="@ClearFiltersAsync" />
                <DxButton RenderStyle="ButtonRenderStyle.Primary"
                          Text="Apply"
                          Click="@ApplyFiltersAsync" />
            </div>
        </FooterContentTemplate>
    </DxPopup>

    <DxPopup HeaderText="Delete draft?"
             CloseOnOutsideClick="false"
             Width="420px"
             CssClass="common-popup"
             ShowFooter="true"
             @bind-Visible="@ConfirmVisible">
        <BodyContentTemplate>
            <p class="iv-confirm__copy">@ConfirmMessage</p>
        </BodyContentTemplate>
        <FooterContentTemplate>
            <div class="iv-popup-footer__actions">
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          Text="Keep"
                          Click="@(() => ConfirmVisible = false)"
                          Enabled="@(!IsSubmitting)" />
                <DxButton RenderStyle="ButtonRenderStyle.Danger"
                          Text="Delete"
                          Click="@ConfirmDeleteAsync"
                          Enabled="@(!IsSubmitting)" />
            </div>
        </FooterContentTemplate>
    </DxPopup>

    <QaHowToUsePopup @bind-Visible="@HelpVisible" />
</MenuAuthorize>
