<DxPopup HeaderText="How to use Quality"
         CloseOnOutsideClick="true"
         Width="640px"
         CssClass="common-popup"
         ShowFooter="true"
         Visible="@Visible"
         VisibleChanged="@OnVisibleChanged">
    <BodyContentTemplate>
        <QaHowToUseContent />
    </BodyContentTemplate>
    <FooterContentTemplate>
        <div class="iv-popup-footer__actions">
            <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                      Text="Close"
                      Click="@CloseAsync" />
        </div>
    </FooterContentTemplate>
</DxPopup>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    private Task OnVisibleChanged(bool value) => VisibleChanged.InvokeAsync(value);
    private Task CloseAsync() => VisibleChanged.InvokeAsync(false);
}
