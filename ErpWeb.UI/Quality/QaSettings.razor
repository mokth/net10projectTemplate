@page "/quality/settings"
@inherits PageBase
@using ErpWeb.Core.Quality

<PageTitle>Quality Settings</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.QualitySettings">
<div class="iv-page">
    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="iv-toast iv-toast--ok" role="status">
            <span>@StatusMessage</span>
            <button type="button" class="iv-toast__close" @onclick="DismissStatus" aria-label="Dismiss">×</button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="iv-toast iv-toast--err" role="alert">
            <span>@ErrorMessage</span>
            <button type="button" class="iv-toast__close" @onclick="DismissError" aria-label="Dismiss">×</button>
        </div>
    }

    <header class="iv-hero">
        <div class="iv-hero__mark" aria-hidden="true">
            <i class="fa-solid fa-sliders"></i>
        </div>
        <div class="iv-hero__copy">
            <p class="iv-eyebrow">Quality</p>
            <h1 class="iv-title">Quality Settings</h1>
            <div class="iv-chips">
                <span class="iv-chip">@(Policy.Version == 0 ? "No saved policy yet" : $"Saved policy · version {Policy.Version}")</span>
                <span class="iv-chip">Record-only</span>
            </div>
        </div>
        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                  Text="How to use"
                  IconCssClass="fa-solid fa-circle-info"
                  Click="@(() => HelpVisible = true)" />
    </header>

    <section class="iv-card">
        <QaRecordOnlyBanner />
        @if (!string.IsNullOrWhiteSpace(InfoMessage))
        {
            <p class="qa-settings-info" role="status">@InfoMessage</p>
        }

        @if (IsLoading)
        {
            <div class="iv-skeleton" aria-busy="true">
                <div class="iv-skeleton__line iv-skeleton__line--lg"></div>
                <div class="iv-skeleton__line iv-skeleton__line--md"></div>
            </div>
        }
        else
        {
            <section class="qa-settings-group" aria-labelledby="qa-settings-inspection">
                <h2 id="qa-settings-inspection" class="iv-card__title">Posting gates</h2>
                <p class="qa-settings-group__hint">Not available yet. These switches cannot authorize posting from Settings.</p>
                <div class="qa-settings-list">
                    @foreach (var gate in FrozenGates)
                    {
                        <div class="qa-setting qa-setting--frozen">
                            <div class="qa-setting__copy">
                                <p class="qa-setting__title">@gate.Title</p>
                                <p class="qa-setting__help">@gate.Help</p>
                            </div>
                            <div class="qa-setting__control">
                                <span class="qa-setting__state @(gate.Enabled ? "is-on" : "is-off")">@(gate.Enabled ? "On" : "Off")</span>
                                <span class="qa-setting__frozen">@(gate.Enabled ? "Persisted outside Settings" : "Not available yet")</span>
                            </div>
                        </div>
                    }
                </div>
            </section>

            <section class="qa-settings-group" aria-labelledby="qa-settings-approvals">
                <h2 id="qa-settings-approvals" class="iv-card__title">Approvals</h2>
                <p class="qa-settings-group__hint">This rule applies to inspection records. It does not turn posting approval on.</p>
                <div class="qa-settings-list">
                    <div class="qa-setting">
                        <div class="qa-setting__copy">
                            <label class="qa-setting__title" for="qa-separation">Inspector cannot approve own case</label>
                            <p class="qa-setting__help">The person who inspected a case cannot approve it.</p>
                        </div>
                        <div class="qa-setting__control">
                            <span class="qa-setting__state @(InspectorApproverSeparation ? "is-on" : "is-off")">@(InspectorApproverSeparation ? "On" : "Off")</span>
                            <DxCheckBox InputId="qa-separation"
                                        @bind-Checked="@InspectorApproverSeparation"
                                        AllowIndeterminateState="false"
                                        Enabled="@CanEdit" />
                        </div>
                    </div>
                </div>
            </section>

            <footer class="mr-footer">
                <p class="mr-footer__hint">Save updates inspector-approval rules. Posting gates stay frozen.</p>
                <div class="mr-footer__actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="Close"
                              IconCssClass="fa-solid fa-xmark"
                              Click="@OnClose" />
                    <PermissionAuthorize MenuCode="@MenuCodes.QualitySettings" Permission="@PermissionCodes.Edit">
                        <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                  Text="@(IsSubmitting ? "Saving…" : "Save")"
                                  IconCssClass="fa-solid fa-floppy-disk"
                                  Click="@OnSaveAsync"
                                  Enabled="@CanSave" />
                    </PermissionAuthorize>
                </div>
            </footer>
        }
    </section>
</div>

<QaHowToUsePopup @bind-Visible="@HelpVisible" />
</MenuAuthorize>
