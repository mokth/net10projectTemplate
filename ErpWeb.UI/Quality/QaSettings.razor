@page "/quality/settings"
@inherits PageBase
@using ErpWeb.Core.Quality

<PageTitle>Quality Settings</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.QualitySettings">
<div class="iv-page">
    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="iv-toast iv-toast--ok" role="status">
            <span>@StatusMessage</span>
            <button type="button" class="iv-toast__close" @onclick="DismissStatus" aria-label="Dismiss">×</button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="iv-toast iv-toast--err" role="alert">
            <span>@ErrorMessage</span>
            <button type="button" class="iv-toast__close" @onclick="DismissError" aria-label="Dismiss">×</button>
        </div>
    }

    <header class="iv-hero">
        <div class="iv-hero__mark" aria-hidden="true">
            <i class="fa-solid fa-sliders"></i>
        </div>
        <div class="iv-hero__copy">
            <p class="iv-eyebrow">Quality</p>
            <h1 class="iv-title">Quality Settings</h1>
            <div class="iv-chips">
                <span class="iv-status @(IncomingInspectionEnabled ? "is-on" : "is-off")">
                    Incoming inspection @(IncomingInspectionEnabled ? "ON" : "OFF")
                </span>
                <span class="iv-status @(FinalFgInspectionEnabled ? "is-on" : "is-off")">
                    Finished-goods inspection @(FinalFgInspectionEnabled ? "ON" : "OFF")
                </span>
                <span class="iv-status @(LogicalHoldEnabled ? "is-on" : "is-off")">
                    Logical WIP hold @(LogicalHoldEnabled ? "ON" : "OFF")
                </span>
                <span class="iv-status @(PhysicalHoldEnabled ? "is-on" : "is-off")">
                    Physical warehouse hold @(PhysicalHoldEnabled ? "ON" : "OFF")
                </span>
                <span class="iv-status @(NonGoodEnabled ? "is-on" : "is-off")">
                    Non-good Daily Production @(NonGoodEnabled ? "ON" : "OFF")
                </span>
                <span class="iv-chip">@(Policy.Version == 0 ? "No saved policy yet" : $"Saved policy · version {Policy.Version}")</span>
            </div>
        </div>
    </header>

    <section class="iv-card">
        <p class="iv-guidance">
            Incoming: receive delivery → Inspect → Save → Submit → Approve → Create a goods receipt for accepted qty → Post.
            Finished goods: inspect FG staging → Approve → Post a finished-good receipt for accepted qty.
            Logical WIP hold reserves Hold qty on the production lot. It does not move stock to a QA warehouse.
            Physical warehouse hold reserves Hold and Reject qty on the source pile. It does not convert IStatus to QCHOLD.
            Non-good Daily Production: inspect scrap/reject/hold counters before POST when that gate is on. Quality does not create a valued lot.
            Rejected quantity is not inventory until an approved scrap or vendor return claims it.
        </p>

        @if (IsLoading)
        {
            <div class="iv-skeleton" aria-busy="true">
                <div class="iv-skeleton__line iv-skeleton__line--lg"></div>
                <div class="iv-skeleton__line iv-skeleton__line--md"></div>
            </div>
        }
        else
        {
            <DxFormLayout SizeMode="SizeMode.Small">
                <DxFormLayoutItem Caption="Check supplier deliveries before stock receipt?" ColSpanMd="6">
                    <Template>
                        <DxCheckBox @bind-Checked="@IncomingInspectionEnabled"
                                    Enabled="@CanEdit">
                            Off until you turn this on. Default is off.
                        </DxCheckBox>
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Check FG staging before finished-good receipt?" ColSpanMd="6">
                    <Template>
                        <DxCheckBox @bind-Checked="@FinalFgInspectionEnabled"
                                    Enabled="@CanEdit">
                            Off until you turn this on. Default is off.
                        </DxCheckBox>
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Reserve Hold qty on the production lot?" ColSpanMd="6">
                    <Template>
                        <DxCheckBox @bind-Checked="@LogicalHoldEnabled"
                                    Enabled="@CanEdit">
                            Off until you turn this on. Default is off. This is a reservation, not a warehouse transfer.
                        </DxCheckBox>
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Reserve Hold/Reject qty on the warehouse pile?" ColSpanMd="6">
                    <Template>
                        <DxCheckBox @bind-Checked="@PhysicalHoldEnabled"
                                    Enabled="@CanEdit">
                            Off until you turn this on. Default is off. This is a reservation, not a QCHOLD conversion.
                        </DxCheckBox>
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Inspect scrap/reject/hold before Daily Production POST?" ColSpanMd="6">
                    <Template>
                        <DxCheckBox @bind-Checked="@NonGoodEnabled"
                                    Enabled="@CanEdit">
                            Off until you turn this on. Default is off. Counters stay counters — no valued lot.
                        </DxCheckBox>
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Inspector cannot approve own case" ColSpanMd="6">
                    <Template>
                        <DxCheckBox @bind-Checked="@InspectorApproverSeparation"
                                    Enabled="@CanEdit" />
                    </Template>
                </DxFormLayoutItem>
            </DxFormLayout>

            <footer class="mr-footer">
                <p class="mr-footer__hint">Catalogue flag Require inspection on receipt stays unused. This page is the posting authority.</p>
                <div class="mr-footer__actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="Close"
                              IconCssClass="fa-solid fa-xmark"
                              Click="@OnClose" />
                    <PermissionAuthorize MenuCode="@MenuCodes.QualitySettings" Permission="@PermissionCodes.Edit">
                        <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                  Text="@(IsSubmitting ? "Saving…" : "Save")"
                                  IconCssClass="fa-solid fa-floppy-disk"
                                  Click="@OnSaveAsync"
                                  Enabled="@CanSave" />
                    </PermissionAuthorize>
                </div>
            </footer>
        }
    </section>
</div>
</MenuAuthorize>
