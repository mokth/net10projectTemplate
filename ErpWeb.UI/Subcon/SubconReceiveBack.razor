@page "/subcon/receive-back/{Mode:regex(^(new|edit|view)$)}"
@page "/subcon/receive-back/{Mode:regex(^(new|edit|view)$)}/{DocNo}"
@inherits PageBase

<PageTitle>@PageHeading</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.SubconReceiveBack">
    <div class="iv-page">
        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <div class="iv-toast iv-toast--ok" role="status">
                <span>@StatusMessage</span>
                <button type="button" class="iv-toast__close" @onclick="() => StatusMessage = null" aria-label="Dismiss">×</button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="iv-toast iv-toast--err" role="alert">
                <span>@ErrorMessage</span>
                <button type="button" class="iv-toast__close" @onclick="() => ErrorMessage = null" aria-label="Dismiss">×</button>
            </div>
        }

        <header class="iv-hero">
            <div class="iv-hero__mark" aria-hidden="true">
                <i class="fa-solid fa-boxes-packing"></i>
            </div>
            <div class="iv-hero__copy">
                <p class="iv-eyebrow">Subcontracting</p>
                <h1 class="iv-title">@PageHeading</h1>
                <div class="iv-chips">
                    <span class="iv-chip">@ModeChip</span>
                    <span class="iv-chip">@DocNoDisplay</span>
                    <span class="iv-chip">@LineCountLabel</span>
                    <span class="iv-chip">@Header.Status</span>
                    @if (Header.PostedTrxBatchNo is int postedBatchNo)
                    {
                        <span class="iv-chip">TR #@postedBatchNo</span>
                    }
                </div>
            </div>
        </header>

        <section class="iv-card">
            <SubconPostingBanner Message="@Header.PostBlockedReason" />
            @if (!string.IsNullOrWhiteSpace(Header.PostBlockedReason))
            {
                <p class="iv-guidance">Outstanding send-out quantity stays empty until a send-out is posted. Save keeps a draft against a send-out document. Stock will not move.</p>
                <div class="qa-empty">
                    <h3>No outstanding items.</h3>
                    <p>@SubconBlockedReasons.NoOutstanding</p>
                </div>
            }
            <DxFormLayout SizeMode="SizeMode.Small">
                <DxFormLayoutItem Caption="Date *" ColSpanMd="4">
                    <Template>
                        <DxDateEdit Date="@Header.TrxDate"
                                    DateChanged="@((DateTime d) => OnTrxDateChanged(d))"
                                    DateExpression="@(() => Header.TrxDate)"
                                    DisplayFormat="dd/MM/yyyy"
                                    Enabled="@CanEditDocument"
                                    InputCssClass="required-field" />
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Document" ColSpanMd="4">
                    <Template>
                        <DxTextBox Text="@DocNoDisplay" ReadOnly="true" ValidationEnabled="false" />
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Supplier *" ColSpanMd="4">
                    <Template>
                        <PoSupplierPicker @bind-SuppCode="@Header.SupplierCode"
                                          Selected="@OnSupplierSelected"
                                          Enabled="@CanEditDocument"
                                          NullText="Search supplier"
                                          InputCssClass="required-field" />
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Supplier name" ColSpanMd="6">
                    <Template>
                        <DxTextBox Text="@Header.SupplierName" ReadOnly="true" ValidationEnabled="false" />
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Remark" ColSpanMd="6">
                    <Template>
                        <DxMemo Text="@Header.Remarks"
                                TextChanged="OnRemarksChanged"
                                TextExpression="@(() => Header.Remarks)"
                                Rows="2"
                                ReadOnly="@(!CanEditDocument)" />
                    </Template>
                </DxFormLayoutItem>
            </DxFormLayout>

            <DxGrid Data="@Lines"
                    KeyFieldName="@nameof(LineVm.LineNo)"
                    SizeMode="SizeMode.Small"
                    ShowFilterRow="false"
                    ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                    TextWrapEnabled="false">
                <Columns>
                    <DxGridCommandColumn VisibleIndex="0"
                                         FixedPosition="GridColumnFixedPosition.Left"
                                         Width="88px"
                                         MinWidth="88"
                                         NewButtonVisible="false"
                                         EditButtonVisible="false"
                                         DeleteButtonVisible="false">
                        <CellDisplayTemplate>
                            @if (CanEditDocument)
                            {
                                var line = (LineVm)context.DataItem;
                                <DxButton RenderStyle="ButtonRenderStyle.Danger"
                                          RenderStyleMode="ButtonRenderStyleMode.Text"
                                          IconCssClass="fa-solid fa-trash"
                                          Click="@(() => RemoveLine(line))"
                                          aria-label="Remove line" />
                            }
                        </CellDisplayTemplate>
                    </DxGridCommandColumn>
                    <DxGridDataColumn FieldName="@nameof(LineVm.DispatchDocNo)" Caption="Send-out" Width="150px" MinWidth="130" />
                    <DxGridDataColumn FieldName="@nameof(LineVm.DispatchLineNo)" Caption="Line" Width="80px" MinWidth="70" />
                    <DxGridDataColumn FieldName="@nameof(LineVm.Qty)" Caption="Qty" Width="110px" MinWidth="100" DisplayFormat="n4" />
                    <DxGridDataColumn FieldName="@nameof(LineVm.Uom)" Caption="UOM" Width="80px" MinWidth="75" />
                </Columns>
            </DxGrid>

            @if (CanEditDocument)
            {
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          Text="Add line"
                          IconCssClass="fa-solid fa-plus"
                          Click="@OpenAddLinePopupAsync" />
            }

            <footer class="iv-footer">
                <p class="iv-footer__hint">@LineCountLabel. @(Header.CanPost ? "Ready to post return from supplier custody." : Header.CanRollback ? "Posted back to company stock." : "Post is not available.")</p>
                <div class="iv-footer__actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="@(IsView ? "Close" : "Cancel")"
                              IconCssClass="fa-solid fa-xmark"
                              Click="@OnCancel" />
                    @if (!IsView)
                    {
                        <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                  Text="@(IsSubmitting ? "Saving…" : "Save")"
                                  IconCssClass="fa-solid fa-floppy-disk"
                                  Click="@OnSaveAsync"
                                  Enabled="@CanSave" />
                    }
                    else
                    {
                        @if (CanEditDocumentAfterView)
                        {
                            <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                      Text="Edit"
                                      IconCssClass="fa-solid fa-pen"
                                      Click="@(() => Navigation.NavigateTo($"/subcon/receive-back/edit/{DocNo}"))" />
                        }
                        @if (CanPostDocument)
                        {
                            <DxButton RenderStyle="ButtonRenderStyle.Success"
                                      Text="@(IsSubmitting ? "Posting…" : "Post")"
                                      IconCssClass="fa-solid fa-box-open"
                                      Click="@(() => PostConfirmVisible = true)"
                                      Enabled="@CanPostDocument" />
                        }
                        @if (CanRollbackDocument)
                        {
                            <DxButton RenderStyle="ButtonRenderStyle.Danger"
                                      Text="@(IsSubmitting ? "Rolling back…" : "Rollback")"
                                      IconCssClass="fa-solid fa-rotate-left"
                                      Click="@(() => RollbackConfirmVisible = true)"
                                      Enabled="@CanRollbackDocument" />
                        }
                    }
                </div>
            </footer>
        </section>
    </div>

    <DxPopup HeaderText="Select send-out line"
             Width="780px"
             ShowFooter="true"
             CloseOnOutsideClick="false"
             @bind-Visible="@LinePopupVisible">
        <BodyContentTemplate>
            <div class="erp-inline-search erp-inline-search--popup mb-2">
                <label class="erp-inline-search__caption" for="subcon-rb-dispatch-search">Send-out</label>
                <div class="erp-inline-search__editor">
                    <DxTextBox InputId="subcon-rb-dispatch-search"
                               Text="@DispatchLookupSearch"
                               TextChanged="OnDispatchLookupSearchChanged"
                               TextExpression="@(() => DispatchLookupSearch)"
                               NullText="Search send-out no. or item…"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                               CssClass="w-100"
                               BindValueMode="BindValueMode.OnInput" />
                </div>
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          IconCssClass="fa-solid fa-magnifying-glass"
                          CssClass="erp-inline-search__button"
                          Click="@(() => LoadDispatchLookupAsync(0))"
                          aria-label="Search send-out lines"
                          title="Search send-out lines" />
            </div>

            <DxGrid Data="@DispatchLookupRows"
                    SizeMode="SizeMode.Small"
                    ShowFilterRow="false"
                    ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                    TextWrapEnabled="false">
                <Columns>
                    <DxGridCommandColumn VisibleIndex="0"
                                         FixedPosition="GridColumnFixedPosition.Left"
                                         Width="96px"
                                         MinWidth="90"
                                         NewButtonVisible="false"
                                         EditButtonVisible="false"
                                         DeleteButtonVisible="false">
                        <CellDisplayTemplate Context="rowCtx">
                            @{
                                var option = (SubconDispatchLineLookupRow)rowCtx.DataItem;
                            }
                            <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                      RenderStyleMode="ButtonRenderStyleMode.Outline"
                                      Text="Select"
                                      Click="@(() => SelectDispatchLine(option))" />
                        </CellDisplayTemplate>
                    </DxGridCommandColumn>
                    <DxGridDataColumn FieldName="@nameof(SubconDispatchLineLookupRow.DispatchDocNo)" Caption="Send-out" Width="135px" MinWidth="120" />
                    <DxGridDataColumn FieldName="@nameof(SubconDispatchLineLookupRow.DispatchLineNo)" Caption="Line" Width="65px" MinWidth="60" />
                    <DxGridDataColumn FieldName="@nameof(SubconDispatchLineLookupRow.ItemCode)" Caption="Item" Width="125px" MinWidth="110" />
                    <DxGridDataColumn FieldName="@nameof(SubconDispatchLineLookupRow.ItemName)" Caption="Description" MinWidth="150" />
                    <DxGridDataColumn FieldName="@nameof(SubconDispatchLineLookupRow.RemainingQty)" Caption="Remaining" Width="105px" MinWidth="95" DisplayFormat="n4" />
                    <DxGridDataColumn FieldName="@nameof(SubconDispatchLineLookupRow.Uom)" Caption="UOM" Width="75px" MinWidth="70" />
                </Columns>
            </DxGrid>

            @if (DispatchLookupTotal > DispatchLookupPageSize)
            {
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <span class="text-muted small">Showing @(DispatchLookupSkip + 1)–@(Math.Min(DispatchLookupSkip + DispatchLookupRows.Count, DispatchLookupTotal)) of @DispatchLookupTotal</span>
                    <div class="d-flex gap-2">
                        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                  Text="Prev"
                                  Enabled="@(DispatchLookupSkip > 0)"
                                  Click="@(() => LoadDispatchLookupAsync(Math.Max(0, DispatchLookupSkip - DispatchLookupPageSize)))" />
                        <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                  Text="Next"
                                  Enabled="@(DispatchLookupSkip + DispatchLookupPageSize < DispatchLookupTotal)"
                                  Click="@(() => LoadDispatchLookupAsync(DispatchLookupSkip + DispatchLookupPageSize))" />
                    </div>
                </div>
            }

            <DxFormLayout SizeMode="SizeMode.Small" CssClass="mt-3">
                <DxFormLayoutItem Caption="Send-out document" ColSpanMd="4">
                    <Template Context="field">
                        <DxTextBox Text="@DraftLine.DispatchDocNo" ReadOnly="true" ValidationEnabled="false" NullText="Select from list above" />
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Line" ColSpanMd="2">
                    <Template Context="field">
                        <DxSpinEdit @bind-Value="@DraftLine.DispatchLineNo" ReadOnly="true" MinValue="1" />
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Remaining" ColSpanMd="3">
                    <Template Context="field">
                        <DxTextBox Text="@(DraftLine.RemainingQty > 0m ? $"{DraftLine.RemainingQty:0.####} {DraftLine.Uom}" : "-")" ReadOnly="true" ValidationEnabled="false" />
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Receive quantity *" ColSpanMd="3">
                    <Template Context="field">
                        <DxSpinEdit @bind-Value="@DraftLine.Qty" Increment="1m" MinValue="0m" InputCssClass="required-field" />
                    </Template>
                </DxFormLayoutItem>
            </DxFormLayout>
        </BodyContentTemplate>
        <FooterContentTemplate>
            <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Cancel" Click="@(() => LinePopupVisible = false)" />
            <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Add" Click="@CommitLine" />
        </FooterContentTemplate>
    </DxPopup>

    <DxPopup HeaderText="Discard changes?"
             Width="420px"
             ShowFooter="true"
             CloseOnOutsideClick="false"
             @bind-Visible="@DiscardConfirmVisible">
        <BodyContentTemplate>
            <p class="mb-0">You have unsaved changes on this receive-back draft. Discard them?</p>
        </BodyContentTemplate>
        <FooterContentTemplate>
            <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Keep editing" Click="@(() => DiscardConfirmVisible = false)" />
            <DxButton RenderStyle="ButtonRenderStyle.Danger" Text="Discard" Click="@ConfirmDiscard" />
        </FooterContentTemplate>
    </DxPopup>

    <DxPopup HeaderText="Post receive-back from supplier custody?"
             Width="480px"
             ShowFooter="true"
             CloseOnOutsideClick="false"
             @bind-Visible="@PostConfirmVisible">
        <BodyContentTemplate>
            <p class="mb-2">Post receive-back <strong>@Header.DocNo</strong> (@LineCountLabel) from supplier <strong>@Header.SupplierCode</strong> on <strong>@Header.TrxDate.ToString("dd/MM/yyyy")</strong>?</p>
            <p class="mb-0 text-muted">This atomically returns company-owned stock from supplier custody into the receiving company warehouse via one Inventory TR.</p>
        </BodyContentTemplate>
        <FooterContentTemplate>
            <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Cancel" Click="@(() => PostConfirmVisible = false)" />
            <DxButton RenderStyle="ButtonRenderStyle.Success" Text="Confirm Post" Click="@ConfirmPostAsync" Enabled="@CanPostDocument" />
        </FooterContentTemplate>
    </DxPopup>

    <DxPopup HeaderText="Roll back receive-back?"
             Width="480px"
             ShowFooter="true"
             CloseOnOutsideClick="false"
             @bind-Visible="@RollbackConfirmVisible">
        <BodyContentTemplate>
            <p class="mb-2">Roll back posted receive-back <strong>@Header.DocNo</strong>@(Header.PostedTrxBatchNo is int b ? $" (TR #{b})" : string.Empty)?</p>
            <p class="mb-0 text-muted">Stock will return to supplier custody and this document will return to NEW.</p>
        </BodyContentTemplate>
        <FooterContentTemplate>
            <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Cancel" Click="@(() => RollbackConfirmVisible = false)" />
            <DxButton RenderStyle="ButtonRenderStyle.Danger" Text="Confirm Rollback" Click="@ConfirmRollbackAsync" Enabled="@CanRollbackDocument" />
        </FooterContentTemplate>
    </DxPopup>
</MenuAuthorize>
