@page "/subcon/settings"
@inherits PageBase

<PageTitle>Subcontracting Settings</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.SubconSettings">
<div class="iv-page">
    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="iv-toast iv-toast--ok" role="status">
            <span>@StatusMessage</span>
            <button type="button" class="iv-toast__close" @onclick="() => StatusMessage = null" aria-label="Dismiss">×</button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="iv-toast iv-toast--err" role="alert">
            <span>@ErrorMessage</span>
            <button type="button" class="iv-toast__close" @onclick="() => ErrorMessage = null" aria-label="Dismiss">×</button>
        </div>
    }

    <header class="iv-hero">
        <div class="iv-hero__mark" aria-hidden="true">
            <i class="fa-solid fa-sliders"></i>
        </div>
        <div class="iv-hero__copy">
            <p class="iv-eyebrow">Subcontracting</p>
            <h1 class="iv-title">Settings</h1>
            <div class="iv-chips">
                <span class="iv-chip">@(Policy.Version == 0 ? "No saved policy yet" : $"Saved policy · version {Policy.Version}")</span>
                <span class="iv-chip">@(Policy.LiveCustodyReady ? "Non-lot custody live" : "Drafts only")</span>
            </div>
        </div>
    </header>

    <section class="iv-card">
        <SubconPostingBanner Message="@BannerMessage" />
        @if (IsLoading)
        {
            <div class="iv-skeleton" aria-busy="true">
                <div class="iv-skeleton__line iv-skeleton__line--lg"></div>
            </div>
        }
        else
        {
            <p class="iv-guidance">Configure an active warehouse with WarehouseType = <code>SUBCON</code> (and one location per supplier code) before enabling non-lot same-SKU custody posting. All other capabilities remain frozen.</p>
            <ul class="qa-settings-help">
                <li>Run <code>scripts/create-subcon-foundation.sql</code>, <code>scripts/create-subcon-v2-jobs.sql</code>, <code>scripts/create-subcon-v3-posting.sql</code>, and <code>scripts/init-subcon-menu.sql</code> on SQL Server tenants.</li>
                <li>Posting and rollback require both Subcon and <code>INV_STOCK_TRANSFER</code> permissions.</li>
                <li>Backdated subcontracting movements with later stock/valuation dependencies remain blocked atomically.</li>
            </ul>
            <DxFormLayout SizeMode="SizeMode.Small">
                <DxFormLayoutItem Caption="Enable live subcontracting" ColSpanMd="4">
                    <Template>
                        <DxCheckBox @bind-Checked="@EditSubconEnabled" Enabled="@CanEdit">
                            Subcon live enabled
                        </DxCheckBox>
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Non-lot same-SKU custody" ColSpanMd="4">
                    <Template>
                        <DxCheckBox @bind-Checked="@EditInventoryCustodyPostEnabled" Enabled="@CanEdit">
                            Allow Send-Out / Receive-Back Post &amp; Rollback
                        </DxCheckBox>
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Default custody warehouse (SUBCON)" ColSpanMd="4">
                    <Template>
                        <IvCodeComboBox Data="@Warehouses"
                                        Value="@EditDefaultCustodyWarehouseCode"
                                        ValueChanged="@(v => EditDefaultCustodyWarehouseCode = v)"
                                        ValueExpression="@(() => EditDefaultCustodyWarehouseCode)"
                                        Enabled="@CanEdit"
                                        NullText="Select SUBCON warehouse" />
                    </Template>
                </DxFormLayoutItem>
            </DxFormLayout>
            <div class="qa-settings-list">
                @foreach (var gate in FrozenGates)
                {
                    <div class="qa-setting qa-setting--frozen">
                        <div class="qa-setting__copy">
                            <p class="qa-setting__title">@gate.Title</p>
                            <p class="qa-setting__help">@gate.Help</p>
                        </div>
                        <div class="qa-setting__control">
                            <span class="qa-setting__state is-off">Off</span>
                            <span class="qa-setting__frozen">Not available yet</span>
                        </div>
                    </div>
                }
            </div>
            <footer class="iv-footer">
                <p class="iv-footer__hint">@(Policy.LiveCustodyReady ? "Non-lot same-SKU custody posting is active; conversion, lot return, WIP, and fee capitalization remain off." : "Live posting stays off until explicitly enabled.")</p>
                <div class="iv-footer__actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="Close"
                              IconCssClass="fa-solid fa-xmark"
                              Click="@(() => Navigation.NavigateTo("/subcon"))" />
                    <PermissionAuthorize MenuCode="@MenuCodes.SubconSettings" Permission="@PermissionCodes.Edit">
                        <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                  Text="@(IsSubmitting ? "Saving…" : "Save")"
                                  IconCssClass="fa-solid fa-floppy-disk"
                                  Click="@OnSaveAsync"
                                  Enabled="@CanSave" />
                    </PermissionAuthorize>
                </div>
            </footer>
        }
    </section>
</div>
</MenuAuthorize>
