@page "/subcon/receive-back"
@inherits PageBase

<PageTitle>Receive Back</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.SubconReceiveBack">
    <div class="iv-page">
        <header class="iv-hero">
            <div class="iv-hero__mark" aria-hidden="true">
                <i class="fa-solid fa-boxes-packing"></i>
            </div>
            <div class="iv-hero__copy">
                <p class="iv-eyebrow">Subcontracting</p>
                <h1 class="iv-title">Receive Back</h1>
                <div class="iv-chips">
                    <span class="iv-chip">@TotalCountLabel</span>
                    <span class="iv-chip">Drafts only</span>
                </div>
            </div>
        </header>
        <section class="iv-card">
            <SubconPostingBanner Message="@SubconBlockedReasons.NoOutstanding" />
            @if (IsBootstrapping)
            {
                <div class="iv-skeleton" aria-busy="true">
                    <div class="iv-skeleton__line"></div>
                </div>
            }
            else if (TotalCount == 0)
            {
                <div class="qa-empty">
                    <h3>No receive-back drafts.</h3>
                    <p>Outstanding stock stays empty until a send-out is posted. You can still save a draft against a send-out document. Stock will not move.</p>
                    @if (CanAdd)
                    {
                        <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                  Text="New receive-back"
                                  IconCssClass="fas fa-plus"
                                  Click="@(() => Navigation.NavigateTo("/subcon/receive-back/new"))" />
                    }
                </div>
            }
            else
            {
                <div class="iv-list-desktop">
                    <CommonDataGridEx T="SubconListRow"
                                      Columns="@Columns"
                                      Buttons="@Buttons"
                                      ActionButtons="@ActionButtons"
                                      KeyName="@nameof(SubconListRow.DocNo)"
                                      GridKey="subcon-receive-back-list"
                                      Title="Receive Back"
                                      CustomDataSource="@DataSource"
                                      ShowSearchBox="false"
                                      ShowFilterRow="false"
                                      ShowGroupPanel="false"
                                      allowSelect="false"
                                      OnButtonEventHandle="@OnButtonClick"
                                      OnActionEventHandle="@OnActionClick" />
                </div>
            }
        </section>
    </div>
</MenuAuthorize>
