@page "/subcon/send-out/{Mode:regex(^(new|edit|view)$)}"
@page "/subcon/send-out/{Mode:regex(^(new|edit|view)$)}/{DocNo}"
@inherits PageBase

<PageTitle>@PageHeading</PageTitle>

<MenuAuthorize MenuCode="@MenuCodes.SubconSendOut">
    <div class="iv-page">
        @if (!string.IsNullOrWhiteSpace(StatusMessage))
        {
            <div class="iv-toast iv-toast--ok" role="status">
                <span>@StatusMessage</span>
                <button type="button" class="iv-toast__close" @onclick="() => StatusMessage = null" aria-label="Dismiss">×</button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="iv-toast iv-toast--err" role="alert">
                <span>@ErrorMessage</span>
                <button type="button" class="iv-toast__close" @onclick="() => ErrorMessage = null" aria-label="Dismiss">×</button>
            </div>
        }

        <header class="iv-hero">
            <div class="iv-hero__mark" aria-hidden="true">
                <i class="fa-solid fa-truck-ramp-box"></i>
            </div>
            <div class="iv-hero__copy">
                <p class="iv-eyebrow">Subcontracting</p>
                <h1 class="iv-title">@PageHeading</h1>
                <div class="iv-chips">
                    <span class="iv-chip">@ModeChip</span>
                    <span class="iv-chip">@DocNoDisplay</span>
                    <span class="iv-chip">@LineCountLabel</span>
                    <span class="iv-chip">@Header.Status</span>
                    @if (Header.PostedTrxBatchNo is int postedBatchNo)
                    {
                        <span class="iv-chip">TR #@postedBatchNo</span>
                    }
                </div>
            </div>
        </header>

        <section class="iv-card">
            <SubconPostingBanner Message="@Header.PostBlockedReason" />
            <p class="iv-guidance">Who am I sending this to? What item? How much? Save keeps a draft. Stock will not move.</p>
            <DxFormLayout SizeMode="SizeMode.Small">
                <DxFormLayoutItem Caption="Date *" ColSpanMd="4">
                    <Template>
                        <DxDateEdit Date="@Header.TrxDate"
                                    DateChanged="@((DateTime d) => OnTrxDateChanged(d))"
                                    DateExpression="@(() => Header.TrxDate)"
                                    DisplayFormat="dd/MM/yyyy"
                                    Enabled="@CanEditDocument"
                                    InputCssClass="required-field" />
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Document" ColSpanMd="4">
                    <Template>
                        <DxTextBox Text="@DocNoDisplay" ReadOnly="true" ValidationEnabled="false" />
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Promised return" ColSpanMd="4">
                    <Template>
                        <DxDateEdit Date="@Header.PromisedReturnDate"
                                    DateChanged="@((DateTime? d) => OnPromisedReturnDateChanged(d))"
                                    DateExpression="@(() => Header.PromisedReturnDate)"
                                    DisplayFormat="dd/MM/yyyy"
                                    Enabled="@CanEditDocument" />
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Supplier *" ColSpanMd="6">
                    <Template>
                        <PoSupplierPicker @bind-SuppCode="@Header.SupplierCode"
                                          Selected="@OnSupplierSelected"
                                          Enabled="@CanEditDocument"
                                          NullText="Search supplier"
                                          InputCssClass="required-field" />
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Supplier name" ColSpanMd="6">
                    <Template>
                        <DxTextBox Text="@Header.SupplierName" ReadOnly="true" ValidationEnabled="false" />
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Job type *" ColSpanMd="4">
                    <Template>
                        <DxComboBox Data="@JobKindOptions"
                                    TextFieldName="@nameof(JobKindOption.Caption)"
                                    ValueFieldName="@nameof(JobKindOption.Code)"
                                    Value="@Header.JobKind"
                                    ValueChanged="@((string v) => OnJobKindChanged(v))"
                                    ValueExpression="@(() => Header.JobKind)"
                                    Enabled="@(CanEditDocument && IsNew)"
                                    InputCssClass="required-field" />
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Source" ColSpanMd="4">
                    <Template>
                        <DxTextBox Text="Inventory stock" ReadOnly="true" ValidationEnabled="false" />
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Linked PO" ColSpanMd="4">
                    <Template>
                        <DxTextBox Text="@Header.PoNo"
                                   TextChanged="OnPoNoChanged"
                                   TextExpression="@(() => Header.PoNo)"
                                   NullText="Optional PO number"
                                   ReadOnly="@(!CanEditDocument)" />
                    </Template>
                </DxFormLayoutItem>
                @if (IsAssemblyJob)
                {
                    <DxFormLayoutItem Caption="Target output item *" ColSpanMd="5">
                        <Template>
                            <IvStockMasterPicker @bind-ICode="@Header.TargetItemCode"
                                                 Selected="@OnTargetItemSelected"
                                                 Enabled="@CanEditDocument"
                                                 NullText="Select assembled product"
                                                 InputCssClass="required-field" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Target qty *" ColSpanMd="3">
                        <Template>
                            <DxSpinEdit Value="@Header.TargetQty"
                                        ValueChanged="@((decimal v) => OnTargetQtyChanged(v))"
                                        ValueExpression="@(() => Header.TargetQty)"
                                        Increment="1m"
                                        MinValue="0m"
                                        Enabled="@CanEditDocument"
                                        InputCssClass="required-field" />
                        </Template>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Assembly source" ColSpanMd="4">
                        <Template>
                            <div class="d-flex align-items-center gap-2">
                                <DxCheckBox Checked="@Header.IsManualKit"
                                            CheckedChanged="@((bool v) => OnManualKitChanged(v))"
                                            CheckedExpression="@(() => Header.IsManualKit)"
                                            Enabled="@CanEditDocument">
                                    Manual kit (one-off)
                                </DxCheckBox>
                                @if (!Header.IsManualKit && CanEditDocument)
                                {
                                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                                              Text="Load from BOM"
                                              IconCssClass="fa-solid fa-sitemap"
                                              Click="@LoadBomAsync" />
                                }
                            </div>
                        </Template>
                    </DxFormLayoutItem>
                }
                <DxFormLayoutItem Caption="Remark" ColSpanMd="12">
                    <Template>
                        <DxMemo Text="@Header.Remarks"
                                TextChanged="OnRemarksChanged"
                                TextExpression="@(() => Header.Remarks)"
                                Rows="2"
                                ReadOnly="@(!CanEditDocument)" />
                    </Template>
                </DxFormLayoutItem>
            </DxFormLayout>

            @if (!CanUseProductionMode)
            {
                <p class="iv-guidance">Work Order send-out is hidden. This company does not need a Planning right to use inventory send-out.</p>
            }
            else
            {
                <p class="iv-guidance">@SubconBlockedReasons.NoProductionCustody</p>
            }

            <DxGrid Data="@Lines"
                    KeyFieldName="@nameof(LineVm.LineNo)"
                    SizeMode="SizeMode.Small"
                    ShowFilterRow="false"
                    ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                    TextWrapEnabled="false">
                <Columns>
                    <DxGridCommandColumn VisibleIndex="0"
                                         FixedPosition="GridColumnFixedPosition.Left"
                                         Width="88px"
                                         MinWidth="88"
                                         NewButtonVisible="false"
                                         EditButtonVisible="false"
                                         DeleteButtonVisible="false">
                        <CellDisplayTemplate>
                            @if (CanEditDocument)
                            {
                                var line = (LineVm)context.DataItem;
                                <DxButton RenderStyle="ButtonRenderStyle.Danger"
                                          RenderStyleMode="ButtonRenderStyleMode.Text"
                                          IconCssClass="fa-solid fa-trash"
                                          Click="@(() => RemoveLine(line))"
                                          aria-label="Remove line" />
                            }
                        </CellDisplayTemplate>
                    </DxGridCommandColumn>
                    <DxGridDataColumn FieldName="@nameof(LineVm.ItemCode)" Caption="Item" Width="140px" MinWidth="120" />
                    <DxGridDataColumn FieldName="@nameof(LineVm.ItemName)" Caption="Description" MinWidth="180" />
                    <DxGridDataColumn FieldName="@nameof(LineVm.WarehouseCode)" Caption="Warehouse" Width="110px" MinWidth="100" />
                    <DxGridDataColumn FieldName="@nameof(LineVm.LocationCode)" Caption="Location" Width="100px" MinWidth="90" />
                    <DxGridDataColumn FieldName="@nameof(LineVm.Qty)" Caption="Qty" Width="110px" MinWidth="100" DisplayFormat="n4" />
                    <DxGridDataColumn FieldName="@nameof(LineVm.Uom)" Caption="UOM" Width="80px" MinWidth="75" />
                </Columns>
            </DxGrid>

            @if (CanEditDocument)
            {
                <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                          Text="Add line"
                          IconCssClass="fa-solid fa-plus"
                          Click="@OpenAddLinePopupAsync" />
            }

            <footer class="iv-footer">
                <p class="iv-footer__hint">@LineCountLabel. @(Header.CanPost ? "Ready to post to supplier custody." : Header.CanRollback ? "Posted to supplier custody." : "Post is not available.")</p>
                <div class="iv-footer__actions">
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="Print Draft"
                              IconCssClass="fa-solid fa-print"
                              Click="@(() => DraftPreviewVisible = true)" />
                    <DxButton RenderStyle="ButtonRenderStyle.Secondary"
                              Text="@(IsView ? "Close" : "Cancel")"
                              IconCssClass="fa-solid fa-xmark"
                              Click="@OnCancel" />
                    @if (!IsView)
                    {
                        <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                  Text="@(IsSubmitting ? "Saving…" : "Save")"
                                  IconCssClass="fa-solid fa-floppy-disk"
                                  Click="@OnSaveAsync"
                                  Enabled="@CanSave" />
                    }
                    else
                    {
                        @if (CanEditDocumentAfterView)
                        {
                            <DxButton RenderStyle="ButtonRenderStyle.Primary"
                                      Text="Edit"
                                      IconCssClass="fa-solid fa-pen"
                                      Click="@(() => Navigation.NavigateTo($"/subcon/send-out/edit/{DocNo}"))" />
                        }
                        @if (CanPostDocument)
                        {
                            <DxButton RenderStyle="ButtonRenderStyle.Success"
                                      Text="@(IsSubmitting ? "Posting…" : "Post")"
                                      IconCssClass="fa-solid fa-paper-plane"
                                      Click="@(() => PostConfirmVisible = true)"
                                      Enabled="@CanPostDocument" />
                        }
                        @if (CanRollbackDocument)
                        {
                            <DxButton RenderStyle="ButtonRenderStyle.Danger"
                                      Text="@(IsSubmitting ? "Rolling back…" : "Rollback")"
                                      IconCssClass="fa-solid fa-rotate-left"
                                      Click="@(() => RollbackConfirmVisible = true)"
                                      Enabled="@CanRollbackDocument" />
                        }
                    }
                </div>
            </footer>
        </section>
    </div>

    <DxPopup HeaderText="Add line"
             Width="720px"
             ShowFooter="true"
             CloseOnOutsideClick="false"
             @bind-Visible="@LinePopupVisible">
        <BodyContentTemplate>
            <DxFormLayout SizeMode="SizeMode.Small">
                <DxFormLayoutItem Caption="On-hand balance" ColSpanMd="12">
                    <Template Context="field">
                        <IvBalLocPicker @bind-BalLocId="@DraftLine.BalLocId"
                                        ICodeFilter="@DraftLine.ItemCode"
                                        AsOfDate="@Header.TrxDate"
                                        Selected="@OnBalLocSelectedAsync" />
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Item *" ColSpanMd="12">
                    <Template Context="field">
                        <IvStockMasterPicker @bind-ICode="@DraftLine.ItemCode"
                                             Selected="@OnItemSelectedAsync"
                                             NullText="Search item"
                                             InputCssClass="required-field" />
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Warehouse *" ColSpanMd="4">
                    <Template Context="field">
                        <IvCodeComboBox Data="@Warehouses"
                                        Value="@DraftLine.WarehouseCode"
                                        ValueChanged="OnDraftWarehouseChangedAsync"
                                        ValueExpression="@(() => DraftLine.WarehouseCode)"
                                        IsLoading="@IsLoadingWarehouses"
                                        NullText="Select warehouse"
                                        InputCssClass="required-field" />
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Location" ColSpanMd="4">
                    <Template Context="field">
                        <IvCodeComboBox Data="@Locations"
                                        Value="@DraftLine.LocationCode"
                                        ValueChanged="@(v => DraftLine.LocationCode = v)"
                                        ValueExpression="@(() => DraftLine.LocationCode)"
                                        IsLoading="@IsLoadingLocations"
                                        Enabled="@(!string.IsNullOrWhiteSpace(DraftLine.WarehouseCode))"
                                        NullText="Optional location" />
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="UOM *" ColSpanMd="4">
                    <Template Context="field">
                        <IvCodeComboBox Data="@Uoms"
                                        Value="@DraftLine.Uom"
                                        ValueChanged="@(v => DraftLine.Uom = v ?? string.Empty)"
                                        ValueExpression="@(() => DraftLine.Uom)"
                                        IsLoading="@IsLoadingUoms"
                                        NullText="Select UOM"
                                        InputCssClass="required-field" />
                    </Template>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Quantity *" ColSpanMd="4">
                    <Template Context="field">
                        <DxSpinEdit @bind-Value="@DraftLine.Qty" Increment="1m" MinValue="0m" InputCssClass="required-field" />
                    </Template>
                </DxFormLayoutItem>
            </DxFormLayout>
        </BodyContentTemplate>
        <FooterContentTemplate>
            <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Cancel" Click="@(() => LinePopupVisible = false)" />
            <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Add" Click="@CommitLine" />
        </FooterContentTemplate>
    </DxPopup>

    <DxPopup HeaderText="Draft Preview — Not Dispatched"
             Width="min(680px, 95vw)"
             ShowFooter="true"
             CloseOnOutsideClick="false"
             @bind-Visible="@DraftPreviewVisible">
        <BodyContentTemplate>
            <div class="alert alert-warning mb-3" role="status">
                <strong>DRAFT — NOT DISPATCHED (STOCK NOT MOVED)</strong>
                <div>This document is a non-posting subcontract draft. Physical inventory has not been issued.</div>
            </div>
            <p class="mb-2">
                <strong>Document:</strong> @DocNoDisplay ·
                <strong>Date:</strong> @Header.TrxDate.ToString("dd/MM/yyyy") ·
                <strong>Supplier:</strong> @Header.SupplierCode @Header.SupplierName
            </p>
            <DxGrid Data="@Lines"
                    KeyFieldName="@nameof(LineVm.LineNo)"
                    SizeMode="SizeMode.Small"
                    ShowFilterRow="false"
                    ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
                    TextWrapEnabled="false">
                <Columns>
                    <DxGridDataColumn FieldName="@nameof(LineVm.LineNo)" Caption="#" Width="60px" MinWidth="50" />
                    <DxGridDataColumn FieldName="@nameof(LineVm.ItemCode)" Caption="Item" Width="130px" MinWidth="110" />
                    <DxGridDataColumn FieldName="@nameof(LineVm.ItemName)" Caption="Description" MinWidth="160" />
                    <DxGridDataColumn FieldName="@nameof(LineVm.WarehouseCode)" Caption="WH" Width="90px" MinWidth="80" />
                    <DxGridDataColumn FieldName="@nameof(LineVm.Qty)" Caption="Qty" Width="100px" MinWidth="90" DisplayFormat="n4" />
                    <DxGridDataColumn FieldName="@nameof(LineVm.Uom)" Caption="UOM" Width="75px" MinWidth="65" />
                </Columns>
            </DxGrid>
        </BodyContentTemplate>
        <FooterContentTemplate>
            <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Close" Click="@(() => DraftPreviewVisible = false)" />
        </FooterContentTemplate>
    </DxPopup>

    <DxPopup HeaderText="Discard changes?"
             Width="420px"
             ShowFooter="true"
             CloseOnOutsideClick="false"
             @bind-Visible="@DiscardConfirmVisible">
        <BodyContentTemplate>
            <p class="mb-0">You have unsaved changes on this send-out draft. Discard them?</p>
        </BodyContentTemplate>
        <FooterContentTemplate>
            <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Keep editing" Click="@(() => DiscardConfirmVisible = false)" />
            <DxButton RenderStyle="ButtonRenderStyle.Danger" Text="Discard" Click="@ConfirmDiscard" />
        </FooterContentTemplate>
    </DxPopup>

    <DxPopup HeaderText="Post send-out to supplier custody?"
             Width="480px"
             ShowFooter="true"
             CloseOnOutsideClick="false"
             @bind-Visible="@PostConfirmVisible">
        <BodyContentTemplate>
            <p class="mb-2">Post <strong>@Header.DocNo</strong> (@LineCountLabel) for supplier <strong>@Header.SupplierCode</strong> on <strong>@Header.TrxDate.ToString("dd/MM/yyyy")</strong>?</p>
            <p class="mb-0 text-muted">This atomically transfers stock into the segregated subcontractor custody warehouse via one Inventory TR.</p>
        </BodyContentTemplate>
        <FooterContentTemplate>
            <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Cancel" Click="@(() => PostConfirmVisible = false)" />
            <DxButton RenderStyle="ButtonRenderStyle.Success" Text="Confirm Post" Click="@ConfirmPostAsync" Enabled="@CanPostDocument" />
        </FooterContentTemplate>
    </DxPopup>

    <DxPopup HeaderText="Roll back send-out?"
             Width="480px"
             ShowFooter="true"
             CloseOnOutsideClick="false"
             @bind-Visible="@RollbackConfirmVisible">
        <BodyContentTemplate>
            <p class="mb-2">Roll back posted send-out <strong>@Header.DocNo</strong>@(Header.PostedTrxBatchNo is int b ? $" (TR #{b})" : string.Empty)?</p>
            <p class="mb-0 text-muted">Stock will return from supplier custody to its original company location and this document will return to NEW.</p>
        </BodyContentTemplate>
        <FooterContentTemplate>
            <DxButton RenderStyle="ButtonRenderStyle.Secondary" Text="Cancel" Click="@(() => RollbackConfirmVisible = false)" />
            <DxButton RenderStyle="ButtonRenderStyle.Danger" Text="Confirm Rollback" Click="@ConfirmRollbackAsync" Enabled="@CanRollbackDocument" />
        </FooterContentTemplate>
    </DxPopup>
</MenuAuthorize>
