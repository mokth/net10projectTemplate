{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=ERPWeb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Error",
      "Override": {
        "ErpWeb": "Debug",
        "ErpWeb.Core": "Debug",
        "ErpWeb.Library": "Debug",
        "ErpWeb.Model": "Debug",
        "ErpWeb.UI": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "./logs/erpweb-logfile.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "fileSizeLimitBytes": 104857600,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level}] {Message}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Application": "ErpWeb"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "ErpWeb": "Debug",
      "ErpWeb.Core": "Debug",
      "ErpWeb.Library": "Debug",
      "ErpWeb.Model": "Debug",
      "ErpWeb.UI": "Debug"
    }
  },
  "AllowedHosts": "*",
  "PasswordPolicy": {
    "MinimumLength": 8,
    "RequireLetter": true,
    "RequireDigit": true,
    "RejectUsername": true
  },
  "Menus": {
    "XmlPath": "Menus/menus.xml",
    "SyncOnStartup": true
  },
  "Attachments": {
    "RootPath": "App_Data/attachments"
  },
  "Purchase": {
    "PoPr": {
      "SupplierPrice": 0,
      "UseWeight": false,
      "PurchaseItemTaxInclusive": false,
      "PurchaseTaxDec": 2,
      "POControlIcode": false,
      "SelfViewEdit": false,
      "DraftAttachmentTtlHours": 24
    },
    "PoOrder": {
      "SupplierPrice": 0,
      "UseWeight": false,
      "PurchaseItemTaxInclusive": false,
      "PurchaseTaxDec": 2,
      "POPriceDecimal": 6,
      "POControlIcode": false,
      "SelfViewEdit": false,
      "DraftAttachmentTtlHours": 24
    }
  }
}
