{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=ERPWeb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Error",
      "Override": {
        "ErpWeb": "Debug",
        "ErpWeb.Core": "Debug",
        "ErpWeb.Library": "Debug",
        "ErpWeb.Model": "Debug",
        "ErpWeb.UI": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "./logs/erpweb-logfile.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "fileSizeLimitBytes": 104857600,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level}] {Message}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Application": "ErpWeb"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "ErpWeb": "Debug",
      "ErpWeb.Core": "Debug",
      "ErpWeb.Library": "Debug",
      "ErpWeb.Model": "Debug",
      "ErpWeb.UI": "Debug"
    }
  },
  "AllowedHosts": "*",
  "PasswordPolicy": {
    "MinimumLength": 8,
    "RequireLetter": true,
    "RequireDigit": true,
    "RejectUsername": true
  },
  "Menus": {
    "XmlPath": "Menus/menus.xml",
    "SyncOnStartup": true
  },
  "Attachments": {
    "RootPath": "App_Data/attachments"
  },
  "Einvoice": {
    // Environment-level MyInvois settings. Non-secret values live here; the credentials
    // (EInv_SecretID / EInv_SecretKey / EInv_CertPath / EInv_CertPass) must NEVER be committed -
    // keep them in the git-ignored appsettings.local.json, in environment variables
    // (Einvoice__EInv_SecretID, Einvoice__EInv_SecretKey, Einvoice__EInv_CertPath, ...) or in a
    // per-company profile under "Einvoice:Companies:{CompanyCode}".
    // Pre-production:
    "EInv_Url": "https://preprod-api.myinvois.hasil.gov.my",
    "EInv_portal": "https://preprod.myinvois.hasil.gov.my",
    // Production (switch both when going live):
    //   "EInv_Url": "https://api.myinvois.hasil.gov.my",
    //   "EInv_portal": "https://myinvois.hasil.gov.my",
    // Working folder for the generated/signed JSON payloads. The signing step writes here before
    // the library creates the folder itself, so the façade creates it before each submission.
    // Keep it writable.
    "EInv_JsonPath": "App_Data/einvoice",
    "EInv_docversion": "1.1",
    // Blank and "direct" both mean "issue under our own TIN". Leave it blank: "direct" also
    // suppresses a per-company EInv_OnBehalfTin, blank lets that profile value take effect.
    "EInv_onbehalfof": "",
    // A SUBMITTING row older than this is eligible for operator/automatic recovery.
    "SubmittingStuckMinutes": 15,
    // How long after validation a submitted document may still be cancelled at MyInvois.
    // LHDN rule (verified): 72 hours from the document's validation timestamp; after that a
    // credit note / debit note / refund note is required. The limit is document-type specific
    // (Get Document Type workflow parameters), so it is configurable rather than hard-coded.
    "CancelWindowHours": 72,
    // How many days back Recover searches MyInvois when it has to look a document up by number.
    "RecoverySearchDays": 30
  },
  "Purchase": {
    "PoPr": {
      "SupplierPrice": 0,
      "UseWeight": false,
      "PurchaseItemTaxInclusive": false,
      "PurchaseTaxDec": 2,
      "POControlIcode": false,
      "SelfViewEdit": false,
      "DraftAttachmentTtlHours": 24
    },
    "PoOrder": {
      "SupplierPrice": 0,
      "UseWeight": false,
      "PurchaseItemTaxInclusive": false,
      "PurchaseTaxDec": 2,
      "POPriceDecimal": 6,
      "POControlIcode": false,
      "SelfViewEdit": false,
      "DraftAttachmentTtlHours": 24
    }
  }
}
