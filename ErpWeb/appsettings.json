{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=ERPWeb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Error",
        "System": "Error",
        "Microsoft.AspNetCore": "Error",
        "Microsoft.EntityFrameworkCore": "Error",
        "Microsoft.AspNetCore.SignalR": "Error",
        "Microsoft.AspNetCore.Http.Connections": "Error",
        "DevExpress": "Error",
        "ErpWeb": "Debug",
        "ErpWeb.Core": "Debug",
        "ErpWeb.Library": "Debug",
        "ErpWeb.Model": "Debug",
        "ErpWeb.UI": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "./logs/erpweb-logfile.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "fileSizeLimitBytes": 104857600,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level}] {Message}{NewLine}{Exception}"

        }
      }
    ],
    "Properties": {
      "Application": "Common feature in WebApi demo"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Microsoft": "Error",
      "System": "Error",
      "DevExpress": "Error",
      "ErpWeb": "Debug",
      "ErpWeb.Core": "Debug",
      "ErpWeb.Library": "Debug",
      "ErpWeb.Model": "Debug",
      "ErpWeb.UI": "Debug"
    }
  },
  "AllowedHosts": "*",
  "PasswordPolicy": {
    "MinimumLength": 8,
    "RequireLetter": true,
    "RequireDigit": true,
    "RejectUsername": true
  },
  "Menus": {
    "XmlPath": "Menus/menus.xml",
    "SyncOnStartup": true
  }
}
