{
  "AppBasePath": "erpweb/",

  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SQL_SERVER;Database=ERPWeb;User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=true;Encrypt=True"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "ErpWeb": "Information",
      "ErpWeb.Core": "Information",
      "ErpWeb.Library": "Information",
      "ErpWeb.Model": "Information",
      "ErpWeb.UI": "Information"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "ErpWeb": "Information",
        "ErpWeb.Core": "Information",
        "ErpWeb.Library": "Information",
        "ErpWeb.Model": "Information",
        "ErpWeb.UI": "Information"
      }
    }
  },

  "Einvoice": {
    "EInv_Url": "https://preprod-api.myinvois.hasil.gov.my",
    "EInv_portal": "https://preprod.myinvois.hasil.gov.my",
    "EInv_JsonPath": "App_Data/einvoice",
    "EInv_docversion": "1.1",
    "EInv_onbehalfof": "",
    "SubmittingStuckMinutes": 15,
    "CancelWindowHours": 72,
    "RecoverySearchDays": 30
  },

  "Menus": {
    "XmlPath": "Menus/menus.xml",
    "SyncOnStartup": true
  },

  "Attachments": {
    "RootPath": "App_Data/attachments"
  }
}