{

  // The app's relative root path, WITH the trailing slash. Set this to the IIS sub-application name
  // when the app is deployed below the site root. Program.cs strips it with UsePathBase and
  // Components/App.razor renders it as <base href>, so routing, static assets, the Blazor SignalR hub
  // and relative links all resolve inside the sub-application.
  //
  // Leave it blank ("" or remove the key) when the app is the root of its site.
  //
  // This file only applies when ASPNETCORE_ENVIRONMENT=Production (the default when the environment
  // variable is absent). If the host runs another environment, set the app-pool environment variable
  // AppBasePath=erpweb/ instead - an environment variable beats every appsettings file.
  "AppBasePath": "erpweb/",

  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "ErpWeb": "Debug",
      "ErpWeb.Core": "Debug",
      "ErpWeb.Library": "Debug",
      "ErpWeb.Model": "Debug",
      "ErpWeb.UI": "Debug"
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Error",
      "Override": {
        "ErpWeb": "Debug",
        "ErpWeb.Core": "Debug",
        "ErpWeb.Library": "Debug",
        "ErpWeb.Model": "Debug",
        "ErpWeb.UI": "Debug"
      }
    }
  }
}
