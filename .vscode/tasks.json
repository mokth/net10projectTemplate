    {
      "label": "test: Sales > Pricing engine",
      "type": "shell",
      "command": "dotnet test ErpWeb.Tests/ErpWeb.Tests.csproj --filter \"Category=SalesPricing&Category!=SqlServer\"",
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test: Purchase > Order (PO)",
      "type": "shell",
      "command": "dotnet test ErpWeb.Tests/ErpWeb.Tests.csproj --filter \"Category=PurchaseOrder&Category!=SqlServer\"",
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test: Purchase > Credit/Debit Note (CN/DN)",
      "type": "shell",
      "command": "dotnet test ErpWeb.Tests/ErpWeb.Tests.csproj --filter \"Category=PurchaseCdn&Category!=SqlServer\"",
