      "problemMatcher": "$msCompile"
    },
    {
      "label": "test: Sales > Quotation (QT)",
      "type": "shell",
      "command": "dotnet test ErpWeb.Tests/ErpWeb.Tests.csproj --filter \"Category=SalesQt&Category!=SqlServer\"",
