      "problemMatcher": "$msCompile"
    },
    {
      "label": "test: Sales > Sales Order (SO)",
      "type": "shell",
      "command": "dotnet test ErpWeb.Tests/ErpWeb.Tests.csproj --filter \"Category=SalesSo&Category!=SqlServer\"",
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test: Sales > Delivery Order (DO)",
      "type": "shell",
      "command": "dotnet test ErpWeb.Tests/ErpWeb.Tests.csproj --filter \"Category=SalesDo&Category!=SqlServer\"",
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test: Sales > Invoice",
      "type": "shell",
      "command": "dotnet test ErpWeb.Tests/ErpWeb.Tests.csproj --filter \"Category=SalesInvoice&Category!=SqlServer\"",
