    {
      "label": "test: EInvoice",
      "type": "shell",
      "command": "dotnet test ErpWeb.Tests/ErpWeb.Tests.csproj --filter \"Category=EInvoice\"",
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test: SqlServer concurrency only",
      "detail": "Requires the scratch-DB env vars to be exported in a SEPARATE terminal command first (a connection string on the dotnet test line is truncated at the first ';').",
      "type": "shell",
      "command": "dotnet test ErpWeb.Tests/ErpWeb.Tests.csproj --filter \"Category=SqlServer\"",
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: solution (catches .razor errors dotnet test cannot)",
      "type": "shell",
      "command": "dotnet build ErpWeb.slnx --nologo -v:q",
      "group": "build",
      "problemMatcher": "$msCompile"
    }
  ],
  "inputs": [
    {
      "id": "category",
      "type": "pickString",
      "description": "Which test category should run?",
      "default": "SalesMasters",
      "options": [
        "SalesMasters",
        "SalesPricing",
        "SalesQt",
        "SalesSo",
        "SalesDo",
        "SalesInvoice",
        "SalesCdn",
        "SalesShared",
        "PurchaseMasters",
        "PurchasePr",
        "PurchaseOrder",
        "PurchaseInvoice",
        "PurchaseCdn",
        "PurchaseSelfBilled",
        "InventoryMasters",
        "InventoryGoodsReceipt",
        "InventoryMiscIssue",
        "InventoryMiscReceipt",
        "InventoryScrap",
        "InventoryAdjustment",
        "InventoryStockCount",
        "InventoryStockReturn",
        "InventoryVendorReturn",
        "InventoryTransfer",
        "InventoryPosting",
        "Sales",
        "EInvoice",
        "Purchase",
        "Inventory",
        "Menus",
