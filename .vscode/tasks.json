{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "test: fast (all except SqlServer)",
      "detail": "Whole suite minus the *SqlServerConcurrencyTests categories (~1960 tests). The day-to-day loop.",
      "type": "shell",
      "command": "dotnet test ErpWeb.Tests/ErpWeb.Tests.csproj --filter \"Category!=SqlServer\"",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test: all (including SqlServer)",
      "detail": "Full suite (~2036 tests). Requires ConnectionStrings__SqlServerTestConnection + ERPWEB_REQUIRE_SQLSERVER_TESTS=1 set in a SEPARATE terminal command first.",
      "type": "shell",
      "command": "dotnet test ErpWeb.Tests/ErpWeb.Tests.csproj",
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test: rerun last build (no rebuild)",
      "detail": "Skips the build. Only safe when no source file changed since the last build.",
      "type": "shell",
      "command": "dotnet test ErpWeb.Tests/ErpWeb.Tests.csproj --no-build --filter \"Category!=SqlServer\"",
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test: pick a category",
      "detail": "Prompt for a category from TestCategories.",
      "type": "shell",
      "command": "dotnet test ErpWeb.Tests/ErpWeb.Tests.csproj --filter \"Category=${input:category}\"",
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test: Sales (no SqlServer)",
      "type": "shell",
      "command": "dotnet test ErpWeb.Tests/ErpWeb.Tests.csproj --filter \"Category=Sales&Category!=SqlServer\"",
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test: Purchase (no SqlServer)",
      "type": "shell",
      "command": "dotnet test ErpWeb.Tests/ErpWeb.Tests.csproj --filter \"Category=Purchase&Category!=SqlServer\"",
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test: Inventory (no SqlServer)",
      "type": "shell",
      "command": "dotnet test ErpWeb.Tests/ErpWeb.Tests.csproj --filter \"Category=Inventory&Category!=SqlServer\"",
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test: Sales > Masters",
      "type": "shell",
      "command": "dotnet test ErpWeb.Tests/ErpWeb.Tests.csproj --filter \"Category=SalesMasters&Category!=SqlServer\"",
